            <div class="adl-overview-title-row">
                <h2>Updated book &ldquo;Atomic Habits&rdquo; (Price)</h2>
                <span class="action-badge action-badge--update">@Model.ActionType</span>
            </div>
            <div class="adl-overview-desc">@Model.Description</div>
        </div>
    </div>

    <div class="adl-meta-strip">
        <div class="adl-meta-item">
            <div class="adl-meta-avatar avatar-green">@firstInitial@secondInitial</div>
            <div class="adl-meta-text">
                <div class="adl-meta-primary">@Model.UserName</div>
                <div class="adl-meta-secondary">@Model.Role</div>
            </div>
        </div>
        <div class="adl-meta-item">
            <div class="adl-meta-icon"><i class="ti ti-books"></i></div>
            <div class="adl-meta-text">
                <div class="adl-meta-primary">Books</div>
                <div class="adl-meta-secondary">Module</div>
            </div>
        </div>
        <div class="adl-meta-item">
            <div class="adl-meta-icon"><i class="ti ti-book"></i></div>
            <div class="adl-meta-text">
                <div class="adl-meta-primary">Book</div>
                <div class="adl-meta-secondary">Entity</div>
            </div>
        </div>
        <div class="adl-meta-item">
            <div class="adl-meta-text">
                <div class="adl-meta-primary">BK-2025-00123</div>
                <div class="adl-meta-secondary">Entity ID</div>
            </div>
        </div>
        <div class="adl-meta-item">
            <div class="adl-meta-icon"><i class="ti ti-calendar"></i></div>
            <div class="adl-meta-text">
                <div class="adl-meta-primary">@Model.Timestamp.ToString("MMM dd, yyyy")</div>
                <div class="adl-meta-secondary">@Model.Timestamp.ToString("hh:mm tt")</div>
            </div>
        </div>
        <div class="adl-meta-item">
            <div class="adl-meta-text">
                <div class="adl-meta-primary">197.159.112.45</div>
                <div class="adl-meta-secondary">IP Address</div>
            </div>
        </div>
    </div>
</div>

