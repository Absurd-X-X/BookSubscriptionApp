                <td>Jun 8, 2025<br>09:50 AM</td>
                <td><span class="action-badge action-badge--update">UPDATE</span></td>
                <td>Users</td>
                <td>User</td>
                <td>Updated user role from Reader to Admin</td>
                <td>197.159.112.20</td>
                <td>
                    <div class="related-user-cell">
                        <div class="related-user-avatar avatar-orange">LA</div>
                        <div>
                            <div class="related-user-name">Library Admin</div>
                            <div class="related-user-role">Admin</div>
                        </div>
                    </div>
                </td>
                <td><button type="button" class="related-view-link" data-log-id="US-2025-00078">View</button></td>
            </tr>
        </tbody>
    </table>
</div>

<script>
    (function () {
        'use strict';

        /* ── Back to Audit Logs: uses browser history ── */
        var backBtn = document.getElementById('backToAuditLogs');
        if (backBtn) {
            backBtn.addEventListener('click', function () {
                if (window.history.length > 1) {
                    window.history.back();
                } else {
                    // Fallback if there's no history to go back to
                    window.location.href = '@Url.Action("AdminActivity", "Admin")';
                }
            });
        }

        /* ── Related Logs "View" \u2014 navigate to that log's detail page ── */
        function goToLogDetails(logId) {
            // Wire this to the real route once available, e.g.:
            // window.location.href = '@Url.Action("GetActivityDetails", "Admin")' + '?id=' + encodeURIComponent(logId);
            window.location.href = '@Url.Action("GetActivityDetails", "Admin")' + '?id=' + encodeURIComponent(logId);
        }

        document.querySelectorAll('.related-view-link').forEach(function (btn) {
            btn.addEventListener('click', function (e) {
                e.stopPropagation();
                goToLogDetails(btn.getAttribute('data-log-id'));
            });
        });

        // Clicking anywhere else on a related-log row also navigates to that log
        document.querySelectorAll('.related-logs-table tbody tr').forEach(function (row) {
            row.style.cursor = 'pointer';
            row.addEventListener('click', function () {
                goToLogDetails(row.getAttribute('data-log-id'));
            });
        });

    })();
</script>

