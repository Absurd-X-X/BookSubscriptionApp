@using static Application.Queries.GetActivityById
@model GetActivityByIdResponse

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Audit Log Details";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@3.19.0/dist/tabler-icons.min.css" />
<link rel="stylesheet" href="~/css/activity.css" />

<div class="adl-header">
    <h1>Audit Log Details</h1>
    <button type="button" class="adl-back-link" id="backToAuditLogs">
        <i class="ti ti-arrow-left"></i> Back to Audit Logs
    </button>
</div>

@{
    string[] strings = { "jd", "sm", "la", "mt", "aw" };

    Random rand = new Random();

    string userInitials = strings[rand.Next(0, strings.Length)];

    string name = Model.UserName;
    string[] nameParts = name.Split(' ');

    char firstInitial;
    char secondInitial;

    if (nameParts.Length < 2)
    {
        firstInitial = nameParts[0][0];
        secondInitial = nameParts[0][nameParts.Length - 1];
    }
    else
    {
        firstInitial = nameParts[0][0];
        secondInitial = nameParts[1][0];
    }
}

<!-- ── LOG OVERVIEW ── -->
