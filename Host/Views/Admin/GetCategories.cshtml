@using static Application.Queries.GetAllCategories
@model Application.Common.Pagenation.PagenatedList<GetAllCategoryResponse>


@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Get Categories";
}

<link href="~/css/getUsers.css" rel="stylesheet" />
<link href="~/css/notify.css" rel="stylesheet" asp-append-version="true" />
<link href="~/css/modal.css" rel="stylesheet" asp-append-version="true" />
<link href="~/css/toast.css" rel="stylesheet" asp-append-version="true" />

<section class="main-container">
    <h2>System Book Categories</h2>
    <div class="sub-main">
        <div class="for-total">
            <img src="~/lib/images/menu.png" alt="Alternate Text" />

            <div class="more-info">
                <small>Total Categories</small>
                <h3>20000+</h3>
            </div>
        </div>

        <div class="for-active">
            <img src="~/lib/images/circle.png" alt="Alternate Text" />

            <div class="more-info">
                <small>Total Undeleted Categories</small>
                <h3>20000+</h3>
            </div>
        </div>

        <div class="for-readers">
            <img src="~/lib/images/open-book.png" alt="Alternate Text" />

            <div class="more-info">
                <small>Category Books</small>
                <h3>20000+</h3>
            </div>
        </div>

        <div class="for-today">
            <img src="~/lib/images/calendar.png" alt="Alternate Text" />

            <div class="more-info">
                <small>New Today</small>
                <h3>20000+</h3>
            </div>
        </div>

        <div class="users-table">
            <div class="actions">
                <h3>Category Directory</h3>

                <div class="real-actions">

                    <div class="search-box">
                        <input type="text" placeholder="Search...">
                        <img src="~/lib/images/search.svg" class="icon" alt="Search">
                    </div>

                    <select name="filter-action" id="filter-action">
                        <option value="" disabled selected>Filter By Plan</option>
                        <option value="library">Libarians</option>
                        <option value="Readers">Libarians</option>
                        <option value="Others">Libarians</option>
                    </select>

                    <button id="openPaymentModal" class="btn-primary button">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                        Add New Category
                    </button>

                    <div id="paymentModal"
                         class="modal-overlay">

                        <div class="modal-content"
                             style="--modal-width:900px;">

                            <div class="modal-header">

                                <h2>Add New Category</h2>

                                <button type="button"
                                        id="closePaymentModal"
                                        class="close-btn">

                                    &times;

                                </button>

                            </div>

                            <form class="form" id="loginForm"
                                  asp-action="AddCategory"
                                  method="post">

                                <div class="modal-body">

                                    <div class="form-group">

                                        
                                        <label for="CategoryName">
                                            Category Name
                                            </label>
                                        <input type="text" id="CategoryName" 
                                            name="Name" 
                                            placeholder="e.g., Fiction, Science, Biography" 
                                            required />

                                    </div>
                                    <div class="form-group full-width">

                                        <label for="Notes">
                                            Notes (Optional)
                                        </label>

                                        <textarea id="Description"
                                                  name="Description"
                                                  rows="4"
                                                  placeholder="Additional information..."></textarea>

                                    </div>

                                </div>

                                <div class="modal-footer">

                                    <button type="button"
                                            id="cancelPaymentModal"
                                            class="btn-cancel">

                                        Cancel

                                    </button>

                                    <button type="submit"
                                            class="btn-save">
                                        Create Category

                                    </button>

                                </div>

                            </form>
                        </div>
                     </div>
                </div>
            </div>
            <table>
                <thead>
                    <tr>
                        <th>Category Image</th>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Date Created</th>
                        <th>Books Count</th>
                        <th>Engagement</th>
                        <th style="text-align: center;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in Model.Items)
                    {
                        <tr>
                            <td><img src="~/lib/images/menu.png" class="icon" alt="Alternate Text" /></td>
                            <td>@category.Name </td>
                            @{
                                string[] categoryrendered = category.Description.Split(' ');
                                string[] render = new string[8];
                                for(int i = 0; i <= 7; i++)
                                {
                                    render[i] = categoryrendered[i];
                                }
                                string finalRender = "";
                                foreach(string item in render)
                                {
                                    finalRender += $"{" "}{item}";
                                }

                                string returns = $"{finalRender}•••";
                            }
                            <td>@returns</td>
                            <td>@category.DateCreated.ToString("MMM dd, yyyy")</td>
                            <td>@category.BooksCount</td>

                            <td class="engagement-cell">
                                <div class="progress-track">
                                    <div class="progress-fill" style="max-width 100%; width: (@category.BooksCount * 5)%;"></div>
                                </div>
                            </td>

                            <td style="text-align: right; padding-right: 16px; white-space: nowrap;">

                                <a href="@Url.Action("EditCategory", "Admin", new { categoryId = category.CategoryId })"
                                   class="action-link details">
                                    Edit
                                </a>

                                <a href="@Url.Action("GetCategory", "Admin", new { categoryId = category.CategoryId })"
                                   class="action-link details">
                                    Manage
                                </a>

                                <a href="javascript:void(0)"
                                   class="action-link delete"
                                   onclick="confirmDeleteAction('@Url.Action("DeleteCategory", "Admin", new { id = category.CategoryId })')">
                                    Ban
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>


            @{
                string isFirstDisabled = (Model.Page <= 1) ? "disabled" : "";
                string isLastDisabled = (Model.Page >= Model.PageCount) ? "disabled" : "";
            }

            <div class="table-pagination-container">

                <a asp-controller="Admin" asp-action="GetCategories" asp-route-page="1" asp-route-pageSize="@Model.PageSize"
                   class="page-item page-icon @isFirstDisabled">
                    &#124;&lt;
                </a>

                <a asp-controller="Admin" asp-action="GetCategories" asp-route-page="@(Model.Page - 1)" asp-route-pageSize="@Model.PageSize"
                   class="page-item page-icon @isFirstDisabled">
                    &lt;
                </a>

                @for (int i = 1; i <= Model.PageCount; i++)
                {
                    string isActive = (i == Model.Page) ? "active" : "";

                    <a asp-controller="Admin" asp-action="GetCategories" asp-route-page="@i" asp-route-pageSize="@Model.PageSize"
                       class="page-item page-number @isActive">
                        @i
                    </a>
                }

                <a asp-controller="Admin" asp-action="GetCategories" asp-route-page="@(Model.Page + 1)" asp-route-pageSize="@Model.PageSize"
                   class="page-item page-icon @isLastDisabled">
                    &gt;
                </a>

                <a asp-controller="Admin" asp-action="GetCategories" asp-route-page="@Model.PageCount" asp-route-pageSize="@Model.PageSize"
                   class="page-item page-icon @isLastDisabled">
                    &gt;&#124;
                </a>

            </div>


        </div>
    </div>
    <script src="~/js/myJsFile.js"></script>
    <script src="~/js/modal.js"></script>
    <script src="~/js/toast.js"></script>

</section>

<script>
    document.getElementById('loginForm').addEventListener('submit', async function (e) {
    e.preventDefault();

    const formData = new FormData(this);

    Modal.show('loading', { title: 'Adding new category...', message: 'Please wait.' });

    try {
    const response = await fetch('@Url.Action("AddCategory", "Admin")', { method: 'POST', body: formData });
    const data = await response.json();

    if (data.success) {
    Modal.show('success', { title: 'Added Successfully!', message: 'You`ve now added a new category ' });
    setTimeout(() => window.location.href = data.redirectUrl, 1200);

    } else if (data.redirectUrl) {
    // e.g. "not verified" case — redirect instead of just showing an error
    window.location.href = data.redirectUrl;
    }

    else {
    Modal.show('error', { title: 'Failed To Create!', message: data.message });
    }
    } catch (err) {
    Modal.show('error', { title: 'Network error', message: 'Could not reach the server.' });
    }
    });

    function confirmDeleteAction(actionUrl) {
    Modal.show('confirmDelete', {
    title: 'Remove from catalog',
    message: 'This will permanently remove this book from the library catalog records. This cannot be undone.',
    requiredText: 'DELETE',
    confirmLabel: 'Delete',
    formAction: actionUrl,
    formMethod: 'post'
    });
    }
</script>

