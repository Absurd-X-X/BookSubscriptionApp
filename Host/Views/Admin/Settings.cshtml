<script src="app.js"></script>

<script>
    const TABS = ['general','business','payment','security','notifications','system-settings','backup'];

    function switchTab(name, btn) {

    TABS.forEach(id => {
    const panel = document.getElementById('tab-' + id);

    if (panel)
    panel.classList.remove('active');
    });

    document.querySelectorAll('.tab-btn')
    .forEach(b => b.classList.remove('active'));

    const target = document.getElementById('tab-' + name);

    if (target)
    target.classList.add('active');

    if (btn)
    btn.classList.add('active');
    }

    function toggleSwitch(el) {
    el.classList.toggle('on');
    el.classList.toggle('off');
    }

    function toggleSecret(iconEl) {
    const field = iconEl.closest('.secret-field');
    if (!field) return;
    const valueEl = field.querySelector('.secret-value');
    if (!valueEl) return;

    const isHidden = iconEl.classList.contains('ti-eye');
    if (isHidden) {
    valueEl.textContent = valueEl.getAttribute('data-value');
    iconEl.classList.remove('ti-eye');
    iconEl.classList.add('ti-eye-off');
    } else {
    valueEl.textContent = '••••••••••••••••••••';
    iconEl.classList.remove('ti-eye-off');
    iconEl.classList.add('ti-eye');
    }
    }
</script>

