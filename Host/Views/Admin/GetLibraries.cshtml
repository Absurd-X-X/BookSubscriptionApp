@using static Application.Queries.GetAllLibrary
@model Application.Common.Pagenation.PagenatedList<GetAllLibraryResponse>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "All Libraries";
}


<link href="~/css/getUsers.css" rel="stylesheet" />
<link href="~/css/notify.css" rel="stylesheet" asp-append-version="true" />
<link href="~/css/modal.css" rel="stylesheet" asp-append-version="true" />
<link href="~/css/toast.css" rel="stylesheet" asp-append-version="true" />

<section class="main-container">
    <h2>System Subscription Management</h2>
    <div class="sub-main">
        <div class="for-total">
            <img src="~/lib/images/members.png" alt="Alternate Text" />

            <div class="more-info">
                <small>Total Active Libraries</small>
                <h3>20000+</h3>
            </div>
        </div>

        <div class="for-active">
            <img src="~/lib/images/add-friend.png" alt="Alternate Text" />

            <div class="more-info">
                <small>Monthly Recurring Revenue</small>
                <h3>20000+</h3>
            </div>
        </div>

        <div class="for-readers">
            <img src="~/lib/images/add-friend.png" alt="Alternate Text" />

            <div class="more-info">
                <small>New Library (30 days)</small>
                <h3>20000+</h3>
            </div>
        </div>

        <div class="for-today">
            <img src="~/lib/images/calendar.png" alt="Alternate Text" />

            <div class="more-info">
                <small>New Today</small>
                <h3>20000+</h3>
            </div>
        </div>
        <div class="users-table">
            <div class="actions">
                <h3>Library Contents</h3>

                <div class="real-actions">

                    <div class="search-box">
                        <input type="text" placeholder="Search...">
                        <img src="~/lib/images/search.svg" class="icon" alt="Search">
                    </div>

                    <select name="filter-action" id="filter-action">
                        <option value="" disabled selected>Filter By Plan</option>
                        <option value="library">Libarians</option>
                        <option value="Readers">Libarians</option>
                        <option value="Others">Libarians</option>
                    </select>
                    <button id="openPaymentModal" class="btn-primary button">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                        Add New Library
                    </button>

                    <div id="paymentModal"
                         class="modal-overlay">

                        <div class="modal-content"
                             style="--modal-width:900px;">

                            <div class="modal-header">

                                <h2>Add New Library</h2>

                                <button type="button"
                                        id="closePaymentModal"
                                        class="close-btn">

                                    &times;

                                </button>

                            </div>

                            <form class="form" id="loginForm"
                                  asp-action="AddLibrary"
                                  method="post">

                                <div class="modal-body">

                                    <div class="form-group">

                                        <label for="Name">
                                            Library Name
                                        </label>

                                        <input type="text"
                                               id="Name"
                                               name="Name"
                                               placeholder="e.g., Ade, Ola, Unilag"
                                               required />

                                    </div>

                                    <div class="form-group">

                                        <label for="UserName">
                                            User Name (Optional)
                                        </label>

                                        <input type="text"
                                               id="UserName"
                                               name="UserName"
                                               placeholder="Short username" />

                                    </div>

                                    <div class="form-group">

                                        <label for="Email">
                                            Email
                                        </label>

                                        <input type="email"
                                               id="Email"
                                               name="Email"
                                               placeholder="Input a valid email"
                                               required />

                                    </div>

                                    <div class="form-group">

                                        <label for="Password">
                                            Password
                                        </label>

                                        <div class="password-wrapper">

                                            <input type="password"
                                                   id="Password"
                                                   name="Password"
                                                   placeholder="Your password here..."
                                                   required />

                                            <button type="button"
                                                    id="togglePasswordBtn"
                                                    class="toggle-password-btn"
                                                    aria-label="Toggle password visibility">

                                                <svg id="eyeIcon"
                                                     viewBox="0 0 24 24"
                                                     fill="none"
                                                     stroke="#8A94A6"
                                                     stroke-width="2"
                                                     stroke-linecap="round"
                                                     stroke-linejoin="round">

                                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>

                                                    <circle cx="12"
                                                            cy="12"
                                                            r="3"></circle>

                                                </svg>

                                            </button>

                                        </div>

                                    </div>

                                    <div class="form-group">

                                        <label for="PhoneNumber">
                                            Phone Number
                                        </label>

                                        <input type="tel"
                                               id="PhoneNumber"
                                               name="PhoneNumber"
                                               placeholder="Input valid phone number"
                                               required />

                                    </div>

                                    <div class="form-group full-width">

                                        <label for="Notes">
                                            Notes (Optional)
                                        </label>

                                        <textarea id="Notes"
                                                  name="Notes"
                                                  rows="4"
                                                  placeholder="Additional information..."></textarea>

                                    </div>

                                </div>

                                <div class="modal-footer">

                                    <button type="button"
                                            id="cancelPaymentModal"
                                            class="btn-cancel">

                                        Cancel

                                    </button>

                                    <button type="submit"
                                            class="btn-save">
                                        Create Library

                                    </button>

                                </div>

                            </form>

    </div>

</div>

<script src="~/js/modal.js"></script>

<partial name="_ValidationScriptsPartial" /></div>

                </div>
            <table>
                <thead>
                    <tr>
                        <th> Name</th>
                        <th> Email</th>
                        <th>Phone Number</th>
                        <th>Ref Number</th>
                        <th>Status</th>
                        <th>No Of Books</th>
                        <th>Date Created</th>
                        <th style="text-align: center;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var library in Model.Items)
                    {
                        <tr>
                            <td>@(library.Name ?? "User")</td>
                            <td>@(library.Email ?? "User")</td>
                            <td><span class="role-badge badge-admin">@(library.PhoneNumber ?? "N/A")</span></td>
                            <td>@library.RefNumber</td>
                            <td>
                                @{
                                    string status = library.IsActive ? "badge-moderator" : "badge-subscriber";
                                }
                                <span class="role-badge @status">@(library.IsActive ? "Active" : "Suspended")</span>
                            </td>
                            <td>@library.Books.Count()</td>

                            <td>@library.DateCreated.ToString("MMM dd, yyyy")</td>

                            <td style="text-align: right; padding-right: 16px; white-space: nowrap;">

                                <a href="@Url.Action("EditLibrary", "Admin", new { id = library.LibraryId })"
                                   class="action-link details">
                                    Manage
                                </a>

                                <a href="@Url.Action("GetInvoices", "Admin", new { id = library.LibraryId })"
                                   class="action-link details">
                                    Invoices
                                </a>

                                <a href="javascript:void(0)"
                                   class="action-link delete"
                                   onclick="confirmDeleteAction('@Url.Action("DeleteBook", "Admin", new { id = library.LibraryId })')">
                                    Cancel
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>


            @{
                string isFirstDisabled = (Model.Page <= 1) ? "disabled" : "";
                string isLastDisabled = (Model.Page >= Model.PageCount) ? "disabled" : "";
            }

            <div class="table-pagination-container">

                <a asp-controller="Admin" asp-action="GetUsers" asp-route-page="1" asp-route-pageSize="@Model.PageSize"
                   class="page-item page-icon @isFirstDisabled">
                    &#124;&lt;
                </a>

                <a asp-controller="Admin" asp-action="GetUsers" asp-route-page="@(Model.Page - 1)" asp-route-pageSize="@Model.PageSize"
                   class="page-item page-icon @isFirstDisabled">
                    &lt;
                </a>

                @for (int i = 1; i <= Model.PageCount; i++)
                {
                    string isActive = (i == Model.Page) ? "active" : "";

                    <a asp-controller="Admin" asp-action="GetUsers" asp-route-page="@i" asp-route-pageSize="@Model.PageSize"
                       class="page-item page-number @isActive">
                        @i
                    </a>
                }

                <a asp-controller="Admin" asp-action="GetUsers" asp-route-page="@(Model.Page + 1)" asp-route-pageSize="@Model.PageSize"
                   class="page-item page-icon @isLastDisabled">
                    &gt;
                </a>

                <a asp-controller="Admin" asp-action="GetUsers" asp-route-page="@Model.PageCount" asp-route-pageSize="@Model.PageSize"
                   class="page-item page-icon @isLastDisabled">
                    &gt;&#124;
                </a>

            </div>
        </div>
    </div>

    <script src="~/js/myJsFile.js"></script>
    <script src="~/js/modal.js"></script>
    <script src="~/js/toast.js"></script>
    <script>
     
    document.getElementById('loginForm').addEventListener('submit', async function (e) {
    e.preventDefault();

    const formData = new FormData(this);

    Modal.show('loading', { title: 'Creating Account...', message: 'Please wait.' });

    try {
    const response = await fetch('@Url.Action("AddLibrary", "Admin")', { method: 'POST', body: formData });
    const data = await response.json();

    if (data.success) {
    Modal.show('success', { title: 'Created Successfully!', message: 'You`ve now added a new Library ' });
    setTimeout(() => window.location.href = data.redirectUrl, 1000);

    } else if (data.redirectUrl) {
    // e.g. "not verified" case — redirect instead of just showing an error
    window.location.href = data.redirectUrl;
    }

    else {
    Modal.show('error', { title: 'Failed To Create!', message: data.message });
    }
    } catch (err) {
    Modal.show('error', { title: 'Network error', message: 'Could not reach the server.' });
    }
    });

        function confirmDeleteAction(actionUrl) {
        Modal.show('confirmDelete', {
        title: 'Remove from catalog',
        message: 'This will permanently remove this book from the library catalog records. This cannot be undone.',
        requiredText: 'DELETE',
        confirmLabel: 'Delete',
        formAction: actionUrl,
        formMethod: 'post'
        });
        }

    </script>

</section>
