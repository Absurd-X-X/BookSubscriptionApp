@using Domain.Enums
@using static Application.Queries.GetTransactions
@model Application.Common.Pagenation.PagenatedList<GetTransactionsResponse>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Get Transactions";
}
<link href="~/css/transaction.css" rel="stylesheet" />

<main class="main">

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <!-- PAGE HEADER -->
    <div class="page-header">
        <div>
            <h1>Transactions</h1>
            <p>Track and manage all payment transactions in the system</p>
        </div>
        <div class="header-actions">
            <button class="btn-outline">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
                Export
            </button>
            <button id="openPaymentModal" class="btn-primary">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                Record Manual Payment
            </button>

            <div id="paymentModal" class="modal-overlay">
                <div class="payment-modal">
                    <div class="modal-header">
                        <h2>Record Manual Payment</h2>
                        <button id="closePaymentModal" class="close-btn">&times;</button>
                    </div>

                    <div class="modal-body">
                        <div class="form-group">
                            <label>Payment Type</label>
                            <select>
                                <option>Subscription Payment</option>
                                <option>Wallet Funding</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label>Library</label>
                            <select>
                                <option>Select Library</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label>Amount (₦)</label>
                            <input type="number" placeholder="Enter amount" />
                        </div>

                        <div class="form-group">
                            <label>Payment Method</label>
                            <select>
                                <option>Bank Transfer</option>
                                <option>Cash</option>
                                <option>POS</option>
                                <option>Cheque</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label>Reference Number</label>
                            <input type="text" placeholder="TRF123456789" />
                        </div>

                        <div class="form-group">
                            <label>Payment Date</label>
                            <input type="date" />
                        </div>

                        <div class="form-group full-width">
                            <label>Notes</label>
                            <textarea rows="4" placeholder="Add any notes about this payment"></textarea>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button id="cancelPaymentModal" class="btn-cancel">Cancel</button>
                        <button class="btn-save">Record Payment</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- STAT CARDS -->
    <div class="stat-grid">
        <div class="stat-card">
            <div class="stat-icon icon-blue">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" /><path d="M8 21h8m-4-4v4" /></svg>
            </div>
            <div>
                <p class="stat-label">Total Transactions</p>
                <p class="stat-value">@Model.TotalCount.ToString("N0")</p>
                <p class="stat-sub">All time transactions</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon icon-green">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
            </div>
            <div>
                <p class="stat-label">Successful</p>
                <p class="stat-value">@Model.Items.Count(t => t.Status == WalletTransactionStatus.Successful)</p>
                <p class="stat-sub green">On this page</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon icon-amber">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
            </div>
            <div>
                <p class="stat-label">Pending</p>
                <p class="stat-value">@Model.Items.Count(t => t.Status == WalletTransactionStatus.Pending)</p>
                <p class="stat-sub">Awaiting completion</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon icon-red">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><line x1="15" y1="9" x2="9" y2="15" /><line x1="9" y1="9" x2="15" y2="15" /></svg>
            </div>
            <div>
                <p class="stat-label">Failed</p>
                <p class="stat-value">@Model.Items.Count(t => t.Status == WalletTransactionStatus.Failed)</p>
                <p class="stat-sub red">On this page</p>
            </div>
        </div>
    </div>

    <!-- FILTERS BAR -->
    <div class="filters-bar">
        <div class="search-wrap">
            <svg class="search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
            <input type="text" placeholder="Search transactions..." />
        </div>
        <select class="filter-select">
            <option>All Types</option>
            <option>Subscription</option>
            <option>Wallet Funding</option>
        </select>
        <select class="filter-select">
            <option>All Statuses</option>
            <option>Success</option>
            <option>Pending</option>
            <option>Failed</option>
        </select>
        <select class="filter-select">
            <option>All Payment Methods</option>
            <option>Paystack Card</option>
            <option>Paystack Bank Transfer</option>
            <option>Paystack USSD</option>
            <option>OPay</option>
            <option>Manual</option>
        </select>
        <button class="date-btn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
            Filter by date
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9" /></svg>
        </button>
        <button class="filter-btn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="6" x2="20" y2="6" /><line x1="8" y1="12" x2="16" y2="12" /><line x1="11" y1="18" x2="13" y2="18" /></svg>
            Filter
        </button>
    </div>

    <!-- TRANSACTIONS TABLE -->
    <div class="table-card">

        @if (Model.Items == null || !Model.Items.Any())
        {
            <p class="ss" style="padding:16px;">No transactions found.</p>
        }
        else
        {
            <table class="txn-table">
                <thead>
                    <tr>
                        <th>Transaction ID</th>
                        <th>Type</th>
                        <th>Customer</th>
                        <th>Amount</th>
                        <th>Payment Method</th>
                        <th>Status</th>
                        <th>Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var txn in Model.Items)
                    {
                        string typeBadgeClass = txn.Type == TransactionType.Payout ? "type-wallet" : "type-subscription";
                        string statusBadgeClass = txn.Status switch
                        {
                            WalletTransactionStatus.Successful => "badge-success",
                            WalletTransactionStatus.Pending => "badge-pending",
                            WalletTransactionStatus.Failed => "badge-failed",
                            _ => "badge-pending"
                        };
                        string refDisplay = string.IsNullOrEmpty(txn.PaystackReference)
                            ? "Manual entry"
                            : (txn.PaystackReference.Length > 12
                                ? txn.PaystackReference.Substring(0, 12) + "..."
                                : txn.PaystackReference);
                       
                        <tr>
                            <td>
                                <div class="txn-id">@txn.DisplayId</div>
                                <div class="txn-ref">
                                    Ref: @refDisplay
                                    <svg class="copy-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" /><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" /></svg>
                                </div>
                            </td>
                            <td>
                                <span class="type-badge @typeBadgeClass">@txn.Type</span>
                                <div class="type-sub-label">@txn.Description</div>
                            </td>
                            <td>
                                <div class="cust-name">@(txn.Wallet?.User.UserName ?? "—")</div>
                                <div class="cust-email">@(txn.Wallet?.User.Email ?? "")</div>
                            </td>
                            <td>
                                <div class="amt-value">₦@txn.Balance.ToString("N0")</div>
                            </td>
                            <td>
                                <div class="pm-row">
                                    @if (string.IsNullOrEmpty(txn.PaystackReference))
                                    {
                                        <span class="pm-manual">Manual</span>
                                    }
                                    else
                                    {
                                        <svg class="pm-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" /><line x1="1" y1="10" x2="23" y2="10" /></svg>
                                        <span class="pm-name-txt">Paystack</span>
                                    }
                                </div>
                            </td>
                            <td><span class="badge @statusBadgeClass">@txn.Status</span></td>
                            <td>
                                <div class="date-val">@txn.DateCreated.ToString("MMM d, yyyy")</div>
                                <div class="date-time">@txn.DateCreated.ToString("hh:mm tt")</div>
                            </td>
                            <td>
                                <a href="@Url.Action("GetTransaction", "Admin", new { id = txn.Id })" class="action-btn">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            

            <!-- TABLE FOOTER -->
            <div class="table-footer">

                @{
                    int totalPages = Model.PageSize > 0
                        ? (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize)
                        : 1;
                    if (totalPages < 1) { totalPages = 1; }

                    int startItem = Model.TotalCount == 0 ? 0 : ((Model.Page - 1) * Model.PageSize) + 1;
                    long endItem = Math.Min(Model.Page * Model.PageSize, Model.TotalCount);
                }

                <span>Showing @startItem to @endItem of @Model.TotalCount.ToString("N0") transactions</span>
                <div class="pagination">
                    <a class="page-btn @(Model.Page <= 1 ? "disabled" : "")"
                       href="@Url.Action("GetTransactions", new { page = Model.Page - 1, pageSize = Model.PageSize })">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6" /></svg>
                    </a>

                    @{
                        int startPage = Math.Max(1, Model.Page - 2);
                        int endPage = Math.Min(totalPages, Model.Page + 2);
                    }

                    @if (startPage > 1)
                    {
                        <a class="page-btn" href="@Url.Action("GetTransactions", new { page = 1, pageSize = Model.PageSize })">1</a>
                        @if (startPage > 2)
                        {
                            <span class="page-dots">...</span>
                        }
                    }

                    @for (int i = startPage; i <= endPage; i++)
                    {
                        <a class="page-btn @(i == Model.Page ? "active" : "")"
                           href="@Url.Action("GetTransactions", new { page = i, pageSize = Model.PageSize })">@i</a>
                    }

                    @if (endPage < totalPages)
                    {
                        @if (endPage < totalPages - 1)
                        {
                            <span class="page-dots">...</span>
                        }
                        <a class="page-btn" href="@Url.Action("GetTransactions", new { page = totalPages, pageSize = Model.PageSize })">@totalPages</a>
                    }

                    <a class="page-btn @(Model.Page >= totalPages ? "disabled" : "")"
                       href="@Url.Action("GetTransactions", new { page = Model.Page + 1, pageSize = Model.PageSize })">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6" /></svg>
                    </a>
                </div>
            </div>
        }
    </div>

    <script src="~/js/myJsFile.js"></script>
</main>