@model Application.Commands.Login.LoginCommand
@{
    Layout = null;
    ViewData["Title"] = "Soul Shelf - Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="~/css/login.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/notify.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/modal.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/toast.css" rel="stylesheet" asp-append-version="true" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@latest/dist/tabler-icons.min.css">
</head>
<body>

    <div id="toastNotification" class="toast-popup">
        <div class="toast-icon-wrapper">

            <svg id="toastSuccessIcon" class="toast-icon hidden" viewBox="0 0 24 24" fill="none" stroke="#24B35F" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
            </svg>

            <svg id="toastErrorIcon" class="toast-icon hidden" viewBox="0 0 24 24" fill="none" stroke="#E74C3C" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </div>
        <span id="toastMessage"></span>
    </div>

    <div class="contains">
        <div class="login-datas">

            <div class="login-header">
                <h1>Soul<span>Shelf</span></h1>
                <h3>Welcome Back</h3>
                <small>Sign in to access your dashboard metrics</small>
            </div>

            <form asp-controller="Auth" asp-action="Login" method="post" class="form" id="loginForm" autocomplete="off">
                @Html.AntiForgeryToken()

                <div class="login-info">
                    <label asp-for="Email">Email</label>
                    <input asp-for="Email" type="email" placeholder="Input your email" required autofocus />
                    <span asp-validation-for="Email" class="validation-span"></span>
                </div>

                <div class="login-info">
                    <label asp-for="Password">Password</label>
                    <div class="password-wrapper">
                        <input asp-for="Password" type="password" id="passwordInput" placeholder="Your password here..." required>
                        <button type="button" id="togglePasswordBtn" class="toggle-password-btn" aria-label="Toggle password visibility">
                            <svg id="eyeIcon" viewBox="0 0 24 24" fill="none" stroke="#8A94A6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="validation-span"></span>
                </div>

                <div class="remember">
                    <label class="custom-checkbox-container">
                        <input asp-for="RememberMe" type="checkbox" />
                        <span class="custom-checkmark"></span>
                        <span class="label-text">Remember Me</span>
                    </label>
                    <a href="@Url.Action("ForgotPassword", "Auth")" class="anchor">Forgot password?</a>
                </div>

                <button type="submit" class="submit-btn">Login</button>
            </form>

            <small class="signup-footer">Don't have an account? <a href="@Url.Action("Register", "Auth")" class="anchor">Create Account</a></small>
        </div>
        <script src="~/js/toast.js"></script>
        <script src="~/js/modal.js"></script>
    </div>

    <!-- UI Operations Engine Script -->
    <script>
            document.addEventListener("DOMContentLoaded", function () {

                // 1. PASSWORD STRING VISIBILITY EYE REVEAL CONTROLLER
                const passwordInput = document.getElementById('passwordInput');
                const togglePasswordBtn = document.getElementById('togglePasswordBtn');
                const eyeIcon = document.getElementById('eyeIcon');

                togglePasswordBtn.addEventListener('click', function () {
                    const isPassword = passwordInput.getAttribute('type') === 'password';
                    passwordInput.setAttribute('type', isPassword ? 'text' : 'password');

                    if (isPassword) {
                        eyeIcon.innerHTML = `
                            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                            <line x1="1" y1="1" x2="23" y2="23"></line>
                        `;
                    } else {
                        eyeIcon.innerHTML = `
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        `;
                    }
                });

            //     2. DYNAMIC ELASTIC TOAST POPOUT CONTROLLER ROUTINE
            //     function showToast(message, isSuccess) {
            //         const toast = document.getElementById('toastNotification');
            //         const msgElement = document.getElementById('toastMessage');
            //         const successIcon = document.getElementById('toastSuccessIcon');
            //         const errorIcon = document.getElementById('toastErrorIcon');

            //         msgElement.textContent = message;

            //         if (isSuccess) {
            //             toast.classList.add('success-border');
            //             successIcon.classList.remove('hidden');
            //         } else {
            //             toast.classList.add('error-border');
            //             errorIcon.classList.remove('hidden');
            //         }

            //         toast.classList.add('show');

            //         setTimeout(() => {
            //             toast.classList.remove('show');

            //             setTimeout(() => {
            //                 toast.className = 'toast-popup';
            //                 successIcon.classList.add('hidden');
            //                 errorIcon.classList.add('hidden');
            //             }, 400);
            //         }, 4000);
            //     }
            });

        document.getElementById('loginForm').addEventListener('submit', async function (e) {
    e.preventDefault();

    const formData = new FormData(this);

    Modal.show('loading', { title: 'Logging in...', message: 'Please wait.' });

    try {
        const response = await fetch('@Url.Action("Login", "Auth")', { method: 'POST', body: formData });
        const data = await response.json();

        if (data.success) {
            Modal.show('success', { title: 'Welcome back!', message: 'You are now logged in.' });
            setTimeout(() => window.location.href = data.redirectUrl, 1200);

        } else if (data.redirectUrl) {
            // e.g. "not verified" case — redirect instead of just showing an error
            window.location.href = data.redirectUrl;
        } 
        
        else {
            Modal.show('error', { title: 'Login failed', message: data.message });
        }
    } catch (err) {
        Modal.show('error', { title: 'Network error', message: 'Could not reach the server.' });
    }
});
    </script>
</body>
</html>
