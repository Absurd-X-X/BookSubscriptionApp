        document.getElementById('forgotPasswordForm').addEventListener('submit', async function (e) {
        e.preventDefault();

        const formData = new FormData(this);
        console.log("aaaaaaaaaaaaaaaaaaaa");

        Modal.show('loading', { title: 'Sending request...', message: 'Please wait.' });

        try {
        const response = await fetch('@Url.Action("ForgotPassword", "Auth")', { method: 'POST', body: formData });
        const data = await response.json();

        if (data.success) {
        Modal.show('success', { title: 'Request sent!', message: 'Please check your email for further instructions.' });
        setTimeout(() => window.location.href = data.redirectUrl, 1200);

        } else if (data.redirectUrl) {
        // e.g. "not verified" case — redirect instead of just showing an error
        window.location.href = data.redirectUrl;
        }

        else {
        Modal.show('error', { title: 'Request failed', message: data.message });
        }
        } catch (err) {
        Modal.show('error', { title: 'Network error', message: 'Could not reach the server.' });
        }
        });
