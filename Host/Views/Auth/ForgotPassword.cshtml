                <small>Enter your email to reset your password</small>
            </div>

            <form asp-controller="Auth" asp-action="ForgotPassword" method="post" class="form" id="forgotPasswordForm" autocomplete="off">
                @Html.AntiForgeryToken()

                <div class="login-info">
                    <label asp-for="Email">Email Address</label>
                    <input asp-for="Email" type="email" placeholder="Input your email" required autofocus>
                    <span asp-validation-for="Email" class="validation-span"></span>
                </div>

                <button type="submit" class="submit-btn">Send Reset Link</button>
            </form>

            <small class="signup-footer">Want to try again?<a href="@Url.Action("Login", "Auth")" class="anchor">Return to Login</a></small>
