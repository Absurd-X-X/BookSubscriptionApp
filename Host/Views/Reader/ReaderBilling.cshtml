@using Application.Queries
@using Domain.Enums
@{
    ViewData["Title"] = "Billing";
    ViewData["ScrollPage"] = "billing";
    Layout = "~/Views/Shared/_ReaderLayout.cshtml";

    var wallet = ViewData["Wallet"] as GetWalletDashboard.GetWalletDashboardResponse;
    var subscription = ViewData["Subscription"] as GetSubscriptionByUserId.GetSubscriptionByUserIdResponse;

    string TxnIcon(TransactionType type) => type switch
    {
        TransactionType.Credit => "ti ti-arrow-up",
        TransactionType.Debit => "ti ti-book",
        TransactionType.Withdaw => "ti ti-arrow-up-circle",
        TransactionType.Payout => "ti ti-arrow-up-circle",
        _ => "ti ti-receipt"
    };

    string TxnIconClass(TransactionType type) => type switch
    {
        TransactionType.Credit => "green",
        TransactionType.Debit => "amber",
        TransactionType.Withdaw => "blue",
        TransactionType.Payout => "blue",
        _ => "purple"
    };

    string TxnLabel(TransactionType type) => type switch
    {
        TransactionType.Credit => "Top Up",
        TransactionType.Debit => "Purchase",
        TransactionType.Withdaw => "Withdrawal",
        TransactionType.Payout => "Payout",
        _ => type.ToString()
    };

    string StatusClass(WalletTransactionStatus status) => status switch
    {
        WalletTransactionStatus.Successful => "success",
        WalletTransactionStatus.Pending => "pending",
        WalletTransactionStatus.Failed => "failed",
        _ => "success"
    };
}
<link href="~/css/readerBilling.css" rel="stylesheet" />

<div class="page-header">
    <h1>Billing</h1>
    <p>Manage your wallet, transactions and subscription.</p>
</div>

<!-- Wallet -->
<section class="page-section" id="section-wallet" data-hash="#section-wallet" data-page="billing">
    <div class="card">
        <div class="section-header-row">
            <div class="section-heading">
                <h2>Wallet</h2>
                <div class="section-sub">Your balance and wallet management.</div>
            </div>
            @Html.AntiForgeryToken()
            <button type="button" class="btn-pill-primary" id="openFundWalletTop"><i class="ti ti-plus"></i> Fund Wallet</button>
        </div>

        <div class="stat-tiles-row">
            <div class="stat-tile">
                <div class="stat-tile-icon purple"><i class="ti ti-wallet"></i></div>
                <div class="stat-tile-body">
                    <div class="stat-tile-label">Wallet Balance</div>
                    <div class="stat-tile-value">@((wallet?.Balance ?? 0).ToString("C"))</div>
                    <div class="stat-tile-sub purple-text">Available Balance</div>
                </div>
            </div>
            <div class="stat-tile">
                <div class="stat-tile-icon blue"><i class="ti ti-clock"></i></div>
                <div class="stat-tile-body">
                    <div class="stat-tile-label">Pending Funds</div>
                    <div class="stat-tile-value">@((wallet?.PendingFunds ?? 0).ToString("C"))</div>
                    <div class="stat-tile-sub blue-text">Processing</div>
                </div>
            </div>
            <div class="stat-tile">
                <div class="stat-tile-icon green"><i class="ti ti-trending-down"></i></div>
                <div class="stat-tile-body">
                    <div class="stat-tile-label">Total Spent</div>
                    <div class="stat-tile-value">@((wallet?.TotalSpentThisYear ?? 0).ToString("C"))</div>
                    <div class="stat-tile-sub green-text">This year</div>
                </div>
            </div>
            <div class="stat-tile">
                <div class="stat-tile-icon amber"><i class="ti ti-refresh"></i></div>
                <div class="stat-tile-body">
                    <div class="stat-tile-label">Auto-Renew</div>
                    <div class="stat-tile-value">@(subscription != null && subscription.AutoRenew ? "Enabled" : "Disabled")</div>
                    <div class="stat-tile-sub amber-text">
                        @(subscription != null ? "Next billing: " + subscription.ExpiryDate.ToString("MMM d, yyyy") : "Next billing: —")
                    </div>
                </div>
            </div>
        </div>

        <div class="action-tiles-row">
            <a href="#" class="action-tile" id="openFundWalletTile">
                <div class="action-tile-icon purple"><i class="ti ti-arrow-down"></i></div>
                <div>
                    <div class="action-tile-title">Fund Wallet</div>
                    <div class="action-tile-sub">Add money</div>
                </div>
            </a>
            <a href="#" class="action-tile">
                <div class="action-tile-icon blue"><i class="ti ti-arrow-up-circle"></i></div>
                <div>
                    <div class="action-tile-title">Withdraw</div>
                    <div class="action-tile-sub">Request payout</div>
                </div>
            </a>
            <a href="#" class="action-tile">
                <div class="action-tile-icon green"><i class="ti ti-arrows-exchange"></i></div>
                <div>
                    <div class="action-tile-title">Transfer</div>
                    <div class="action-tile-sub">Send to another</div>
                </div>
            </a>
            <a href="#" class="action-tile">
                <div class="action-tile-icon purple"><i class="ti ti-credit-card"></i></div>
                <div>
                    <div class="action-tile-title">Payment Methods</div>
                    <div class="action-tile-sub">Manage cards</div>
                </div>
            </a>
        </div>

        <div class="history-section-header">
            <h3>Transaction History</h3>
            <a href="#" class="view-all-link">View all</a>
        </div>
        <table class="history-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Description</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th>Reference</th>
                </tr>
            </thead>
            <tbody>
                @if (wallet is null || !wallet.RecentTransactions.Any())
                {
                    <tr><td colspan="6">No transactions yet.</td></tr>
                }
                else
                {
                    @foreach (var t in wallet.RecentTransactions)
                    {
                        var isCredit = t.Type == TransactionType.Credit;
                        <tr>
                            <td>@t.Date.ToString("MMM d, yyyy")</td>
                            <td>
                                <div class="txn-type-cell">
                                    <div class="txn-type-icon @TxnIconClass(t.Type)"><i class="@TxnIcon(t.Type)"></i></div>
                                    @TxnLabel(t.Type)
                                </div>
                            </td>
                            <td class="txn-desc">@t.Description</td>
                            <td class="txn-amount @(isCredit ? "positive" : "negative")">
                                @(isCredit ? "+" : "-")@t.Amount.ToString("C")
                            </td>
                            <td><span class="status-pill @StatusClass(t.Status)">@t.Status</span></td>
                            <td class="txn-reference">@(t.Reference ?? "—")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        <a href="@Url.Action("ReaderDetails", "Reader")" class="view-more-row-link">View all transactions <i class="ti ti-arrow-right"></i></a>
    </div>
</section>

<!-- Subscription -->
<section class="page-section" id="section-subscription" data-hash="#section-subscription" data-page="billing">
    <div class="card">
        <div class="section-header-row">
            <div class="section-heading">
                <h2>Subscription</h2>
                <div class="section-sub">Manage your plan and billing details.</div>
            </div>
            <a href="@Url.Action("ManageSub", "Reader")" class="btn-pill-primary" style="text-decoration: none">Upgrade Plan</a>
        </div>

        @if (subscription is null)
        {
            <p>No active subscription found.</p>
        }
        else
        {
            var daysToExpiry = (subscription.ExpiryDate.Date - DateTime.UtcNow.Date).Days;

            <div class="sub-tiles-row">
                <div class="stat-tile">
                    <div class="stat-tile-icon purple"><i class="ti ti-crown"></i></div>
                    <div class="stat-tile-body">
                        <div class="sub-tile-label">Current Plan</div>
                        <div class="sub-tile-value">@subscription.CurrentPlan</div>
                        <div class="sub-tile-sub purple-text">@subscription.Cost.ToString("C")</div>
                    </div>
                </div>
                <div class="stat-tile">
                    <div class="stat-tile-icon blue"><i class="ti ti-calendar"></i></div>
                    <div class="stat-tile-body">
                        <div class="sub-tile-label">Renewal Date</div>
                        <div class="sub-tile-value">@subscription.ExpiryDate.ToString("MMM d, yyyy")</div>
                        <div class="sub-tile-sub blue-text">In @daysToExpiry days</div>
                    </div>
                </div>
                <div class="stat-tile">
                    <div class="stat-tile-icon green"><i class="ti ti-refresh"></i></div>
                    <div class="stat-tile-body">
                        <div class="sub-tile-label">Auto-Renew</div>
                        <div class="sub-tile-value">@(subscription.AutoRenew ? "Enabled" : "Disabled")</div>
                        <div class="sub-tile-sub green-text">
                            @(subscription.AutoRenew ? "Will renew automatically" : "Will not auto-renew")
                        </div>
                    </div>
                </div>
                <div class="stat-tile">
                    <div class="stat-tile-icon amber"><i class="ti ti-shield-check"></i></div>
                    <div class="stat-tile-body">
                        <div class="sub-tile-label">Status</div>
                        <div class="sub-tile-value">@(subscription.IsActive ? "Active" : "Inactive")</div>
                        <div class="sub-tile-sub amber-text">
                            @(subscription.IsActive ? "Your plan is active" : "Your plan is not active")
                        </div>
                    </div>
                </div>
            </div>

            <div class="sub-action-tiles-row">
                <a href="#" class="payment-method-tile">
                    <div class="payment-method-icon"><i class="ti ti-credit-card"></i></div>
                    <div>
                        <div class="action-tile-title">Payment Method</div>
                        <div class="action-tile-sub">Not available</div>
                    </div>
                    <i class="ti ti-chevron-right action-tile-arrow"></i>
                </a>
                <form asp-action="AutoRenewSub" asp-controller="Reader" method="post" class="action-tile" style="border:none; background:none; cursor:pointer;">
                    <input type="hidden" name="subId" value="@subscription.Id" />
                    <input type="hidden" name="autoRenew" value="@(!subscription.AutoRenew)" />
                    <button type="submit" style="all:unset; display:flex; gap:inherit; align-items:center; width:100%;">
                        <div class="action-tile-icon blue"><i class="ti ti-refresh"></i></div>
                        <div>
                            <div class="action-tile-title">@(subscription.AutoRenew ? "Disable Auto-Renew" : "Enable Auto-Renew")</div>
                            <div class="action-tile-sub">@subscription.Cost.ToString("C")</div>
                        </div>
                    </button>
                </form>
                <a href="@Url.Action("ManageSub", "Reader")" class="action-tile">
                    <div class="action-tile-icon purple"><i class="ti ti-replace"></i></div>
                    <div>
                        <div class="action-tile-title">Change Plan</div>
                        <div class="action-tile-sub">View other plans</div>
                    </div>
                </a>
                <a href="#" class="action-tile danger-tile">
                    <div class="action-tile-icon"><i class="ti ti-x"></i></div>
                    <div>
                        <div class="action-tile-title">Cancel Plan</div>
                        <div class="action-tile-sub">Cancel subscription</div>
                    </div>
                </a>
            </div>
        }

        <div class="history-section-header">
            <h3>Subscription History</h3>
            <a href="#" class="view-all-link">View all</a>
        </div>
        <table class="history-table">
            <thead>
                <tr>
                    <th>Plan</th>
                    <th>Amount</th>
                    <th>Renewed On</th>
                    <th>Next Billing</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (subscription is null)
                {
                    <tr><td colspan="5">No subscription history.</td></tr>
                }
                else
                {
                    <tr>
                        <td class="txn-desc">@subscription.CurrentPlan</td>
                        <td>@subscription.Cost.ToString("C")</td>
                        <td>@subscription.SubcriptionDate.ToString("MMM d, yyyy")</td>
                        <td>@subscription.ExpiryDate.ToString("MMM d, yyyy")</td>
                        <td><span class="status-pill @(subscription.IsActive ? "active" : "completed")">@(subscription.IsActive ? "Active" : "Expired")</span></td>
                    </tr>
                }
            </tbody>
        </table>
        <a href="@Url.Action("ReaderDetails", "Reader")" class="view-more-row-link">View all subscription history <i class="ti ti-arrow-right"></i></a>
    </div>
</section>

<!-- Help Banner -->
<section class="page-section" id="section-help" data-hash="#section-help" data-page="billing" style="margin-top: 10px;">
    <div class="card help-banner">
        <div class="help-banner-left">
            <div class="help-banner-icon"><i class="ti ti-wallet"></i></div>
            <div>
                <div class="help-banner-title">Need help with billing?</div>
                <div class="help-banner-sub">Visit our <a href="#">Help Center</a> or contact our support team.</div>
            </div>
        </div>
        <a href="#" class="btn-help-center">Help Center <i class="ti ti-external-link"></i></a>
    </div>
</section>