<script>
    (function () {
        'use strict';

        // ── TAB SWITCHING ──
        var tabBtns = document.querySelectorAll('.ud-tab-btn');
        var tabPanels = document.querySelectorAll('.ud-tab-panel');

        tabBtns.forEach(function (btn) {
            btn.addEventListener('click', function () {
                var target = btn.getAttribute('data-tab');

                tabBtns.forEach(function (b) { b.classList.remove('active'); });
                btn.classList.add('active');

                tabPanels.forEach(function (panel) {
                    panel.classList.toggle('active', panel.getAttribute('data-tab-panel') === target);
                });
            });
        });
    })();

    document.addEventListener('DOMContentLoaded', function () {

        // ── PASSWORD VISIBILITY TOGGLE (handles all three fields in the Change Password modal) ──
        var toggleButtons = document.querySelectorAll('.toggle-password-btn');

        toggleButtons.forEach(function (btn) {
            btn.addEventListener('click', function () {
                var targetId = btn.getAttribute('data-target');
                var input = document.getElementById(targetId);
                var icon = btn.querySelector('.eyeIcon');

                if (!input || !icon) return;

                var isPassword = input.getAttribute('type') === 'password';
                input.setAttribute('type', isPassword ? 'text' : 'password');

                if (isPassword) {
                    icon.innerHTML =
                        '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>' +
                        '<line x1="1" y1="1" x2="23" y2="23"></line>';
                } else {
                    icon.innerHTML =
                        '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>' +
                        '<circle cx="12" cy="12" r="3"></circle>';
                }
            });
        });

        // ── STRONG PASSWORD + CONFIRM MATCH VALIDATION ──
        var form = document.getElementById('changePasswordForm');
        if (!form) return;

        var newPasswordInput = document.getElementById('newPassword');
        var confirmPasswordInput = document.getElementById('confirmPassword');
        var initialPasswordInput = document.getElementById('Password');

        var newPasswordError = document.getElementById('newPasswordError');
        var confirmPasswordError = document.getElementById('confirmPasswordError');

        var strengthFill = document.getElementById('pwStrengthFill');
        var strengthLabel = document.getElementById('pwStrengthLabel');

        var MIN_LENGTH = 8;

        function checkPasswordRules(pw) {
            return {
                length: pw.length >= MIN_LENGTH,
                upper: /[A-Z]/.test(pw),
                lower: /[a-z]/.test(pw),
                number: /[0-9]/.test(pw),
                special: /[^A-Za-z0-9]/.test(pw)
            };
        }

        function getStrengthScore(rules) {
            var score = 0;
            for (var key in rules) {
                if (rules[key]) score++;
            }
            return score; // 0–5
        }

        function updateStrengthMeter(pw) {
            if (!strengthFill || !strengthLabel) return;

            if (!pw) {
                strengthFill.style.width = '0%';
                strengthFill.className = 'pw-strength-fill';
                strengthLabel.textContent = '';
                return;
            }

            var rules = checkPasswordRules(pw);
            var score = getStrengthScore(rules);

            var pct = (score / 5) * 100;
            strengthFill.style.width = pct + '%';

            var tier, label;
            if (score <= 2) { tier = 'weak'; label = 'Weak'; }
            else if (score === 3) { tier = 'fair'; label = 'Fair'; }
            else if (score === 4) { tier = 'good'; label = 'Good'; }
            else { tier = 'strong'; label = 'Strong'; }

            strengthFill.className = 'pw-strength-fill ' + tier;
            strengthLabel.textContent = label;
        }

        function showError(el, message) {
            if (!el) return;
            el.textContent = message;
            el.style.display = 'block';
        }

        function clearError(el) {
            if (!el) return;
            el.textContent = '';
            el.style.display = 'none';
        }

        function validateNewPassword() {
            var pw = newPasswordInput.value;
            var rules = checkPasswordRules(pw);

            if (!pw) {
                showError(newPasswordError, 'New password is required.');
                return false;
            }
            if (!rules.length) {
                showError(newPasswordError, 'Password must be at least ' + MIN_LENGTH + ' characters.');
                return false;
            }
            if (!rules.upper) {
                showError(newPasswordError, 'Password must include an uppercase letter.');
                return false;
            }
            if (!rules.lower) {
                showError(newPasswordError, 'Password must include a lowercase letter.');
                return false;
            }
            if (!rules.number) {
                showError(newPasswordError, 'Password must include a number.');
                return false;
            }
            if (!rules.special) {
                showError(newPasswordError, 'Password must include a special character.');
                return false;
            }
            if (initialPasswordInput && pw === initialPasswordInput.value) {
                showError(newPasswordError, 'New password must be different from your current password.');
                return false;
            }

            clearError(newPasswordError);
            return true;
        }

        function validateConfirmPassword() {
            if (!confirmPasswordInput.value) {
                showError(confirmPasswordError, 'Please confirm your new password.');
                return false;
            }
            if (confirmPasswordInput.value !== newPasswordInput.value) {
                showError(confirmPasswordError, 'Passwords do not match.');
                return false;
            }

            clearError(confirmPasswordError);
            return true;
        }

        newPasswordInput.addEventListener('input', function () {
            updateStrengthMeter(newPasswordInput.value);
            validateNewPassword();
            if (confirmPasswordInput.value) validateConfirmPassword();
        });

        confirmPasswordInput.addEventListener('input', validateConfirmPassword);

        form.addEventListener('submit', function (e) {
            var isNewValid = validateNewPassword();
            var isConfirmValid = validateConfirmPassword();

            if (!isNewValid || !isConfirmValid) {
                e.preventDefault();
            }
        });
    });

    (function () {
    'use strict';

    var postUrl = '@Url.Action("Fund", "Reader")';
    var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
    var token = tokenInput ? tokenInput.value : '';

    function openFundWalletModal() {
    Modal.showFundWallet({ postUrl: postUrl, antiForgeryToken: token });
    }

    var topBtn = document.getElementById('openFundWalletTop');
    var tileBtn = document.getElementById('openFundWalletTile');

    if (topBtn) topBtn.addEventListener('click', openFundWalletModal);
    if (tileBtn) tileBtn.addEventListener('click', function (e) {
    e.preventDefault();
    openFundWalletModal();
    });
    })();
</script>