@using Application.Queries
@{
    ViewData["Title"] = "My Collection";
    ViewData["ScrollPage"] = "mycollection";
    Layout = "~/Views/Shared/_ReaderLayout.cshtml";

    var bookmarks = ViewData["Bookmarks"] as List<GetAllBookmarks.GetAllBookmarksResponse> ?? new();
    var readingList = ViewData["ReadingList"] as List<GetReadingList.GetReadingListResponse> ?? new();
    var favorites = ViewData["Favorites"] as List<GetFavorites.GetFavoritesResponse> ?? new();
}

@functions {
    string RenderStars(double rating)
    {
        var full = (int)Math.Floor(rating);
        var hasHalf = (rating - full) >= 0.25 && (rating - full) < 0.75;
        var hasExtraFull = (rating - full) >= 0.75;
        if (hasExtraFull) full++;

        var stars = new string('★', full);
        if (hasHalf) stars += "½";
        return stars;
    }
}

<link href="~/css/readerCollection.css" rel="stylesheet" />

<div class="page-header">
    <h1>My Collection</h1>
    <p>All the books you've saved and want to read.</p>
</div>

<!-- Favorites -->
<section class="page-section" id="section-favorites" data-hash="#section-favorites" data-page="mycollection">
    <div class="section-header-row">
        <div>
            <div class="section-heading">
                <i class="ti ti-heart-filled" style="color:#FF5C8A"></i>
                <h2>Favorites</h2>
            </div>
            <div class="section-sub">Books you love and want to read again.</div>
        </div>
        <div class="section-header-right">
            <a href="@Url.Action("ViewAllFavorites", "Reader")" class="view-all">View all</a>
            <span class="section-count-pill">@favorites.Count books</span>
            <div class="carousel-nav" data-carousel-controls="favorites-grid">
                <button class="carousel-nav-btn" data-carousel-prev="favorites-grid"><i class="ti ti-chevron-left"></i></button>
                <button class="carousel-nav-btn" data-carousel-next="favorites-grid"><i class="ti ti-chevron-right"></i></button>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="book-grid" data-carousel="favorites-grid">
            @if (!favorites.Any())
            {
                <div class="collection-empty">No favorites yet.</div>
            }
            else
            {
                @foreach (var f in favorites)
                {
                    <div class="collection-book-card" data-book-id="@f.BookId">
                        <div class="collection-book-cover-wrap">
                            <img class="collection-book-cover" src="@f.BookCoverUrl" alt="@f.Title cover" />
                            <button class="collection-cover-badge filled" data-favorite-toggle aria-label="Toggle favorite"><i class="ti ti-heart-filled"></i></button>
                        </div>
                        <div class="collection-book-title">@f.Title</div>
                        <div class="collection-book-author">@f.Author</div>
                        <div class="star-rating">
                            <span class="stars">@RenderStars(f.AverageRating)</span>
                            <span>@f.AverageRating.ToString("0.0")</span>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>

<!-- Bookmarks -->
<section class="page-section" id="section-bookmarks" data-hash="#section-bookmarks" data-page="mycollection">
    <div class="section-header-row">
        <div>
            <div class="section-heading">
                <i class="ti ti-bookmark-filled" style="color:#7C6AFF"></i>
                <h2>Bookmarks</h2>
            </div>
            <div class="section-sub">Important pages and passages you've saved.</div>
        </div>
        <div class="section-header-right">
            <a href="@Url.Action("GetAllBookmark", "Reader")" class="view-all">View all</a>
            <span class="section-count-pill">@bookmarks.Count bookmarks</span>
            <div class="carousel-nav" data-carousel-controls="bookmarks-table">
                <button class="carousel-nav-btn" data-carousel-prev="bookmarks-table"><i class="ti ti-chevron-left"></i></button>
                <button class="carousel-nav-btn" data-carousel-next="bookmarks-table"><i class="ti ti-chevron-right"></i></button>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="bookmarks-table-wrap" data-carousel="bookmarks-table">
            <table class="bookmarks-table">
                <thead>
                    <tr>
                        <th>Book</th>
                        <th>Bookmark</th>
                        <th>Note</th>
                        <th>Date Added</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (!bookmarks.Any())
                    {
                        <tr><td colspan="5">No bookmarks yet.</td></tr>
                    }
                    else
                    {
                        @foreach (var b in bookmarks)
                        {
                            <tr data-bookmark-id="@b.BookmarkId">
                                <td>
                                    <div class="bookmark-book-cell">
                                        <img class="bookmark-book-thumb" src="@b.BookCoverUrl" alt="@b.BookTitle cover" />
                                        <div>
                                            <div class="bookmark-book-name">@b.BookTitle</div>
                                            <div class="bookmark-book-author">@b.BookAuthor</div>
                                            <div class="star-rating">
                                                <span class="stars">@RenderStars(b.AverageRating)</span>
                                                <span>@b.AverageRating.ToString("0.0")</span>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="bookmark-page-cell"><i class="ti ti-bookmark-filled"></i> Page @b.PageNumber</div>
                                    <div class="bookmark-quote">"@b.Quote"</div>
                                </td>
                                <td><span class="bookmark-note-tag" data-note-text>@b.Note</span></td>
                                <td><div class="bookmark-date">@b.DateAdded.ToString("MMM d, yyyy")<br>@b.DateAdded.ToString("h:mm tt")</div></td>
                                <td>
                                    <div class="dots-menu-wrap">
                                        <button class="dots-btn" data-dots-toggle><i class="ti ti-dots-vertical"></i></button>
                                        <ul class="dots-menu">
                                            <li><a href="#" data-edit-note><i class="ti ti-edit"></i>Edit Note</a></li>
                                            <li><a href="#"><i class="ti ti-share"></i>Share</a></li>
                                            <li class="danger"><button type="button" data-remove-bookmark><i class="ti ti-trash"></i>Remove</button></li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <a href=" @Url.Action("GetAllBookmark", "Reader")" class="view-more-btn">View all bookmarks</a>
    </div>
</section>

<!-- Reading List -->
<section class="page-section" id="section-reading-list" data-hash="#section-reading-list" data-page="mycollection">
    <div class="section-header-row">
        <div>
            <div class="section-heading">
                <i class="ti ti-list" style="color:#7C6AFF"></i>
                <h2>Reading List</h2>
            </div>
            <div class="section-sub">Books you want to read later.</div>
        </div>
        <div class="section-header-right">
            <a href="@Url.Action("ViewAllReadingProgress", "Reader")" class="view-all">View all</a>
            <span class="section-count-pill">@readingList.Count books</span>
            <div class="carousel-nav" data-carousel-controls="readinglist-grid">
                <button class="carousel-nav-btn" data-carousel-prev="readinglist-grid"><i class="ti ti-chevron-left"></i></button>
                <button class="carousel-nav-btn" data-carousel-next="readinglist-grid"><i class="ti ti-chevron-right"></i></button>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="readinglist-grid" data-carousel="readinglist-grid">
            @if (!readingList.Any())
            {
                <div class="collection-empty">Your reading list is empty.</div>
            }
            else
            {
                @foreach (var r in readingList)
                {
                    <div class="readinglist-book-card" data-book-id="@r.BookId">
                        <img class="readinglist-book-cover" src="@r.BookCoverUrl" alt="@r.Title cover" />
                        <div class="readinglist-book-title">@r.Title</div>
                        <div class="readinglist-book-author">@r.Author</div>
                        <div class="star-rating">
                            <span class="stars">@RenderStars(r.AverageRating)</span>
                            <span>@r.AverageRating.ToString("0.0")</span>
                        </div>
                        <button class="btn-add-list added" data-add-to-list><i class="ti ti-check"></i> Added</button>
                    </div>
                }
            }
        </div>
    </div>
</section>

<!-- Quote Banner -->
<section class="page-section" id="section-quote" data-hash="#section-quote" data-page="mycollection">
    <div class="collection-quote-banner">
        <i class="ti ti-sparkles collection-quote-star"></i>
        <div>
            <div class="collection-quote-text">"A room without books is like a body without a soul."</div>
            <div class="collection-quote-author">— Marcus Tullius Cicero</div>
        </div>
        <div class="collection-quote-illus">📖</div>
    </div>
</section>

@section Scripts {
    <script src="~/js/modal.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {

        function initCarousels() {
        document.querySelectorAll('[data-carousel]').forEach(function (track) {
        var key = track.getAttribute('data-carousel');
        var prevBtn = document.querySelector('[data-carousel-prev="' + key + '"]');
        var nextBtn = document.querySelector('[data-carousel-next="' + key + '"]');
        if (!prevBtn || !nextBtn) return;

        function step() {
        var firstChild = track.children[0];
        return firstChild ? firstChild.getBoundingClientRect().width + 18 : track.clientWidth * 0.75;
        }
        function updateButtons() {
        var maxScroll = track.scrollWidth - track.clientWidth;
        prevBtn.disabled = track.scrollLeft <= 2;
        nextBtn.disabled = track.scrollLeft >= maxScroll - 2;
        }
        prevBtn.addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: 'smooth' }); });
        nextBtn.addEventListener('click', function () { track.scrollBy({ left: step(), behavior: 'smooth' }); });
        track.addEventListener('scroll', updateButtons);
        window.addEventListener('resize', updateButtons);
        updateButtons();
        });
        }

        function initFavoriteToggles() {
        document.querySelectorAll('[data-favorite-toggle]').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
        e.preventDefault();
        var card = btn.closest('[data-book-id]');
        var bookId = card ? card.getAttribute('data-book-id') : null;
        if (!bookId) return;

        fetch('/Reader/ToggleBookList', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: 'bookId=' + encodeURIComponent(bookId) + '&listType=Favorite'
        })
        .then(function (res) { return res.json(); })
        .then(function (result) {
        if (!result.success) return;
        if (!result.isInList) { card.remove(); return; }
        btn.classList.toggle('filled', result.isInList);
        var icon = btn.querySelector('i');
        if (icon) {
        icon.classList.toggle('ti-heart-filled', result.isInList);
        icon.classList.toggle('ti-heart', !result.isInList);
        }
        });
        });
        });
        }

        function initAddToList() {
        document.querySelectorAll('[data-add-to-list]').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
        e.preventDefault();
        var card = btn.closest('[data-book-id]');
        var bookId = card ? card.getAttribute('data-book-id') : null;
        if (!bookId) return;

        fetch('/Reader/ToggleBookList', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: 'bookId=' + encodeURIComponent(bookId) + '&listType=ReadingList'
        })
        .then(function (res) { return res.json(); })
        .then(function (result) {
        if (!result.success) return;
        var icon = btn.querySelector('i');
        if (result.isInList) {
        btn.classList.add('added');
        if (icon) icon.className = 'ti ti-check';
        btn.lastChild.textContent = ' Added';
        } else {
        card.remove();
        }
        });
        });
        });
        }

        function initDotsMenus() {
        var openMenu = null;
        function closeOpenMenu() {
        if (openMenu) { openMenu.classList.remove('show'); openMenu = null; }
        }

        document.querySelectorAll('[data-dots-toggle]').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
        e.stopPropagation();
        var menu = btn.parentElement.querySelector('.dots-menu');
        if (!menu) return;
        var isOpen = menu.classList.contains('show');
        closeOpenMenu();
        if (!isOpen) { menu.classList.add('show'); openMenu = menu; }
        });
        });

        document.querySelectorAll('[data-remove-bookmark]').forEach(function (btn) {
        btn.addEventListener('click', function () {
        var row = btn.closest('tr[data-bookmark-id]');
        var bookmarkId = row ? row.getAttribute('data-bookmark-id') : null;
        if (!bookmarkId) return;

        fetch('/Reader/RemoveBookmark', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: 'bookmarkId=' + encodeURIComponent(bookmarkId)
        })
        .then(function (res) { return res.json(); })
        .then(function (result) {
        if (result.success) row.remove();
        });
        });
        });

        document.querySelectorAll('[data-edit-note]').forEach(function (link) {
        link.addEventListener('click', function (e) {
        e.preventDefault();
        var row = link.closest('tr[data-bookmark-id]');
        var bookmarkId = row ? row.getAttribute('data-bookmark-id') : null;
        var noteEl = row ? row.querySelector('[data-note-text]') : null;
        if (!bookmarkId || !noteEl) return;

        Modal.showEditNote({
        title: 'Edit Note',
        initialValue: noteEl.textContent.trim(),
        saveLabel: 'Save',
        onSave: function (newNote) {
        fetch('/Reader/UpdateBookmarkNote', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: 'bookmarkId=' + encodeURIComponent(bookmarkId) + '&note=' + encodeURIComponent(newNote)
        })
        .then(function (res) { return res.json(); })
        .then(function (result) {
        if (result.success) noteEl.textContent = newNote;
        else Modal.show('error', { title: 'Update failed', message: result.message || 'Something went wrong.' });
        });
        }
        });
        });
        });

        window.addEventListener('click', closeOpenMenu);
        }

        initCarousels();
        initFavoriteToggles();
        initAddToList();
        initDotsMenus();
        });
    </script>
}