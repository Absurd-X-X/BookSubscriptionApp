@{
    ViewData["Title"] = "My Engagement";
    ViewData["ScrollPage"] = "myengagement";
    Layout = "~/Views/Shared/_ReaderLayout.cshtml";
}
<link href="~/css/readerEngagement.css" rel="stylesheet" />

<!-- TOPBAR -->
<header class="eg-topbar">
    <div class="eg-topbar-left">
        <h1>Engagement</h1>
        <p>Stay connected, share your thoughts and get support.</p>
    </div>
    <div class="eg-topbar-right">
        <div class="eg-search">
            <i class="ti ti-search eg-si"></i>
            <input class="eg-search-input" id="egSI" type="text" placeholder="Search books, authors, categories…" autocomplete="off" />
            <span class="eg-sk">⌘K</span>
            <div class="eg-sdrop" id="egSD"></div>
        </div>
        <div class="eg-bell-w">
            <div class="eg-bell" id="egBell"><i class="ti ti-bell"></i><span class="bdot" id="egBDot"></span></div>
            <div class="eg-nd" id="egND">
                <div class="eg-nd-hdr"><span>Notifications</span><a id="egMA">Mark all read</a></div>
                <div class="eg-nd-item unread"><div class="eg-nd-ico"><i class="ti ti-book-2"></i></div><div class="eg-nd-txt"><div class="ndt">New chapter unlocked</div><div class="nds">Atomic Habits · Ch.13 available</div></div><div class="eg-nd-dot"></div></div>
                <div class="eg-nd-item unread"><div class="eg-nd-ico"><i class="ti ti-trophy"></i></div><div class="eg-nd-txt"><div class="ndt">Streak milestone 🔥</div><div class="nds">12 days in a row!</div></div><div class="eg-nd-dot"></div></div>
                <div class="eg-nd-item"><div class="eg-nd-ico"><i class="ti ti-star"></i></div><div class="eg-nd-txt"><div class="ndt">Review reminder</div><div class="nds">Rate Deep Work you finished</div></div></div>
            </div>
        </div>
        <div class="eg-av-w">
            <div class="eg-av" id="egAV">A</div>
            <div class="eg-avd" id="egAVD">
                <div class="eg-avd-top"><div class="avn">Alex Reader</div><div class="ave">alex@soulshelf.app</div></div>
                <a><i class="ti ti-user"></i> Profile</a>
                <a><i class="ti ti-settings"></i> Settings</a>
                <div class="eg-avd-div"></div>
                <a class="out"><i class="ti ti-logout"></i> Logout</a>
            </div>
        </div>
    </div>
</header>

<!-- BODY -->
<div class="eg-body">
    <div class="eg-feed">

        <!-- REVIEWS -->
