            </div>

            <!-- Deep Work -->
            <div class="rev-row">
                <div class="bk-cover">
                    <svg viewBox="0 0 38 52" width="38" height="52"><defs><linearGradient id="cdw" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#1a1a2e" /><stop offset="100%" stop-color="#0d0d14" /></linearGradient></defs><rect width="38" height="52" rx="3" fill="url(#cdw)" /><text x="19" y="20" text-anchor="middle" font-size="10" font-weight="900" fill="#f0b429" font-family="sans-serif">DEEP</text><text x="19" y="31" text-anchor="middle" font-size="10" font-weight="900" fill="#f0b429" font-family="sans-serif">WORK</text><text x="19" y="40" text-anchor="middle" font-size="3.5" fill="rgba(255,255,255,.55)" font-family="sans-serif">Rules for Focused</text><text x="19" y="45" text-anchor="middle" font-size="3.5" fill="rgba(255,255,255,.55)" font-family="sans-serif">Success in a Distracted</text><text x="19" y="50" text-anchor="middle" font-size="3.5" fill="rgba(255,255,255,.55)" font-family="sans-serif">World · Cal Newport</text></svg>
