            <div id="anActivity" style="display:none" class="an-placeholder"><i class="ti ti-activity"></i><p>Activity heatmap coming soon</p></div>
            <div id="anStreaks" style="display:none" class="an-placeholder"><div style="font-size:28px">🔥</div><p>Streak analytics coming soon</p></div>
        </section>

    </div><!-- eg-feed -->
    <!-- RIGHT ASIDE -->
