                <a class="eg-va">View all reviews</a>
            </div>
            <div class="rev-overview">
                <div class="rev-big">
                    <div class="rbn">4.6</div>
                    <div class="rbs"><i class="ti ti-star-filled"></i><i class="ti ti-star-filled"></i><i class="ti ti-star-filled"></i><i class="ti ti-star-filled"></i><i class="ti ti-star-half-filled"></i></div>
                    <div class="rbl">Out of 5</div><div class="rbc">Based on 128 reviews</div>
                </div>
                <div class="rev-bars">
                    <div class="rev-bar-row"><span class="rl">5 star</span><div class="rev-bar-bg"><div class="rev-bar-fill" style="width:72%"></div></div><span class="rp">72%</span></div>
                    <div class="rev-bar-row"><span class="rl">4 star</span><div class="rev-bar-bg"><div class="rev-bar-fill" style="width:18%"></div></div><span class="rp">18%</span></div>
                    <div class="rev-bar-row"><span class="rl">3 star</span><div class="rev-bar-bg"><div class="rev-bar-fill" style="width:7%"></div></div><span class="rp">7%</span></div>
                    <div class="rev-bar-row"><span class="rl">2 star</span><div class="rev-bar-bg"><div class="rev-bar-fill" style="width:2%"></div></div><span class="rp">2%</span></div>
