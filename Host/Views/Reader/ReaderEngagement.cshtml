@model Application.Features.ReaderEngagement.Queries.GetReaderEngagementDashboard.ReaderEngagementVm
@using System.Text.Json

@{
    ViewData["Title"] = "My Engagement";
    ViewData["ScrollPage"] = "myengagement";
    Layout = "~/Views/Shared/_ReaderLayout.cshtml";

    var chartJson = JsonSerializer.Serialize(Model.Analytics.Chart);
    var reviewableBooks = (List<Application.Queries.GetReviewableBooks.GetReviewableBooksResponse>)(ViewBag.ReviewableBooks ?? new List<Application.Queries.GetReviewableBooks.GetReviewableBooksResponse>());
}

@functions {
    string StarClass(int position, double rating)
    {
        if (position <= Math.Floor(rating)) return "ti-star-filled";
        if (position - rating < 1 && position - rating > 0) return "ti-star-half-filled";
        return "ti-star";
    }

    string TimeAgo(DateTime dt)
    {
        var span = DateTime.UtcNow - dt;
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}h ago";
        return $"{(int)span.TotalDays}d ago";
    }
}

<link href="~/css/readerEngagement.css" rel="stylesheet" />

@Html.AntiForgeryToken()

<!-- TOPBAR -->
<header class="eg-topbar">
    <div class="eg-topbar-left">
        <h1>Engagement</h1>
        <p>Stay connected, share your thoughts and get support.</p>
    </div>
    <div class="eg-topbar-right">
        <div class="eg-search">
            <i class="ti ti-search eg-si"></i>
            <input class="eg-search-input" id="egSI" type="text" placeholder="Search books, authors, categories…" autocomplete="off" />
            <span class="eg-sk">⌘K</span>
            <div class="eg-sdrop" id="egSD"></div>
        </div>
        <div class="eg-bell-w">
            <div class="eg-bell" id="egBell">
                <i class="ti ti-bell"></i>
                <span class="bdot" id="egBDot" style="display:@(Model.UnreadNotificationCount > 0 ? "block" : "none")"></span>
            </div>
            <div class="eg-nd" id="egND">
                <div class="eg-nd-hdr"><span>Notifications</span><a id="egMA">Mark all read</a></div>
                @if (!Model.Notifications.Any())
                {
                    <div class="eg-nd-item"><div class="eg-nd-txt"><div class="ndt">No notifications yet</div></div></div>
                }
                else
                {
                    @foreach (var n in Model.Notifications.Take(3))
                    {
                        <div class="eg-nd-item @(n.IsRead ? "" : "unread")" data-notif-id="@n.Id">
                            <!-- TODO: swap ti-bell for a type-based icon once NotificationType is confirmed -->
                            <div class="eg-nd-ico"><i class="ti ti-bell"></i></div>
                            <div class="eg-nd-txt">
                                <div class="ndt">@n.Title</div>
                                <div class="nds">@n.Message</div>
                            </div>
                            @if (!n.IsRead)
                            {
                                <div class="eg-nd-dot"></div>
                            }
                        </div>
                    }
                }
                <a class="dropdown-footer" href="@Url.Action("ReaderEngagement", "Reader")">View all notifications</a>
            </div>
        </div>
        <div class="eg-av-w">
            <div class="eg-av" id="egAV">A</div>
            <div class="eg-avd" id="egAVD">
                <div class="eg-avd-top"><div class="avn">Alex Reader</div><div class="ave">alex@soulshelf.app</div></div>
                <a href="@Url.Action("ReaderPersonal", "Reader")"><i class="ti ti-user"></i> Profile</a>
                <a href="@Url.Action("ReaderPersonal", "Reader")"><i class="ti ti-settings"></i> Settings</a>
                <div class="eg-avd-div"></div>
                <a class="out"><i class="ti ti-logout"></i> Logout</a>
            </div>
        </div>
    </div>
</header>

<!-- BODY -->
<div class="eg-body">
    <div class="eg-feed">

        <!-- REVIEWS -->
        <section id="section-reviews" class="page-section eg-card">
            <div class="eg-shdr">
                <div class="eg-shdr-l"><i class="ti ti-star"></i><div><div class="eg-stitle">Reviews</div><div class="eg-ssub">Your reviews and ratings</div></div></div>
                <a class="eg-va" href="/Reader/Reviews">View all reviews</a>
            </div>
            <div class="rev-overview">
                <div class="rev-big">
                    <div class="rbn">@Model.ReviewSummary.AverageRating.ToString("0.0")</div>
                    <div class="rbs">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <i class="ti @StarClass(i, Model.ReviewSummary.AverageRating)"></i>
                        }
                    </div>
                    <div class="rbl">Out of 5</div>
                    <div class="rbc">Based on @Model.ReviewSummary.TotalReviews reviews</div>
                </div>
                <div class="rev-bars">
                    @foreach (var bar in Model.ReviewSummary.Distribution)
                    {
                        <div class="rev-bar-row">
                            <span class="rl">@bar.Stars star</span>
                            <div class="rev-bar-bg"><div class="rev-bar-fill" style="width:@bar.Percentage.ToString("0")%"></div></div>
                            <span class="rp">@bar.Percentage.ToString("0")%</span>
                        </div>
                    }
                </div>
            </div>
            <div class="rev-rec-hdr">
                <span>Your Recent Reviews</span>
                <button class="eg-btn" id="writeBtn1"><i class="ti ti-edit" style="font-size:12px"></i> Write a review</button>
            </div>

            @if (!Model.RecentReviews.Any())
            {
                <div class="an-placeholder"><i class="ti ti-star"></i><p>You haven't reviewed any books yet</p></div>
            }
            else
            {
                @foreach (var review in Model.RecentReviews)
                {
                    <div class="rev-row" data-review-id="@review.ReviewId">
                        <div class="bk-cover">
                            <div class="bk-cover-ph"><i class="ti ti-book"></i></div>
                        </div>
                        <div class="rev-mid">
                            <div class="rmt">@review.BookTitle</div>
                            <div class="rma">@review.BookAuthor</div>
                            <div class="rms">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="ti @(i <= review.Rating ? "ti-star-filled" : "ti-star")"></i>
                                }
                                <span>@review.Rating.ToString("0.0")</span>
                            </div>
                            <div class="rmtx">@review.Comment</div>
                        </div>
                        <div class="rev-right">
                            <span class="rrd">@review.DateCreated.ToString("MMM d, yyyy")</span>
                            <div class="kb-w">
                                <i class="ti ti-dots-vertical kb"></i>
                                <div class="kb-m">
                                    <a><i class="ti ti-edit"></i>Edit</a>
                                    <a class="danger"><i class="ti ti-trash"></i>Delete</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }

            <button class="eg-btn-out">View all reviews</button>
        </section>

        <!-- NOTIFICATIONS -->
        <section id="section-notifications" class="page-section eg-card">
            <div class="eg-shdr">
                <div class="eg-shdr-l"><i class="ti ti-bell"></i><div><div class="eg-stitle">Notifications</div><div class="eg-ssub">Recent updates and alerts</div></div></div>
                <a class="eg-va" id="markSecRead">Mark all as read</a>
            </div>

            @if (!Model.Notifications.Any())
            {
                <div class="an-placeholder"><i class="ti ti-bell"></i><p>You're all caught up</p></div>
            }
            else
            {
                @foreach (var n in Model.Notifications)
                {
                    <div class="notif-row" data-notif-id="@n.Id">
                        <!-- TODO: map notification type to icon once NotificationType is confirmed -->
                        <div class="notif-ico"><i class="ti ti-bell"></i></div>
                        <div class="notif-mid">
                            <div class="nt">@n.Title</div>
                            <div class="ns">@n.Message</div>
                        </div>
                        <div class="notif-r">
                            <span class="ntime">@TimeAgo(n.DateCreated)</span>
                            @if (!n.IsRead)
                            {
                                <div class="ndot"></div>
                            }
                        </div>
                    </div>
                }
            }

            <button class="eg-btn-out">View all notifications</button>
        </section>

        <!-- ANALYTICS -->
        <section id="section-analytics" class="page-section eg-card">
            <div class="eg-shdr">
                <div class="eg-shdr-l"><i class="ti ti-chart-bar"></i><div><div class="eg-stitle">Analytics</div><div class="eg-ssub">Your reading insights</div></div></div>
                <a class="eg-va">View detailed analytics</a>
            </div>
            <div class="an-tabs" id="anTabs">
                <button class="an-tab active" data-tab="overview">Overview</button>
                <button class="an-tab" data-tab="reading">Reading</button>
                <button class="an-tab" data-tab="activity">Activity</button>
                <button class="an-tab" data-tab="streaks">Streaks</button>
            </div>
            <div id="anOverview">
                <div class="an-stats">
                    <div class="an-stat">
                        <div class="asl">Books Read</div>
                        <div class="asv">@Model.Analytics.BooksReadThisYear</div>
                        <div class="ass">This year</div>
                        @if (Model.Analytics.BooksReadTrend is { } bt)
                        {
                            <div class="ast @(bt.IsUp ? "" : "down")">
                                <i class="ti @(bt.IsUp ? "ti-arrow-up" : "ti-arrow-down")"></i>
                                @Math.Abs(bt.PercentChange)% from last year
                            </div>
                        }
                    </div>
                    <div class="an-stat">
                        <div class="asl">Pages Read</div>
                        <div class="asv">@Model.Analytics.TotalPagesRead.ToString("N0")</div>
                        <div class="ass">This year</div>
                        @if (Model.Analytics.PagesReadTrend is { } pt)
                        {
                            <div class="ast @(pt.IsUp ? "" : "down")">
                                <i class="ti @(pt.IsUp ? "ti-arrow-up" : "ti-arrow-down")"></i>
                                @Math.Abs(pt.PercentChange)% from last year
                            </div>
                        }
                    </div>
                    <div class="an-stat">
                        <div class="asl">Reading Time</div>
                        <div class="asv sm">@(Model.Analytics.TotalMinutesRead / 60)h @(Model.Analytics.TotalMinutesRead % 60)m</div>
                        <div class="ass">This year</div>
                        @if (Model.Analytics.ReadingTimeTrend is { } rt)
                        {
                            <div class="ast @(rt.IsUp ? "" : "down")">
                                <i class="ti @(rt.IsUp ? "ti-arrow-up" : "ti-arrow-down")"></i>
                                @Math.Abs(rt.PercentChange)% from last year
                            </div>
                        }
                    </div>
                    <div class="an-stat">
                        <div class="asl">★ Avg. Rating</div>
                        <div class="asv">@Model.Analytics.AverageRatingGiven.ToString("0.0")</div>
                        <div class="ass">This year</div>
                        @if (Model.Analytics.AvgRatingTrend is { } at)
                        {
                            <div class="ast @(at.IsUp ? "" : "down")">
                                <i class="ti @(at.IsUp ? "ti-arrow-up" : "ti-arrow-down")"></i>
                                @Math.Abs(at.PercentChange)% from last year
                            </div>
                        }
                    </div>
                </div>
                <div class="an-divider"></div>
                <div class="an-act-hdr">
                    <div><div class="aht">Reading Activity</div><div class="ahs">Hours read per week</div></div>
                    <div class="pd-w">
                        <button class="pd-btn" id="pdBtn" type="button"><span id="pdLabel">Last 8 weeks</span><i class="ti ti-chevron-down"></i></button>
                        <div class="pd-drop" id="pdDrop">
                            <a class="active" data-p="8w">Last 8 weeks</a>
                            <a data-p="4w">Last 4 weeks</a>
                            <a data-p="12w">Last 12 weeks</a>
                            <a data-p="6m">Last 6 months</a>
                        </div>
                    </div>
                </div>
                <div class="an-chart">
                    <div class="an-yaxis" id="anYAxis"></div>
                    <div class="an-bars-wrap">
                        <div class="an-bars" id="anBars"></div>
                        <div class="an-xlabels" id="anXL"></div>
                    </div>
                </div>
            </div>
            <div id="anReading" style="display:none" class="an-placeholder"><i class="ti ti-book-2"></i><p>Reading breakdown coming soon</p></div>
            <div id="anActivity" style="display:none" class="an-placeholder"><i class="ti ti-activity"></i><p>Activity heatmap coming soon</p></div>
            <div id="anStreaks" style="display:none" class="an-placeholder"><div style="font-size:28px">🔥</div><p>Streak analytics coming soon</p></div>
        </section>

    </div><!-- eg-feed -->
    <!-- RIGHT ASIDE -->
    <aside class="eg-aside">
        <!-- Community Highlights: no leaderboard data source yet, left static -->
        <div class="ra-card">
            <div class="ra-title">Community Highlights</div>
            <div style="font-size:11px;color:var(--t4);font-weight:600;margin-bottom:6px;">Top Reviewers</div>
            <div class="ch-row"><span class="ch-rank">1</span><div class="ch-av a1">S</div><div><div class="ch-name">Sarah J.</div><div class="ch-sub">Reviews 42</div></div><span class="ch-count">42</span></div>
            <div class="ch-row"><span class="ch-rank">2</span><div class="ch-av a2">M</div><div><div class="ch-name">Michael T.</div><div class="ch-sub">Reviews 37</div></div><span class="ch-count">37</span></div>
            <div class="ch-row"><span class="ch-rank">3</span><div class="ch-av a3">P</div><div><div class="ch-name">Priya K.</div><div class="ch-sub">Reviews 22</div></div><span class="ch-count">29</span></div>
            <a class="ch-lb">View leaderboard</a>
        </div>

        <div class="share-card">
            <div class="sc-t">Share your thoughts</div>
            <div class="sc-s">Your reviews help others discover great books.</div>
            <button class="eg-btn" id="writeBtn2" style="width:100%;justify-content:center;"><i class="ti ti-edit" style="font-size:12px"></i> Write a review</button>
        </div>

        <div class="ra-card">
            <div class="ra-title">Need Help?</div>
            <div style="font-size:11px;color:var(--t4);margin-bottom:4px;">We're here for you</div>
            <div class="sup-row"><div class="sup-row-l"><div class="sup-ico"><i class="ti ti-help-circle"></i></div><div><div class="sup-title">Help Center</div><div class="sup-sub">Find answers to common questions</div></div></div><i class="ti ti-chevron-right sup-chev"></i></div>
            <div class="sup-row"><div class="sup-row-l"><div class="sup-ico"><i class="ti ti-message-circle"></i></div><div><div class="sup-title">Contact Support</div><div class="sup-sub">Get help from our team</div></div></div><i class="ti ti-chevron-right sup-chev"></i></div>
            <div class="sup-row"><div class="sup-row-l"><div class="sup-ico"><i class="ti ti-alert-circle"></i></div><div><div class="sup-title">Report an Issue</div><div class="sup-sub">Let us know what's wrong</div></div></div><i class="ti ti-chevron-right sup-chev"></i></div>
            <div class="sup-row"><div class="sup-row-l"><div class="sup-ico"><i class="ti ti-message-dots"></i></div><div><div class="sup-title">Feedback</div><div class="sup-sub">Share your suggestions</div></div></div><i class="ti ti-chevron-right sup-chev"></i></div>
        </div>

        <div class="quote-card">
            <div class="qc-mark">"</div>
            <div class="qc-text">The more you engage, the richer your reading journey becomes.</div>
            <div class="qc-auth">— Atomic Habits Team</div>
        </div>
    </aside>
</div><!-- eg-body -->
<!-- WRITE REVIEW MODAL -->
<div class="eg-modal-bd" id="revModal">
    <div class="eg-modal">
        <div class="eg-mhdr"><h3>Write a Review</h3><i class="ti ti-x eg-mclose" id="closeRev"></i></div>
        <label>Book</label>
        <select id="revBook">
            <option value="" disabled selected>Choose a book…</option>
            @if (!reviewableBooks.Any())
            {
                <option value="" disabled>No books available to review</option>
            }
            else
            {
                @foreach (var b in reviewableBooks)
                {
                    <option value="@b.BookId">@b.Title — @b.Author</option>
                }
            }
        </select>
        <label>Rating</label>
        <div class="eg-mstars" id="mStars">
            <i class="ti ti-star" data-s="1"></i><i class="ti ti-star" data-s="2"></i>
            <i class="ti ti-star" data-s="3"></i><i class="ti ti-star" data-s="4"></i>
            <i class="ti ti-star" data-s="5"></i>
        </div>
        <label>Review</label>
        <textarea id="revText" placeholder="Share your thoughts about this book…" rows="4"></textarea>
        <div class="eg-mfoot">
            <button class="eg-mcancel" id="cancelRev">Cancel</button>
            <button class="eg-btn" id="submitRev"><i class="ti ti-send" style="font-size:12px"></i> Submit</button>
        </div>
    </div>
</div>

<script>
    (function() {
        'use strict';
        function gi(id) { return document.getElementById(id); }

        const CHART_DATA = @Html.Raw(chartJson); // [{ label, hours }]

        var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        window.ANTIFORGERY_TOKEN = tokenInput ? tokenInput.value : '';

        function closeAll(except) {
            [gi('egND'), gi('egAVD'), gi('egSD'), gi('pdDrop')].forEach(function(d) { if (d && d !== except) d.classList.remove('open'); });
            var pb = gi('pdBtn'); if (pb && gi('pdDrop') !== except) pb.classList.remove('open');
            document.querySelectorAll('.kb-m').forEach(function(m) { if (m !== except) m.classList.remove('open'); });
        }
        document.addEventListener('click', function() { closeAll(null); });

        /* Bell */
        var bell = gi('egBell'), nd = gi('egND'), bdot = gi('egBDot');
        if (bell) bell.addEventListener('click', function(e) { e.stopPropagation(); var o = nd.classList.contains('open'); closeAll(null); if (!o) nd.classList.add('open'); });

        var ma = gi('egMA');
        if (ma) ma.addEventListener('click', async function() {
            await fetch('/Reader/MarkAllNotificationsRead', { method: 'POST' });
            document.querySelectorAll('.eg-nd-item.unread').forEach(function(el) { el.classList.remove('unread'); });
            document.querySelectorAll('.eg-nd-dot').forEach(function(el) { el.remove(); });
            if (bdot) bdot.style.display = 'none';
        });

        var msr = gi('markSecRead');
        if (msr) msr.addEventListener('click', async function(e) {
            e.preventDefault();
            await fetch('/Reader/MarkAllNotificationsRead', { method: 'POST' });
            document.querySelectorAll('.notif-row .ndot').forEach(function(el) { el.remove(); });
            if (bdot) bdot.style.display = 'none';
        });

        /* Individual notification click → mark read */
        document.querySelectorAll('.notif-row, .eg-nd-item').forEach(function(row) {
            row.addEventListener('click', async function() {
                var id = row.dataset.notifId;
                if (!id) return;
                await fetch('/Reader/MarkNotificationRead?id=' + id, { method: 'POST' });
                var dot = row.querySelector('.ndot, .eg-nd-dot');
                if (dot) dot.remove();
                row.classList.remove('unread');
            });
        });

        /* Avatar */
        var av = gi('egAV'), avd = gi('egAVD');
        if (av) av.addEventListener('click', function(e) { e.stopPropagation(); var o = avd.classList.contains('open'); closeAll(null); if (!o) avd.classList.add('open'); });

        /* Kebabs */
        document.querySelectorAll('.kb').forEach(function(k) {
            k.addEventListener('click', function(e) {
                e.stopPropagation();
                var m = this.nextElementSibling;
                var o = m.classList.contains('open');
                closeAll(null);
                if (!o) m.classList.add('open');
            });
        });

        /* Analytics tabs */
        var panels = { overview: gi('anOverview'), reading: gi('anReading'), activity: gi('anActivity'), streaks: gi('anStreaks') };
        document.querySelectorAll('.an-tab').forEach(function(tab) {
            tab.addEventListener('click', function() {
                document.querySelectorAll('.an-tab').forEach(function(t) { t.classList.remove('active'); });
                this.classList.add('active');
                var k = this.getAttribute('data-tab');
                Object.keys(panels).forEach(function(p) { if (panels[p]) panels[p].style.display = (p === k) ? '' : 'none'; });
            });
        });

        /* Chart — server-provided data for the current range only */
        function buildChart(data) {
            var bars = gi('anBars'), xl = gi('anXL'), yax = gi('anYAxis');
            if (!bars || !xl) return;
            if (!data || !data.length) {
                bars.innerHTML = ''; xl.innerHTML = '';
                if (yax) yax.innerHTML = '';
                return;
            }
            var mx = Math.max.apply(null, data.map(function(d) { return d.hours; })) || 1;

            if (yax) {
                yax.innerHTML = '';
                [1, 0.75, 0.5, 0.25, 0].forEach(function(f) {
                    var s = document.createElement('span');
                    s.textContent = Math.round(mx * f) + 'h';
                    yax.appendChild(s);
                });
            }

            bars.innerHTML = ''; xl.innerHTML = '';
            data.forEach(function(d) {
                var b = document.createElement('div');
                b.className = 'an-bar' + (d.hours === mx ? ' hi' : '');
                b.style.height = Math.round((d.hours / mx) * 100) + '%';
                var tip = document.createElement('div');
                tip.className = 'an-bar-tip';
                tip.textContent = d.hours + 'h';
                b.appendChild(tip);
                bars.appendChild(b);

                var s = document.createElement('span');
                s.className = 'an-xlabel';
                s.textContent = d.label;
                xl.appendChild(s);
            });
        }

        var pb = gi('pdBtn'), pdrop = gi('pdDrop'), pl = gi('pdLabel');
        if (pb) {
            pb.addEventListener('click', function(e) {
                e.stopPropagation();
                var o = pdrop.classList.contains('open');
                closeAll(null);
                if (!o) { pdrop.classList.add('open'); pb.classList.add('open'); }
            });
            pdrop.querySelectorAll('a[data-p]').forEach(function(a) {
                a.addEventListener('click', function(e) {
                    e.stopPropagation();
                    window.location.href = '/Reader/Engagement?range=' + this.getAttribute('data-p') + '#section-analytics';
                });
            });
        }

        /* Modal */
        var modal = gi('revModal'); var rating = 0;
        function openM() { modal.classList.add('open'); }
        function closeM() { modal.classList.remove('open'); }
        [gi('writeBtn1'), gi('writeBtn2')].forEach(function(b) { if (b) b.addEventListener('click', openM); });
        if (gi('closeRev')) gi('closeRev').addEventListener('click', closeM);
        if (gi('cancelRev')) gi('cancelRev').addEventListener('click', closeM);
        if (modal) modal.addEventListener('click', function(e) { if (e.target === modal) closeM(); });

        var mstars = document.querySelectorAll('#mStars i');
        mstars.forEach(function(s, i) {
            s.addEventListener('mouseover', function() { mstars.forEach(function(x, j) { x.className = j <= i ? 'ti ti-star-filled lit' : 'ti ti-star'; }); });
            s.addEventListener('click', function() { rating = i + 1; });
        });
        var ms = gi('mStars');
        if (ms) ms.addEventListener('mouseleave', function() { mstars.forEach(function(s, i) { s.className = i < rating ? 'ti ti-star-filled lit' : 'ti ti-star'; }); });

        /* Submit review — wired to AddReview command */
        if (gi('submitRev')) gi('submitRev').addEventListener('click', async function() {
            var bookSelect = gi('revBook');
            var bookId = bookSelect ? bookSelect.value : null;
            var comment = gi('revText').value.trim();

            if (!bookId) { alert('Please select a book.'); return; }
            if (!rating) { alert('Please select a rating.'); return; }
            if (!comment) { alert('Please write a short review.'); return; }

            var btn = this;
            btn.disabled = true;

            try {
                var res = await fetch('/Reader/AddReview', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': window.ANTIFORGERY_TOKEN
                    },
                    body: JSON.stringify({ rating: rating, comment: comment, bookId: bookId })
                });
                var data = await res.json();

                if (!data.success) {
                    alert(data.message || 'Could not submit review.');
                    return;
                }

                closeM();
                gi('revText').value = '';
                rating = 0;
                mstars.forEach(function(s) { s.className = 'ti ti-star'; });
                if (bookSelect) bookSelect.selectedIndex = 0;
                window.location.reload();
            } catch (err) {
                alert('Something went wrong submitting your review.');
            } finally {
                btn.disabled = false;
            }
        });

        /* Scrollspy */
        var smap = [{ label: 'Reviews', id: 'section-reviews' }, { label: 'Notifications', id: 'section-notifications' }, { label: 'Analytics', id: 'section-analytics' }, { label: 'Support', id: 'section-notifications' }];
        document.querySelectorAll('.nav-subitem').forEach(function(link) {
            var txt = link.textContent.trim();
            smap.forEach(function(m) { if (txt === m.label) { link.setAttribute('href', '#' + m.id); link.classList.add('scrollspy-link'); } });
        });

        /* Init */
        buildChart(CHART_DATA);
    })();
</script>