            </div>

            <!-- Atomic Habits -->
            <div class="rev-row">
                <div class="bk-cover">
                    <svg viewBox="0 0 38 52" width="38" height="52"><defs><linearGradient id="cah" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#d4a843" /><stop offset="100%" stop-color="#7a4010" /></linearGradient></defs><rect width="38" height="52" rx="3" fill="url(#cah)" /><text x="19" y="11" text-anchor="middle" font-size="4" font-weight="700" fill="rgba(255,255,255,.7)" font-family="sans-serif">TINY CHANGES</text><text x="19" y="16" text-anchor="middle" font-size="3.5" fill="rgba(255,255,255,.6)" font-family="sans-serif">REMARKABLE RESULTS</text><text x="19" y="27" text-anchor="middle" font-size="8.5" font-weight="900" fill="#fff" font-family="sans-serif">Atomic</text><text x="19" y="36" text-anchor="middle" font-size="8.5" font-weight="900" fill="#fff" font-family="sans-serif">Habits</text><text x="19" y="48" text-anchor="middle" font-size="4" font-weight="600" fill="rgba(255,255,255,.85)" font-family="sans-serif">James Clear</text></svg>
                </div>
                <div class="rev-mid">
                    <div class="rmt">Atomic Habits</div><div class="rma">James Clear</div>
                    <div class="rms"><i class="ti ti-star-filled"></i><i class="ti ti-star-filled"></i><i class="ti ti-star-filled"></i><i class="ti ti-star-filled"></i><i class="ti ti-star-filled"></i><span>5.0</span></div>
                    <div class="rmtx">Life changing! The small habits approach is practical and easy to implement.</div>
                </div>
                <div class="rev-right"><span class="rrd">May 12, 2024</span><div class="kb-w"><i class="ti ti-dots-vertical kb"></i><div class="kb-m"><a><i class="ti ti-edit"></i>Edit</a><a class="danger"><i class="ti ti-trash"></i>Delete</a></div></div></div>
            </div>

            <!-- The 5 AM Club -->
            <div class="rev-row">
                <div class="bk-cover">
