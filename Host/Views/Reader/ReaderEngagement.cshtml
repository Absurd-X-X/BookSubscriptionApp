</div><!-- eg-body -->
<!-- WRITE REVIEW MODAL -->
<div class="eg-modal-bd" id="revModal">
    <div class="eg-modal">
        <div class="eg-mhdr"><h3>Write a Review</h3><i class="ti ti-x eg-mclose" id="closeRev"></i></div>
        <label>Book</label>
        <select id="revBook">
            <option>Atomic Habits — James Clear</option>
            <option>The 5 AM Club — Robin Sharma</option>
            <option>Deep Work — Cal Newport</option>
            <option>Make Your Bed — William H. McRaven</option>
            <option>Mindset — Carol S. Dweck</option>
        </select>
        <label>Rating</label>
        <div class="eg-mstars" id="mStars">
            <i class="ti ti-star" data-s="1"></i><i class="ti ti-star" data-s="2"></i>
            <i class="ti ti-star" data-s="3"></i><i class="ti ti-star" data-s="4"></i>
            <i class="ti ti-star" data-s="5"></i>
        </div>
        <label>Review</label>
        <textarea id="revText" placeholder="Share your thoughts about this book…" rows="4"></textarea>
        <div class="eg-mfoot">
            <button class="eg-mcancel" id="cancelRev">Cancel</button>
            <button class="eg-btn" id="submitRev"><i class="ti ti-send" style="font-size:12px"></i> Submit</button>
        </div>
    </div>
</div>
<script>
        (function(){
    'use strict';
    function gi(id){ return document.getElementById(id); }

    function closeAll(except){
      [gi('egND'),gi('egAVD'),gi('egSD'),gi('pdDrop')].forEach(function(d){ if(d&&d!==except) d.classList.remove('open'); });
      var pb=gi('pdBtn'); if(pb&&gi('pdDrop')!==except) pb.classList.remove('open');
      document.querySelectorAll('.kb-m').forEach(function(m){ if(m!==except) m.classList.remove('open'); });
    }
    document.addEventListener('click',function(){ closeAll(null); });

    /* Search */
    var ITEMS=[
      {t:'Reviews',s:'Your reviews and ratings',i:'ti-star',h:'#section-reviews'},
      {t:'Notifications',s:'Recent updates',i:'ti-bell',h:'#section-notifications'},
      {t:'Analytics',s:'Your reading insights',i:'ti-chart-bar',h:'#section-analytics'},
      {t:'Atomic Habits',s:'James Clear',i:'ti-book-2',h:'#section-reviews'},
      {t:'The 5 AM Club',s:'Robin Sharma',i:'ti-book-2',h:'#section-reviews'},
      {t:'Deep Work',s:'Cal Newport',i:'ti-book-2',h:'#section-reviews'},
      {t:'Help Center',s:'Find answers to common questions',i:'ti-help-circle',h:'#section-notifications'},
    ];
    var si=gi('egSI'),sd=gi('egSD');
    function renderSearch(q){
      sd.innerHTML=''; if(!q){sd.classList.remove('open');return;}
      var ql=q.toLowerCase();
      var hits=ITEMS.filter(function(x){return x.t.toLowerCase().includes(ql)||x.s.toLowerCase().includes(ql);});
      if(!hits.length){sd.innerHTML='<div class="eg-sr-empty">No results for "'+q+'"</div>';}
      else{hits.forEach(function(b){var el=document.createElement('div');el.className='eg-sr';el.innerHTML='<i class="ti '+b.i+'"></i><div><div class="eg-sr-t">'+b.t+'</div><div class="eg-sr-s">'+b.s+'</div></div>';el.addEventListener('click',function(){var t=document.querySelector(b.h);if(t)t.scrollIntoView({behavior:'smooth',block:'start'});si.value=b.t;sd.classList.remove('open');});sd.appendChild(el);});}
      sd.classList.add('open');
    }
    if(si){
      si.addEventListener('input',function(){closeAll(sd);renderSearch(this.value.trim());});
      si.addEventListener('focus',function(){if(this.value.trim())renderSearch(this.value.trim());});
      document.addEventListener('keydown',function(e){if((e.metaKey||e.ctrlKey)&&e.key==='k'){e.preventDefault();si.focus();si.select();}if(e.key==='Escape'){sd.classList.remove('open');si.blur();closeAll(null);}});
    }

    /* Bell */
    var bell=gi('egBell'),nd=gi('egND'),bdot=gi('egBDot');
    if(bell)bell.addEventListener('click',function(e){e.stopPropagation();var o=nd.classList.contains('open');closeAll(null);if(!o)nd.classList.add('open');});
    var ma=gi('egMA');
    if(ma)ma.addEventListener('click',function(){document.querySelectorAll('.eg-nd-item.unread').forEach(function(el){el.classList.remove('unread');});document.querySelectorAll('.eg-nd-dot').forEach(function(el){el.remove();});if(bdot)bdot.style.display='none';});

    /* Avatar */
    var av=gi('egAV'),avd=gi('egAVD');
    if(av)av.addEventListener('click',function(e){e.stopPropagation();var o=avd.classList.contains('open');closeAll(null);if(!o)avd.classList.add('open');});

    /* Section mark read */
    var msr=gi('markSecRead');
    if(msr)msr.addEventListener('click',function(e){e.preventDefault();['snd1','snd2','snd3','snd4'].forEach(function(id){var el=gi(id);if(el)el.style.display='none';});if(bdot)bdot.style.display='none';});

    /* Kebabs */
    document.querySelectorAll('.kb').forEach(function(k){k.addEventListener('click',function(e){e.stopPropagation();var m=this.nextElementSibling;var o=m.classList.contains('open');closeAll(null);if(!o)m.classList.add('open');});});

    /* Analytics tabs */
    var panels={overview:gi('anOverview'),reading:gi('anReading'),activity:gi('anActivity'),streaks:gi('anStreaks')};
    document.querySelectorAll('.an-tab').forEach(function(tab){tab.addEventListener('click',function(){document.querySelectorAll('.an-tab').forEach(function(t){t.classList.remove('active');});this.classList.add('active');var k=this.getAttribute('data-tab');Object.keys(panels).forEach(function(p){if(panels[p])panels[p].style.display=(p===k)?'':'none';});});});

    /* Chart */
    var CHART={
      '8w':{v:[2,5,3,4,6,3,5,7],l:['Mar 24','Mar 31','Apr 7','Apr 14','Apr 21','Apr 28','May 5','May 12']},
      '4w':{v:[4,6,5,7],l:['Apr 21','Apr 28','May 5','May 12']},
      '12w':{v:[1,3,2,4,3,5,2,4,3,5,4,7],l:['Feb','','Mar','','Apr','','','May','','','','']},
      '6m':{v:[4,5,3,6,5,7],l:['Dec','Jan','Feb','Mar','Apr','May']}
    };
    function buildChart(key){
      var bars=gi('anBars'),xl=gi('anXL');if(!bars||!xl)return;
      var d=CHART[key]||CHART['8w'];var mx=Math.max.apply(null,d.v);
      bars.innerHTML='';xl.innerHTML='';
      d.v.forEach(function(v){var b=document.createElement('div');b.className='an-bar'+(v===mx?' hi':'');b.style.height=Math.round((v/mx)*100)+'%';var tip=document.createElement('div');tip.className='an-bar-tip';tip.textContent=v+'h';b.appendChild(tip);bars.appendChild(b);});
      d.l.forEach(function(l){var s=document.createElement('span');s.className='an-xlabel';s.textContent=l;xl.appendChild(s);});
    }
    var pb=gi('pdBtn'),pdrop=gi('pdDrop'),pl=gi('pdLabel');
    if(pb){
      pb.addEventListener('click',function(e){e.stopPropagation();var o=pdrop.classList.contains('open');closeAll(null);if(!o){pdrop.classList.add('open');pb.classList.add('open');}});
      pdrop.querySelectorAll('a[data-p]').forEach(function(a){a.addEventListener('click',function(e){e.stopPropagation();pdrop.querySelectorAll('a').forEach(function(x){x.classList.remove('active');});this.classList.add('active');pl.textContent=this.textContent;buildChart(this.getAttribute('data-p'));pdrop.classList.remove('open');pb.classList.remove('open');});});
    }

    /* Modal */
    var modal=gi('revModal');var rating=0;
    function openM(){modal.classList.add('open');}
    function closeM(){modal.classList.remove('open');}
    [gi('writeBtn1'),gi('writeBtn2')].forEach(function(b){if(b)b.addEventListener('click',openM);});
    if(gi('closeRev'))gi('closeRev').addEventListener('click',closeM);
    if(gi('cancelRev'))gi('cancelRev').addEventListener('click',closeM);
    if(modal)modal.addEventListener('click',function(e){if(e.target===modal)closeM();});
    var mstars=document.querySelectorAll('#mStars i');
    mstars.forEach(function(s,i){s.addEventListener('mouseover',function(){mstars.forEach(function(x,j){x.className=j<=i?'ti ti-star-filled lit':'ti ti-star';});});s.addEventListener('click',function(){rating=i+1;});});
    var ms=gi('mStars');
    if(ms)ms.addEventListener('mouseleave',function(){mstars.forEach(function(s,i){s.className=i<rating?'ti ti-star-filled lit':'ti ti-star';});});
    if(gi('submitRev'))gi('submitRev').addEventListener('click',function(){alert('Review submitted: '+gi('revBook').value+' ('+rating+' stars)');closeM();});

    /* Scrollspy */
    var smap=[{label:'Reviews',id:'section-reviews'},{label:'Notifications',id:'section-notifications'},{label:'Analytics',id:'section-analytics'},{label:'Support',id:'section-notifications'}];
    document.querySelectorAll('.nav-subitem').forEach(function(link){var txt=link.textContent.trim();smap.forEach(function(m){if(txt===m.label){link.setAttribute('href','#'+m.id);link.classList.add('scrollspy-link');}});});

    /* Init */
    if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',function(){buildChart('8w');});}
    else{buildChart('8w');}
    })();
</script>