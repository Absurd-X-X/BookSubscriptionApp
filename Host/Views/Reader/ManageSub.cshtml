@model Application.Queries.GetSubscriptionByUserId.GetSubscriptionByUserIdResponse
@{
    ViewData["Title"] = "Subscription Management";
    Layout = "~/Views/Shared/_ReaderLayout.cshtml";

    var hasActiveSub = Model.IsActive;
    var plans = Model.AvailablePlans ?? new();
    var history = Model.Subscription ?? new();

    string TileState(Guid planId, decimal planCost)
    {
        if (!hasActiveSub) return "none";
        if (planId == Model.SubscriptionTypeId) return "current";
        return planCost < Model.Cost ? "lower" : "higher";
    }

    string CycleLabel(Domain.Enums.BillingCycle cycle) => cycle switch
    {
        Domain.Enums.BillingCycle.Monthly => "month",
        Domain.Enums.BillingCycle.Quaterly => "quarter",
        Domain.Enums.BillingCycle.SemiAnnually => "6 months",
        Domain.Enums.BillingCycle.Yearly => "year",
        _ => "cycle"
    };
}

<link href="~/css/manageSub.css" rel="stylesheet" />

<div class="content-wrap">
    <div class="main sub-page">

        <nav class="breadcrumb">
            <a asp-action="ReaderDashboard" asp-controller="Reader">Dashboard</a>
            <span class="sep">&gt;</span>
            <span class="current">Subscription</span>
        </nav>

        <div class="page-header">
            <h1>Subscription Management</h1>
            <p>Manage your plan, billing, and payment preferences.</p>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert-banner alert-error">@TempData["Error"]</div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert-banner alert-success">@TempData["Success"]</div>
        }

        <div class="sub-grid">

            <div class="sub-col sub-col--left">

                <!-- Current Plan -->
                <section class="card current-plan-card">
                    <h2 class="card-title">Current Plan</h2>

                    @if (!hasActiveSub)
                    {
                        <p>You don't have an active subscription. Choose a plan below to get started.</p>
                    }
                    else
                    {
                        <div class="plan-row">
                            <div class="plan-id">
                                <div class="plan-icon plan-icon--premium">
                                    <i class="fa-solid fa-crown"></i>
                                </div>
                                <div>
                                    <div class="plan-name">@Model.CurrentPlan Plan</div>
                                    <div class="plan-price"><span class="amount">@Model.Cost.ToString("C")</span> / month</div>
                                </div>
                            </div>

                            <div class="plan-meta">
                                <div class="meta-item">
                                    <div class="meta-label">Status</div>
                                    <span class="badge badge--active">Active</span>
                                </div>
                                <div class="meta-item">
                                    <div class="meta-label">Renewal Date</div>
                                    <div class="meta-value">@Model.ExpiryDate.ToString("MMM d, yyyy")</div>
                                </div>
                                <div class="meta-item">
                                    <div class="meta-label">Auto-Renew</div>
                                    <div class="meta-value meta-value--accent">@(Model.AutoRenew ? "Enabled" : "Disabled")</div>
                                </div>
                            </div>
                        </div>

                        <ul class="feature-list">
                            <li><i class="fa-solid fa-square-check"></i> Unlimited access to books</li>
                            <li><i class="fa-solid fa-square-check"></i> Audiobooks included</li>
                            <li><i class="fa-solid fa-square-check"></i> Offline reading</li>
                            <li><i class="fa-solid fa-square-check"></i> Early access to new releases</li>
                            <li><i class="fa-solid fa-square-check"></i> Cancel anytime</li>
                        </ul>

                        <div class="plan-actions">
                            <form asp-action="AutoRenewSub" asp-controller="Reader" method="post">
                                <input type="hidden" name="subId" value="@Model.Id" />
                                <input type="hidden" name="autoRenew" value="@(!Model.AutoRenew)" />
                                <button type="submit" class="btn btn-outline">
                                    @(Model.AutoRenew ? "Disable Auto-Renew" : "Enable Auto-Renew")
                                </button>
                            </form>
                            <button type="button" class="btn btn-outline">Cancel Subscription</button>
                        </div>

                        <div class="notice-row">
                            <i class="fa-regular fa-circle-info"></i>
                            @(Model.AutoRenew
                                ? $"Your plan will renew automatically on {Model.ExpiryDate:MMM d, yyyy}."
                                : $"Your plan will expire on {Model.ExpiryDate:MMM d, yyyy} and will not renew.")
                        </div>
                    }
                </section>

                <!-- Payment Method (mocked) -->
                <section class="card payment-card">
                    <h2 class="card-title">Payment Method</h2>

                    <div class="payment-row">
                        <div class="payment-row-left">
                            <i class="fa-brands fa-mastercard card-brand-icon card-brand-icon--lg"></i>
                            <div>
                                <div class="payment-row-top">
                                    <span class="card-number">•••• •••• •••• 4242</span>
                                    <span class="badge badge--default">Default</span>
                                </div>
                                <div class="payment-row-sub">Expires 12/26</div>
                            </div>
                        </div>
                        <button type="button" class="btn btn-outline">Update</button>
                    </div>

                    <button type="button" class="add-payment-link">
                        <i class="fa-solid fa-plus"></i> Add Payment Method
                    </button>

                    <div class="notice-row notice-row--secure">
                        <i class="fa-solid fa-lock"></i>
                        Your payment information is secure and encrypted.
                    </div>
                </section>

            </div>

            <div class="sub-col sub-col--right">

                <!-- Choose Your Plan -->
                <section class="card choose-plan-card">
                    <div class="choose-plan-head">
                        <h2 class="card-title">Choose Your Plan</h2>
                    </div>

                    @if (!plans.Any())
                    {
                        <p>No subscription plans are available right now.</p>
                    }
                    else
                    {
                        <div class="plans-grid">
                            @foreach (var plan in plans)
                            {
                                var state = TileState(plan.Id, plan.Cost);
                                var tileClass = state == "current" ? "plan-tile plan-tile--current" : "plan-tile";

                                <div class="@tileClass">
                                    @if (state == "current")
                                    {
                                        <span class="popular-badge">Current Plan</span>
                                    }
                                    <div class="plan-tile-icon plan-tile-icon--premium">
                                        <i class="fa-solid fa-crown"></i>
                                    </div>
                                    <div class="plan-tile-name">@plan.TypeName</div>
                                    <div class="plan-tile-price">
                                        <span class="amount">@plan.Cost.ToString("C")</span> / @CycleLabel(plan.Cycle)
                                    </div>

                                    @switch (state)
                                    {
                                        case "current":
                                            <button type="button" class="btn btn-primary btn-block" disabled>Current Plan</button>
                                            break;
                                        default:
                                            <form asp-action="Subscribe" asp-controller="Reader" method="post">
                                                <input type="hidden" name="subTypeId" value="@plan.Id" />
                                                <button type="submit" class="btn @(state == "higher" || state == "none" ? "btn-primary" : "btn-outline") btn-block">
                                                    @(state == "lower" ? "Change Now" : state == "higher" ? "Upgrade" : "Choose Plan")
                                                </button>
                                            </form>
                                            break;
                                    }
                                </div>
                            }
                        </div>
                    }

                    <div class="plans-footnote">Switching plans takes effect immediately.</div>
                </section>

                <!-- Subscription History -->
                <section class="card billing-card">
                    <div class="card-head-row">
                        <h2 class="card-title">Subscription History</h2>
                    </div>

                    @if (!history.Any())
                    {
                        <p>No subscription history yet.</p>
                    }
                    else
                    {
                        <table class="billing-table">
                            <thead>
                                <tr>
                                    <th>Plan</th>
                                    <th>Amount</th>
                                    <th>Subscribed On</th>
                                    <th>Expiry</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var h in history.OrderByDescending(x => x.Types.SubscriptionDate))
                                {
                                    <tr>
                                        <td>@h.Types.TypeName</td>
                                        <td>@h.Types.Cost.ToString("C")</td>
                                        <td>@h.Types.SubscriptionDate.ToString("MMM d, yyyy")</td>
                                        <td>@h.Types.ExpiryDate.ToString("MMM d, yyyy")</td>
                                        <td>
                                            <span class="badge @(h.IsActive ? "badge--paid" : "badge--default")">
                                                @(h.IsActive ? "Active" : "Expired")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </section>

            </div>

        </div>

        <!-- Premium Benefits (mocked) -->
        <section class="card benefits-card">
            <h2 class="card-title">Premium Benefits</h2>
            <div class="benefits-grid">
                <div class="benefit-item">
                    <div class="benefit-icon"><i class="fa-solid fa-book-open"></i></div>
                    <div>
                        <div class="benefit-title">Unlimited Reading</div>
                        <div class="benefit-desc">Access thousands of books</div>
                    </div>
                </div>
                <div class="benefit-item">
                    <div class="benefit-icon"><i class="fa-solid fa-headphones"></i></div>
                    <div>
                        <div class="benefit-title">Audiobooks</div>
                        <div class="benefit-desc">Listen on the go</div>
                    </div>
                </div>
                <div class="benefit-item">
                    <div class="benefit-icon"><i class="fa-solid fa-cloud-arrow-down"></i></div>
                    <div>
                        <div class="benefit-title">Offline Access</div>
                        <div class="benefit-desc">Download and read anytime</div>
                    </div>
                </div>
                <div class="benefit-item">
                    <div class="benefit-icon"><i class="fa-solid fa-bolt"></i></div>
                    <div>
                        <div class="benefit-title">Early Access</div>
                        <div class="benefit-desc">Get new books first</div>
                    </div>
                </div>
                <div class="benefit-item">
                    <div class="benefit-icon"><i class="fa-solid fa-headset"></i></div>
                    <div>
                        <div class="benefit-title">Premium Support</div>
                        <div class="benefit-desc">We're here to help</div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Help Banner -->
        <section class="help-banner">
            <div class="help-banner-left">
                <div class="help-banner-icon"><i class="fa-regular fa-comment-dots"></i></div>
                <div>
                    <div class="help-banner-title">Need help with your subscription?</div>
                    <div class="help-banner-sub">Visit our <a href="#">Help Center</a> or contact our support team.</div>
                </div>
            </div>
            <a href="#" class="btn btn-primary help-banner-btn">
                Visit Help Center <i class="fa-solid fa-arrow-up-right-from-square"></i>
            </a>
        </section>

    </div>
</div>