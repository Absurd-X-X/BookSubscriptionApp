@{
    ViewData["Title"] = "My Reading";
    Layout = "~/Views/Shared/_ReaderLayout.cshtml";
}
<link href="~/css/readingProgress.css" rel="stylesheet" />

<div class="page-header">
    <h1>My Reading</h1>
    <p>Track your journey and keep growing.</p>
</div>

<div class="reading-page">

    <!-- LEFT: Main content -->
    <div class="reading-main">

        <!-- Currently Reading -->
        <section class="page-section" id="section-currently-reading">
            <div class="section-header">
                <h2>Currently Reading</h2>
                <a href="#" class="view-all">View all</a>
            </div>
            <div class="card">
                <div class="currently-reading-card">

                    <!-- Book Cover -->
                    <div class="book-cover-placeholder">
                        <div class="book-subtitle">Tiny Changes,<br>Remarkable Results</div>
                        <div class="book-title-text">Atomic Habits</div>
                        <div class="book-desc">An Easy & Proven Way to Build Good Habits & Break Bad Ones.</div>
                        <div class="book-author-cover">James Clear</div>
                    </div>

                    <!-- Book Info -->
                    <div class="book-info">
                        <div class="book-title">Atomic Habits</div>
                        <div class="book-author">James Clear</div>
                        <div class="book-desc-text">An Easy & Proven Way to Build Good Habits<br>& Break Bad Ones.</div>
                        <div class="reading-progress-bar-wrap">
                            <div class="progress-label">67% complete</div>
                            <div class="progress-bar-track">
                                <div class="progress-bar-fill" style="width: 67%"></div>
                            </div>
                        </div>
                        <div class="time-left">
                            <i class="ti ti-clock"></i> 9h 24min left to finish
                        </div>
                        <div class="book-actions">
                            <a href="#" class="btn-primary"><i class="ti ti-player-play"></i> Continue Reading</a>
                            <a href="#" class="btn-secondary">Details</a>
                        </div>
                    </div>

                    <!-- Progress Panel -->
                    <div class="progress-panel">
                        <div class="progress-panel-header">
                            <span>Your Progress</span>
                            <button class="progress-panel-close"><i class="ti ti-x"></i></button>
                        </div>
                        <div class="donut-wrap">
                            <div class="donut-chart">
                                <svg width="90" height="90" viewBox="0 0 90 90">
                                    <circle cx="45" cy="45" r="35" fill="none" stroke="#1C2541" stroke-width="8" />
                                    <circle cx="45" cy="45" r="35" fill="none" stroke="url(#donutGrad)" stroke-width="8"
                                            stroke-dasharray="219.9" stroke-dashoffset="72.6" stroke-linecap="round" />
                                    <defs>
                                        <linearGradient id="donutGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                                            <stop offset="0%" stop-color="#7C6AFF" />
                                            <stop offset="100%" stop-color="#A78BFA" />
                                        </linearGradient>
                                    </defs>
                                </svg>
                                <div class="donut-center">
                                    <span class="donut-pct">67%</span>
                                    <span class="donut-label">Completed</span>
                                </div>
                            </div>
                        </div>
                        <div class="progress-stats">
                            <div class="progress-stat-row">
                                <span class="stat-label">Pages Read</span>
                                <span class="stat-val">184 / 272</span>
                            </div>
                            <div class="progress-stat-row">
                                <span class="stat-label">Chapters</span>
                                <span class="stat-val">12 / 20</span>
                            </div>
                            <div class="progress-stat-row">
                                <span class="stat-label">Time Read</span>
                                <span class="stat-val">6h 35m</span>
                            </div>
                            <div class="progress-stat-row">
                                <span class="stat-label">Last Read</span>
                                <span class="stat-val">Today, 7:45 PM</span>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </section>

        <!-- Completed Books -->
