                                </div>
                            </td>
                            <td>5h 10m</td>
                            <td><button class="dots-btn"><i class="ti ti-dots-vertical"></i></button></td>
                        </tr>
                        <tr>
                            <td>
                                <div class="history-book-cell">
                                    <div class="history-book-thumb" style="background:linear-gradient(135deg,#7d6608,#5d4e03)">Thinking<br>Fast<br>& Slow</div>
                                    <div>
                                        <div class="history-book-name">Thinking, Fast and Slow</div>
                                        <div class="history-book-sub">Daniel Kahneman</div>
                                    </div>
                                </div>
                            </td>
                            <td>Daniel Kahneman</td>
                            <td>May 11, 2024<br>6:40 PM</td>
                            <td>
                                <div class="history-progress-bar">
                                    <div class="history-bar-track"><div class="history-bar-fill complete" style="width:100%"></div></div>
