                        </tr>
                        <tr>
                            <td>
                                <div class="history-book-cell">
                                    <div class="history-book-thumb" style="background:linear-gradient(135deg,#1e8449,#0b5345)">The<br>Compound<br>Effect</div>
                                    <div>
