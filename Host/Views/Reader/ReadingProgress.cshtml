                    <div class="genre-dot" style="background:#3B82F6"></div>
                    <span class="genre-name">Leadership</span>
                    <span class="genre-pct">11%</span>
                </div>
            </div>
        </div>

        <!-- Quote Card -->
        <div class="quote-card">
            <span class="quote-icon">❝</span>
            <div class="quote-text">"The more you read, the more things you will know. The more that you learn, the more places you'll go."</div>
            <div class="quote-author">— Dr. Seuss</div>
            <div class="quote-book-illus">📖</div>
        </div>

    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {

        // ── Scrollspy for this page ──
        const sections = document.querySelectorAll('.page-section');
        if (sections.length === 0) return;

        function setActiveByHash(hash) {
            document.querySelectorAll('.nav-item[data-hash]').forEach(function (link) {
                link.classList.remove('active');
            });
            if (hash) {
                var matched = document.querySelector('.nav-item[data-hash="' + hash + '"]');
                if (matched) matched.classList.add('active');
            } else {
                var firstLink = document.querySelector('.nav-item[data-hash]');
                if (firstLink) firstLink.classList.add('active');
            }
        }

        setActiveByHash(window.location.hash);

        window.addEventListener('hashchange', function () {
            setActiveByHash(window.location.hash);
        });

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    var hash = '#' + entry.target.id;
                    history.replaceState(null, null, hash);
                    setActiveByHash(hash);
                }
            });
        }, {
            threshold: 0,
            rootMargin: '-50% 0px -50% 0px'
        });

        sections.forEach(section => observer.observe(section));

    });
</script>

