    </div>

    <!-- RIGHT SIDEBAR -->
    <div class="reading-sidebar">

        <!-- Reading Streak -->
        <div class="streak-card">
            <div class="streak-title">Reading Streak</div>
            <div class="streak-count">
                <span class="streak-fire">🔥</span>
                <div>
