@model Application.Queries.GetMyReadingDashboard.GetMyReadingDashboardResponse
@{
    ViewData["Title"] = "My Reading";
    Layout = "~/Views/Shared/_ReaderLayout.cshtml";

    string StarDisplay(int seedValue)
    {
        // No rating field exists on Book yet — derive a display-only rating from a stable seed
        var rating = 3.5 + (Math.Abs(seedValue) % 15) / 10.0;
        var full = (int)Math.Floor(rating);
        var half = (rating - full) >= 0.5;
        var sb = new System.Text.StringBuilder();
        for (int i = 0; i < full; i++) sb.Append("★");
        if (half) sb.Append("½");
        return sb.ToString() + $"<span class=\"rec-score\">{rating:0.0}</span>";
    }
}
<link href="~/css/readingProgress.css" rel="stylesheet" />

<div class="page-header">
    <h1>My Reading</h1>
    <p>Track your journey and keep growing.</p>
</div>

<div class="reading-page">
    <div class="reading-main">

        <!-- Currently Reading -->
        <section class="page-section" id="section-currently-reading">
            <div class="section-header">
                <h2>Currently Reading</h2>
                <a href="@Url.Action("ViewAllReadingProgress", "Reader")" class="view-all">View all</a>
            </div>
            <div class="card">
                @if (Model.CurrentlyReading is null)
                {
                    <p class="cr-empty">No books in progress right now.</p>
                }
                else
                {
                    <div class="currently-reading-card">
                        <div class="book-cover-placeholder">
                            @if (!string.IsNullOrEmpty(Model.CurrentlyReading.BookCoverUrl))
                            {
                                <img src="@Model.CurrentlyReading.BookCoverUrl" alt="@Model.CurrentlyReading.Title" style="width:100%;height:100%;object-fit:cover;" />
                            }
                            else
                            {
                                <div class="book-title-text">@Model.CurrentlyReading.Title</div>
                            }
                        </div>
                        <div class="book-info">
                            <div class="book-title">@Model.CurrentlyReading.Title</div>
                            <div class="book-author">@Model.CurrentlyReading.Author</div>
                            <div class="reading-progress-bar-wrap">
                                <div class="progress-label">@Model.CurrentlyReading.ProgressPercentage.ToString("0")% complete</div>
                                <div class="progress-bar-track">
                                    <div class="progress-bar-fill" style="width: @Model.CurrentlyReading.ProgressPercentage.ToString("0")%"></div>
                                </div>
                            </div>
                            <div class="time-left">
                                <i class="ti ti-clock"></i> @Model.CurrentlyReading.TotalMinutesRead min read
                            </div>
                            <div class="book-actions">
                                <a href="@Url.Action("ReadBook", "Reader", new { bookId = Model.CurrentlyReading.BookId })" class="btn-primary"><i class="ti ti-player-play"></i> Continue Reading</a>
                                <a href="/Reader/ReaderBook/@Model.CurrentlyReading.BookId" class="btn-secondary">Details</a>
                            </div>
                        </div>
                        <div class="progress-panel">
                            <div class="progress-panel-header">
                                <span>Your Progress</span>
                                <button class="progress-panel-close"><i class="ti ti-x"></i></button>
                            </div>
                            <div class="donut-wrap">
                                <div class="donut-chart">
                                    @{
                                        var pct = Model.CurrentlyReading.ProgressPercentage;
                                        var circumference = 219.9;
                                        var offset = circumference - (circumference * pct / 100);
                                    }
                                    <svg width="90" height="90" viewBox="0 0 90 90">
                                        <circle cx="45" cy="45" r="35" fill="none" stroke="#1C2541" stroke-width="8" />
                                        <circle cx="45" cy="45" r="35" fill="none" stroke="url(#donutGrad)" stroke-width="8"
                                                stroke-dasharray="@circumference.ToString("0.0")" stroke-dashoffset="@offset.ToString("0.0")" stroke-linecap="round" />
                                        <defs>
                                            <linearGradient id="donutGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                                                <stop offset="0%" stop-color="#7C6AFF" />
                                                <stop offset="100%" stop-color="#A78BFA" />
                                            </linearGradient>
                                        </defs>
                                    </svg>
                                    <div class="donut-center">
                                        <span class="donut-pct">@pct.ToString("0")%</span>
                                        <span class="donut-label">Completed</span>
                                    </div>
                                </div>
                            </div>
                            <div class="progress-stats">
                                <div class="progress-stat-row">
                                    <span class="stat-label">Time Read</span>
                                    <span class="stat-val">@Model.CurrentlyReading.TotalMinutesRead min</span>
                                </div>
                                <div class="progress-stat-row">
                                    <span class="stat-label">Last Read</span>
                                    <span class="stat-val">@(Model.CurrentlyReading.LastReadDate?.ToString("MMM d, h:mm tt") ?? "—")</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </section>

        <!-- Completed Books -->
        <section class="page-section" id="section-completed-books">
            <div class="section-header">
                <h2>Completed Books</h2>
                <a href="@Url.Action("ViewAllReadingProgress", "Reader")" class="view-all">View all</a>
            </div>
            <div class="card">
                @if (!Model.CompletedBooks.Any())
                {
                    <p class="cr-empty">No completed books yet.</p>
                }
                else
                {
                    <div class="books-carousel">
                        @foreach (var book in Model.CompletedBooks)
                        {
                            <div class="completed-book-card">
                                @if (!string.IsNullOrEmpty(book.BookCoverUrl))
                                {
                                    <div class="completed-book-cover" style="background-image:url('@book.BookCoverUrl');background-size:cover;"></div>
                                }
                                else
                                {
                                    <div class="completed-book-cover"><span>@book.Title</span></div>
                                }
                                <div class="completed-book-title">@book.Title</div>
                                <div class="completed-book-author">@book.Author</div>
                                <div class="star-rating">@Html.Raw(StarDisplay(book.BookId.GetHashCode()))</div>
                                <div class="completed-badge"><i class="ti ti-circle-check-filled"></i> Completed</div>
                                <div class="completed-date"><i class="ti ti-calendar"></i> @(book.CompletedAt?.ToString("MMM d, yyyy") ?? "—")</div>
                            </div>
                        }
                    </div>
                }
            </div>
        </section>

        <!-- Reading History -->
        <section class="page-section" id="section-reading-history">
            <div class="section-header">
                <h2>Reading History</h2>
                <a href="@Url.Action("ViewAllReadingProgress", "Reader")" class="view-all">View all</a>
            </div>
            <div class="card">
                <table class="history-table">
                    <thead>
                        <tr>
                            <th>Book</th>
                            <th>Author</th>
                            <th>Last Read</th>
                            <th>Progress</th>
                            <th>Time Spent</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.ReadingHistory)
                        {
                            <tr>
                                <td>
                                    <div class="history-book-cell">
                                        <div class="history-book-thumb">@item.Title</div>
                                        <div>
                                            <div class="history-book-name">@item.Title</div>
                                            <div class="history-book-sub">@item.Author</div>
                                        </div>
                                    </div>
                                </td>
                                <td>@item.Author</td>
                                <td>@(item.LastReadDate?.ToString("MMM d") ?? "—")<br />@(item.LastReadDate?.ToString("h:mm tt") ?? "")</td>
                                <td>
                                    <div class="history-progress-bar">
                                        <div class="history-bar-track"><div class="history-bar-fill @(item.ProgressPercentage >= 100 ? "complete" : "")" style="width:@item.ProgressPercentage.ToString("0")%"></div></div>
                                        <span>@item.ProgressPercentage.ToString("0")%</span>
                                    </div>
                                </td>
                                <td>@item.TotalMinutesRead min</td>
                                <td><button class="dots-btn"><i class="ti ti-dots-vertical"></i></button></td>
                            </tr>
                        }
                    </tbody>
                </table>
                <a href="@Url.Action("ViewAllReadingProgress", "Reader")" class="view-history-btn">View full reading history</a>
            </div>
        </section>

        <!-- Reading Progress -->
        <section class="page-section" id="section-reading-progress">
            <div class="section-header">
                <h2>Reading Progress</h2>
            </div>
            <div class="progress-stats-grid">
                <div class="progress-stat-card">
                    <div class="stat-icon-label"><i class="ti ti-books"></i> Books Read</div>
                    <div class="big-number purple">@Model.ProgressStats.BooksRead</div>
                    <div class="stat-sub">of @Model.GoalTargetBooks books</div>
                    <div class="mini-bar-track"><div class="mini-bar-fill" style="width:@(Model.GoalTargetBooks == 0 ? 0 : Math.Round((double)Model.ProgressStats.BooksRead / Model.GoalTargetBooks * 100))%"></div></div>
                </div>
                <div class="progress-stat-card">
                    <div class="stat-icon-label"><i class="ti ti-clock"></i> Minutes Read</div>
                    <div class="big-number">@Model.ProgressStats.MinutesRead</div>
                    <div class="stat-sub">total minutes</div>
                </div>
            </div>

            <div class="journey-card">
                <div class="journey-header">
                    <div>
                        <h3>Your Reading Journey</h3>
                        <div class="journey-sub">Minutes Read</div>
                    </div>
                    <div class="period-select">Last 30 days <i class="ti ti-chevron-down"></i></div>
                </div>
                <div class="chart-wrap">
                    @{
                        var maxMinutes = Model.JourneyChart.Any() ? Model.JourneyChart.Max(x => x.MinutesRead) : 1;
                        if (maxMinutes == 0) { maxMinutes = 1; }
                    }
                    @foreach (var point in Model.JourneyChart)
                    {
                        var heightPct = (int)Math.Round((double)point.MinutesRead / maxMinutes * 100);
                        <div class="bar-group" title="@point.Date.ToString("MMM d"): @point.MinutesRead min">
                            <div class="bar" style="height:@heightPct%"></div>
                        </div>
                    }
                </div>
            </div>
        </section>

    </div>

    <!-- RIGHT SIDEBAR -->
    <div class="reading-sidebar">

        <div class="streak-card">
            <div class="streak-title">Reading Streak</div>
            <div class="streak-count">
                <span class="streak-fire">🔥</span>
                <div>
                    <div class="streak-number">@Model.Streak.CurrentStreakDays</div>
                    <div class="streak-days">days in a row</div>
                </div>
            </div>
            <div class="streak-calendar">
                <div class="cal-days-header">
                    <span>M</span><span>T</span><span>W</span><span>T</span><span>F</span><span>S</span><span>S</span>
                </div>
                <div class="cal-days">
                    @foreach (var active in Model.Streak.LastSevenDays)
                    {
                        <div class="cal-day @(active ? "done" : "empty")">
                            @if (active)
                            {
                                <i class="ti ti-check"></i>
                            }
                        </div>
                    }
                </div>
            </div>
            <div class="streak-motto">Keep it up! 🔥</div>
        </div>

        <div class="this-month-card">
            <div class="this-month-header">
                <h3>This Month</h3>
            </div>
            <div class="month-stats">
                <div class="month-stat-row">
                    <div class="month-stat-label"><i class="ti ti-books"></i> Books Read</div>
                    <div class="month-stat-val">@Model.MonthlyStats.BooksRead</div>
                </div>
                <div class="month-stat-row">
                    <div class="month-stat-label"><i class="ti ti-clock"></i> Minutes Read</div>
                    <div class="month-stat-val">@Model.MonthlyStats.MinutesRead</div>
                </div>
            </div>
        </div>

        <div class="goal-card">
            <div class="goal-header">
                <h3>Reading Goal</h3>
                <a href="@Url.Action("ReaderDashBoard", "Reader")" class="edit-goal">Edit Goal</a>
            </div>
            <div class="on-track">@(Model.GoalIsOnTrack ? "You're on track!" : "Keep going!")</div>
            <div class="goal-count">@Model.GoalBooksCompleted of @Model.GoalTargetBooks books</div>
            <div class="goal-bar-track">
                <div class="goal-bar-fill" style="width:@Model.GoalPercentComplete.ToString("0")%"></div>
            </div>
            <div class="goal-pct">@Model.GoalPercentComplete.ToString("0")%</div>
            <div class="goal-message">Great progress! Keep reading 🚀</div>
        </div>

        <div class="genres-card">
            <div class="genres-title">Top Genres</div>
            @if (!Model.TopGenres.Any())
            {
                <p class="cr-empty">No genre data yet.</p>
            }
            else
            {
                
                    var totalGenreMinutes = Model.TopGenres.Sum(g => g.MinutesRead);
                    string[] genreColors = { "#7C6AFF", "#22C55E", "#F59E0B", "#3B82F6", "#EC4899" };

                <div class="genre-list">
                    @for (int i = 0; i < Model.TopGenres.Count; i++)
                    {
                        var g = Model.TopGenres[i];
                        var pct = totalGenreMinutes == 0 ? 0 : Math.Round((double)g.MinutesRead / totalGenreMinutes * 100);
                        <div class="genre-row">
                            <div class="genre-dot" style="background:@genreColors[i % genreColors.Length]"></div>
                            <span class="genre-name">@g.Genre</span>
                            <span class="genre-pct">@pct%</span>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="quote-card">
            <span class="quote-icon">❝</span>
            <div class="quote-text">"The more you read, the more things you will know. The more that you learn, the more places you'll go."</div>
            <div class="quote-author">— Dr. Seuss</div>
        </div>

    </div>
</div>

<!-- keep your existing scrollspy <script> block unchanged at the bottom -->