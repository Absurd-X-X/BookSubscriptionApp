        <!-- Reading Progress -->
        <section class="page-section" id="section-reading-progress">
            <div class="section-header">
                <h2>Reading Progress</h2>
                <a href="#" class="view-all">View all</a>
            </div>

            <div class="progress-stats-grid">
                <div class="progress-stat-card">
                    <div class="stat-icon-label"><i class="ti ti-books"></i> Books Read</div>
                    <div class="big-number purple">24</div>
                    <div class="stat-sub">of 50 books</div>
                    <div class="mini-bar-track"><div class="mini-bar-fill" style="width:48%"></div></div>
                </div>
                <div class="progress-stat-card">
                    <div class="stat-icon-label"><i class="ti ti-file-text"></i> Pages Read</div>
                    <div class="big-number">3,240</div>
                    <div class="stat-sub">of 6,500 pages</div>
                    <div class="mini-bar-track"><div class="mini-bar-fill" style="width:50%"></div></div>
                </div>
                <div class="progress-stat-card">
