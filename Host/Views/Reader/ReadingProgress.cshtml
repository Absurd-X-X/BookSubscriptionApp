                                        <div class="history-book-sub">Rick Rubin</div>
                                    </div>
                                </div>
                            </td>
                            <td>Rick Rubin</td>
                            <td>Yesterday<br>9:15 PM</td>
                            <td>
                                <div class="history-progress-bar">
                                    <div class="history-bar-track"><div class="history-bar-fill" style="width:34%"></div></div>
                                    <span>34%</span>
                                </div>
                            </td>
                            <td>1h 08m</td>
                            <td><button class="dots-btn"><i class="ti ti-dots-vertical"></i></button></td>
                        </tr>
                        <tr>
                            <td>
                                <div class="history-book-cell">
                                    <div class="history-book-thumb" style="background:linear-gradient(135deg,#1a5276,#0d2137)">Let<br>Them<br>Theory</div>
                                    <div>
                                        <div class="history-book-name">The Let Them Theory</div>
                                        <div class="history-book-sub">Mel Robbins</div>
                                    </div>
                                </div>
