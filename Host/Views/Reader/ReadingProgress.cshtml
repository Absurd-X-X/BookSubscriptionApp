                            <i class="ti ti-star-filled"></i><i class="ti ti-star-filled"></i>
                            <i class="ti ti-star-half-filled"></i>
                            <span>4.3</span>
                        </div>
                        <div class="completed-badge"><i class="ti ti-circle-check-filled"></i> Completed</div>
                        <div class="completed-date"><i class="ti ti-calendar"></i> Apr 18, 2024</div>
                    </div>

                    <!-- Book 5 -->
                    <div class="completed-book-card">
                        <div class="completed-book-cover cover-5"><span>THE 5 AM CLUB</span></div>
                        <div class="completed-book-title">The 5 AM Club</div>
                        <div class="completed-book-author">Robin Sharma</div>
