                            <div class="bar-group"><div class="bar" style="height:65%"></div></div>
                            <div class="bar-group"><div class="bar" style="height:45%"></div></div>
                            <div class="bar-group"><div class="bar" style="height:80%"></div></div>
                            <div class="bar-group"><div class="bar" style="height:60%"></div></div>
                            <div class="bar-group"><div class="bar" style="height:70%"></div></div>
