@{
    Layout = "~/Views/Shared/_ReaderLayout.cshtml";
    ViewData["Title"] = "Reader Books";
    ViewData["ScrollPage"] = "books";
}
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@latest/dist/tabler-icons.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@fortawesome/fontawesome-free@6/css/all.min.css" />
<link href="~/css/readerBooks.css" rel="stylesheet" />

<!-- ── TOPBAR ── -->
<header class="topbar">
    <div class="greeting">
        <h1>Explore Books</h1>
        <p>Discover new arrivals, top picks, and everything in your library.</p>
    </div>
    <div class="topbar-right">
        <div class="search-box">
            <input type="text" placeholder="Search books, authors..." id="searchInput">
            <i class="fa-solid fa-magnifying-glass"></i>
            <div class="search-results" id="searchResults"></div>
        </div>
        <div class="dropdown-wrap">
            <button class="icon-btn bell-btn" id="bellBtn">
                <i class="fa-regular fa-bell"></i>
                <span class="bell-badge">8</span>
            </button>
            <div class="dropdown-panel notif-panel" id="notifPanel">
                <div class="dropdown-header">Notifications</div>
                <div class="notif-item">
                    <div class="notif-icon blue"><i class="fa-solid fa-book-open"></i></div>
                    <div class="notif-body">
                        <p><b>Deep Work</b> marked as completed</p>
                        <span>2 hours ago</span>
                    </div>
                </div>
                <div class="notif-item">
                    <div class="notif-icon purple"><i class="fa-solid fa-calendar"></i></div>
                    <div class="notif-body">
                        <p>Book Club Discussion starts soon</p>
                        <span>5 hours ago</span>
                    </div>
                </div>
                <div class="notif-item">
                    <div class="notif-icon orange"><i class="fa-solid fa-fire"></i></div>
                    <div class="notif-body">
                        <p>You're on a 12-day reading streak!</p>
                        <span>1 day ago</span>
                    </div>
                </div>
                <a class="dropdown-footer" href="#">View all notifications</a>
            </div>
        </div>
        <div class="dropdown-wrap">
            <button class="profile-chip" id="profileBtn">
                <img src="https://i.pravatar.cc/64?img=12" alt="John Doe">
                <i class="fa-solid fa-chevron-down"></i>
            </button>
            <div class="dropdown-panel profile-panel" id="profilePanel">
                <div class="dropdown-profile-head">
                    <img src="https://i.pravatar.cc/64?img=12" alt="John Doe">
                    <div>
                        <div class="dp-name">John Doe</div>
                        <div class="dp-email">john.doe@email.com</div>
                    </div>
                </div>
                <a class="dropdown-link" href="#"><i class="fa-regular fa-user"></i> Profile</a>
                <a class="dropdown-link" href="#"><i class="fa-solid fa-gear"></i> Settings</a>
                <a class="dropdown-link" href="#"><i class="fa-regular fa-credit-card"></i> Subscription</a>
                <div class="dropdown-divider"></div>
                <a class="dropdown-link danger" href="#">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i>
                    Logout
                </a>
            </div>
        </div>
    </div>
</header>


<!-- ── HERO / EDITOR'S PICK ── -->
<div class="page-section" id="section-hero">
    <div class="hero-card">

        <!-- Left: text + buttons -->
        <div class="hero-left">
            <div class="hero-eyebrow">
                <i class="ti ti-award"></i> Editor's Pick
            </div>
            <div class="hero-title">Atomic Habits</div>
            <div class="hero-author">James Clear</div>
            <div class="hero-stars">
                <span class="stars">★★★★★</span>
                <span class="rating">4.8</span>
                <span class="count">(12.4K reviews)</span>
            </div>
            <div class="hero-desc">
                An Easy &amp; Proven Way to Build Good Habits &amp; Break Bad Ones.
            </div>
            <div class="hero-actions">
                <a href="#" class="btn-read-now">Read Now</a>
                <a href="#" class="btn-add-to-list">+ Add to List</a>
            </div>
        </div>

        <!-- Right: book cover + quote -->
        <div class="hero-right">
            <div class="hero-cover">
                <!-- Replace with: <img src="/lib/images/atomic-habits.jpg" alt="Atomic Habits" /> -->
                <div class="hero-cover-placeholder">
                    <i class="ti ti-book-2"></i>
                </div>
            </div>
            <div class="camp">
                <div class="hero-quote-block">
                    <div class="hero-quote-icon">"</div>
                    <div class="hero-quote-text">
                        You do not rise to the level of your goals. You fall to the level of your systems.
                    </div>
                    <div class="hero-quote-cite">— James Clear</div>
                </div>

                <!-- Carousel dots -->
                <div class="hero-dots">
                    <div class="hero-dot"></div>
                    <div class="hero-dot"></div>
                    <div class="hero-dot"></div>
                    <div class="hero-dot active"></div>
                </div>
            </div>
        </div>

    </div>

</div>


