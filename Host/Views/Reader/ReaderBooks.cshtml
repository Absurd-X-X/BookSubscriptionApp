@model Application.Features.ReaderBooks.Queries.GetReaderBooksPage.ReaderBooksPageVm

@{
    Layout = "~/Views/Shared/_ReaderLayout.cshtml";
    ViewData["Title"] = "Reader Books";
    ViewData["ScrollPage"] = "books";
}

@functions {
    string RenderStars(double rating)
    {
        var full = (int)Math.Floor(rating);
        var hasHalf = (rating - full) >= 0.25 && (rating - full) < 0.75;
        var hasExtraFull = (rating - full) >= 0.75;
        if (hasExtraFull) full++;

        var stars = new string('★', full);
        if (hasHalf) stars += "½";
        return stars;
    }

    string GetCategoryIcon(string name) => name?.ToLower() switch
    {
        var n when n != null && n.Contains("personal") => "ti ti-trending-up",
        var n when n != null && n.Contains("product") => "ti ti-target",
        var n when n != null && n.Contains("mind") => "ti ti-brain",
        var n when n != null && n.Contains("lead") => "ti ti-users",
        var n when n != null && n.Contains("financ") => "ti ti-coins",
        var n when n != null && n.Contains("health") => "ti ti-heartbeat",
        var n when n != null && n.Contains("psych") => "ti ti-puzzle",
        _ => "ti ti-books"
    };
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@latest/dist/tabler-icons.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@fortawesome/fontawesome-free@6/css/all.min.css" />
<link href="~/css/readerBooks.css" rel="stylesheet" />

<!-- ── TOPBAR ── -->
<header class="topbar">
    <div class="greeting">
        <h1>Explore Books</h1>
        <p>Discover new arrivals, top picks, and everything in your library.</p>
    </div>
    <div class="topbar-right">
        <div class="search-box">
            <input type="text" placeholder="Search books, authors..." id="searchInput">
            <i class="fa-solid fa-magnifying-glass"></i>
            <div class="search-results" id="searchResults"></div>
        </div>
        <div class="dropdown-wrap">
            <button class="icon-btn bell-btn" id="bellBtn">
                <i class="fa-regular fa-bell"></i>
                <span class="bell-badge">8</span>
            </button>
            <div class="dropdown-panel notif-panel" id="notifPanel">
                <div class="dropdown-header">Notifications</div>
                <a class="dropdown-footer" href="#">View all notifications</a>
            </div>
        </div>
        <div class="dropdown-wrap">
            <button class="profile-chip" id="profileBtn">
                <img src="https://i.pravatar.cc/64?img=12" alt="Profile">
                <i class="fa-solid fa-chevron-down"></i>
            </button>
            <div class="dropdown-panel profile-panel" id="profilePanel">
                <a class="dropdown-link" href="#"><i class="fa-regular fa-user"></i> Profile</a>
                <a class="dropdown-link" href="#"><i class="fa-solid fa-gear"></i> Settings</a>
                <a class="dropdown-link" href="#"><i class="fa-regular fa-credit-card"></i> Subscription</a>
                <div class="dropdown-divider"></div>
                <a class="dropdown-link danger" href="#">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i> Logout
                </a>
            </div>
        </div>
    </div>
</header>

<!-- ── HERO / EDITOR'S PICK ── -->
@if (Model.HeroBook != null)
{
    var hero = Model.HeroBook;
    <div class="page-section" id="section-hero">
        <div class="hero-card">
            <div class="hero-left">
                <div class="hero-eyebrow"><i class="ti ti-award"></i> Editor's Pick</div>
                <div class="hero-title">@hero.Title</div>
                <div class="hero-author">@hero.Author</div>
                <div class="hero-stars">
                    <span class="stars">@RenderStars(hero.AverageRating)</span>
                    <span class="rating">@hero.AverageRating.ToString("0.0")</span>
                    <span class="count">(@hero.ReviewCount reviews)</span>
                </div>
                <div class="hero-desc">
                    @(hero.About?.Length > 160 ? hero.About.Substring(0, 160) + "…" : hero.About)
                </div>
                <div class="hero-actions">
                    <a href="/Reader/BookDetails/@hero.Id" class="btn-read-now">Read Now</a>
                    <a href="#" class="btn-add-to-list" data-book-id="@hero.Id">+ Add to List</a>
                </div>
            </div>
            <div class="hero-right">
                <div class="hero-cover">
                    @if (!string.IsNullOrWhiteSpace(hero.CoverImageUrl))
                    {
                        <img src="@hero.CoverImageUrl" alt="@hero.Title" />
                    }
                    else
                    {
                        <div class="hero-cover-placeholder"><i class="ti ti-book-2"></i></div>
                    }
                </div>
            </div>
        </div>
    </div>
}

<!-- ── CATEGORIES ── -->
<div class="page-section" id="section-categories">
    <div class="lib-section-header">
        <span class="lib-section-title">Categories</span>
        <a href="/Reader/Categories" class="lib-view-all">View all</a>
    </div>
    <div class="categories-row">
        @foreach (var cat in Model.Categories)
        {
            <a href="/Reader/Books?categoryId=@cat.Id" class="cat-pill">
                <div class="cat-pill-icon"><i class="@GetCategoryIcon(cat.Name)"></i></div>
                <span class="cat-pill-name">@cat.Name</span>
                <span class="cat-pill-count">@cat.BookCount books</span>
            </a>
        }
    </div>
</div>

<!-- ── NEW ARRIVALS ── -->
<div class="page-section" id="section-new-arrivals">
    <div class="lib-section-header">
        <span class="lib-section-title">New Arrivals</span>
        <a href="#" class="lib-view-all">View all</a>
    </div>
    <div class="row-wrapper">
        <div class="books-scroll-row" id="newArrivalsRow">
            @foreach (var book in Model.NewArrivals)
            {
                <div class="book-card" data-book-id="@book.Id">
                    <div class="book-cover">
                        @if (!string.IsNullOrWhiteSpace(book.CoverImageUrl))
                        {
                            <img src="@book.CoverImageUrl" alt="@book.Title" />
                        }
                        else
                        {
                            <div class="book-cover-ph"><i class="ti ti-book"></i></div>
                        }
                        @if (book.IsNew)
                        {
                            <span class="badge-new">New</span>
                        }
                        <button class="btn-bookmark @(book.IsInReadingList ? "active" : "")"
                                data-book-id="@book.Id" title="Save for later">
                            <i class="ti ti-bookmark"></i>
                        </button>
                    </div>
                    <div class="book-title">@book.Title</div>
                    <div class="book-author">@book.Author</div>
                    <div class="book-stars">
                        <span class="stars">@RenderStars(book.AverageRating)</span>
                        <span class="val">@book.AverageRating.ToString("0.0")</span>
                    </div>
                    <button class="btn-card-add @(book.IsFavorite ? "active" : "")" data-book-id="@book.Id">
                        <i class="ti ti-plus"></i> @(book.IsFavorite ? "In Favorites" : "Add to List")
                    </button>
                </div>
            }
        </div>
        <button class="scroll-arrow right" onclick="scrollRow('newArrivalsRow',1)">
            <i class="ti ti-chevron-right"></i>
        </button>
    </div>
</div>

<!-- ── RECOMMENDED FOR YOU ── -->
