<script>
    function scrollRow(rowId, dir) {
        var row = document.getElementById(rowId);
        if (row) row.scrollBy({ left: dir * 520, behavior: 'smooth' });
    }
    document.querySelectorAll('.hero-dot').forEach(function (dot, i, dots) {
        dot.addEventListener('click', function () {
            dots.forEach(function (d) { d.classList.remove('active'); });
            dot.classList.add('active');
        });
    });

    /* ── Topbar: dropdowns (bell + profile) ── */
    document.addEventListener('DOMContentLoaded', function () {
        const bellBtn = document.getElementById('bellBtn');
        const notifPanel = document.getElementById('notifPanel');
        const profileBtn = document.getElementById('profileBtn');
        const profilePanel = document.getElementById('profilePanel');

        function closeAllDropdowns(except) {
            [notifPanel, profilePanel].forEach(panel => {
                if (panel && panel !== except) panel.classList.remove('open');
            });
        }

        function toggleDropdown(btn, panel) {
            if (!btn || !panel) return;
            btn.addEventListener('click', (e) => {
                e.stopPropagation();
                const isOpen = panel.classList.contains('open');
                closeAllDropdowns();
                panel.classList.toggle('open', !isOpen);
            });
        }

        toggleDropdown(bellBtn, notifPanel);
        toggleDropdown(profileBtn, profilePanel);

        document.addEventListener('click', () => closeAllDropdowns());

        [notifPanel, profilePanel].forEach(panel => {
            if (panel) panel.addEventListener('click', (e) => e.stopPropagation());
        });

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeAllDropdowns();
        });

        /* ── Topbar search: indexes this page's actual book cards ── */
        const searchInput = document.getElementById('searchInput');
        const searchResults = document.getElementById('searchResults');

        function buildSearchIndex() {
            const items = [];
            document.querySelectorAll('.book-card').forEach(function (card) {
                var titleEl = card.querySelector('.book-title');
                var authorEl = card.querySelector('.book-author');
                var sectionEl = card.closest('.page-section');
                var sectionTitleEl = sectionEl ? sectionEl.querySelector('.lib-section-title') : null;
                var title = titleEl ? titleEl.textContent.trim() : '';
                var author = authorEl ? authorEl.textContent.trim() : '';
                var section = sectionTitleEl ? sectionTitleEl.textContent.trim() : 'Library';
                if (title) items.push({ title: title, author: author, section: section, card: card });
            });
            return items;
        }

        const searchIndex = buildSearchIndex();

        function renderResults(query) {
            if (!query) {
                searchResults.classList.remove('open');
                searchResults.innerHTML = '';
                return;
            }
            const q = query.toLowerCase();
            const matches = searchIndex.filter(item =>
                item.title.toLowerCase().includes(q) ||
                (item.author && item.author.toLowerCase().includes(q))
            );

            if (matches.length === 0) {
                searchResults.innerHTML = '<div class="search-empty">No books match your search.</div>';
            } else {
                searchResults.innerHTML = matches.map((m, idx) => `
        <div class="search-result-item" data-idx="${idx}">
          <div class="sr-title">${m.title}</div>
          <div class="sr-meta"><span>${m.author || ''}</span><span class="sr-section">${m.section}</span></div>
        </div>
      `).join('');

                Array.from(searchResults.querySelectorAll('.search-result-item')).forEach(function (el, idx) {
                    el.addEventListener('click', function () {
                        const match = matches[idx];
                        if (match && match.card) {
                            match.card.scrollIntoView({ behavior: 'smooth', block: 'center', inline: 'center' });
                            match.card.style.outline = '2px solid #1EA7C4';
                            setTimeout(function () { match.card.style.outline = ''; }, 1200);
                        }
                        searchInput.value = match ? match.title : '';
                        searchResults.classList.remove('open');
                    });
                });
            }
            searchResults.classList.add('open');
        }

        if (searchInput && searchResults) {
            searchInput.addEventListener('input', function (e) {
                renderResults(e.target.value.trim());
            });
            searchInput.addEventListener('focus', function (e) {
                var v = e.target.value.trim();
                if (v) renderResults(v);
            });
            searchInput.addEventListener('click', function (e) {
                e.stopPropagation();
            });
            searchResults.addEventListener('click', function (e) {
                e.stopPropagation();
            });

            document.addEventListener('click', function () {
                searchResults.classList.remove('open');
            });

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') {
                    searchResults.classList.remove('open');
                    searchInput.blur();
                }
            });
        }
    });

    // ── Scrollspy for this page ──
    document.addEventListener('DOMContentLoaded', function () {

        const sections = document.querySelectorAll('.page-section');
        if (sections.length === 0) return;

        const currentPage = 'books';
        const pageHashLinks = document.querySelectorAll('.nav-item[data-hash][data-page="' + currentPage + '"]');
        const sectionList = Array.from(sections);

        function setActiveByHash(hash) {
            pageHashLinks.forEach(function (link) {
                link.classList.remove('active');
            });
            if (hash) {
                var matched = document.querySelector('.nav-item[data-hash="' + hash + '"][data-page="' + currentPage + '"]');
                if (matched) matched.classList.add('active');
            } else {
                if (pageHashLinks[0]) pageHashLinks[0].classList.add('active');
            }
        }

        // ── Scroll listener on .main — works for short and tall sections ──
        function getActiveSection() {
            var scrollContainer = document.querySelector('.main');
            var scrollTop = scrollContainer ? scrollContainer.scrollTop : window.pageYOffset;
            var triggerPoint = scrollTop + window.innerHeight * 0.35;

            var active = sectionList[0];
            for (var i = 0; i < sectionList.length; i++) {
                if (sectionList[i].offsetTop <= triggerPoint) {
                    active = sectionList[i];
                }
            }
            return active;
        }

        function onScroll() {
            var active = getActiveSection();
            var hash = '#' + active.id;
            if (window.location.hash !== hash) {
                history.replaceState(null, null, hash);
                setActiveByHash(hash);
            }
        }

        var scrollContainer = document.querySelector('.main');
        if (scrollContainer) {
            scrollContainer.addEventListener('scroll', onScroll, { passive: true });
        } else {
            window.addEventListener('scroll', onScroll, { passive: true });
        }

        // Set active on page load
        onScroll();

        // Update on nav link click
        window.addEventListener('hashchange', function () {
            setActiveByHash(window.location.hash);
        });

    });
</script>

