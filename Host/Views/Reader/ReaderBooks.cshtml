                    </div>
                    <button class="btn-card-add @(book.IsFavorite ? "active" : "")" data-book-id="@book.Id">
                        <i class="ti ti-plus"></i> @(book.IsFavorite ? "In Favorites" : "Add to List")
                    </button>
                </div>
