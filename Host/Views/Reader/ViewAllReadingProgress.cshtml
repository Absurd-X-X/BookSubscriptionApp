<script>
    (function () {
      function toast(msg, type = 'info', icon = '✓') {
        const wrap = document.querySelector('.toast-wrap') || (() => {
          const w = document.createElement('div');
          w.className = 'toast-wrap';
          document.body.appendChild(w);
          return w;
        })();
        const t = document.createElement('div');
        t.className = 'toast';
        t.innerHTML = `<div class="toast-ic ${type}">${icon}</div><span class="toast-msg">${msg}</span>`;
        wrap.appendChild(t);
        setTimeout(() => t.remove(), 3100);
      }

      function closeAllDropdowns(except) {
        document.querySelectorAll('.dropdown-menu.open').forEach(m => {
          if (m !== except) m.classList.remove('open');
        });
      }

      /* ─────────────────────────────────────────────
         Sort dropdown
      ───────────────────────────────────────────── */
      const sortOptions = [
        { label: 'Last Opened',   value: 'last-opened' },
        { label: 'Title A – Z',   value: 'title-asc' },
        { label: 'Title Z – A',   value: 'title-desc' },
        { label: 'Progress ↑',    value: 'progress-asc' },
        { label: 'Progress ↓',    value: 'progress-desc' },
        { label: 'Date Added',    value: 'date-added' },
      ];

      const sortBtn = document.querySelector('.topbar-btn:nth-of-type(1)');
      let currentSort = 'last-opened';

      // Wrap sort button in a relative container
      const sortWrap = document.createElement('div');
      sortWrap.className = 'dropdown-wrap';
      sortBtn.parentNode.insertBefore(sortWrap, sortBtn);
      sortWrap.appendChild(sortBtn);

      const sortMenu = document.createElement('div');
      sortMenu.className = 'dropdown-menu';
      sortMenu.innerHTML = `<div class="dropdown-label">Sort by</div>` +
        sortOptions.map(o => `
          <div class="dropdown-item${o.value === currentSort ? ' active' : ''}" data-val="${o.value}">
            ${o.label}
            <svg class="di-check" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
          </div>`).join('');
      sortWrap.appendChild(sortMenu);

      sortBtn.addEventListener('click', e => {
        e.stopPropagation();
        closeAllDropdowns(sortMenu);
        sortMenu.classList.toggle('open');
        sortBtn.classList.toggle('btn-active', sortMenu.classList.contains('open'));
      });

      sortMenu.querySelectorAll('.dropdown-item').forEach(item => {
        item.addEventListener('click', () => {
          currentSort = item.dataset.val;
          sortMenu.querySelectorAll('.dropdown-item').forEach(i => i.classList.remove('active'));
          item.classList.add('active');
          sortBtn.childNodes[2].textContent = ' ' + item.textContent.trim().replace(/\n/g,'').replace(/\s+/g,' ').split('✓')[0].trim();
          // Update label text node (the text between the two SVGs)
          const labelNode = [...sortBtn.childNodes].find(n => n.nodeType === 3 && n.textContent.trim());
          if (labelNode) labelNode.textContent = ' Sort by: ' + item.textContent.trim().split('\n')[0].trim() + ' ';
          sortMenu.classList.remove('open');
          sortBtn.classList.remove('btn-active');
          sortBooks(currentSort);
          toast(`Sorted by <strong>${item.textContent.trim().split('\n')[0].trim()}</strong>`, 'info', '↕');
        });
      });

      function sortBooks(mode) {
        const list = document.querySelector('.book-list');
        const cards = [...list.querySelectorAll('.book-card')];
        cards.sort((a, b) => {
          const titleA = a.querySelector('.bc-title').textContent;
          const titleB = b.querySelector('.bc-title').textContent;
          const pctA   = parseInt(a.querySelector('.prog-pct').textContent);
          const pctB   = parseInt(b.querySelector('.prog-pct').textContent);
          if (mode === 'title-asc')      return titleA.localeCompare(titleB);
          if (mode === 'title-desc')     return titleB.localeCompare(titleA);
          if (mode === 'progress-asc')   return pctA - pctB;
          if (mode === 'progress-desc')  return pctB - pctA;
          return 0; // keep order for last-opened / date-added
        });
        cards.forEach(c => list.appendChild(c));
      }

      /* ─────────────────────────────────────────────
         Filter dropdown
      ───────────────────────────────────────────── */
      const filterOptions = [
        { label: 'All Books',       value: 'all',       icon: '📚' },
        { label: 'Under 50%',       value: 'under50',   icon: '🔵' },
        { label: 'Over 50%',        value: 'over50',    icon: '🟣' },
        { label: 'Almost done',     value: 'over75',    icon: '🏁' },
        { label: 'Started recently',value: 'recent',    icon: '🆕' },
      ];

      const filterBtn = document.querySelector('.topbar-btn:nth-of-type(2)');
      let activeFilter = 'all';

      const filterWrap = document.createElement('div');
      filterWrap.className = 'dropdown-wrap';
      filterBtn.parentNode.insertBefore(filterWrap, filterBtn);
      filterWrap.appendChild(filterBtn);

      const filterMenu = document.createElement('div');
      filterMenu.className = 'dropdown-menu';
      filterMenu.style.left = 'auto';
      filterMenu.innerHTML = `<div class="dropdown-label">Filter books</div>` +
        filterOptions.map(o => `
          <div class="dropdown-item${o.value === activeFilter ? ' active' : ''}" data-val="${o.value}">
            <span>${o.icon}</span> ${o.label}
            <svg class="di-check" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
          </div>`).join('');
      filterWrap.appendChild(filterMenu);

      // Chip row (appears below topbar in content area)
      const chipRow = document.createElement('div');
      chipRow.className = 'filter-chips';
      const crHeader = document.querySelector('.cr-header');
      crHeader.parentNode.insertBefore(chipRow, crHeader.nextSibling);

      filterBtn.addEventListener('click', e => {
        e.stopPropagation();
        closeAllDropdowns(filterMenu);
        filterMenu.classList.toggle('open');
        filterBtn.classList.toggle('btn-active', filterMenu.classList.contains('open'));
      });

      filterMenu.querySelectorAll('.dropdown-item').forEach(item => {
        item.addEventListener('click', () => {
          activeFilter = item.dataset.val;
          filterMenu.querySelectorAll('.dropdown-item').forEach(i => i.classList.remove('active'));
          item.classList.add('active');
          filterMenu.classList.remove('open');
          filterBtn.classList.remove('btn-active');
          applyFilter(activeFilter);

          // chips
          chipRow.innerHTML = '';
          if (activeFilter !== 'all') {
            const label = item.textContent.trim().split('\n')[0].trim().replace(/\s+/g,' ');
            chipRow.innerHTML = `
              <div class="chip" data-filter="${activeFilter}">
                ${label}
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              </div>
              <div class="chip chip-clear" id="clear-filter">Clear all</div>`;
            chipRow.classList.add('visible');
            chipRow.querySelector('.chip').addEventListener('click', clearFilter);
            chipRow.querySelector('#clear-filter').addEventListener('click', clearFilter);
          } else {
            chipRow.classList.remove('visible');
          }
          filterBtn.classList.toggle('btn-active', activeFilter !== 'all');
        });
      });

      function clearFilter() {
        activeFilter = 'all';
        filterMenu.querySelectorAll('.dropdown-item').forEach(i => {
          i.classList.toggle('active', i.dataset.val === 'all');
        });
        chipRow.classList.remove('visible');
        filterBtn.classList.remove('btn-active');
        applyFilter('all');
      }

      function applyFilter(mode) {
        document.querySelectorAll('.book-card').forEach(card => {
          const pct = parseInt(card.querySelector('.prog-pct').textContent);
          let show = true;
          if (mode === 'under50')  show = pct < 50;
          if (mode === 'over50')   show = pct >= 50;
          if (mode === 'over75')   show = pct >= 75;
          if (mode === 'recent')   show = card.querySelector('.meta-val').textContent.includes('May 14') ||
                                          card.querySelector('.meta-val').textContent.includes('Today') ||
                                          card.querySelector('.meta-val').textContent.includes('Yesterday');
          card.style.display = show ? '' : 'none';
        });
        updateShowing();
      }

      /* ─────────────────────────────────────────────
         Live search
      ───────────────────────────────────────────── */
      const searchInput = document.querySelector('.search-wrap input');
      searchInput.addEventListener('input', () => {
        const q = searchInput.value.toLowerCase().trim();
        document.querySelectorAll('.book-card').forEach(card => {
          const text = (card.querySelector('.bc-title').textContent +
                        card.querySelector('.bc-author').textContent).toLowerCase();
          card.style.display = (!q || text.includes(q)) ? '' : 'none';
        });
        updateShowing();
      });

      /* ─────────────────────────────────────────────
         Remove book — confirm modal
      ───────────────────────────────────────────── */
      const modal = document.createElement('div');
      modal.className = 'modal-overlay';
      modal.innerHTML = `
        <div class="modal-box">
          <div class="modal-icon">
            <svg width="24" height="24" fill="none" stroke="#ef4444" stroke-width="2" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
          </div>
          <div class="modal-title">Remove book?</div>
          <div class="modal-body">Are you sure you want to remove <strong id="modal-book-name"></strong> from your reading list? Your progress will be lost.</div>
          <div class="modal-actions">
            <button class="modal-cancel">Keep it</button>
            <button class="modal-confirm">Yes, remove</button>
          </div>
        </div>`;
      document.body.appendChild(modal);

      let pendingCard = null;

      modal.querySelector('.modal-cancel').addEventListener('click', () => {
        modal.classList.remove('open');
        pendingCard = null;
      });
      modal.addEventListener('click', e => {
        if (e.target === modal) { modal.classList.remove('open'); pendingCard = null; }
      });
      modal.querySelector('.modal-confirm').addEventListener('click', () => {
        if (!pendingCard) return;
        const title = pendingCard.querySelector('.bc-title').textContent;
        pendingCard.classList.add('removing');
        setTimeout(() => {
          pendingCard.remove();
          updateShowing();
        }, 320);
        modal.classList.remove('open');
        toast(`"${title}" removed from your list`, 'danger', '🗑');
        pendingCard = null;
      });

      document.querySelector('.book-list').addEventListener('click', e => {
        const removeBtn = e.target.closest('.btn-remove');
        if (!removeBtn) return;
        pendingCard = removeBtn.closest('.book-card');
        const title = pendingCard.querySelector('.bc-title').textContent;
        modal.querySelector('#modal-book-name').textContent = title;
        modal.classList.add('open');
      });

      /* ─────────────────────────────────────────────
         Continue Reading button
      ───────────────────────────────────────────── */
      document.querySelector('.book-list').addEventListener('click', e => {
        const btn = e.target.closest('.btn-continue');
        if (!btn) return;
        const title = btn.closest('.book-card').querySelector('.bc-title').textContent;
        toast(`Opening "${title}"…`, 'success', '▶');
      });

      /* ─────────────────────────────────────────────
         Notification panel
      ───────────────────────────────────────────── */
      const notifications = [
        { icon:'📖', bg:'rgba(124,92,252,.15)', title:'Reading goal reached!',  text:'You hit 2 hours today. Great job!',       time:'2 min ago',  unread:true  },
        { icon:'🔥', bg:'rgba(249,115,22,.15)', title:'12-day streak!',          text:'Keep it up — you\'re on fire.',            time:'1 hr ago',   unread:true  },
        { icon:'📚', bg:'rgba(52,211,153,.12)', title:'New recommendation',      text:'"The Power of Now" matches your taste.',  time:'3 hrs ago',  unread:true  },
        { icon:'✅', bg:'rgba(52,211,153,.12)', title:'Book completed',           text:'You finished "Can\'t Hurt Me".',          time:'Yesterday',  unread:false },
        { icon:'💡', bg:'rgba(99,179,237,.12)', title:'Reading tip',              text:'Try reading before bed for better recall.','time':'2 days ago',unread:false },
      ];

      const notifBtn  = document.querySelector('.notif-btn');
      const notifWrap = notifBtn.parentElement;
      notifWrap.style.position = 'relative';

      const notifPanel = document.createElement('div');
      notifPanel.className = 'notif-panel';
      notifPanel.innerHTML = `
        <div class="notif-panel-head">
          <span>Notifications</span>
          <span class="notif-mark-all">Mark all read</span>
        </div>
        <div class="notif-list">
          ${notifications.map(n => `
            <div class="notif-row${n.unread ? ' unread' : ''}">
              <div class="${n.unread ? 'notif-dot-unread' : 'notif-dot-read'}"></div>
              <div class="notif-icon" style="background:${n.bg}">${n.icon}</div>
              <div class="notif-body">
                <strong>${n.title}</strong>
                <p>${n.text}</p>
                <span class="notif-time">${n.time}</span>
              </div>
            </div>`).join('')}
        </div>`;
      notifWrap.appendChild(notifPanel);

      notifBtn.addEventListener('click', e => {
        e.stopPropagation();
        closeAllDropdowns();
        notifPanel.classList.toggle('open');
      });

      notifPanel.querySelector('.notif-mark-all').addEventListener('click', () => {
        notifPanel.querySelectorAll('.notif-row').forEach(r => r.classList.remove('unread'));
        notifPanel.querySelectorAll('.notif-dot-unread').forEach(d => d.className = 'notif-dot-read');
        const badge = document.querySelector('.notif-badge');
        if (badge) badge.style.display = 'none';
        toast('All notifications marked as read', 'success', '✓');
      });

      /* ─────────────────────────────────────────────
         Pagination
      ───────────────────────────────────────────── */
      const BOOKS_PER_PAGE = 5;
      // Full dataset (current visible cards are page 1)
      const allBooks = [...document.querySelectorAll('.book-card')].map(c => c.outerHTML);
      // Simulate 7 total books (2 more on page 2)
      const page2Extra = [
        `<div class="book-card">
          <div class="bc-cover"><div class="book-cover-fake" style="background:linear-gradient(160deg,#1a5c2a,#0d3a18);width:64px;height:92px;border-radius:7px;display:flex;flex-direction:column;align-items:center;justify-content:center;box-shadow:0 6px 20px rgba(0,0,0,.55);padding:6px;text-align:center;flex-shrink:0;">
            <div style="font-size:9px;font-weight:800;color:#fff;line-height:1.2;margin-bottom:4px;text-transform:uppercase;">THE LEAN<br>STARTUP</div>
            <div style="font-size:7px;color:rgba(255,255,255,.65);text-transform:uppercase;">Eric Ries</div>
          </div></div>
          <div class="bc-info">
            <div class="bc-title">The Lean Startup</div>
            <div class="bc-tagline">How Today's Entrepreneurs Use Continuous Innovation</div>
            <div class="bc-author">Eric Ries</div>
            <div class="progress-row"><div class="prog-bg"><div class="prog-fill" style="width:19%"></div></div><span class="prog-pct">19%</span></div>
            <div class="time-left"><svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>11h 30m left</div>
          </div>
          <div class="bc-meta">
            <div class="meta-row"><span class="meta-icon"><svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></span><div class="meta-text"><div class="meta-label">Last opened</div><div class="meta-val">May 10, 2024</div></div></div>
            <div class="meta-row"><span class="meta-icon"><svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg></span><div class="meta-text"><div class="meta-label">Started on</div><div class="meta-val">May 8, 2024</div></div></div>
          </div>
          <div class="bc-actions">
            <button class="btn-continue"><svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>Continue Reading</button>
            <button class="btn-remove"><svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>Remove</button>
          </div>
        </div>`,
        `<div class="book-card">
          <div class="bc-cover"><div class="book-cover-fake" style="background:linear-gradient(160deg,#5c1a1a,#3a0d0d);width:64px;height:92px;border-radius:7px;display:flex;flex-direction:column;align-items:center;justify-content:center;box-shadow:0 6px 20px rgba(0,0,0,.55);padding:6px;text-align:center;flex-shrink:0;">
            <div style="font-size:9px;font-weight:800;color:#fff;line-height:1.2;margin-bottom:4px;text-transform:uppercase;">MAN'S SEARCH<br>FOR MEANING</div>
            <div style="font-size:7px;color:rgba(255,255,255,.65);text-transform:uppercase;">Viktor Frankl</div>
          </div></div>
          <div class="bc-info">
            <div class="bc-title">Man's Search for Meaning</div>
            <div class="bc-tagline">A Psychiatrist's Experiences in the Concentration Camps</div>
            <div class="bc-author">Viktor E. Frankl</div>
            <div class="progress-row"><div class="prog-bg"><div class="prog-fill" style="width:73%"></div></div><span class="prog-pct">73%</span></div>
            <div class="time-left"><svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>1h 20m left</div>
          </div>
          <div class="bc-meta">
            <div class="meta-row"><span class="meta-icon"><svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></span><div class="meta-text"><div class="meta-label">Last opened</div><div class="meta-val">May 9, 2024, 11:00 PM</div></div></div>
            <div class="meta-row"><span class="meta-icon"><svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg></span><div class="meta-text"><div class="meta-label">Started on</div><div class="meta-val">Apr 15, 2024</div></div></div>
          </div>
          <div class="bc-actions">
            <button class="btn-continue"><svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>Continue Reading</button>
            <button class="btn-remove"><svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>Remove</button>
          </div>
        </div>`
      ];

      const pages = [allBooks, page2Extra, []]; // page 3 empty for demo
      let currentPage = 1;

      const pgBtns = document.querySelectorAll('.pg-btn');
      const prevBtn = pgBtns[0];
      const nextBtn = pgBtns[pgBtns.length - 1];
      const numBtns = [...pgBtns].slice(1, -1);

      function goToPage(n) {
        if (n < 1 || n > 2) return;
        currentPage = n;

        const list = document.querySelector('.book-list');
        list.style.opacity = '0';
        list.style.transform = 'translateY(8px)';
        list.style.transition = 'opacity .2s, transform .2s';

        setTimeout(() => {
          list.innerHTML = pages[n - 1].join('');
          list.style.opacity = '1';
          list.style.transform = 'translateY(0)';
          updateShowing();
        }, 200);

        numBtns.forEach((b, i) => b.classList.toggle('active', i + 1 === n));
        prevBtn.style.opacity = n === 1 ? '.4' : '1';
        prevBtn.style.pointerEvents = n === 1 ? 'none' : 'all';
        nextBtn.style.opacity = n === 2 ? '.4' : '1';
        nextBtn.style.pointerEvents = n === 2 ? 'none' : 'all';

        window.scrollTo({ top: 0, behavior: 'smooth' });
      }

      prevBtn.addEventListener('click', () => goToPage(currentPage - 1));
      nextBtn.addEventListener('click', () => goToPage(currentPage + 1));
      numBtns.forEach((b, i) => b.addEventListener('click', () => goToPage(i + 1)));
      goToPage(1); // init state

      /* ─────────────────────────────────────────────
         Showing X–Y of Z counter
      ───────────────────────────────────────────── */
      function updateShowing() {
        const visible = document.querySelectorAll('.book-card:not([style*="display: none"])').length;
        const total   = pages.flat().length;
        const start   = (currentPage - 1) * BOOKS_PER_PAGE + 1;
        const end     = Math.min(start + visible - 1, total);
        const el = document.querySelector('.pg-showing');
        if (el) el.textContent = visible
          ? `Showing ${start} to ${end} of ${total} books`
          : 'No books match your filter';
      }

      /* ─────────────────────────────────────────────
         Close dropdowns / panels on outside click
      ───────────────────────────────────────────── */
      document.addEventListener('click', e => {
        if (!e.target.closest('.dropdown-wrap')) {
          document.querySelectorAll('.dropdown-menu.open').forEach(m => m.classList.remove('open'));
          document.querySelectorAll('.topbar-btn').forEach(b => b.classList.remove('btn-active'));
        }
        if (!e.target.closest('.notif-btn') && !e.target.closest('.notif-panel')) {
          notifPanel.classList.remove('open');
        }
      });

    })();
</script>