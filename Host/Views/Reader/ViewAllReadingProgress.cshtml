@model Application.Queries.GetCurrentlyReading.GetCurrentlyReadingResponse
@{
    ViewData["Title"] = "Currently Reading";
    Layout = "~/Views/Shared/_ReaderLayout.cshtml";

    string? currentSearch = Context.Request.Query["search"];
    string? currentSort = Context.Request.Query["sortBy"];
    string? currentFilter = Context.Request.Query["filter"];

    var sortOptions = new (string Value, string Label)[]
    {
        ("last-opened", "Last Opened"),
        ("title-asc", "Title A – Z"),
        ("title-desc", "Title Z – A"),
        ("progress-asc", "Progress ↑"),
        ("progress-desc", "Progress ↓"),
        ("date-added", "Date Added"),
    };

    var filterOptions = new (string Value, string Label, string Icon)[]
    {
        ("all", "All Books", "📚"),
        ("under50", "Under 50%", "🔵"),
        ("over50", "Over 50%", "🟣"),
        ("over75", "Almost done", "🏁"),
        ("recent", "Started recently", "🆕"),
    };

    string sortLabel = sortOptions.FirstOrDefault(x => x.Value == currentSort).Label ?? "Last Opened";
    string activeFilterVal = string.IsNullOrEmpty(currentFilter) ? "all" : currentFilter;
    var activeFilterOpt = filterOptions.FirstOrDefault(x => x.Value == activeFilterVal);

    int totalPages = (int)Math.Ceiling((double)Model.TotalCount / (Model.PageSize == 0 ? 1 : Model.PageSize));
    if (totalPages < 1) totalPages = 1;

    string BuildUrl(int? page = null, string? sort = null, string? filter = null, string? search = null)
    {
        var q = new Dictionary<string, string?>
        {
            ["page"] = (page ?? Model.Page).ToString(),
            ["pageSize"] = Model.PageSize.ToString(),
            ["sortBy"] = sort ?? currentSort,
            ["filter"] = filter ?? currentFilter,
            ["search"] = search ?? currentSearch
        };
        var query = string.Join("&", q.Where(kv => !string.IsNullOrEmpty(kv.Value))
            .Select(kv => $"{kv.Key}={Uri.EscapeDataString(kv.Value!)}"));
        return Url.Action("ViewAllReadingProgress", "Reader") + "?" + query;
    }

    string[] coverPalette = { "cv-1", "cv-2", "cv-3", "cv-4", "cv-5", "cv-6" };
    string CoverClass(Guid id) => coverPalette[Math.Abs(id.GetHashCode()) % coverPalette.Length];

    (string cssClass, string icon) NotifStyle(string type)
    {
        var t = (type ?? "").ToLower();
        if (t.Contains("payment") || t.Contains("wallet") || t.Contains("transaction"))
            return ("green", "fa-solid fa-wallet");
        if (t.Contains("book"))
            return ("blue", "fa-solid fa-book-open");
        if (t.Contains("alert") || t.Contains("warning"))
            return ("orange", "fa-solid fa-triangle-exclamation");
        if (t.Contains("system"))
            return ("indigo", "fa-solid fa-gear");
        return ("purple", "fa-solid fa-bell");
    }

    string FormatMinutesLeft(int? minutes)
    {
        if (!minutes.HasValue) return "";
        var h = minutes.Value / 60;
        var m = minutes.Value % 60;
        return h > 0 ? $"{h}h {m:00}m left" : $"{m}m left";
    }

    string? toastMessage = TempData["ToastMessage"] as string;
    string toastType = TempData["ToastType"] as string ?? "success";
    string toastIcon = TempData["ToastIcon"] as string ?? "✓";
}

<link href="~/css/allReadingProgress.css" rel="stylesheet" />

<style>
    .cv-1 {
        background: linear-gradient(135deg,#7c6af7,#4c3fd6);
    }

    .cv-2 {
        background: linear-gradient(135deg,#e8540f,#b93d08);
    }

    .cv-3 {
        background: linear-gradient(135deg,#1b2a52,#0f172e);
    }

    .cv-4 {
        background: linear-gradient(135deg,#f4d61a,#c9a800);
    }

    .cv-5 {
        background: linear-gradient(135deg,#0f9d76,#066b4f);
    }

    .cv-6 {
        background: linear-gradient(135deg,#d63384,#a5266a);
    }
</style>

<div class="toast-wrap"></div>

<main>

    <!-- ── Topbar ── -->
    <div class="topbar">
        <form class="search-wrap" method="get" action="@Url.Action("ViewAllReadingProgress", "Reader")">
            <span class="search-icon">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
            </span>
            <input type="text" name="search" placeholder="Search your books…" value="@currentSearch" />
            <input type="hidden" name="sortBy" value="@currentSort" />
            <input type="hidden" name="filter" value="@currentFilter" />
        </form>

        <div class="dropdown-wrap">
            <button class="topbar-btn" id="sortBtn" type="button">
                <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><polyline points="9 22 9 12 15 12 15 22" /></svg>
                Sort by: @sortLabel
                <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg>
            </button>
            <div class="dropdown-menu" id="sortMenu">
                <div class="dropdown-label">Sort by</div>
                @foreach (var opt in sortOptions)
                {
                    <a class="dropdown-item @(opt.Value == currentSort || (string.IsNullOrEmpty(currentSort) && opt.Value == "last-opened") ? "active" : "")"
                       href="@BuildUrl(page: 1, sort: opt.Value)">
                        @opt.Label
                        <svg class="di-check" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12" /></svg>
                    </a>
                }
            </div>
        </div>

        <div class="dropdown-wrap">
            <button class="topbar-btn @(activeFilterVal != "all" ? "btn-active" : "")" id="filterBtn" type="button">
                <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3" /></svg>
                Filter
            </button>
            <div class="dropdown-menu" id="filterMenu" style="left:auto;">
                <div class="dropdown-label">Filter books</div>
                @foreach (var opt in filterOptions)
                {
                    <a class="dropdown-item @(opt.Value == activeFilterVal ? "active" : "")"
                       href="@BuildUrl(page: 1, filter: opt.Value == "all" ? "" : opt.Value)">
                        <span>@opt.Icon</span> @opt.Label
                        <svg class="di-check" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12" /></svg>
                    </a>
                }
            </div>
        </div>

        <div class="topbar-right">
            <div class="dropdown-wrap" style="position:relative;">
                <button class="notif-btn" id="notifBtn" type="button">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" /></svg>
                    @if (Model.UnreadNotificationCount > 0)
                    {
                        <span class="notif-badge">@Model.UnreadNotificationCount</span>
                    }
                </button>
                <div class="notif-panel" id="notifPanel">
                    <div class="notif-panel-head">
                        <span>Notifications</span>
                        <span class="notif-mark-all" id="markAllReadBtn">Mark all read</span>
                    </div>
                    <div class="notif-list">
                        @if (!Model.Notifications.Any())
                        {
                            <div class="notif-row"><div class="notif-body"><p>You're all caught up</p></div></div>
                        }
                        else
                        {
                            @foreach (var notif in Model.Notifications)
                            {
                                var style = NotifStyle(notif.Type);
                                <div class="notif-row @(notif.IsRead ? "" : "unread")">
                                    <div class="@(notif.IsRead ? "notif-dot-read" : "notif-dot-unread")"></div>
                                    <div class="notif-icon @style.cssClass"><i class="@style.icon"></i></div>
                                    <div class="notif-body">
                                        <strong>@notif.Title</strong>
                                        <p>@notif.Message</p>
                                        <span class="notif-time">@notif.DateModified.ToString("MMM d, h:mm tt")</span>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
            <div class="avatar">
                <div class="avatar-fallback">JD</div>
            </div>
        </div>
    </div>

    <!-- ── Content ── -->
    <div class="cr-content">

        <div class="cr-header">
            <h1 class="cr-title">Currently Reading</h1>
            <p class="cr-sub">Continue where you left off.</p>
        </div>

        @if (activeFilterVal != "all")
        {
            <div class="filter-chips visible">
                <div class="chip">
                    @activeFilterOpt.Icon @activeFilterOpt.Label
                    <a href="@BuildUrl(page: 1, filter: "")" style="color:inherit;text-decoration:none;">
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
                    </a>
                </div>
                <a class="chip chip-clear" href="@BuildUrl(page: 1, filter: "")" style="text-decoration:none;">Clear all</a>
            </div>
        }

        <!-- Stats -->
        <div class="cr-stats">
            <div class="stat-card">
                <div class="stat-ic purple">
                    <svg width="22" height="22" fill="none" stroke="#a78bfa" stroke-width="1.8" viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" /><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" /></svg>
                </div>
                <div class="stat-body">
                    <div class="stat-label">Active Books</div>
                    <div class="stat-val">@Model.ActiveBooksCount</div>
                    <div class="stat-note purple">Keep going!</div>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-ic orange">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2z" fill="rgba(249,115,22,.2)" stroke="#f97316" stroke-width="1.5" /><path d="M8 14s1.5-2 4-2 4 2 4 2" stroke="#f97316" stroke-width="1.5" stroke-linecap="round" /><circle cx="9" cy="9.5" r="1" fill="#f97316" /><circle cx="15" cy="9.5" r="1" fill="#f97316" /></svg>
                </div>
                <div class="stat-body">
                    <div class="stat-label">Reading Streak</div>
                    <div class="stat-val">@Model.ReadingStreakDays</div>
                    <div class="stat-note orange">days in a row</div>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-ic blue">
                    <svg width="22" height="22" fill="none" stroke="#63b3ed" stroke-width="1.8" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                </div>
                <div class="stat-body">
                    <div class="stat-label">Total Reading Time</div>
                    <div class="stat-val sm">@(Model.TotalReadingMinutes / 60)h @(Model.TotalReadingMinutes % 60)m</div>
                    <div class="stat-note muted">All time</div>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-ic teal">
                    <svg width="22" height="22" fill="none" stroke="#a78bfa" stroke-width="1.8" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><path d="M12 8v4l3 3" /><circle cx="12" cy="12" r="3" stroke="none" fill="rgba(167,139,250,.2)" /></svg>
                </div>
                <div class="stat-body">
                    <div class="stat-label">Books in Progress</div>
                    <div class="stat-val">@Model.ActiveBooksCount</div>
                    <div class="stat-note teal">You're on track!</div>
                </div>
            </div>
        </div>

        <!-- Book List -->
        @if (!Model.Items.Any())
        {
            <div class="rc-empty"><p>No books match your search or filter.</p></div>
        }
        else
        {
            <div class="book-list">
                @foreach (var book in Model.Items)
                {
                    <div class="book-card" data-progress-id="@book.ReadingProgressId">
                        <div class="bc-cover">
                            @if (string.IsNullOrEmpty(book.BookCoverUrl))
                            {
                                <div class="book-cover-fake @CoverClass(book.BookId)">
                                    <div class="cover-title" style="font-size:11px;">@book.Title</div>
                                </div>
                            }
                            else
                            {
                                <img src="@book.BookCoverUrl" alt="@book.Title" style="width:64px;height:92px;border-radius:7px;object-fit:cover;flex-shrink:0;" />
                            }
                        </div>
                        <div class="bc-info">
                            <div class="bc-title">@book.Title</div>
                            <div class="bc-author">@book.Author</div>
                            <div class="progress-row">
                                <div class="prog-bg"><div class="prog-fill" style="width:@book.ProgressPercentage.ToString("0")%"></div></div>
                                <span class="prog-pct">@book.ProgressPercentage.ToString("0")%</span>
                            </div>
                            @if (book.EstimatedMinutesLeft.HasValue)
                            {
                                <div class="time-left">
                                    <svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                                    @FormatMinutesLeft(book.EstimatedMinutesLeft)
                                </div>
                            }
                        </div>
                        <div class="bc-meta">
                            <div class="meta-row">
                                <span class="meta-icon"><svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg></span>
                                <div class="meta-text">
                                    <div class="meta-label">Last opened</div>
                                    <div class="meta-val">@(book.LastReadDate?.ToString("MMM d, yyyy, h:mm tt") ?? "Never")</div>
                                </div>
                            </div>
                            <div class="meta-row">
                                <span class="meta-icon"><svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg></span>
                                <div class="meta-text">
                                    <div class="meta-label">Started on</div>
                                    <div class="meta-val">@book.StartedOn.ToString("MMM d, yyyy")</div>
                                </div>
                            </div>
                        </div>
                        <div class="bc-actions">
                            <a href="@Url.Action("BookReadingProgress", "Reader", new { id = book.BookId })" class="btn-continue" data-title="@book.Title" style="text-decoration:none;">
                                <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3" /></svg>
                                Continue Reading
                            </a>
                            <button class="btn-remove" type="button" data-progress-id="@book.ReadingProgressId" data-title="@book.Title">
                                <svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6" /><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" /></svg>
                                Remove
                            </button>
                        </div>
                    </div>
                }
            </div>
        }

        <!-- Pagination -->
        <div class="pagination-wrap">
            <div class="pagination-row">
                <a class="pg-btn @(Model.Page <= 1 ? "disabled" : "")" href="@(Model.Page > 1 ? BuildUrl(Model.Page - 1) : "#")">
                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6" /></svg>
                    Prev
                </a>
                @for (int i = 1; i <= totalPages; i++)
                {
                    <a class="pg-btn @(i == Model.Page ? "active" : "")" href="@BuildUrl(i)">@i</a>
                }
                <a class="pg-btn @(Model.Page >= totalPages ? "disabled" : "")" href="@(Model.Page < totalPages ? BuildUrl(Model.Page + 1) : "#")">
                    Next
                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6" /></svg>
                </a>
            </div>
            <div class="pg-showing">
                @{
                    int start = Model.TotalCount == 0 ? 0 : (Model.Page - 1) * Model.PageSize + 1;
                    long end = Math.Min(start + Model.Items.Count - 1, Model.TotalCount);
                }
                @(Model.TotalCount == 0 ? "No books match your filter" : $"Showing {start} to {end} of {Model.TotalCount} books")
            </div>
        </div>

    </div>
</main>

<!-- Remove confirmation modal -->
<div class="modal-overlay" id="removeModal">
    <div class="modal-box">
        <div class="modal-icon">
            <svg width="24" height="24" fill="none" stroke="#ef4444" stroke-width="2" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6" /><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" /><path d="M10 11v6M14 11v6" /><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" /></svg>
        </div>
        <div class="modal-title">Remove book?</div>
        <div class="modal-body">Are you sure you want to remove <strong id="modal-book-name"></strong> from your reading list? Your progress will be lost.</div>
        <div class="modal-actions">
            <button class="modal-cancel" type="button" id="modalCancelBtn">Keep it</button>
            <form method="post" action="@Url.Action("RemoveReadingProgress", "Reader")" id="removeForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="removeProgressId" />
                <button class="modal-confirm" type="submit">Yes, remove</button>
            </form>
        </div>
    </div>
</div>

<script>
    (function () {
        function toast(msg, type = 'info', icon = '✓') {
            const wrap = document.querySelector('.toast-wrap');
            const t = document.createElement('div');
            t.className = 'toast';
            t.innerHTML = `<div class="toast-ic ${type}">${icon}</div><span class="toast-msg">${msg}</span>`;
            wrap.appendChild(t);
            setTimeout(() => t.remove(), 3100);
        }

        function closeAllDropdowns(except) {
            document.querySelectorAll('.dropdown-menu.open').forEach(m => {
                if (m !== except) m.classList.remove('open');
            });
        }

        var sortBtn = document.getElementById('sortBtn');
        var sortMenu = document.getElementById('sortMenu');
        if (sortBtn && sortMenu) {
            sortBtn.addEventListener('click', function (e) {
                e.stopPropagation();
                closeAllDropdowns(sortMenu);
                sortMenu.classList.toggle('open');
            });
            sortMenu.querySelectorAll('.dropdown-item').forEach(function (item) {
                item.addEventListener('click', function () {
                    toast('Sorting your books…', 'info', '↕');
                });
            });
        }

        var filterBtn = document.getElementById('filterBtn');
        var filterMenu = document.getElementById('filterMenu');
        if (filterBtn && filterMenu) {
            filterBtn.addEventListener('click', function (e) {
                e.stopPropagation();
                closeAllDropdowns(filterMenu);
                filterMenu.classList.toggle('open');
            });
        }

        var notifBtn = document.getElementById('notifBtn');
        var notifPanel = document.getElementById('notifPanel');
        if (notifBtn && notifPanel) {
            notifBtn.addEventListener('click', function (e) {
                e.stopPropagation();
                closeAllDropdowns();
                notifPanel.classList.toggle('open');
            });
        }

        document.addEventListener('click', function (e) {
            if (!e.target.closest('.dropdown-wrap')) {
                document.querySelectorAll('.dropdown-menu.open').forEach(m => m.classList.remove('open'));
            }
            if (!e.target.closest('#notifBtn') && !e.target.closest('#notifPanel')) {
                notifPanel?.classList.remove('open');
            }
        });

        /* Mark all notifications read */
        var markAllBtn = document.getElementById('markAllReadBtn');
        if (markAllBtn) {
            markAllBtn.addEventListener('click', function () {
                fetch('@Url.Action("MarkAllNotificationsRead", "Reader")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                })
                .then(function (res) {
                    if (!res.ok) throw new Error('Request failed');
                    document.querySelectorAll('.notif-row').forEach(function (r) {
                        r.classList.remove('unread');
                    });
                    document.querySelectorAll('.notif-dot-unread').forEach(function (d) {
                        d.className = 'notif-dot-read';
                    });
                    var badge = document.querySelector('.notif-badge');
                    if (badge) badge.style.display = 'none';
                    toast('All notifications marked as read', 'success', '✓');
                })
                .catch(function () {
                    toast('Could not mark notifications as read', 'danger', '!');
                });
            });
        }

        /* Continue Reading — delay navigation so the toast is visible */
        document.querySelectorAll('.btn-continue').forEach(function (btn) {
            btn.addEventListener('click', function (e) {
                e.preventDefault();
                var title = btn.dataset.title;
                var href = btn.getAttribute('href');
                toast('Opening "' + title + '"…', 'success', '▶');
                setTimeout(function () {
                    window.location.href = href;
                }, 450);
            });
        });

        /* Remove modal */
        var modal = document.getElementById('removeModal');
        var cancelBtn = document.getElementById('modalCancelBtn');
        var modalNameEl = document.getElementById('modal-book-name');
        var progressIdInput = document.getElementById('removeProgressId');

        document.querySelectorAll('.btn-remove').forEach(function (btn) {
            btn.addEventListener('click', function () {
                modalNameEl.textContent = btn.dataset.title;
                progressIdInput.value = btn.dataset.progressId;
                modal.classList.add('open');
            });
        });

        cancelBtn.addEventListener('click', function () {
            modal.classList.remove('open');
        });

        modal.addEventListener('click', function (e) {
            if (e.target === modal) modal.classList.remove('open');
        });

        /* Toast carried over from server via TempData after a redirect (e.g. remove) */
        @if (!string.IsNullOrEmpty(toastMessage))
        {
                @Html.Raw($"toast('{System.Web.HttpUtility.JavaScriptStringEncode(toastMessage)}', '{toastType}', '{toastIcon}');")
        }
    })();
</script>