@model Application.Queries.GetReaderDashboard.GetReaderDashboardResponse
@{
    Layout = "~/Views/Shared/_ReaderLayout.cshtml";
    ViewData["Title"] = "Activity";

    string[] coverPalette = { "cv-1", "cv-2", "cv-3", "cv-4", "cv-5", "cv-6" };

    string CoverClass(Guid id) => coverPalette[Math.Abs(id.GetHashCode()) % coverPalette.Length];

    string ActivityColor(string icon)
    {
        var i = (icon ?? "").ToLower();
        if (i.Contains("book")) return "blue";
        if (i.Contains("star")) return "yellow";
        if (i.Contains("bookmark") || i.Contains("heart")) return "green";
        if (i.Contains("bolt") || i.Contains("fire") || i.Contains("flame")) return "indigo";
        return "blue";
    }

    (string cssClass, string icon) NotifStyle(string type)
    {
        var t = (type ?? "").ToLower();
        if (t.Contains("payment") || t.Contains("wallet") || t.Contains("transaction"))
            return ("green", "ti ti-wallet");
        if (t.Contains("book"))
            return ("blue", "ti ti-book-2");
        if (t.Contains("alert") || t.Contains("warning"))
            return ("orange", "ti ti-alert-triangle");
        if (t.Contains("system"))
            return ("indigo", "ti ti-settings");
        return ("purple", "ti ti-bell");
    }

    string StarDisplay(int seedValue)
    {
        var rating = 3.5 + (Math.Abs(seedValue) % 15) / 10.0;
        var full = (int)Math.Floor(rating);
        var half = (rating - full) >= 0.5;
        var sb = new System.Text.StringBuilder();
        for (int i = 0; i < full; i++) sb.Append("★");
        if (half) sb.Append("½");
        return sb.ToString() + $"<span class=\"rec-score\">{rating:0.0}</span>";
    }
}

<link href="~/css/readerDashboard.css" rel="stylesheet" />
<link href="~/css/modal.css" rel="stylesheet" />
<link href="~/css/notify.css" rel="stylesheet" />


<form id="antiForgeryForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<div class="content-wrap">

    <main class="main">

        <!-- Top bar -->
        <header class="topbar">
            <div class="greeting">
                <h1>Good evening, @Model.DisplayName! <span class="wave">👋</span></h1>
                <p>Pick up where you left off and keep your reading streak alive.</p>
            </div>
            <div class="topbar-right">
                <div class="search-box">
                    <input type="text" placeholder="Search books, authors..." id="searchInput">
                    <i class="ti ti-search"></i>
                    <div class="search-results" id="searchResults"></div>
                </div>
                <div class="dropdown-wrap">
                    <button class="icon-btn bell-btn" id="bellBtn">
                        <i class="ti ti-bell"></i>
                        @if (Model.UnreadNotificationCount > 0)
                        {
                            <span class="bell-badge">@Model.UnreadNotificationCount</span>
                        }
                    </button>
                    <div class="dropdown-panel notif-panel" id="notifPanel">
                        <div class="dropdown-header">Notifications</div>
                        @if (!Model.Notifications.Any())
                        {
                            <div class="notif-item">
                                <div class="notif-body">
                                    <p>You're all caught up</p>
                                </div>
                            </div>
                        }
                        else
                        {
                            @foreach (var notif in Model.Notifications)
                            {
                                var style = NotifStyle(notif.Type);
                                <div class="notif-item">
                                    <div class="notif-icon @style.cssClass"><i class="@style.icon"></i></div>
                                    <div class="notif-body">
                                        <p><b>@notif.Title</b></p>
                                        <span>@notif.DateModified.ToString("MMM d, h:mm tt")</span>
                                    </div>
                                </div>
                            }
                        }
                        <a class="dropdown-footer" href="@Url.Action("ReaderEngagement", "Reader")#section-notifications">View all notifications</a>
                    </div>
                </div>
                <div class="dropdown-wrap">
                    <button class="profile-chip" id="profileBtn">
                        <img src="@(string.IsNullOrEmpty(Model.AvatarUrl) ? "https://i.pravatar.cc/64?u=" + Model.UserId : Model.AvatarUrl)" alt="@Model.DisplayName">
                        <i class="ti ti-chevron-down"></i>
                    </button>
                    <div class="dropdown-panel profile-panel" id="profilePanel">
                        <div class="dropdown-profile-head">
                            <img src="@(string.IsNullOrEmpty(Model.AvatarUrl) ? "https://i.pravatar.cc/64?u=" + Model.UserId : Model.AvatarUrl)" alt="@Model.DisplayName">
                            <div>
                                @{
                                    string email = Model.Email ?? "";
                                    int take = Math.Min(10, email.Length);
                                    string shorten = email.Substring(0, take);
                                    string outEmail = $"{shorten}...";
                                }
                                <div class="dp-name">@Model.DisplayName</div>
                                <div class="dp-email">@outEmail</div>
                            </div>
                        </div>
                        <a class="dropdown-link" href="@Url.Action("ReaderPersonal", "Reader")"><i class="ti ti-user"></i> Profile</a>
                        <a class="dropdown-link" href="@Url.Action("ReaderPersonal", "Reader")"><i class="ti ti-settings"></i> Settings</a>
                        <a class="dropdown-link" href="@Url.Action("ManageSub", "Reader")"><i class="ti ti-credit-card"></i> Subscription</a>
                        <div class="dropdown-divider"></div>
                        <a class="dropdown-link danger" href="#">
                            <i class="ti ti-logout"></i>
                            Logout
                        </a>
                    </div>
                </div>
            </div>
        </header>

        <!-- Stat cards -->
        <section class="stat-grid">
            <div class="stat-card">
                <div class="stat-icon purple"><i class="ti ti-book"></i></div>
                <div class="stat-body">
                    <div class="stat-label">Books Read</div>
                    <div class="stat-value">@Model.BooksReadTotal</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon purple"><i class="ti ti-book-2"></i></div>
                <div class="stat-body">
                    <div class="stat-label">Books In Progress</div>
                    <div class="stat-value">@Model.BooksInProgress</div>
                    <div class="stat-foot link">Keep going!</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon purple"><i class="ti ti-heart"></i></div>
                <div class="stat-body">
                    <div class="stat-label">Favorite Books</div>
                    <div class="stat-value">@Model.FavoriteBooksCount</div>
                    <div class="stat-foot link">View your favorites</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon orange"><i class="ti ti-flame"></i></div>
                <div class="stat-body">
                    <div class="stat-label">Reading Streak</div>
                    <div class="stat-value">@Model.ReadingStreakDays</div>
                    <div class="stat-foot orange">days in a row</div>
                </div>
            </div>
        </section>

        <!-- Continue reading + Recently completed -->
        <section class="two-col">
            <div class="panel continue-reading">
                <div class="panel-head">
                    <h2>Continue Reading</h2>
                    <a class="view-all" href="@Url.Action("ViewAllReadingProgress", "Reader")">View all</a>
                </div>
                @if (Model.ContinueReading is null)
                {
                    <div class="cr-empty">
                        <p>No books in progress right now.</p>
                    </div>
                }
                else
                {
                    <div class="cr-card">
                        @if (string.IsNullOrEmpty(Model.ContinueReading.BookCoverUrl))
                        {
                            <div class="cr-cover @CoverClass(Model.ContinueReading.BookId)">
                                <div class="cover-fallback">@Model.ContinueReading.Title</div>
                            </div>
                        }
                        else
                        {
                            <img class="cr-cover" src="@Model.ContinueReading.BookCoverUrl" alt="@Model.ContinueReading.Title">
                        }
                        <div class="cr-info">
                            <div>
                                <h3>@Model.ContinueReading.Title</h3>
                                <p class="cr-author">@Model.ContinueReading.Author</p>
                            </div>
                            <div class="cr-progress-row">
                                <span class="cr-progress-label">@Model.ContinueReading.PercentComplete.ToString("0")% complete</span>
                            </div>
                            <div class="progress-track">
                                <div class="progress-fill" style="width:@Model.ContinueReading.PercentComplete.ToString("0")%"></div>
                            </div>
                            <div class="cr-bottom-row">
                                <span class="cr-time"><i class="ti ti-clock"></i> @Model.ContinueReading.TotalMinutesRead min read</span>
                                <a href="@Url.Action("BookReadingProgress", "Reader", new { id = Model.ContinueReading.BookId })" class="btn-primary" style="text-decoration: none;"><i class="ti ti-player-play"></i> Continue Reading</a>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="panel recently-completed">
                <div class="panel-head">
                    <h2>Recently Completed</h2>
                    <a class="view-all" href="@Url.Action("ViewAllReadingProgress", "Reader")">View all</a>
                </div>
                @if (!Model.RecentlyCompleted.Any())
                {
                    <div class="rc-empty">
                        <p>No completed books yet.</p>
                    </div>
                }
                else
                {
                    <div class="rc-list">
                        @foreach (var book in Model.RecentlyCompleted)
                        {
                            <div class="rc-item">
                                @if (string.IsNullOrEmpty(book.BookCoverUrl))
                                {
                                    <div class="@CoverClass(book.BookId)" style="width:56px;height:80px;border-radius:8px;">
                                        <div class="cover-fallback">@book.Title</div>
                                    </div>
                                }
                                else
                                {
                                    <img src="@book.BookCoverUrl" alt="@book.Title">
                                }
                                <div class="rc-info">
                                    <h4>@book.Title</h4>
                                    <p>@book.Author</p>
                                    <div class="rc-bottom">
                                        <span class="stars">@Html.Raw(StarDisplay(book.BookId.GetHashCode()))</span>
                                        <span class="rc-when">Completed @book.CompletedOn.ToString("MMM d, yyyy")</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </section>

        <!-- Recommended for you -->
        <section class="panel recommended">
            <div class="panel-head">
                <h2>Recommended for You</h2>
                <a class="view-all" href="@Url.Action("ReaderBooks", "Reader")">View all</a>
            </div>
            @if (!Model.Recommended.Any())
            {
                <div class="rec-empty">
                    <p>No recommendations available right now.</p>
                </div>
            }
            else
            {
                <div class="rec-carousel-wrap">
                    <div class="rec-carousel">
                        @foreach (var rec in Model.Recommended)
                        {
                            <div class="rec-card">
                                @if (string.IsNullOrEmpty(rec.BookCoverUrl))
                                {
                                    <div class="rec-cover @CoverClass(rec.BookId)">
                                        <div class="cover-fallback">@rec.Title</div>
                                    </div>
                                }
                                else
                                {
                                    <img class="rec-cover-img rec-cover" src="@rec.BookCoverUrl" alt="@rec.Title">
                                }
                                <h4>@rec.Title</h4>
                                <p class="rec-author">@rec.Author</p>
                                <div class="rec-rating">
                                    <span class="stars small">@Html.Raw(StarDisplay(rec.BookId.GetHashCode()))</span>
                                </div>
                            </div>
                        }
                    </div>
                    <button class="carousel-next"><i class="ti ti-chevron-right"></i></button>
                </div>
            }
        </section>

        <!-- Recent Activity -->
        <section class="panel recent-activity">
            <div class="panel-head">
                <h2>Recent Activity</h2>
                <a class="view-all" href="@Url.Action("ReaderActivities", "Reader")">View all</a>
            </div>
            @if (!Model.RecentActivity.Any())
            {
                <div class="activity-empty">
                    <p>No recent activity.</p>
                </div>
            }
            else
            {
                <div class="activity-list">
                    @foreach (var activity in Model.RecentActivity.Where(v => v.ActionType.
                    ToLower() != "logged in" && v.ActionType.ToLower() != "reset password" &&
                    v.ActionType.ToLower() != "verify email" &&
                    v.ActionType.ToLower() != "bank payment" &&
                    v.ActionType.ToLower() != "vrify" &&
                    v.ActionType.ToLower() != "resend" &&
                    v.ActionType.ToLower() != "add new user"))
                    {
                        <div class="activity-item">
                            <div class="activity-icon @ActivityColor(activity.Icon)"><i class="@activity.Icon"></i></div>
                            <div class="activity-body">
                                <p class="activity-title">@activity.ActionType</p>
                                <p class="activity-sub">@activity.Description</p>
                            </div>
                            <div class="activity-time">
                                <div>@activity.Timestamp.ToString("MMM d")</div>
                                <div class="activity-time-sub">@activity.Timestamp.ToString("h:mm tt")</div>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>

    </main>

    <!-- Right panel -->
    <aside class="right-panel">
        <div class="camped">
            <div class="profile-card">
                <img src="@(string.IsNullOrEmpty(Model.AvatarUrl) ? "https://i.pravatar.cc/72?u=" + Model.UserId : Model.AvatarUrl)" alt="@Model.DisplayName">
                <div class="profile-info">
                    <h3>@Model.DisplayName</h3>
                    @if (Model.PlanName != "Free Plan")
                    {
                        <span class="premium-tag"><i class="ti ti-circle-check"></i> @Model.PlanName Member</span>
                    }
                </div>
            </div>
            <div class="profile-meta">
                <div class="profile-meta-row"><span>Member since</span><b>@Model.MemberSince.ToString("MMM d, yyyy")</b></div>
            </div>
            <a href="@Url.Action("ReaderDetails", "Reader")" style="text-decoration: none;" class="btn-outline full">View Profile</a>
        </div>

        <div class="rp-card">
            <h4 class="rp-title">Your Plan</h4>
            <div class="plan-row">
                <div class="plan-icon"><i class="ti ti-crown"></i></div>
                <div>
                    <div class="plan-name">@Model.PlanName</div>
                    <div class="plan-price">@Model.MonthlyPrice.ToString("C") / cycle</div>
                </div>
            </div>
            @if (Model.RenewsOn.HasValue)
            {
                <div class="profile-meta-row"><span>Renews on</span><b>@Model.RenewsOn.Value.ToString("MMM d, yyyy")</b></div>
            }
            <a href="@Url.Action("ManageSub", "Reader")" class="btn-primary full" style="text-decoration: none">Manage Subscription</a>
        </div>

        <div class="rp-card">
            <div class="rp-head-row">
                <h4 class="rp-title">Reading Goal</h4>
                <a class="edit-link" href="#" id="editGoalBtn">Edit Goal</a>
            </div>
            <p class="goal-status">
                @if (Model.GoalIsOnTrack)
                {
                    <span><i class="ti ti-circle-check"></i> You're on track!</span>
                }
                else
                {
                    <span><i class="ti ti-alert-circle"></i> Keep going!</span>
                }
            </p>
            <div class="goal-row">
                <span>@Model.GoalCurrentValue of @Model.GoalTargetValue @(Model.GoalType == "Pages" ? "pages" : "books")</span>
                <span>@Model.GoalPercentComplete.ToString("0")%</span>
            </div>
            <div class="progress-track">
                <div class="progress-fill" style="width:@Model.GoalPercentComplete.ToString("0")%"></div>
            </div>
            @if (!string.IsNullOrEmpty(Model.GoalMotivation))
            {
                <p class="goal-foot">@Model.GoalMotivation</p>
            }
            else
            {
                <p class="goal-foot">Great progress! Keep reading. 🚀</p>
            }
        </div>

        <!-- Upcoming — MOCKED, not model-bound. Replace when you wire a real source. -->
        <div class="rp-card">
            <div class="rp-head-row">
                <h4 class="rp-title">Upcoming</h4>
                <a class="view-all" href="#">View all</a>
            </div>
            <div class="upcoming-item">
                <div class="upcoming-icon purple"><i class="ti ti-calendar"></i></div>
                <div class="upcoming-body">
                    <h5>Book Club Discussion</h5>
                    <p>Deep Work</p>
                    <p class="upcoming-date">May 20, 2024 • 7:00 PM</p>
                </div>
            </div>
            <div class="upcoming-item">
                <div class="upcoming-icon indigo"><i class="ti ti-bell"></i></div>
                <div class="upcoming-body">
                    <h5>Subscription Renewal</h5>
                    <p>@Model.PlanName renews soon</p>
                    <p class="upcoming-date">@(Model.RenewsOn?.ToString("MMM d, yyyy") ?? "—")</p>
                </div>
            </div>
        </div>

        <div class="quote-card">
            <i class="ti ti-quote quote-mark"></i>
            <p class="quote-text">"Books are a uniquely portable magic."</p>
            <p class="quote-author">— Stephen King</p>
            <i class="ti ti-book-2 quote-book-icon"></i>
        </div>
    </aside>

</div>

<script src="~/js/modal.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', () => {

    /* ============ Carousel next-arrow ============ */
    const nextBtn = document.querySelector('.carousel-next');
    const carousel = document.querySelector('.rec-carousel');
    if (nextBtn && carousel) {
    nextBtn.addEventListener('click', () => {
    carousel.scrollBy({ left: 220, behavior: 'smooth' });
    });
    }

    /* ============ Dropdowns: notification bell + profile chip ============ */
    const bellBtn = document.getElementById('bellBtn');
    const notifPanel = document.getElementById('notifPanel');
    const profileBtn = document.getElementById('profileBtn');
    const profilePanel = document.getElementById('profilePanel');

    function closeAllDropdowns(except) {
    [notifPanel, profilePanel].forEach(panel => {
    if (panel && panel !== except) panel.classList.remove('open');
    });
    }

    function toggleDropdown(btn, panel) {
    if (!btn || !panel) return;
    btn.addEventListener('click', (e) => {
    e.stopPropagation();
    const isOpen = panel.classList.contains('open');
    closeAllDropdowns();
    panel.classList.toggle('open', !isOpen);
    });
    }

    toggleDropdown(bellBtn, notifPanel);
    toggleDropdown(profileBtn, profilePanel);

    document.addEventListener('click', () => closeAllDropdowns());

    [notifPanel, profilePanel].forEach(panel => {
    if (panel) panel.addEventListener('click', (e) => e.stopPropagation());
    });

    document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAllDropdowns();
    });

    /* ============ Search ============ */
    const searchInput = document.getElementById('searchInput');
    const searchResults = document.getElementById('searchResults');

    function buildSearchIndex() {
    const items = [];

    var crInfos = document.querySelectorAll('.continue-reading .cr-info');
    for (var i = 0; i < crInfos.length; i++) {
    var el = crInfos[i];
    var titleEl = el.querySelector('h3');
    var authorEl = el.querySelector('.cr-author');
    var title = titleEl ? titleEl.textContent.trim() : '';
    var author = authorEl ? authorEl.textContent.trim() : '';
    if (title) items.push({ title: title, author: author, section: 'Continue Reading' });
    }

    var rcItems = document.querySelectorAll('.rc-item');
    for (var j = 0; j < rcItems.length; j++) {
    var rcEl = rcItems[j];
    var rcTitleEl = rcEl.querySelector('h4');
    var rcAuthorEl = rcEl.querySelector('.rc-info p');
    var rcTitle = rcTitleEl ? rcTitleEl.textContent.trim() : '';
    var rcAuthor = rcAuthorEl ? rcAuthorEl.textContent.trim() : '';
    if (rcTitle) items.push({ title: rcTitle, author: rcAuthor, section: 'Recently Completed' });
    }

    var recCards = document.querySelectorAll('.rec-card');
    for (var k = 0; k < recCards.length; k++) {
    var recEl = recCards[k];
    var recTitleEl = recEl.querySelector('h4');
    var recAuthorEl = recEl.querySelector('.rec-author');
    var recTitle = recTitleEl ? recTitleEl.textContent.trim() : '';
    var recAuthor = recAuthorEl ? recAuthorEl.textContent.trim() : '';
    if (recTitle) items.push({ title: recTitle, author: recAuthor, section: 'Recommended for You' });
    }

    return items;
    }

    const searchIndex = buildSearchIndex();

    function renderResults(query) {
    if (!query) {
    searchResults.classList.remove('open');
    searchResults.innerHTML = '';
    return;
    }
    const q = query.toLowerCase();
    const matches = searchIndex.filter(item =>
    item.title.toLowerCase().includes(q) ||
    (item.author && item.author.toLowerCase().includes(q))
    );

    if (matches.length === 0) {
    searchResults.innerHTML = '<div class="search-empty">No books match your search.</div>';
    } else {
    searchResults.innerHTML = matches.map(m => `
    <div class="search-result-item">
    <div class="sr-title">${m.title}</div>
    <div class="sr-meta"><span>${m.author || ''}</span><span class="sr-section">${m.section}</span></div>
    </div>
    `).join('');
    }
    searchResults.classList.add('open');
    }

    if (searchInput && searchResults) {
    searchInput.addEventListener('input', function (e) {
    renderResults(e.target.value.trim());
    });
    searchInput.addEventListener('focus', function (e) {
    var v = e.target.value.trim();
    if (v) renderResults(v);
    });
    searchInput.addEventListener('click', function (e) {
    e.stopPropagation();
    });
    searchResults.addEventListener('click', function (e) {
    e.stopPropagation();
    });

    document.addEventListener('click', function () {
    searchResults.classList.remove('open');
    });

    document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
    searchResults.classList.remove('open');
    searchInput.blur();
    }
    });
    }

    /* ============ Edit Reading Goal ============ */
    var editGoalBtn = document.getElementById('editGoalBtn');
    if (editGoalBtn) {
    editGoalBtn.addEventListener('click', function (e) {
    e.preventDefault();

    var token = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]').value;

    Modal.showReadingGoal({
    goalType: '@Model.GoalType',
    target: @Model.GoalTargetValue,
    deadline: '@(Model.GoalDeadline?.ToString("yyyy-MM-dd") ?? "")',
    motivation: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.GoalMotivation ?? "")),
    postUrl: '@Url.Action("UpdateReadingGoal", "Reader")',
    antiForgeryToken: token
    });
    });
    }

    });
</script>