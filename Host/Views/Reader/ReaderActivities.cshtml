            let currentPage  = 1;
            const PER_PAGE   = 10;

            /* ══════════════════════════════════════════
               TOAST
            ══════════════════════════════════════════ */
            function toast(msg, type='info', icon='✦'){
              const root = document.getElementById('toast-root');
              const el = document.createElement('div');
              el.className = 'toast';
              el.innerHTML = `<div class="toast-ic ${type}">${icon}</div><span class="toast-msg">${msg}</span>`;
              root.appendChild(el);
              setTimeout(()=>{ el.classList.add('out'); setTimeout(()=>el.remove(), 300); }, 2800);
            }

            /* ══════════════════════════════════════════
               RENDER
            ══════════════════════════════════════════ */
            function escRe(s){ return s.replace(/[.*+?^${}()|[\]\\]/g,'\\$&'); }

            function hl(text){
              if(!searchQuery) return text;
              return text.replace(new RegExp(`(${escRe(searchQuery)})`,'gi'),'<mark>$1</mark>');
            }

            function buildRow(a){
              const dets = a.details.map(d=>`<div class="ac-dline">${d.t} <span class="hl ${d.c||''}">${d.v}</span></div>`).join('');
              const lnk  = a.link ? `<a class="ac-link" href="${a.link.h}" onclick="return false">${a.link.l}</a>` : '';
              return `
            <div class="ac-row">
              <div class="ac-cell-act">
                <div class="ac-icon ${a.cls}">${a.icon}</div>
                <div class="ac-text"><strong>${hl(a.title)}</strong><span>${a.sub}</span></div>
              </div>
              <div class="ac-cell-det">${dets}${lnk}</div>
              <div class="ac-cell-date">
                <div class="ac-date-main">${a.date}</div>
                <div class="ac-date-time">${a.time}</div>
              </div>
            </div>`;
            }

            function applyFilters(){
              const q = searchQuery.toLowerCase();
              filtered = ACTIVITIES.filter(a=>{
                const typeOk   = activeFilter==='all' || a.type===activeFilter;
                const searchOk = !q || a.title.toLowerCase().includes(q) || a.sub.toLowerCase().includes(q);
                return typeOk && searchOk;
              });
              currentPage = 1;
              render();
            }

            function render(){
              const list  = document.getElementById('activity-list');
              const empty = document.getElementById('ac-empty');
              const total = filtered.length;
              const start = (currentPage-1)*PER_PAGE;
              const slice = filtered.slice(start, start+PER_PAGE);

              if(!slice.length){
                list.innerHTML='';
                empty.classList.add('show');
              } else {
                empty.classList.remove('show');
                list.innerHTML = slice.map(buildRow).join('');
                // wire ac-link clicks
                list.querySelectorAll('.ac-link').forEach(a=>{
                  a.addEventListener('click', e=>{
                    e.preventDefault();
                    toast(`Opening: ${a.textContent}`, 'info', '🔗');
                  });
                });
              }

              const end = Math.min(start+slice.length, total);
              document.getElementById('ac-showing').textContent =
                total ? `Showing ${start+1} to ${end} of ${total} activities` : 'No activities found';

              renderPagination(total);
            }

            function renderPagination(total){
              const pages = Math.ceil(total/PER_PAGE)||1;
              const pg = document.getElementById('pg-row');
              pg.innerHTML='';

              function mkBtn(html, page, cls=''){
                const b=document.createElement('button');
                b.className='pg-btn '+cls;
                b.innerHTML=html;
                if(page!==null){
                  b.addEventListener('click',()=>{ currentPage=page; render(); window.scrollTo({top:0,behavior:'smooth'}); });
                }
                return b;
              }

              // Prev
              const prev = mkBtn('<svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg> Prev', currentPage-1);
              if(currentPage===1) prev.disabled=true;
              pg.appendChild(prev);

              // Pages with ellipsis
              const nums=[];
              for(let i=1;i<=pages;i++){
                if(i===1||i===pages||Math.abs(i-currentPage)<=1) nums.push(i);
                else if(nums[nums.length-1]!=='…') nums.push('…');
              }
              nums.forEach(n=>{
                if(n==='…'){
                  const s=document.createElement('button');
                  s.className='pg-btn'; s.textContent='…'; s.disabled=true;
                  pg.appendChild(s);
                } else {
                  pg.appendChild(mkBtn(n, n, n===currentPage?'is-active':''));
                }
              });

              // Next
              const next = mkBtn('Next <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>', currentPage+1);
              if(currentPage===pages) next.disabled=true;
              pg.appendChild(next);
            }

            /* ══════════════════════════════════════════
               DROPDOWNS — generic open/close
            ══════════════════════════════════════════ */
            const allDropdowns = []; // [{trigger, panel}]

            function registerDropdown(triggerId, panelId, onOpen){
              const trigger = document.getElementById(triggerId);
              const panel   = document.getElementById(panelId);
              if(!trigger||!panel) return;
              allDropdowns.push({trigger, panel});

              trigger.addEventListener('click', e=>{
                e.stopPropagation();
                const isOpen = panel.classList.contains('is-open');
                closeAllDropdowns();
                if(!isOpen){
                  panel.classList.add('is-open');
                  trigger.classList.add('is-open');
                  if(onOpen) onOpen();
                }
              });

              panel.addEventListener('click', e=>e.stopPropagation());
            }

            function closeAllDropdowns(){
              allDropdowns.forEach(({trigger,panel})=>{
                panel.classList.remove('is-open');
                trigger.classList.remove('is-open');
              });
            }

            document.addEventListener('click', closeAllDropdowns);

            /* ══════════════════════════════════════════
               FILTER DROPDOWN
            ══════════════════════════════════════════ */
            registerDropdown('filter-trigger','filter-menu');

            document.getElementById('filter-menu').querySelectorAll('.dd-item').forEach(item=>{
              item.addEventListener('click', e=>{
                e.stopPropagation();
                document.querySelectorAll('#filter-menu .dd-item').forEach(i=>i.classList.remove('is-active'));
                item.classList.add('is-active');
                activeFilter = item.dataset.val;
                document.getElementById('filter-label').textContent = item.dataset.label;
                closeAllDropdowns();
                applyFilters();
                toast(`Filter: ${item.dataset.label}`, 'info', '🔎');
              });
            });

            /* ══════════════════════════════════════════
               DATE RANGE PICKER
            ══════════════════════════════════════════ */
            registerDropdown('date-trigger','date-panel');

            document.querySelectorAll('.date-preset').forEach(p=>{
              p.addEventListener('click', e=>{
                e.stopPropagation();
                document.querySelectorAll('.date-preset').forEach(x=>x.classList.remove('is-active'));
                p.classList.add('is-active');
                document.getElementById('date-label').textContent = p.dataset.label;
                toast(`Date: ${p.dataset.label}`, 'info', '📅');
              });
            });

            document.getElementById('date-apply').addEventListener('click', e=>{
              e.stopPropagation();
              const from = document.getElementById('date-from').value;
              const to   = document.getElementById('date-to').value;
              if(!from||!to){ toast('Please select both dates','warn','⚠️'); return; }
              if(from>to){ toast('Start date must be before end date','warn','⚠️'); return; }
              const fmt = d=>{ const [y,m,day]=d.split('-'); return new Date(y,m-1,day).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}); };
              const label = `${fmt(from)} – ${fmt(to)}`;
              document.getElementById('date-label').textContent = label;
              document.querySelectorAll('.date-preset').forEach(x=>x.classList.remove('is-active'));
              closeAllDropdowns();
              toast(`Range applied: ${label}`, 'success', '✓');
            });

            /* ══════════════════════════════════════════
               SEARCH
            ══════════════════════════════════════════ */
            const searchInput = document.getElementById('search-input');
            let searchDebounce;
            searchInput.addEventListener('input', ()=>{
              clearTimeout(searchDebounce);
              searchDebounce = setTimeout(()=>{
                searchQuery = searchInput.value.trim();
                applyFilters();
              }, 200);
            });
            searchInput.addEventListener('keydown', e=>{
              if(e.key==='Escape'){ searchInput.value=''; searchQuery=''; applyFilters(); }
            });

            /* ══════════════════════════════════════════
               NOTIFICATION PANEL
            ══════════════════════════════════════════ */
            registerDropdown('btn-notif','notif-panel');

            // Render notifications
            const notifList = document.getElementById('notif-list');
            notifList.innerHTML = NOTIFS.map(n=>`
              <div class="notif-row${n.unread?' unread':''}">
                <div class="notif-dot ${n.unread?'on':'off'}"></div>
                <div class="notif-icon" style="background:${n.bg}">${n.icon}</div>
                <div class="notif-body">
                  <strong>${n.title}</strong>
                  <p>${n.text}</p>
                  <span class="notif-time">${n.time}</span>
                </div>
              </div>`).join('');

            // Click individual notification
            notifList.querySelectorAll('.notif-row').forEach(row=>{
              row.addEventListener('click', ()=>{
                row.classList.remove('unread');
                row.querySelector('.notif-dot').className='notif-dot off';
                updateBadge();
              });
            });

            // Mark all read
            document.getElementById('notif-mark-all').addEventListener('click', e=>{
              e.stopPropagation();
              notifList.querySelectorAll('.notif-row').forEach(r=>{
                r.classList.remove('unread');
                r.querySelector('.notif-dot').className='notif-dot off';
              });
              updateBadge();
              toast('All notifications marked as read','success','✓');
            });

            function updateBadge(){
              const count = notifList.querySelectorAll('.notif-row.unread').length;
              const badge = document.getElementById('notif-count');
              badge.textContent = count;
              badge.style.display = count ? '' : 'none';
            }

            /* ══════════════════════════════════════════
               BACK BUTTON
            ══════════════════════════════════════════ */
            document.getElementById('btn-back').addEventListener('click', ()=>{
              toast('Going back…', 'info', '←');
              // history.back();
            });

            /* ══════════════════════════════════════════
               RESET (empty state button)
            ══════════════════════════════════════════ */
            document.getElementById('btn-reset').addEventListener('click', ()=>{
              searchInput.value='';
              searchQuery='';
              activeFilter='all';
              document.querySelectorAll('#filter-menu .dd-item').forEach(i=>i.classList.toggle('is-active', i.dataset.val==='all'));
              document.getElementById('filter-label').textContent='All Activities';
              applyFilters();
            });

            /* ══════════════════════════════════════════
               INIT
            ══════════════════════════════════════════ */
            render();

            })();
    </script>