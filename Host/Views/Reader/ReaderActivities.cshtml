@model Application.ViewModels.ActivityViewModel
@{
    ViewData["Title"] = "My Activities";
    Layout = "~/Views/Shared/_ReaderLayout.cshtml";

    var pageSize = Model.AuditLogs.PageSize > 0 ? Model.AuditLogs.PageSize : 10;
    var totalPages = Math.Max(1, (int)Math.Ceiling(Model.AuditLogs.TotalCount / (double)pageSize));
    var start = Model.AuditLogs.TotalCount == 0 ? 0 : ((Model.AuditLogs.Page - 1) * pageSize) + 1;
    var end = Math.Min(Model.AuditLogs.Page * pageSize, Model.AuditLogs.TotalCount);

    var typeOptions = new (string Val, string Label, string Icon)[]
    {
        ("all",          "All Activities",           "📋"),
        ("reading",      "Reading Sessions",         "📖"),
        ("completed",    "Completed Books",          "✅"),
        ("reviews",      "Reviews",                  "⭐"),
        ("streak",       "Streaks & Achievements",   "🔥"),
        ("favorites",    "Favorites",                "❤️"),
        ("subscription", "Subscription",              "💳"),
        ("downloads",    "Downloads",                "⬇️"),
    };
    var activeType = string.IsNullOrEmpty(Model.ActionType) ? "all" : Model.ActionType;
    var activeLabel = typeOptions.FirstOrDefault(t => t.Val == activeType).Label ?? "All Activities";

    string IconClass(string actionType) => actionType?.ToLowerInvariant() switch
    {
        "reading" => "c-purple",
        "completed" => "c-teal",
        "reviews" => "c-gold",
        "streak" => "c-orange",
        "favorites" => "c-pink",
        "subscription" => "c-indigo",
        "downloads" => "c-blue",
        _ => "c-blue"
    };

    string BuildQuery(int? page = null, string? search = null, string? type = null, DateTime? from = null, DateTime? to = null)
    {
        var p = page ?? Model.AuditLogs.Page;
        var s = search ?? Model.Search;
        var t = type ?? activeType;
        var f = from ?? Model.DateFrom;
        var to2 = to ?? Model.DateTo;

        var qs = new List<string> { $"page={p}", $"pageSize={pageSize}" };
        if (!string.IsNullOrWhiteSpace(s)) qs.Add($"search={Uri.EscapeDataString(s)}");
        if (!string.IsNullOrWhiteSpace(t) && t != "all") qs.Add($"type={Uri.EscapeDataString(t)}");
        if (f.HasValue) qs.Add($"from={f:yyyy-MM-dd}");
        if (to2.HasValue) qs.Add($"to={to2:yyyy-MM-dd}");
        return "?" + string.Join("&", qs);
    }
}
<link href="~/css/readerActivities.css" rel="stylesheet" />
<!-- TOPBAR -->
<div class="topbar">
    <button class="tb-back" id="btn-back" title="Go back">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6" /></svg>
    </button>

    <div class="tb-search">
        <span class="tb-search-ic">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
        </span>
        <input type="text" id="search-input" placeholder="Search books, authors…" autocomplete="off" value="@Model.Search" />
    </div>


    
    <!-- Notification button + panel -->
    <div class="tb-right">
        <div class="dd-wrap" id="notif-wrap" style="position:relative;">
            <button class="tb-notif" id="btn-notif">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" /></svg>
                <span class="tb-badge" id="notif-count" style="@(Model.Notifications.UnreadNotifications == 0 ? "display:none" : "")">@Model.Notifications.UnreadNotifications</span>
            </button>
            <div class="notif-panel" id="notif-panel">
                <div class="notif-head">
                    <span class="notif-head-title">Notifications</span>
                    <span class="notif-mark" id="notif-mark-all">Mark all read</span>
                </div>
                <div class="notif-list" id="notif-list">
                    @foreach (var n in Model.Notifications.Items)
                    {
                        <div class="notif-row@(n.IsRead ? "" : " unread")" data-id="@n.Id">
                            <div class="notif-dot @(n.IsRead ? "off" : "on")"></div>
                            <div class="notif-icon">@n.Category</div>
                            <div class="notif-body">
                                <strong>@n.Title</strong>
                                <p>@n.Message</p>
                                <span class="notif-time">@n.DateCreated.ToString("MMM d, h:mm tt")</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="tb-avatar">
            <div class="tb-av">JD</div>
            <svg width="14" height="14" fill="none" stroke="#6b6990" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg>
        </div>
    </div>
</div>

<!-- MAIN CONTENT -->
<div class="ac-content">
    <div class="ac-header">
        <h1 class="ac-title">All Activity</h1>
        <p class="ac-sub">A complete history of your reading activity and account updates.</p>
    </div>

    <!-- Toolbar -->
    <div class="ac-toolbar">
        <div class="tb-left">
            <span class="tb-lbl">Filter by</span>
            <div class="dd-wrap" id="filter-wrap">
                <div class="dd-trigger" id="filter-trigger">
                    <span id="filter-label">@activeLabel</span>
                    <svg class="dd-caret" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg>
                </div>
                <div class="dd-menu" id="filter-menu">
                    <div class="dd-section-label">Activity type</div>
                    @foreach (var opt in typeOptions)
                    {
                        <a class="dd-item@(opt.Val == activeType ? " is-active" : "")" href="@BuildQuery(page: 1, type: opt.Val)">
                            <span class="dd-item-icon">@opt.Icon</span> @opt.Label
                            <svg class="dd-check" width="12" height="12" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12" /></svg>
                        </a>
                    }
                </div>
            </div>
        </div>

        <!-- Date range -->
        <div class="dd-wrap" id="date-wrap">
            <div class="dd-trigger" id="date-trigger">
                <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
                <span id="date-label">@(Model.DateFrom.HasValue && Model.DateTo.HasValue ? $"{Model.DateFrom:MMM d} – {Model.DateTo:MMM d, yyyy}" : "All time")</span>
                <svg class="dd-caret" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg>
            </div>
            <div class="date-panel" id="date-panel">
                <div class="date-panel-title">Select date range</div>
                <div class="date-sep"></div>
                <div class="date-custom-lbl">Custom range</div>
                <div class="date-row">
                    <input type="date" id="date-from" value="@Model.DateFrom?.ToString("yyyy-MM-dd")" />
                    <span class="date-row-sep">→</span>
                    <input type="date" id="date-to" value="@Model.DateTo?.ToString("yyyy-MM-dd")" />
                </div>
                <button class="date-apply-btn" id="date-apply">Apply range</button>
            </div>
        </div>
    </div>

    <!-- Table -->
    <div class="ac-table-wrap">
        <div class="ac-thead">
            <div class="ac-th">Activity</div>
            <div class="ac-th">Details</div>
            <div class="ac-th">Date &amp; Time</div>
        </div>
        <div id="activity-list">
            @foreach (var a in Model.AuditLogs.Items)
            {
                <div class="ac-row">
                    <div class="ac-cell-act">
                        <div class="ac-icon @IconClass(a.ActionType)">@a.Icon</div>
                        <div class="ac-text"><strong>@a.Description</strong><span>@a.UserName · @a.Role</span></div>
                    </div>
                    <div class="ac-cell-det">
                        <div class="ac-dline"><span class="hl">@a.Description</span></div>
                    </div>
                    <div class="ac-cell-date">
                        <div class="ac-date-main">@a.Timestamp.ToString("MMM d, yyyy")</div>
                        <div class="ac-date-time">@a.Timestamp.ToString("h:mm tt")</div>
                    </div>
                </div>
            }
        </div>
        <div class="ac-empty@(Model.AuditLogs.Items.Count() == 0 ? " show" : "")" id="ac-empty">
            <div class="ac-empty-emoji">🔍</div>
            <h3>No activities found</h3>
            <p>Try adjusting your search or filter.</p>
            <a class="ac-empty-reset" href="@Url.Action("Index")">Clear filters</a>
        </div>
    </div>

    <!-- Footer -->
    <div class="ac-footer">
        <span class="ac-showing">@(Model.AuditLogs.TotalCount == 0 ? "No activities found" : $"Showing {start} to {end} of {Model.AuditLogs.TotalCount} activities")</span>
        <div class="pg-row">
            <a class="pg-btn@(Model.AuditLogs.Page <= 1 ? " is-disabled" : "")" href="@(Model.AuditLogs.Page <= 1 ? "#" : BuildQuery(page: Model.AuditLogs.Page - 1))">
                <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6" /></svg> Prev
            </a>
            @for (var p = 1; p <= totalPages; p++)
            {
                if (p == 1 || p == totalPages || Math.Abs(p - Model.AuditLogs.Page) <= 1)
                {
                    <a class="pg-btn@(p == Model.AuditLogs.Page ? " is-active" : "")" href="@BuildQuery(page: p)">@p</a>
                }
                else if (p == 2 || p == totalPages - 1)
                {
                    <span class="pg-btn" style="pointer-events:none">…</span>
                }
            }
            <a class="pg-btn@(Model.AuditLogs.Page >= totalPages ? " is-disabled" : "")" href="@(Model.AuditLogs.Page >= totalPages ? "#" : BuildQuery(page: Model.AuditLogs.Page + 1))">
                Next
                <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6" /></svg>
            </a>
        </div>
    </div>
</div>

<!-- Toast root -->
<div id="toast-root"></div>

<script>
    (function() {
        'use strict';

        /*TOAST */
        function toast(msg, type = 'info', icon = '✦') {
            const root = document.getElementById('toast-root');
            const el = document.createElement('div');
            el.className = 'toast';
            el.innerHTML = `<div class="toast-ic ${type}">${icon}</div><span class="toast-msg">${msg}</span>`;
            root.appendChild(el);
            setTimeout(() => { el.classList.add('out'); setTimeout(() => el.remove(), 300); }, 2800);
        }

        /* URL HELPERS — merge params, navigate (server round trip) */
        function navigateWithParams(params) {
            const url = new URL(window.location.href);
            Object.entries(params).forEach(([k, v]) => {
                if (v === null || v === undefined || v === '') { url.searchParams.delete(k); }
                else { url.searchParams.set(k, v); }
            });
            url.searchParams.set('page', '1'); // any filter change resets to page 1
            window.location.href = url.toString();
        }

        /* DROPDOWNS — generic open/close */
        const allDropdowns = [];

        function registerDropdown(triggerId, panelId) {
            const trigger = document.getElementById(triggerId);
            const panel = document.getElementById(panelId);
            if (!trigger || !panel) return;
            allDropdowns.push({ trigger, panel });

            trigger.addEventListener('click', e => {
                e.stopPropagation();
                const isOpen = panel.classList.contains('is-open');
                closeAllDropdowns();
                if (!isOpen) {
                    panel.classList.add('is-open');
                    trigger.classList.add('is-open');
                }
            });

            panel.addEventListener('click', e => e.stopPropagation());
        }

        function closeAllDropdowns() {
            allDropdowns.forEach(({ trigger, panel }) => {
                panel.classList.remove('is-open');
                trigger.classList.remove('is-open');
            });
        }

        document.addEventListener('click', closeAllDropdowns);

        registerDropdown('filter-trigger', 'filter-menu');
        registerDropdown('date-trigger', 'date-panel');
        registerDropdown('btn-notif', 'notif-panel');

        /* DATE RANGE — apply triggers a real navigation */

        document.getElementById('date-apply').addEventListener('click', e => {
            e.stopPropagation();
            const from = document.getElementById('date-from').value;
            const to = document.getElementById('date-to').value;
            if ((from && !to) || (!from && to)) { toast('Please select both dates', 'warn', '⚠️'); return; }
            if (from && to && from > to) { toast('Start date must be before end date', 'warn', '⚠️'); return; }
            navigateWithParams({ from: from || null, to: to || null });
        });

        /* SEARCH — debounced navigation (server round trip) */
        const searchInput = document.getElementById('search-input');
        let searchDebounce;
        searchInput.addEventListener('input', () => {
            clearTimeout(searchDebounce);
            searchDebounce = setTimeout(() => {
                navigateWithParams({ search: searchInput.value.trim() || null });
            }, 700);
        });
        searchInput.addEventListener('keydown', e => {
            if (e.key === 'Enter') {
                clearTimeout(searchDebounce);
                navigateWithParams({ search: searchInput.value.trim() || null });
            }
            if (e.key === 'Escape') { searchInput.value = ''; }
        });

        /* NOTIFICATIONS — AJAX mark-as-read */
        const notifList = document.getElementById('notif-list');

        function updateBadge() {
            const count = notifList.querySelectorAll('.notif-row.unread').length;
            const badge = document.getElementById('notif-count');
            badge.textContent = count;
            badge.style.display = count ? '' : 'none';
        }

        notifList.querySelectorAll('.notif-row').forEach(row => {
            row.addEventListener('click', () => {
                if (!row.classList.contains('unread')) return;
                const id = row.dataset.id;
                fetch('@Url.Action("MarkNotificationRead", "ReaderActivity")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'id=' + encodeURIComponent(id)
                })
                    .then(r => r.json())
                    .then(res => {
                        if (res.success) {
                            row.classList.remove('unread');
                            row.querySelector('.notif-dot').className = 'notif-dot off';
                            updateBadge();
                        } else {
                            toast(res.message || 'Could not update notification', 'warn', '⚠️');
                        }
                    })
                    .catch(() => toast('Network error', 'warn', '⚠️'));
            });
        });

        document.getElementById('notif-mark-all').addEventListener('click', e => {
            e.stopPropagation();
            fetch('@Url.Action("MarkAllNotificationsRead", "ReaderActivity")', { method: 'POST' })
                .then(r => r.json())
                .then(res => {
                    if (res.success) {
                        notifList.querySelectorAll('.notif-row').forEach(r => {
                            r.classList.remove('unread');
                            r.querySelector('.notif-dot').className = 'notif-dot off';
                        });
                        updateBadge();
                        toast('All notifications marked as read', 'success', '✓');
                    } else {
                        toast(res.message || 'Could not update notifications', 'warn', '⚠️');
                    }
                })
                .catch(() => toast('Network error', 'warn', '⚠️'));
        });

        /*BACK BUTTON */

        document.getElementById('btn-back').addEventListener('click', () => {
            history.back();
        });

    })();
</script>
