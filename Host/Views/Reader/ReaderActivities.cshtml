@{
    ViewData["Title"] = "My Activities";
    Layout = "~/Views/Shared/_ReaderLayout.cshtml";
}
<link href="~/css/readerActivities.css" rel="stylesheet" />
    <!-- TOPBAR -->
    <div class="topbar">
        <button class="tb-back" id="btn-back" title="Go back">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6" /></svg>
        </button>

        <div class="tb-search">
            <span class="tb-search-ic">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
            </span>
            <input type="text" id="search-input" placeholder="Search books, authors…" autocomplete="off" />
        </div>

        <div class="tb-right">
            <!-- Notification button + panel -->
            <div class="dd-wrap" id="notif-wrap" style="position:relative">
                <button class="tb-notif" id="btn-notif">
                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" /></svg>
                    <span class="tb-badge" id="notif-count">8</span>
                </button>
                <div class="notif-panel" id="notif-panel">
                    <div class="notif-head">
                        <span class="notif-head-title">Notifications</span>
                        <span class="notif-mark" id="notif-mark-all">Mark all read</span>
                    </div>
                    <div class="notif-list" id="notif-list"></div>
                </div>
            </div>

            <div class="tb-avatar">
                <div class="tb-av">JD</div>
                <svg width="14" height="14" fill="none" stroke="#6b6990" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg>
            </div>
        </div>
    </div>

    <!-- MAIN CONTENT -->
    <div class="ac-content">
        <div class="ac-header">
            <h1 class="ac-title">All Activity</h1>
            <p class="ac-sub">A complete history of your reading activity and account updates.</p>
        </div>

        <!-- Toolbar -->
        <div class="ac-toolbar">
            <div class="tb-left">
                <span class="tb-lbl">Filter by</span>
                <div class="dd-wrap" id="filter-wrap">
                    <div class="dd-trigger" id="filter-trigger">
                        <span id="filter-label">All Activities</span>
                        <svg class="dd-caret" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg>
                    </div>
                    <div class="dd-menu" id="filter-menu">
                        <div class="dd-section-label">Activity type</div>
                        <div class="dd-item is-active" data-val="all" data-label="All Activities">
                            <span class="dd-item-icon">📋</span> All Activities
                            <svg class="dd-check" width="12" height="12" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12" /></svg>
                        </div>
                        <div class="dd-item" data-val="reading" data-label="Reading Sessions">
                            <span class="dd-item-icon">📖</span> Reading Sessions
                            <svg class="dd-check" width="12" height="12" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12" /></svg>
                        </div>
                        <div class="dd-item" data-val="completed" data-label="Completed Books">
                            <span class="dd-item-icon">✅</span> Completed Books
                            <svg class="dd-check" width="12" height="12" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12" /></svg>
                        </div>
                        <div class="dd-item" data-val="reviews" data-label="Reviews">
                            <span class="dd-item-icon">⭐</span> Reviews
                            <svg class="dd-check" width="12" height="12" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12" /></svg>
                        </div>
                        <div class="dd-item" data-val="streak" data-label="Streaks & Achievements">
                            <span class="dd-item-icon">🔥</span> Streaks & Achievements
                            <svg class="dd-check" width="12" height="12" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12" /></svg>
                        </div>
                        <div class="dd-item" data-val="favorites" data-label="Favorites">
                            <span class="dd-item-icon">❤️</span> Favorites
                            <svg class="dd-check" width="12" height="12" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12" /></svg>
                        </div>
                        <div class="dd-sep"></div>
                        <div class="dd-item" data-val="subscription" data-label="Subscription">
                            <span class="dd-item-icon">💳</span> Subscription
                            <svg class="dd-check" width="12" height="12" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12" /></svg>
                        </div>
                        <div class="dd-item" data-val="downloads" data-label="Downloads">
                            <span class="dd-item-icon">⬇️</span> Downloads
                            <svg class="dd-check" width="12" height="12" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12" /></svg>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Date range -->
            <div class="dd-wrap" id="date-wrap">
                <div class="dd-trigger" id="date-trigger">
                    <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
                    <span id="date-label">May 14 – May 15, 2024</span>
                    <svg class="dd-caret" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg>
                </div>
                <div class="date-panel" id="date-panel">
                    <div class="date-panel-title">Select date range</div>
                    <div id="date-presets">
                        <div class="date-preset" data-label="Today" data-range="Today">
                            <span class="date-preset-name">Today</span>
                            <span class="date-preset-range">Jun 28, 2026</span>
                        </div>
                        <div class="date-preset" data-label="Yesterday" data-range="Yesterday">
                            <span class="date-preset-name">Yesterday</span>
                            <span class="date-preset-range">Jun 27, 2026</span>
                        </div>
                        <div class="date-preset" data-label="Last 7 days" data-range="Jun 21 – Jun 28, 2026">
                            <span class="date-preset-name">Last 7 days</span>
                            <span class="date-preset-range">Jun 21 – Jun 28</span>
                        </div>
                        <div class="date-preset" data-label="Last 30 days" data-range="May 29 – Jun 28, 2026">
                            <span class="date-preset-name">Last 30 days</span>
                            <span class="date-preset-range">May 29 – Jun 28</span>
                        </div>
                        <div class="date-preset is-active" data-label="May 14 – May 15, 2024" data-range="May 14 – May 15, 2024">
                            <span class="date-preset-name">May 14 – May 15, 2024</span>
                            <span class="date-preset-range">Custom</span>
                        </div>
                    </div>
                    <div class="date-sep"></div>
                    <div class="date-custom-lbl">Custom range</div>
                    <div class="date-row">
                        <input type="date" id="date-from" value="2024-05-14" />
                        <span class="date-row-sep">→</span>
                        <input type="date" id="date-to" value="2024-05-15" />
                    </div>
                    <button class="date-apply-btn" id="date-apply">Apply range</button>
                </div>
            </div>
        </div>

        <!-- Table -->
        <div class="ac-table-wrap">
            <div class="ac-thead">
                <div class="ac-th">Activity</div>
                <div class="ac-th">Details</div>
                <div class="ac-th">Date &amp; Time</div>
            </div>
            <div id="activity-list"></div>
            <div class="ac-empty" id="ac-empty">
                <div class="ac-empty-emoji">🔍</div>
                <h3>No activities found</h3>
                <p>Try adjusting your search or filter.</p>
                <button class="ac-empty-reset" id="btn-reset">Clear filters</button>
            </div>
        </div>

        <!-- Footer -->
        <div class="ac-footer">
            <span class="ac-showing" id="ac-showing"></span>
            <div class="pg-row" id="pg-row"></div>
        </div>
    </div>

    <!-- Toast root -->
    <div id="toast-root"></div>

