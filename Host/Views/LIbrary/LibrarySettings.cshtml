@model Application.Queries.GetLibrarySettings.GetLibrarySettingsResponse
@{
    Layout = "~/Views/Shared/_LibraryLayout.cshtml";
    ViewData["Title"] = "Library Settings";
}

<link href="~/css/librarySettings.css" rel="stylesheet" />

@Html.AntiForgeryToken()

<main class="ah-settings-main">

    <!--  HEADER  -->
    <div class="ah-settings-header">
        <div class="ah-settings-header-left">
            <h1>Settings</h1>
            <nav class="ah-breadcrumb" aria-label="Breadcrumb">
                <span>Home</span><span class="ah-sep">/</span><span>Settings</span><span class="ah-sep">/</span><span id="ah-breadcrumb-current" class="ah-current">General</span>
            </nav>
        </div>
        <div class="ah-settings-header-right">
            <button type="button" class="ah-date-range-btn">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
                <span>May 1 – May 31, 2024</span>
            </button>
            <button type="button" class="ah-btn ah-btn-primary ah-js-save-changes">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12" /></svg>
                Save Changes
            </button>
        </div>
    </div>

    <!-- BODY: content + sidebar -->
    <div class="ah-settings-body">

        <!-- LEFT: General panel       -->
        <div class="ah-settings-content">

            <!-- GENERAL  -->
            <section class="ah-tab-panel ah-active" data-tab-content="general">

                <div class="ah-card">
                    <div class="ah-card-header">
                        <div>
                            <h3>Library Information</h3>
                            <p>Update your library details and basic information.</p>
                        </div>
                    </div>
                    <div class="ah-form-grid ah-cols-3">
                        <div class="ah-field"><label for="gen-name">Library Name</label><input id="gen-name" data-field="name" type="text" value="@Model.Library.Name"></div>
                        <div class="ah-field"><label for="gen-email">Library Email</label><input id="gen-email" data-field="email" type="email" value="@Model.Library.Email"></div>
                        <div class="ah-field"><label for="gen-phone">Library Phone</label><input id="gen-phone" data-field="phoneNumber" type="tel" value="@Model.Library.PhoneNumber"></div>
                        <div class="ah-field"><label for="gen-address">Library Address</label><input id="gen-address" data-field="address" type="text" value="@Model.Library.Address"></div>
                        <div class="ah-field"><label for="gen-website">Library Website</label><input id="gen-website" data-field="website" type="url" value="@Model.Library.Website"></div>
                        <div class="ah-field"><label for="gen-desc">Library Description</label><textarea id="gen-desc" data-field="description">@Model.Library.Description</textarea></div>
                    </div>
                </div>

                <div class="ah-card">
                    <div class="ah-card-header">
                        <div>
                            <h3>Regional Settings</h3>
                            <p>Set your library's regional and localization preferences.</p>
                        </div>
                    </div>
                    <div class="ah-form-grid">
                        <div class="ah-field">
                            <label for="gen-lang">Language</label>
                            <select id="gen-lang"><option>English (US)</option><option>English (UK)</option><option>Spanish</option><option>French</option></select>
                        </div>
                        <div class="ah-field">
                            <label for="gen-tz">Time Zone</label>
                            <select id="gen-tz"><option>(UTC-05:00) Eastern Time (US & Canada)</option><option>(UTC-08:00) Pacific Time</option><option>(UTC+00:00) London</option></select>
                        </div>
                        <div class="ah-field">
                            <label for="gen-date">Date Format</label>
                            <select id="gen-date"><option>May 31, 2024</option><option>31/05/2024</option><option>2024-05-31</option></select>
                        </div>
                        <div class="ah-field">
                            <label for="gen-time">Time Format</label>
                            <select id="gen-time"><option>12 Hour (01:30 PM)</option><option>24 Hour (13:30)</option></select>
                        </div>
                        <div class="ah-field">
                            <label for="gen-currency">Currency</label>
                            <select id="gen-currency"><option>USD - US Dollar ($)</option><option>EUR - Euro (€)</option><option>GBP - Pound (£)</option></select>
                        </div>
                    </div>
                </div>

                <div class="ah-card">
                    <div class="ah-card-header">
                        <div>
                            <h3>System Preferences</h3>
                            <p>Configure general system preferences for your library.</p>
                        </div>
                    </div>
                    <div class="ah-form-grid">
                        <div class="ah-switch-row ah-with-icon">
                            <div class="ah-switch-copy">
                                <div class="ah-row-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg></div>
                                <div><strong>Maintenance Mode</strong><span>Temporarily disable public access to your library.</span></div>
                            </div>
                            <label class="ah-switch"><input type="checkbox"><span class="ah-slider"></span></label>
                        </div>
                        <div class="ah-switch-row ah-with-icon">
                            <div class="ah-switch-copy">
                                <div class="ah-row-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg></div>
                                <div><strong>Allow Reader Registration</strong><span>Allow new readers to register in your library.</span></div>
                            </div>
                            <label class="ah-switch"><input type="checkbox" checked><span class="ah-slider"></span></label>
                        </div>
                        <div class="ah-switch-row ah-with-icon">
                            <div class="ah-switch-copy">
                                <div class="ah-row-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" /><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" /></svg></div>
                                <div><strong>Auto Approve Books</strong><span>Automatically approve submitted books.</span></div>
                            </div>
                            <label class="ah-switch"><input type="checkbox" checked><span class="ah-slider"></span></label>
                        </div>
                        <div class="ah-switch-row ah-with-icon">
                            <div class="ah-switch-copy">
                                <div class="ah-row-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v16H4z" opacity="0" /><path d="M22 6l-10 7L2 6" /><rect x="2" y="4" width="20" height="16" rx="2" /></svg></div>
                                <div><strong>Enable Email Notifications</strong><span>Receive important updates via email.</span></div>
                            </div>
                            <label class="ah-switch"><input type="checkbox" checked="@Model.NotificationPreferences.EmailEnabled"><span class="ah-slider"></span></label>
                        </div>
                    </div>
                </div>

            </section>

        </div>

        <!-- RIGHT: General sidebar                                  -->
        <aside class="ah-settings-sidebar">

            <div class="ah-sidebar-panel ah-active" data-sidebar-content="general">
                <div class="ah-card ah-hero-block">
                    <div class="ah-avatar-upload ah-hero-avatar-upload">
                        <div class="ah-avatar-wrap ah-hero-icon-circle">
                            @if (!string.IsNullOrEmpty(Model.Profile.AvatarUrl))
                            {
                                <img src="@Model.Profile.AvatarUrl" alt="@Model.Library.Name logo" id="genHeroLogoImg">
                                <div class="ah-avatar-placeholder ah-hidden" id="genHeroLogoPlaceholder">
                                    <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
                                        <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
                                    </svg>
                                </div>
                            }
                            else
                            {
                                <img src="" alt="@Model.Library.Name logo" id="genHeroLogoImg" class="ah-hidden">
                                <div class="ah-avatar-placeholder" id="genHeroLogoPlaceholder">
                                    <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
                                        <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
                                    </svg>
                                </div>
                            }
                            <label class="ah-avatar-edit" for="genHeroLogoFileInput" aria-label="Change logo" title="Change logo">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z" /><circle cx="12" cy="13" r="4" /></svg>
                            </label>
                            <input type="file" id="genHeroLogoFileInput" name="LogoFile" accept="image/*" style="display:none" />
                        </div>
                    </div>
                    <p class="ah-hero-title">@Model.Library.Name</p>
                    <span class="ah-badge ah-badge-purple">Verified Library</span>
                    <div class="ah-divider" style="margin:16px 0;"></div>
                    <div class="ah-info-list">
                        <div class="ah-info-row"><span>Library ID</span><span>@Model.Profile.Username-0112a-990</span></div>
                        <div class="ah-info-row"><span>Member Since</span><span>@Model.AccountOverview.MemberSince.ToString("MMM d, yyyy")</span></div>
                        <div class="ah-info-row"><span>Plan</span><span class="ah-badge ah-badge-success">Premium Plan</span></div>
                        <div class="ah-info-row"><span>Renewal Date</span><span>Jun 15, 2024</span></div>
                    </div>
                </div>
                <div class="ah-card">
                    <div class="ah-card-header"><h3>Quick Actions</h3></div>
                    <ul class="ah-quick-actions">
                        <li><button type="button"><svg class="ah-leading" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>Change Password<svg class="ah-trailing" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6" /></svg></button></li>
                        <li><button type="button"><svg class="ah-leading" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" /></svg>Notification Settings<svg class="ah-trailing" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6" /></svg></button></li>
                        <li><button type="button"><svg class="ah-leading" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /></svg>Manage Administrators<svg class="ah-trailing" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6" /></svg></button></li>
                        <li><button type="button"><svg class="ah-leading" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>View Activity Logs<svg class="ah-trailing" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6" /></svg></button></li>
                        <li><button type="button"><svg class="ah-leading" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>Export Settings<svg class="ah-trailing" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6" /></svg></button></li>
                    </ul>
                </div>
                <div class="ah-card">
                    <div class="ah-card-header"><h3>Security Summary</h3></div>
                    <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
                        <div class="ah-row-icon" style="background:var(--ah-success-soft);color:var(--ah-success);width:40px;height:40px;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /><polyline points="9 12 11 14 15 10" /></svg></div>
                        <div><strong style="font-size:13.5px;display:block;">Your account is secure</strong><span style="font-size:12px;color:var(--ah-text-faint);">Last security check: May 31, 2024</span></div>
                    </div>
                    <ul class="ah-checklist">
                        <li><span class="ah-left"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12" /></svg>Two-Factor Authentication</span><span class="ah-val" style="color:var(--ah-success);">@(Model.Security.TwoFactorEnabled ? "Enabled" : "Disabled")</span></li>
                        <li><span class="ah-left"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12" /></svg>Login Alerts</span><span class="ah-val" style="color:var(--ah-success);">Enabled</span></li>
                        <li><span class="ah-left"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12" /></svg>Password Strength</span><span class="ah-val" style="color:var(--ah-success);">Strong</span></li>
                        <li><span class="ah-left"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12" /></svg>Active Sessions</span><span class="ah-val" style="color:var(--ah-success);">@Model.Security.ActiveSessionsCount Active</span></li>
                    </ul>
                </div>
            </div>

        </aside>

    </div>

</main>

<script>
    (function() {
        "use strict";

        function init() {

            const root = document.querySelector(".ah-settings-main");
            if (!root) return;

            function showAvatarPreview(imgSelector, placeholderSelector, dataUrl) {
                const img = root.querySelector(imgSelector);
                const placeholder = root.querySelector(placeholderSelector);
                if (img) {
                    img.src = dataUrl;
                    img.classList.remove("ah-hidden");
                }
                if (placeholder) placeholder.classList.add("ah-hidden");
            }

            const heroLogoInput = root.querySelector("#genHeroLogoFileInput");
            let selectedLogoFile = null;

            if (heroLogoInput) {
                heroLogoInput.addEventListener("change", function() {
                    const file = this.files[0];
                    if (!file) return;
                    selectedLogoFile = file;
                    const reader = new FileReader();
                    reader.onload = (e) => showAvatarPreview("#genHeroLogoImg", "#genHeroLogoPlaceholder", e.target.result);
                    reader.readAsDataURL(file);
                });
            }

            function getAntiForgeryToken() {
                const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                return tokenInput ? tokenInput.value : "";
            }

            function setSaveButtonState(btn, state, label) {
                const icons = {
                    idle: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12" /></svg>`,
                    saving: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="ah-spin"><circle cx="12" cy="12" r="9" stroke-dasharray="42" stroke-dashoffset="14" /></svg>`,
                    saved: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12" /></svg>`,
                    error: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>`
                };
                btn.innerHTML = `${icons[state] || icons.idle} ${label}`;
            }

            /* Save Changes — real submission */
            root.querySelectorAll(".ah-js-save-changes").forEach((btn) => {
                btn.addEventListener("click", async () => {
                    const original = btn.innerHTML;
                    btn.disabled = true;
                    setSaveButtonState(btn, "saving", "Saving...");

                    try {
                        const formData = new FormData();

                        root.querySelectorAll("[data-field]").forEach((field) => {
                            const key = field.getAttribute("data-field");
                            formData.append(key, field.value);
                        });

                        if (selectedLogoFile) {
                            formData.append("logoFile", selectedLogoFile);
                        }

                        formData.append("__RequestVerificationToken", getAntiForgeryToken());

                        const response = await fetch("/Library/UpdateLibrarySettings", {
                            method: "POST",
                            body: formData
                        });

                        if (!response.ok) {
                            throw new Error(`Request failed with status ${response.status}`);
                        }

                        const result = await response.json();

                        if (!result.success) {
                            throw new Error(result.message || "Failed to save settings.");
                        }

                        if (result.logoUrl) {
                            const heroLogoImg = root.querySelector("#genHeroLogoImg");
                            if (heroLogoImg) heroLogoImg.src = result.logoUrl;
                        }

                        setSaveButtonState(btn, "saved", "Saved");
                        setTimeout(() => {
                            btn.innerHTML = original;
                            btn.disabled = false;
                        }, 1800);

                    } catch (err) {
                        console.error("Failed to save library settings:", err);
                        setSaveButtonState(btn, "error", "Failed to save");
                        setTimeout(() => {
                            btn.innerHTML = original;
                            btn.disabled = false;
                        }, 2200);
                    }
                });
            });
        }

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", init);
        } else {
            init();
        }
    })();
</script>