@model Application.Queries.GetLibrarySettings.GetLibrarySettingsResponse
@{
    Layout = "~/Views/Shared/_LibraryLayout.cshtml";
    ViewData["Title"] = "Library Settings";
}

<link href="~/css/librarySettings.css" rel="stylesheet" />
<style>
    .ah-avatar-upload .ah-avatar-wrap-square img {
        border-radius: var(--ah-radius-sm);
    }
</style>

<main class="ah-settings-main">

    <!-- ============ HEADER ============ -->
    <div class="ah-settings-header">
        <div class="ah-settings-header-left">
            <h1>Settings</h1>
            <nav class="ah-breadcrumb" aria-label="Breadcrumb">
                <span>Home</span><span class="ah-sep">/</span><span>Settings</span><span class="ah-sep">/</span><span id="ah-breadcrumb-current" class="ah-current">General</span>
            </nav>
        </div>
        <div class="ah-settings-header-right">
            <button type="button" class="ah-date-range-btn">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
                <span>May 1 – May 31, 2024</span>
            </button>
            <button type="button" class="ah-btn ah-btn-primary ah-js-save-changes">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12" /></svg>
                Save Changes
            </button>
        </div>
    </div>

    <!-- ============ BODY: content + sidebar ============ -->
    <div class="ah-settings-body">

        <!-- ====================================================== -->
        <!-- LEFT: tab content panels                                -->
        <!-- ====================================================== -->
        <div class="ah-settings-content">

            <!-- ---------------- GENERAL ---------------- -->
            <section class="ah-tab-panel ah-active" data-tab-content="general">

                <div class="ah-card">
                    <div class="ah-card-header">
                        <div>
                            <h3>Library Information</h3>
                            <p>Update your library details and basic information.</p>
                        </div>
                    </div>
                    <div class="ah-form-grid ah-cols-3">
                        <div class="ah-field"><label for="gen-name">Library Name</label><input id="gen-name" type="text" value="@Model.Library.Name"></div>
                        <div class="ah-field"><label for="gen-email">Library Email</label><input id="gen-email" type="email" value="@Model.Library.Email"></div>
                        <div class="ah-field"><label for="gen-phone">Library Phone</label><input id="gen-phone" type="tel" value="@Model.Library.PhoneNumber"></div>
                        <div class="ah-field"><label for="gen-address">Library Address</label><input id="gen-address" type="text" value="@Model.Library.Address"></div>
                        <div class="ah-field"><label for="gen-website">Library Website</label><input id="gen-website" type="url" value="@Model.Library.Website"></div>
                        <div class="ah-field"><label for="gen-desc">Library Description</label><textarea id="gen-desc">@Model.Library.Description</textarea></div>
                        <div class="ah-field">
                            <label>Library Logo</label>
                            <div class="ah-avatar-upload">
                                <div class="ah-avatar-wrap ah-avatar-wrap-square">
                                    <img src="@(!string.IsNullOrEmpty(Model.Profile.AvatarUrl) ? Model.Profile.AvatarUrl : "https://ui-avatars.com/api/?name=" + Uri.EscapeDataString(Model.Library.Name) + "&background=7c6aff&color=fff")"
                                         alt="@Model.Library.Name logo" id="genLogoImg">
                                    <label class="ah-avatar-edit" for="genLogoFileInput" aria-label="Change logo" title="Change logo">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z" /><circle cx="12" cy="13" r="4" /></svg>
                                    </label>
                                    <input type="file" id="genLogoFileInput" name="LogoFile" accept="image/*" style="display:none" />
                                </div>
                                <span class="ah-avatar-hint">Recommended: 512x512px<br>PNG, SVG or JPG. Max size 2MB</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="ah-card">
                    <div class="ah-card-header">
                        <div>
                            <h3>Regional Settings</h3>
                            <p>Set your library's regional and localization preferences.</p>
                        </div>
                    </div>
                    <div class="ah-form-grid">
                        <div class="ah-field">
                            <label for="gen-lang">Language</label>
                            <select id="gen-lang"><option>English (US)</option><option>English (UK)</option><option>Spanish</option><option>French</option></select>
                        </div>
                        <div class="ah-field">
                            <label for="gen-tz">Time Zone</label>
                            <select id="gen-tz"><option>(UTC-05:00) Eastern Time (US & Canada)</option><option>(UTC-08:00) Pacific Time</option><option>(UTC+00:00) London</option></select>
                        </div>
                        <div class="ah-field">
                            <label for="gen-date">Date Format</label>
                            <select id="gen-date"><option>May 31, 2024</option><option>31/05/2024</option><option>2024-05-31</option></select>
                        </div>
                        <div class="ah-field">
                            <label for="gen-time">Time Format</label>
                            <select id="gen-time"><option>12 Hour (01:30 PM)</option><option>24 Hour (13:30)</option></select>
                        </div>
                        <div class="ah-field">
                            <label for="gen-currency">Currency</label>
                            <select id="gen-currency"><option>USD - US Dollar ($)</option><option>EUR - Euro (€)</option><option>GBP - Pound (£)</option></select>
                        </div>
                    </div>
                </div>

                <div class="ah-card">
                    <div class="ah-card-header">
                        <div>
                            <h3>System Preferences</h3>
                            <p>Configure general system preferences for your library.</p>
                        </div>
                    </div>
                    <div class="ah-form-grid">
                        <div class="ah-switch-row ah-with-icon">
                            <div class="ah-switch-copy">
                                <div class="ah-row-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg></div>
                                <div><strong>Maintenance Mode</strong><span>Temporarily disable public access to your library.</span></div>
                            </div>
                            <label class="ah-switch"><input type="checkbox"><span class="ah-slider"></span></label>
                        </div>
                        <div class="ah-switch-row ah-with-icon">
                            <div class="ah-switch-copy">
                                <div class="ah-row-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg></div>
                                <div><strong>Allow Reader Registration</strong><span>Allow new readers to register in your library.</span></div>
                            </div>
                            <label class="ah-switch"><input type="checkbox" checked><span class="ah-slider"></span></label>
                        </div>
                        <div class="ah-switch-row ah-with-icon">
                            <div class="ah-switch-copy">
                                <div class="ah-row-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" /><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" /></svg></div>
                                <div><strong>Auto Approve Books</strong><span>Automatically approve submitted books.</span></div>
                            </div>
                            <label class="ah-switch"><input type="checkbox" checked><span class="ah-slider"></span></label>
                        </div>
                        <div class="ah-switch-row ah-with-icon">
                            <div class="ah-switch-copy">
                                <div class="ah-row-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v16H4z" opacity="0" /><path d="M22 6l-10 7L2 6" /><rect x="2" y="4" width="20" height="16" rx="2" /></svg></div>
                                <div><strong>Enable Email Notifications</strong><span>Receive important updates via email.</span></div>
                            </div>
                            <label class="ah-switch"><input type="checkbox" checked="@Model.NotificationPreferences.EmailEnabled"><span class="ah-slider"></span></label>
                        </div>
                    </div>
                </div>

            </section>

            <!-- ---------------- PROFILE ---------------- -->
            <section class="ah-tab-panel" data-tab-content="profile">

                <div class="ah-card">
                    <div class="ah-card-header">
                        <div>
                            <h3>Profile Information</h3>
                            <p>Update your personal information and profile details.</p>
                        </div>
                    </div>
                    <div class="ah-form-grid ah-cols-3">
                        <div class="ah-field" style="grid-row: span 2;">
                            <label>Photo</label>
                            <div class="ah-avatar-upload">
                                <div class="ah-avatar-wrap">
                                    <img src="@(!string.IsNullOrEmpty(Model.Profile.AvatarUrl) ? Model.Profile.AvatarUrl : "https://i.pravatar.cc/96?img=12")" alt="@Model.Profile.FullName avatar" id="pfAvatarImg">
                                    <label class="ah-avatar-edit" for="pfAvatarFileInput" aria-label="Change photo" title="Change photo">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z" /><circle cx="12" cy="13" r="4" /></svg>
                                    </label>
                                    <input type="file" id="pfAvatarFileInput" name="AvatarFile" accept="image/*" style="display:none" />
                                </div>
                                <span class="ah-avatar-hint">Recommended: 500x500px<br>JPG, PNG or SVG. Max size 2MB</span>
                            </div>
                        </div>
                        <div class="ah-field"><label for="pf-name">Full Name</label><input id="pf-name" type="text" value="@Model.Profile.FullName"></div>
                        <div class="ah-field"><label for="pf-email">Email Address</label><input id="pf-email" type="email" value="@Model.Profile.Email"></div>
                        <div class="ah-field"><label for="pf-phone">Phone Number</label><input id="pf-phone" type="tel" value="+1 (555) 123-4567"></div>
                        <div class="ah-field">
                            <label for="pf-title">Job Title / Position</label>
                            <select id="pf-title"><option>Library Administrator</option><option>Librarian</option><option>Content Moderator</option></select>
                        </div>
                        <div class="ah-field ah-span-2">
                            <label for="pf-bio">Bio / About</label>
                            <textarea id="pf-bio" data-maxlength="250" maxlength="250">@Model.Profile.Bio</textarea>
                            <span class="ah-char-count">@Model.Profile.Bio.Length/250</span>
                        </div>
                    </div>
                </div>

                <div class="ah-card">
                    <div class="ah-card-header">
                        <div>
                            <h3>Account Information</h3>
                            <p>View your account and membership information.</p>
                        </div>
                    </div>
                    <div class="ah-form-grid ah-cols-4">
                        <div class="ah-field"><label>Admin ID</label><div class="ah-info-static">LIB-2024-000123</div></div>
                        <div class="ah-field"><label>Username</label><div class="ah-info-static">@Model.Profile.Username</div></div>
                        <div class="ah-field"><label>Member Since</label><div class="ah-info-static">@Model.Profile.MemberSince.ToString("MMM d, yyyy")</div></div>
                        <div class="ah-field"><label>Last Login</label><div class="ah-info-static">May 31, 2024 10:15 AM</div></div>
                    </div>
                    <div style="margin-top:14px;"><span class="ah-badge ah-badge-success">Account Active</span></div>
                </div>

                <div class="ah-card">
                    <div class="ah-card-header">
                        <div>
                            <h3>Security</h3>
                            <p>Manage your password and account security.</p>
                        </div>
                    </div>
                    <div class="ah-form-grid ah-cols-3">
                        <div class="ah-field">
                            <label for="pf-pass">Password</label>
                            <div class="ah-password-field">
                                <input id="pf-pass" type="password" value="averystrongpassword">
                            </div>
                            <button type="button" class="ah-btn ah-btn-secondary ah-btn-sm" style="margin-top:6px;">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                                Change Password
                            </button>
                        </div>
                        <div class="ah-field">
                            <label>Two-Factor Authentication</label>
                            <span class="ah-field-hint">Add an extra layer of security to your account.</span>
                            <span class="ah-badge @(Model.Security.TwoFactorEnabled ? "ah-badge-success" : "ah-badge-neutral")" style="width:fit-content;">@(Model.Security.TwoFactorEnabled ? "Enabled" : "Disabled")</span>
                        </div>
                        <div class="ah-field">
                            <label>Active Sessions</label>
                            <span class="ah-field-hint">You are currently logged in on @Model.Security.ActiveSessionsCount device(s).</span>
                            <button type="button" class="ah-btn ah-btn-secondary ah-btn-sm" style="width:fit-content;">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" /><line x1="8" y1="21" x2="16" y2="21" /><line x1="12" y1="17" x2="12" y2="21" /></svg>
                                View Sessions
                            </button>
                        </div>
                    </div>
                </div>

                <div class="ah-card">
                    <div class="ah-card-header">
                        <div>
                            <h3>Preferences</h3>
                            <p>Manage your preferences and notification settings.</p>
                        </div>
                    </div>
                    <div class="ah-form-grid ah-cols-3">
                        <div class="ah-field">
                            <label for="pf-theme">Theme Preference</label>
                            <select id="pf-theme">
                                <option value="dark" selected="@(Model.Preferences.Theme == "dark")">Dark</option>
                                <option value="light" selected="@(Model.Preferences.Theme == "light")">Light</option>
                                <option value="system" selected="@(Model.Preferences.Theme == "system")">System</option>
                            </select>
                        </div>
                        <div class="ah-field">
                            <label for="pf-lang">Language</label>
                            <select id="pf-lang">
                                <option value="en" selected="@(Model.Preferences.Language == "en")">English (US)</option>
                                <option value="es" selected="@(Model.Preferences.Language == "es")">Spanish</option>
                            </select>
                        </div>
                        <div class="ah-field">
                            <label for="pf-dateformat">Date Format</label>
                            <select id="pf-dateformat"><option>May 31, 2024</option><option>31/05/2024</option></select>
                        </div>
                    </div>
                    <div class="ah-form-grid" style="margin-top:8px;">
                        <div class="ah-switch-row">
                            <div class="ah-switch-copy"><strong>Email Notifications</strong><span>Receive updates via email.</span></div>
                            <label class="ah-switch"><input type="checkbox" checked="@Model.NotificationPreferences.EmailEnabled"><span class="ah-slider"></span></label>
                        </div>
                        <div class="ah-switch-row">
                            <div class="ah-switch-copy"><strong>In-App Notifications</strong><span>Receive in-app alerts.</span></div>
                            <label class="ah-switch"><input type="checkbox" checked="checked"><span class="ah-slider"></span></label>
                        </div>
                    </div>
                </div>

                <div class="ah-form-actions">
                    <button type="button" class="ah-btn ah-btn-primary ah-js-save-changes">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12" /></svg>
                        Save Changes
                    </button>
                    <button type="button" class="ah-btn ah-btn-secondary">Cancel</button>
                    <button type="button" class="ah-btn ah-btn-danger-outline">Reset Profile</button>
                </div>

            </section>

            <!-- ---------------- SECURITY ---------------- -->
            <section class="ah-tab-panel" data-tab-content="security">

                <div class="ah-card">
                    <div class="ah-card-header">
                        <div>
                            <h3>Change Password</h3>
                            <p>Update your password regularly to keep your account secure.</p>
                        </div>
                    </div>
                    <div class="ah-form-grid ah-cols-3">
                        <div class="ah-field">
                            <label for="sec-current">Current Password</label>
                            <div class="ah-password-field">
                                <input id="sec-current" type="password" value="averystrongpassword">
                                <button type="button" class="ah-eye-toggle" aria-label="Show password"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z" /><circle cx="12" cy="12" r="3" /></svg></button>
                            </div>
                        </div>
                        <div class="ah-field">
                            <label for="sec-new">New Password</label>
                            <div class="ah-password-field">
                                <input id="sec-new" type="password" value="averystrongpassword" data-password-strength>
                                <button type="button" class="ah-eye-toggle" aria-label="Show password"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z" /><circle cx="12" cy="12" r="3" /></svg></button>
                            </div>
                            <div class="ah-strength-meter">
                                <div class="ah-strength-bar"><div class="ah-strength-bar-fill" style="width:85%;background:#34d399;"></div></div>
                                <div class="ah-strength-label"><span>Use 8+ characters with a mix of letters, numbers & symbols.</span><span class="ah-level">Strong</span></div>
                            </div>
                        </div>
                        <div class="ah-field">
                            <label for="sec-confirm">Confirm New Password</label>
                            <div class="ah-password-field">
                                <input id="sec-confirm" type="password" value="averystrongpassword">
                                <button type="button" class="ah-eye-toggle" aria-label="Show password"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z" /><circle cx="12" cy="12" r="3" /></svg></button>
                            </div>
                        </div>
                    </div>
                    <div style="margin-top:18px;">
                        <button type="button" class="ah-btn ah-btn-primary">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                            Update Password
                        </button>
                    </div>
                </div>

                <div class="ah-card">
                    <div class="ah-card-header">
                        <div>
                            <h3>Two-Factor Authentication (2FA)</h3>
                            <p>Add an extra layer of security to your account.</p>
                        </div>
                    </div>
                    <div class="ah-form-grid">
                        <div class="ah-cell-with-icon">
                            <div class="ah-cell-icon" style="background:rgba(52,211,153,.14);color:#34d399;width:44px;height:44px;border-radius:12px;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /><polyline points="9 12 11 14 15 10" /></svg></div>
                            <div>
                                <strong style="color:@(Model.Security.TwoFactorEnabled ? "#34d399" : "var(--ah-text-dim)");display:block;font-size:14px;">
                                    2FA is @(Model.Security.TwoFactorEnabled ? "Enabled" : "Disabled")
                                </strong>
                                <span style="font-size:13px;color:var(--ah-text-dim);">Your account is protected with Two-Factor Authentication.</span>
                            </div>
                        </div>
                        <div style="display:flex;align-items:center;justify-content:space-between;gap:14px;border:1px solid var(--ah-border);border-radius:10px;padding:12px 14px;">
                            <div class="ah-cell-with-icon">
                                <div class="ah-cell-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2" /><line x1="12" y1="18" x2="12.01" y2="18" /></svg></div>
                                <div>
                                    <strong style="font-size:13.5px;">Authenticator App (TOTP) <span class="ah-badge ah-badge-purple">Primary</span></strong>
                                    <span class="ah-cell-sub">Added on Jan 15, 2024</span>
                                </div>
                            </div>
                            <button type="button" class="ah-btn ah-btn-secondary ah-btn-sm">Manage 2FA <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6" /></svg></button>
                        </div>
                    </div>
                </div>

                <div class="ah-card">
                    <div class="ah-card-header">
                        <div>
                            <h3>Active Sessions</h3>
                            <p>Manage your active sessions across different devices.</p>
                        </div>
                    </div>
                    <div class="ah-table-wrap">
                        <table class="ah-data-table">
                            <thead><tr><th>Device</th><th>Location</th><th>Browser</th><th>Last Active</th><th>Status</th><th>Action</th></tr></thead>
                            <tbody>
                                <!-- MOCK: no session-tracking table yet -->
                                <tr>
                                    <td><div class="ah-cell-with-icon"><div class="ah-cell-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" /><line x1="8" y1="21" x2="16" y2="21" /><line x1="12" y1="17" x2="12" y2="21" /></svg></div>Windows Desktop</div></td>
                                    <td>New York, USA<span class="ah-cell-sub">192.168.1.45</span></td>
                                    <td>Chrome 124.0.0.0</td>
                                    <td>May 31, 2024, 10:15 AM</td>
                                    <td><span class="ah-badge ah-badge-purple">Current Session</span></td>
                                    <td>—</td>
                                </tr>
                                <tr>
                                    <td><div class="ah-cell-with-icon"><div class="ah-cell-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="12" rx="2" /><line x1="2" y1="20" x2="22" y2="20" /></svg></div>MacBook Pro</div></td>
                                    <td>New York, USA<span class="ah-cell-sub">192.168.1.22</span></td>
                                    <td>Safari 17.4</td>
                                    <td>May 30, 2024, 09:45 PM</td>
                                    <td><span class="ah-badge ah-badge-success">Active</span></td>
                                    <td><button type="button" class="ah-btn ah-btn-danger-outline ah-btn-sm">Log Out</button></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div style="margin-top:16px;text-align:right;">
                        <button type="button" class="ah-btn ah-btn-danger-outline ah-btn-sm">Log Out All Other Sessions</button>
                    </div>
                </div>

                <div class="ah-card">
                    <div class="ah-card-header">
                        <div>
                            <h3>Login History</h3>
                            <p>Review your recent account login history.</p>
                        </div>
                        <button type="button" class="ah-link-btn">View All History <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6" /></svg></button>
                    </div>
                    <div class="ah-table-wrap">
                        <table class="ah-data-table">
                            <!-- MOCK: no audit-log source wired yet -->
