<script>
    (function() {
        "use strict";

        function init() {

            const root = document.querySelector(".ah-settings-main");
            if (!root) return;

            const tabButtons = Array.from(root.querySelectorAll(".ah-tab-btn"));
            const contentPanels = Array.from(root.querySelectorAll("[data-tab-content]"));
            const sidebarPanels = Array.from(root.querySelectorAll("[data-sidebar-content]"));
            const breadcrumbCurrent = root.querySelector("#ah-breadcrumb-current");

            /* ---------- Avatar photo preview (Profile tab) ---------- */
            const pfAvatarInput = root.querySelector("#pfAvatarFileInput");
            if (pfAvatarInput) {
                pfAvatarInput.addEventListener("change", function() {
                    const file = this.files[0];
                    if (!file) return;
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        const img = root.querySelector("#pfAvatarImg");
                        if (img) img.src = e.target.result;
                    };
                    reader.readAsDataURL(file);
                });
            }

            /* ---------- Library logo preview (General + Library Settings tabs) ---------- */
            [
                { input: "#genLogoFileInput", img: "#genLogoImg" },
                { input: "#libLogoFileInput", img: "#libLogoImg" },
            ].forEach(({ input, img }) => {
                const fileInput = root.querySelector(input);
                if (!fileInput) return;
                fileInput.addEventListener("change", function() {
                    const file = this.files[0];
                    if (!file) return;
                    const reader = new FileReader();
                    reader.onload = (e) => {
                        const target = root.querySelector(img);
                        if (target) target.src = e.target.result;
                    };
                    reader.readAsDataURL(file);
                });
            });

            function activateTab(tabName, { focus = false } = {}) {
                if (!tabName) return;

                tabButtons.forEach((btn) => {
                    const isActive = btn.dataset.tab === tabName;
                    btn.classList.toggle("ah-active", isActive);
                    btn.setAttribute("aria-selected", isActive ? "true" : "false");
                    if (isActive && focus) btn.focus();
                });

                contentPanels.forEach((panel) => {
                    panel.classList.toggle("ah-active", panel.dataset.tabContent === tabName);
                });

                sidebarPanels.forEach((panel) => {
                    panel.classList.toggle("ah-active", panel.dataset.sidebarContent === tabName);
                });

                if (breadcrumbCurrent) {
                    const activeBtn = tabButtons.find((b) => b.dataset.tab === tabName);
                    if (activeBtn) {
                        const label = activeBtn.querySelector(".ah-tab-label");
                        breadcrumbCurrent.textContent = label ? label.textContent : activeBtn.textContent.trim();
                    }
                }

                if (history.replaceState) {
                    history.replaceState(null, "", `#${tabName}`);
                }
            }

            tabButtons.forEach((btn) => {
                btn.addEventListener("click", () => activateTab(btn.dataset.tab));
            });

            root.querySelectorAll("[data-jump-tab]").forEach((btn) => {
                btn.addEventListener("click", () => activateTab(btn.dataset.jumpTab));
            });

            const tabsNav = root.querySelector(".ah-settings-tabs");
            if (tabsNav) {
                tabsNav.addEventListener("keydown", (e) => {
                    if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
                    const currentIndex = tabButtons.findIndex((b) => b.classList.contains("ah-active"));
                    if (currentIndex === -1) return;
                    const nextIndex =
                        e.key === "ArrowRight"
                            ? (currentIndex + 1) % tabButtons.length
                            : (currentIndex - 1 + tabButtons.length) % tabButtons.length;
                    activateTab(tabButtons[nextIndex].dataset.tab, { focus: true });
                });
            }

            const initialTab = window.location.hash.replace("#", "");
            const hasInitialTab = tabButtons.some((b) => b.dataset.tab === initialTab);
            const fallbackTab =
                (tabButtons.find((b) => b.classList.contains("ah-active")) || tabButtons[0])?.dataset.tab;
            activateTab(hasInitialTab ? initialTab : fallbackTab);

            const EYE_SVG = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg>`;
            const EYE_OFF_SVG = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.94 10.94 0 0 1 12 19c-7 0-11-7-11-7a18.5 18.5 0 0 1 4.22-5.06M9.9 4.24A10.94 10.94 0 0 1 12 5c7 0 11 7 11 7a18.5 18.5 0 0 1-2.16 3.19M14.12 14.12a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>`;

            root.querySelectorAll(".ah-eye-toggle").forEach((toggle) => {
                toggle.addEventListener("click", () => {
                    const input = toggle.parentElement.querySelector("input");
                    if (!input) return;
                    const isHidden = input.type === "password";
                    input.type = isHidden ? "text" : "password";
                    toggle.innerHTML = isHidden ? EYE_OFF_SVG : EYE_SVG;
                });
            });

            root.querySelectorAll("textarea[data-maxlength]").forEach((textarea) => {
                const max = parseInt(textarea.dataset.maxlength, 10);
                const counter = textarea.parentElement.querySelector(".ah-char-count");
                if (!counter) return;
                const update = () => {
                    counter.textContent = `${textarea.value.length}/${max}`;
                };
                textarea.addEventListener("input", update);
                update();
            });

            root.querySelectorAll("[data-password-strength]").forEach((input) => {
                const fieldWrap = input.closest(".field");
                const bar = fieldWrap?.querySelector(".ah-strength-bar-fill");
                const label = fieldWrap?.querySelector(".ah-strength-label .ah-level");
                if (!bar || !label) return;

                input.addEventListener("input", () => {
                    const val = input.value;
                    let score = 0;
                    if (val.length >= 8) score++;
                    if (/[A-Z]/.test(val)) score++;
                    if (/[0-9]/.test(val)) score++;
                    if (/[^A-Za-z0-9]/.test(val)) score++;

                    const levels = [
                        { width: "10%", color: "#f87171", text: "Weak" },
                        { width: "35%", color: "#f87171", text: "Weak" },
                        { width: "60%", color: "#fbbf24", text: "Fair" },
                        { width: "85%", color: "#34d399", text: "Good" },
                        { width: "100%", color: "#34d399", text: "Strong" },
                    ];
                    const lvl = levels[Math.min(score, levels.length - 1)];
                    bar.style.width = val ? lvl.width : "0%";
                    bar.style.background = lvl.color;
                    label.textContent = val ? lvl.text : "";
                });
            });

            root.querySelectorAll("[data-toggle-target]").forEach((toggle) => {
                const targetSelector = toggle.dataset.toggleTarget;
                const targets = root.querySelectorAll(targetSelector);
                const sync = () => {
                    targets.forEach((t) => {
                        t.disabled = !toggle.checked;
                    });
                };
                toggle.addEventListener("change", sync);
                sync();
            });

            root.querySelectorAll(".ah-js-save-changes").forEach((btn) => {
                btn.addEventListener("click", () => {
                    const original = btn.innerHTML;
                    btn.disabled = true;
                    btn.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg> Saved`;
                    setTimeout(() => {
                        btn.innerHTML = original;
                        btn.disabled = false;
                    }, 1800);
                });
            });
        }

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", init);
        } else {
            init();
        }
    })();
</script>