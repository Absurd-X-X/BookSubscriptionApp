          <div class="top-card">
            <div class="cover dark"><span class="rank">2</span><span class="cover-title">Clean Code</span></div>
            <div class="top-title">Clean Code</div><div class="top-cat">Technology</div>
            <div class="top-meta"><span>985 Reads</span><span class="rating">4.8 ★</span></div>
          </div>
          <div class="top-card">
            <div class="cover amber"><span class="rank">3</span><span class="cover-title">Deep Work</span></div>
            <div class="top-title">Deep Work</div><div class="top-cat">Business</div>
            <div class="top-meta"><span>876 Reads</span><span class="rating">4.7 ★</span></div>
          </div>
          <div class="top-card">
            <div class="cover red"><span class="rank">4</span><span class="cover-title">Rich Dad Poor Dad</span></div>
            <div class="top-title">Rich Dad Poor Dad</div><div class="top-cat">Finance</div>
            <div class="top-meta"><span>765 Reads</span><span class="rating">4.6 ★</span></div>
          </div>
          <div class="top-card">
            <div class="cover orange"><span class="rank">5</span><span class="cover-title">The 5 AM Club</span></div>
            <div class="top-title">The 5 AM Club</div><div class="top-cat">Productivity</div>
            <div class="top-meta"><span>654 Reads</span><span class="rating">4.5 ★</span></div>
