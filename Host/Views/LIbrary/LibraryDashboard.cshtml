@{
    Layout = "~/Views/Shared/_LibraryLayout.cshtml";
    ViewData["Title"] = "Library Dashboard";
}


<link href="~/css/libraryDashboard.css" rel="stylesheet" />
  <main class="lib-main">
    <!-- Header -->
    <header class="lib-header">
      <div>
        <h1>Welcome back, Unilag Library 👋</h1>
        <p>Here's what's happening with your library today.</p>
      </div>
      <div class="lib-actions">
        <button class="btn btn-ghost">📅 May 1 – May 31, 2024 ▾</button>
        <a href="@Url.Action("AddBook", "Library")" class="btn btn-primary">＋ Add Book</a>
        <button class="btn btn-ghost">⤓ Import Books</button>
        <button class="btn btn-ghost">⤒ Export Report</button>
      </div>
    </header>

    <!-- Stat cards -->
    <section class="stat-grid">
      <article class="card stat">
        <span class="stat-icon ic-purple">📖</span>
        <div class="stat-body">
          <span class="stat-label">Total Books</span>
          <strong class="stat-value">128</strong>
          <span class="stat-trend up">↑ 12 this month</span>
        </div>
      </article>
      <article class="card stat">
        <span class="stat-icon ic-green">👥</span>
        <div class="stat-body">
          <span class="stat-label">Total Reads</span>
          <strong class="stat-value">12,456</strong>
          <span class="stat-trend up">↑ 18% from last month</span>
        </div>
      </article>
      <article class="card stat">
        <span class="stat-icon ic-amber">👛</span>
        <div class="stat-body">
          <span class="stat-label">Revenue This Month</span>
          <strong class="stat-value">₦450,000</strong>
          <span class="stat-trend up">↑ 10% from last month</span>
        </div>
      </article>
      <article class="card stat">
        <span class="stat-icon ic-blue">★</span>
        <div class="stat-body">
          <span class="stat-label">Average Rating</span>
          <strong class="stat-value">4.8</strong>
