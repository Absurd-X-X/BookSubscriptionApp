    <script>
            (function () {
      // --- Live search filter ---
      var search = document.getElementById("bookSearch");
      var grid = document.getElementById("bookGrid");

      if (search && grid) {
        var cards = grid.querySelectorAll(".book-card");
        search.addEventListener("input", function () {
          var q = search.value.trim().toLowerCase();
          cards.forEach(function (card) {
            var hay = card.getAttribute("data-title") || "";
            card.style.display = hay.indexOf(q) !== -1 ? "" : "none";
          });
        });
      }

      // --- Pagination active state ---
      var pager = document.getElementById("pager");
      if (pager) {
        var pageButtons = pager.querySelectorAll(".pg-btn");
        pageButtons.forEach(function (btn) {
          btn.addEventListener("click", function () {
            // Ignore the prev/next arrows for active highlighting
            var label = btn.textContent.trim();
            if (label === "\u2039" || label === "\u203a") return;
            pageButtons.forEach(function (b) { b.classList.remove("active"); });
            btn.classList.add("active");
          });
        });
      }
    })();


    // --- Three-dot dropdown menu (vertical kebab + horizontal "More") ---
var MENU_HTML =
  '<button type="button" role="menuitem" class="kebab-item" data-action="edit">✎ Edit Book</button>' +
  '<button type="button" role="menuitem" class="kebab-item" data-action="upload">⤓ Upload New Version</button>' +
  '<button type="button" role="menuitem" class="kebab-item" data-action="duplicate">⧉ Duplicate Book</button>' +
  '<button type="button" role="menuitem" class="kebab-item" data-action="share">↗ Share Link</button>' +
  '<div class="kebab-sep"></div>' +
  '<button type="button" role="menuitem" class="kebab-item" data-action="archive">🗄 Archive Book</button>' +
  '<button type="button" role="menuitem" class="kebab-item danger" data-action="delete">🗑 Delete Book</button>';

function attachMenu(trigger, alignClass) {
  // Wrap the trigger in a positioned container and attach a menu
  var wrap = document.createElement("div");
  wrap.className = "kebab-wrap";
  trigger.parentNode.insertBefore(wrap, trigger);
  wrap.appendChild(trigger);

  var menu = document.createElement("div");
  menu.className = "kebab-menu" + (alignClass ? " " + alignClass : "");
  menu.setAttribute("role", "menu");
  menu.innerHTML = MENU_HTML;
  wrap.appendChild(menu);

  trigger.addEventListener("click", function (e) {
    e.stopPropagation();
    var isOpen = wrap.classList.contains("open");
    // Close any other open menus first
    document.querySelectorAll(".kebab-wrap.open").forEach(function (w) {
      w.classList.remove("open");
    });
    if (!isOpen) wrap.classList.add("open");
  });

  menu.querySelectorAll(".kebab-item").forEach(function (item) {
    item.addEventListener("click", function (e) {
      e.stopPropagation();
      wrap.classList.remove("open");
      var card = trigger.closest(".book-card");
      var title = card ? card.querySelector(".b-title").textContent : "";
      var action = item.getAttribute("data-action");
      console.log("[v0]", action, "clicked for:", title);
    });
  });
}

// Vertical kebab (top-right of each card) — menu opens downward to the right edge
document.querySelectorAll(".kebab").forEach(function (kebab) {
  attachMenu(kebab, "");
});

// Horizontal "More" button (bottom action row) — menu opens upward
document.querySelectorAll('.b-actions button[aria-label="More"]').forEach(function (more) {
  attachMenu(more, "menu-up");
});

// Close menus when clicking anywhere else
document.addEventListener("click", function () {
  document.querySelectorAll(".kebab-wrap.open").forEach(function (w) {
    w.classList.remove("open");
  });
});

    const modal =
        document.getElementById("paymentModal");

    const openBtn =
        document.getElementById("openPaymentModal");

    const closeBtn =
        document.getElementById("closePaymentModal");

    const cancelBtn =
        document.getElementById("cancelPaymentModal");

    /* Open */

    openBtn.addEventListener("click", () => {

        modal.classList.add("show");

    });

    /* Close Button */

    closeBtn.addEventListener("click", () => {

        modal.classList.remove("show");

    });

    /* Cancel Button */

    cancelBtn.addEventListener("click", () => {

        modal.classList.remove("show");

    });

    /* Click Outside */

    modal.addEventListener("click", (e) => {

        if (e.target === modal) {

            modal.classList.remove("show");

        }

    });
    </script>