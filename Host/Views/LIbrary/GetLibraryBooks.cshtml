@model Application.Common.Pagenation.PagenatedList<Application.Queries.GetByLibraryId.GetByLibraryIdResponse>

@{
    Layout = "~/Views/Shared/_LibraryLayout.cshtml";
    ViewData["Title"] = "Get Books";

    int totalPages = Model.TotalCount == 0 ? 1 : (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize);
    int startItem = Model.TotalCount == 0 ? 0 : ((Model.Page - 1) * Model.PageSize) + 1;
    long endItem = Math.Min(Model.Page * Model.PageSize, Model.TotalCount);

    string[] coverClasses = { "cover-cream", "cover-yellow", "cover-dark", "cover-purple", "cover-orange", "cover-blue" };

    string GetSearchKey(string title, string author) =>
        $"{title} {author}".ToLower();

    var currentSearch = Context.Request.Query["search"].ToString();
    var currentCategoryId = Context.Request.Query["categoryId"].ToString();
    var currentIsPublished = Context.Request.Query["isPublished"].ToString();
    var currentSortBy = Context.Request.Query["sortBy"].ToString();
    if (string.IsNullOrEmpty(currentSortBy)) currentSortBy = "newest";

    var pagesToShow = new List<int?>();
    int windowSize = 1;
    for (int p = 1; p <= totalPages; p++)
    {
        bool isEdge = p == 1 || p == totalPages;
        bool isNearCurrent = Math.Abs(p - Model.Page) <= windowSize;

        if (isEdge || isNearCurrent)
        {
            pagesToShow.Add(p);
        }
        else if (pagesToShow.Count > 0 && pagesToShow[^1] != null)
        {
            pagesToShow.Add(null);
        }
    }
}
<link rel="stylesheet" href="~/css/libraryBooks.css" />
<main class="lib-main">
    <!-- Header -->
    <header class="lib-header">
        <div>
            <h1>Books</h1>
            <p>Manage and publish your digital book collection.</p>
        </div>
        <div class="lib-actions">
            <div class="search-top">
                <span class="search-ic">⌕</span>
                <input type="text" placeholder="Search books..." aria-label="Search books" />
                <kbd>⌘K</kbd>
            </div>
            <a href="@Url.Action("AddBook", "Library")" class="btn-primary button">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                Add Book
            </a>
            <button class="btn btn-ghost">⤓ Import Books</button>
            <button class="btn btn-ghost">⤒ Export</button>
        </div>
    </header>

    <!-- Stat cards -->
    <section class="stat-grid">
        <article class="card stat">
            <span class="stat-icon ic-purple">📖</span>
            <div class="stat-body">
                <span class="stat-label">Total Books</span>
                <strong class="stat-value">@Model.TotalCount</strong>
            </div>
            <span class="stat-info">ⓘ</span>
        </article>
        <article class="card stat">
            <span class="stat-icon ic-blue">👁</span>
            <div class="stat-body">
                <span class="stat-label">Total Reads</span>
                <strong class="stat-value">4,582</strong>
            </div>
            <span class="stat-info">ⓘ</span>
        </article>
        <article class="card stat">
            <span class="stat-icon ic-red">🗄</span>
            <div class="stat-body">
                <span class="stat-label">Archived</span>
                <strong class="stat-value">6</strong>
            </div>
            <span class="stat-info">ⓘ</span>
        </article>
        <article class="card stat">
            <span class="stat-icon ic-green">📗</span>
            <div class="stat-body">
                <span class="stat-label">Published</span>
                <strong class="stat-value">@Model.Items.Count(x => x.IsPublished)</strong>
            </div>
            <span class="stat-info">ⓘ</span>
        </article>
        <article class="card stat">
            <span class="stat-icon ic-amber">📄</span>
            <div class="stat-body">
                <span class="stat-label">Drafts</span>
                <strong class="stat-value">@Model.Items.Count(x => !x.IsPublished)</strong>
            </div>
            <span class="stat-info">ⓘ</span>
        </article>
    </section>

    <!-- Filter bar -->
    <form method="get" asp-action="GetLibraryBooks" asp-controller="Library" class="filter-bar card" id="filterForm">
        <input type="hidden" name="pageSize" value="@Model.PageSize" />
        <div class="search-inline">
            <span class="search-ic">⌕</span>
            <input id="bookSearch" name="search" type="text" value="@currentSearch"
                   placeholder="Search books by title, author or ISBN..." aria-label="Filter books" />
        </div>
        <label class="field">
            <span>Category</span>
            <select name="categoryId" onchange="document.getElementById('filterForm').submit()">
                <option value="">All Categories</option>
                @foreach (var cat in Model.Items.Select(x => new { x.CategoryId, x.CategoryName }).Distinct())
                {
                    var isSelected = currentCategoryId == cat.CategoryId.ToString();
                    @if (isSelected)
                    {
                        <option value="@cat.CategoryId" selected>@cat.CategoryName</option>
                    }
                    else
                    {
                        <option value="@cat.CategoryId">@cat.CategoryName</option>
                    }
                }
            </select>
        </label>
        <label class="field">
            <span>Status</span>
            <select name="isPublished" onchange="document.getElementById('filterForm').submit()">
                <option value="">All Status</option>
                @if (currentIsPublished == "true")
                {
                    <option value="true" selected>Published</option>
                }
                else
                {
                    <option value="true">Published</option>
                }
                @if (currentIsPublished == "false")
                {
                    <option value="false" selected>Draft</option>
                }
                else
                {
                    <option value="false">Draft</option>
                }
            </select>
        </label>
        <label class="field">
            <span>Sort by</span>
            <select name="sortBy" onchange="document.getElementById('filterForm').submit()">
                @if (currentSortBy == "newest")
                {
                    <option value="newest" selected>Newest First</option>
                }
                else
                {
                    <option value="newest">Newest First</option>
                }
                @if (currentSortBy == "oldest")
                {
                    <option value="oldest" selected>Oldest First</option>
                }
                else
                {
                    <option value="oldest">Oldest First</option>
                }
                @if (currentSortBy == "mostread")
                {
                    <option value="mostread" selected>Most Reads</option>
                }
                else
                {
                    <option value="mostread">Most Reads</option>
                }
            </select>
        </label>
        <button type="submit" class="btn btn-ghost">⚲ Filter</button>
    </form>

    <!-- Book grid -->
    <section class="book-grid" id="bookGrid">
        @{
            int coverIdx = 0;
        }
        @foreach (var book in Model.Items)
        {
            var searchKey = GetSearchKey(book.Title, book.Author);
            var coverClass = coverClasses[coverIdx % coverClasses.Length];
            coverIdx++;
            <article class="book-card" data-title="@searchKey">
                <div class="book-top">
                    <span class="badge @(book.IsPublished ? "badge-pub" : "badge-draft")">@(book.IsPublished ? "Published" : "Draft")</span>
                    <button class="kebab" aria-label="More options">⋮</button>
                </div>
                @if (!string.IsNullOrWhiteSpace(book.BookCoverUrl))
                {
                    <div class="cover cover-img" style="background-image:url('@book.BookCoverUrl')"></div>
                }
                else
                {
                    <div class="cover @coverClass">
                        <span class="cover-title">@book.Title</span>
                        <span class="cover-author">@book.Author</span>
                    </div>
                }
                <h3 class="b-title">@book.Title</h3>
                <p class="b-author">@book.Author</p>
                <div class="b-meta"><span>@book.NoOfTimeReadByPeople Reads</span><span>@book.EngagementPercent% Engagement</span></div>
                <div class="b-actions">
                    <a href="@Url.Action("GetLibraryBook", "Library", new { bookId = book.BookId })" aria-label="View">👁</a>
                    <a href="@Url.Action("EditBook", "Library", new { id = book.BookId })" aria-label="Edit">✎</a>
                    <button aria-label="More">⋯</button>
                </div>
            </article>
        }
        @if (!Model.Items.Any())
        {
            <p>No books found.</p>
        }
    </section>

    <!-- Pagination -->
    <footer class="pager">
        <span class="pager-info">Showing @startItem to @endItem of @Model.TotalCount books</span>
        <nav class="pager-nav" id="pager" aria-label="Pagination">
            <a class="pg-btn" aria-label="Previous"
               href="@Url.Action("GetLibraryBooks", "Library", new
               {
                   page = Math.Max(1, Model.Page - 1),
                   pageSize = Model.PageSize,
                   search = currentSearch,
                   categoryId = currentCategoryId,
                   isPublished = currentIsPublished,
                   sortBy = currentSortBy
               })">‹</a>
            @foreach (var p in pagesToShow)
            {
                if (p == null)
                {
                    <span class="pg-dots">…</span>
                }
                else
                {
                    <a class="pg-btn @(p == Model.Page ? "active" : "")"
                       href="@Url.Action("GetLibraryBooks", "Library", new
                       {
                           page = p,
                           pageSize = Model.PageSize,
                           search = currentSearch,
                           categoryId = currentCategoryId,
                           isPublished = currentIsPublished,
                           sortBy = currentSortBy
                       })">@p</a>
                }
            }
            <a class="pg-btn" aria-label="Next"
               href="@Url.Action("GetLibraryBooks", "Library", new
               {
                   page = Math.Min(totalPages, Model.Page + 1),
                   pageSize = Model.PageSize,
                   search = currentSearch,
                   categoryId = currentCategoryId,
                   isPublished = currentIsPublished,
                   sortBy = currentSortBy
               })">›</a>
        </nav>
        <label class="pager-show">
            Show
            <select><option>10</option><option>20</option><option>50</option></select>
            per page
        </label>
    </footer>
</main>

<script>
    var MENU_HTML =
        '<a href"@Url.Action("EditBook", "Library")" type="button" role="menuitem" class="kebab-item" data-action="edit">✎ Open Book</a>' +
        '<a href"@Url.Action("PreviewBook", "Library")" type="button" role="menuitem" class="kebab-item" data-action="edit">⤓ Edit Book</a>' +
        '<div class="kebab-sep"></div>' +
        '<button type="button" role="menuitem" class="kebab-item" data-action="archive">🗄 Archive Book</button>' +
        '<button type="button" role="menuitem" class="kebab-item danger" data-action="delete">🗑 Delete Book</button>';

    function attachMenu(trigger, alignClass) {
        var wrap = document.createElement("div");
        wrap.className = "kebab-wrap";
        trigger.parentNode.insertBefore(wrap, trigger);
        wrap.appendChild(trigger);

        var menu = document.createElement("div");
        menu.className = "kebab-menu" + (alignClass ? " " + alignClass : "");
        menu.setAttribute("role", "menu");
        menu.innerHTML = MENU_HTML;
        wrap.appendChild(menu);

        trigger.addEventListener("click", function (e) {
            e.stopPropagation();
            var isOpen = wrap.classList.contains("open");
            document.querySelectorAll(".kebab-wrap.open").forEach(function (w) {
                w.classList.remove("open");
            });
            if (!isOpen) wrap.classList.add("open");
        });

        menu.querySelectorAll(".kebab-item").forEach(function (item) {
            item.addEventListener("click", function (e) {
                e.stopPropagation();
                wrap.classList.remove("open");
                var card = trigger.closest(".book-card");
                var title = card ? card.querySelector(".b-title").textContent : "";
                var action = item.getAttribute("data-action");
                console.log("[v0]", action, "clicked for:", title);
            });
        });
    }

    document.querySelectorAll(".kebab").forEach(function (kebab) {
        attachMenu(kebab, "");
    });

    document.querySelectorAll('.b-actions button[aria-label="More"]').forEach(function (more) {
        attachMenu(more, "menu-up");
    });

    document.addEventListener("click", function () {
        document.querySelectorAll(".kebab-wrap.open").forEach(function (w) {
            w.classList.remove("open");
        });
    });
</script>