@model Application.Queries.GetLibraryReviews.LibraryReviewsResponse
@{
    Layout = "~/Views/Shared/_LibraryLayout.cshtml";
    ViewData["Title"] = "Library Book Reviews";
}

<link href="~/css/reviews.css" rel="stylesheet" />

<div class="reviews-page">

    <!-- Header -->
    <div class="reviews-header">
        <div>
            <h1 class="reviews-title">Reviews</h1>
            <p class="reviews-subtitle">Manage and moderate reader reviews for all books in your library.</p>
        </div>
        <div class="header-actions">
            <form method="get" asp-action="Reviews" style="display:flex;gap:8px;align-items:center">
                <input type="date" name="start" value="@Model.PeriodStart.ToString("yyyy-MM-dd")" class="date-range-btn" />
                <input type="date" name="end" value="@Model.PeriodEnd.ToString("yyyy-MM-dd")" class="date-range-btn" />
                <button type="submit" class="export-btn">Apply</button>
            </form>
            <button class="export-btn">&#11015; Export Reviews &#9662;</button>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div style="background:#3a1a1a;color:#f87171;padding:10px 14px;border-radius:8px;margin-bottom:16px;font-size:13px">
            @TempData["Error"]
        </div>
    }

    <!-- Stat Cards -->
    <div class="stats-row">
        <div class="stat-card">
            <div class="stat-icon purple">&#9733;</div>
            <div class="help-hold">
                <div class="stat-label">Total Reviews</div>
                <div class="stat-value">@Model.TotalReviews.ToString("N0")</div>
                <div class="stat-delta"><span class="@(Model.TotalReviewsGrowthPercent >= 0 ? "up" : "down")">@(Model.TotalReviewsGrowthPercent >= 0 ? "↑" : "↓") @Math.Abs(Model.TotalReviewsGrowthPercent)%</span> vs prior period</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon green">&#128197;</div>
            <div class="help-hold">
                <div class="stat-label">Approved Reviews</div>
                <div class="stat-value">@Model.ApprovedReviews.ToString("N0")</div>
                <div class="stat-delta"><span class="@(Model.ApprovedReviewsGrowthPercent >= 0 ? "up" : "down")">@(Model.ApprovedReviewsGrowthPercent >= 0 ? "↑" : "↓") @Math.Abs(Model.ApprovedReviewsGrowthPercent)%</span> vs prior period</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon amber">&#128336;</div>
            <div class="help-hold">
                <div class="stat-label">Pending Reviews</div>
                <div class="stat-value">@Model.PendingReviews.ToString("N0")</div>
                <div class="stat-delta"><span class="@(Model.PendingReviewsGrowthPercent >= 0 ? "up" : "down")">@(Model.PendingReviewsGrowthPercent >= 0 ? "↑" : "↓") @Math.Abs(Model.PendingReviewsGrowthPercent)%</span> vs prior period</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon red">&#128683;</div>
            <div class="help-hold">
                <div class="stat-label">Rejected Reviews</div>
                <div class="stat-value">@Model.RejectedReviews.ToString("N0")</div>
                <div class="stat-delta"><span class="@(Model.RejectedReviewsGrowthPercent <= 0 ? "up" : "down")">@(Model.RejectedReviewsGrowthPercent <= 0 ? "↓" : "↑") @Math.Abs(Model.RejectedReviewsGrowthPercent)%</span> vs prior period</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon blue">&#11088;</div>
            <div class="help-hold">
                <div class="stat-label">Average Rating</div>
                <div class="stat-value">@Model.AverageRating.ToString("0.0") <span class="of-five">/ 5</span></div>
                <div class="stat-delta"><span class="@(Model.AverageRatingChange >= 0 ? "up" : "down")">@(Model.AverageRatingChange >= 0 ? "↑" : "↓") @Math.Abs(Model.AverageRatingChange)</span> vs prior period</div>
            </div>
        </div>
    </div>

    <!-- Main Grid -->
    <div class="main-grid">

        <!-- Table -->
        <div class="table-card">
            <div class="table-controls">
                <div class="search-input-wrap">
                    <input type="text" placeholder="Search reviews by book title or reviewer..." />
                    <span class="icon">&#128269;</span>
                </div>
                <select class="filter-select">
                    <option value="">All Books</option>
                </select>
                <select class="filter-select">
                    <option value="">All Ratings</option>
                </select>
                <select class="filter-select">
                    <option value="">All Status</option>
                </select>
                <button class="filters-btn">&#9881; Filters</button>
            </div>

            <table class="reviews-table">
                <thead>
                    <tr>
                        <th>Reviewer</th>
                        <th>Book</th>
                        <th>Rating</th>
                        <th>Review</th>
                        <th>Status</th>
                        <th>Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Reviews.Items.Any())
                    {
                        @foreach (var r in Model.Reviews.Items)
                        {
                            var initials = string.Join("", r.ReviewerName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(w => w[0])).ToUpper();
                            var statusClass = r.Status.ToLower();
                            <tr>
                                <td>
                                    <div class="reviewer-cell">
                                        <div class="avatar" style="background:#7c3aed;">@initials</div>
                                        <div>
                                            <div class="reviewer-name">@r.ReviewerName</div>
                                            <div class="reviewer-email">@r.ReviewerEmail</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="book-cell">
                                        <div class="book-cover" style="@(string.IsNullOrEmpty(r.BookCoverUrl) ? "" : $"background-image:url('{r.BookCoverUrl}')")"></div>
                                        <div>
                                            <div class="book-title">@r.BookTitle</div>
                                            <div class="book-author">@r.BookAuthor</div>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="stars">@(new string('★', r.Rating))@(new string('☆', 5 - r.Rating))</span></td>
                                <td><span class="review-text">@r.Comment</span></td>
                                <td><span class="status-badge @statusClass">@r.Status</span></td>
                                <td><span class="date-cell">@r.DateCreated.ToString("MMM d, yyyy")<br>@r.DateCreated.ToString("h:mm tt")</span></td>
                                <td>
                                    <div class="actions-cell">
                                        <a href="@Url.Action("GetReview", "Library", new { id = r.ReviewId })" class="action-icon-btn">&#128065;</a>
                                        <button class="action-icon-btn" aria-label="More" data-review-id="@r.ReviewId">&#8942;</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="7" style="text-align:center;color:#7878a0;font-size:12px;padding:20px">No reviews found for this period</td></tr>
                    }
                </tbody>
            </table>

            <div class="table-footer">
                <span class="showing-text">
                    @{
                        var startIdx = Model.Reviews.TotalCount == 0 ? 0 : ((Model.Reviews.Page - 1) * Model.Reviews.PageSize) + 1;
                        var endIdx = Math.Min(Model.Reviews.Page * Model.Reviews.PageSize, Model.Reviews.TotalCount);
                    }
                    Showing @startIdx to @endIdx of @Model.Reviews.TotalCount.ToString("N0") reviews
                </span>
                <div class="pagination">
                    @{
                        var totalPages = Math.Max(1, (int)Math.Ceiling((double)Model.Reviews.TotalCount / Model.Reviews.PageSize));
                    }
                    <a class="page-btn @(Model.Reviews.Page <= 1 ? "disabled" : "")"
                       asp-action="Reviews" asp-route-start="@Model.PeriodStart.ToString("yyyy-MM-dd")" asp-route-end="@Model.PeriodEnd.ToString("yyyy-MM-dd")" asp-route-page="@(Model.Reviews.Page - 1)" asp-route-pageSize="@Model.Reviews.PageSize">&#8249;</a>
                    @for (int p = 1; p <= totalPages; p++)
                    {
                        <a class="page-btn @(p == Model.Reviews.Page ? "active" : "")"
                           asp-action="Reviews" asp-route-start="@Model.PeriodStart.ToString("yyyy-MM-dd")" asp-route-end="@Model.PeriodEnd.ToString("yyyy-MM-dd")" asp-route-page="@p" asp-route-pageSize="@Model.Reviews.PageSize">@p</a>
                    }
                    <a class="page-btn @(Model.Reviews.Page >= totalPages ? "disabled" : "")"
                       asp-action="Reviews" asp-route-start="@Model.PeriodStart.ToString("yyyy-MM-dd")" asp-route-end="@Model.PeriodEnd.ToString("yyyy-MM-dd")" asp-route-page="@(Model.Reviews.Page + 1)" asp-route-pageSize="@Model.Reviews.PageSize">&#8250;</a>
                    <select class="per-page-select" onchange="location.href='@Url.Action("Reviews")?start=@Model.PeriodStart.ToString("yyyy-MM-dd")&end=@Model.PeriodEnd.ToString("yyyy-MM-dd")&page=1&pageSize=' + this.value">
                        <option value="10" selected="@(Model.Reviews.PageSize == 10)">10 per page</option>
                        <option value="25" selected="@(Model.Reviews.PageSize == 25)">25 per page</option>
                        <option value="50" selected="@(Model.Reviews.PageSize == 50)">50 per page</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="sidebar-col">

            <div class="side-card">
                <div class="side-card-title">Rating Distribution</div>

                <div class="rating-row">
                    <span class="rating-label">5 Stars</span>
                    <div class="rating-bar-track"><div class="rating-bar-fill" style="width:@(Model.RatingDistribution.FiveStarPct)%;"></div></div>
                    <span class="rating-count">@Model.RatingDistribution.FiveStar.ToString("N0") (@Model.RatingDistribution.FiveStarPct%)</span>
                </div>
                <div class="rating-row">
                    <span class="rating-label">4 Stars</span>
                    <div class="rating-bar-track"><div class="rating-bar-fill" style="width:@(Model.RatingDistribution.FourStarPct)%;"></div></div>
                    <span class="rating-count">@Model.RatingDistribution.FourStar.ToString("N0") (@Model.RatingDistribution.FourStarPct%)</span>
                </div>
                <div class="rating-row">
                    <span class="rating-label">3 Stars</span>
                    <div class="rating-bar-track"><div class="rating-bar-fill" style="width:@(Model.RatingDistribution.ThreeStarPct)%;"></div></div>
                    <span class="rating-count">@Model.RatingDistribution.ThreeStar.ToString("N0") (@Model.RatingDistribution.ThreeStarPct%)</span>
                </div>
                <div class="rating-row">
                    <span class="rating-label">2 Stars</span>
                    <div class="rating-bar-track"><div class="rating-bar-fill" style="width:@(Model.RatingDistribution.TwoStarPct)%;"></div></div>
                    <span class="rating-count">@Model.RatingDistribution.TwoStar.ToString("N0") (@Model.RatingDistribution.TwoStarPct%)</span>
                </div>
                <div class="rating-row">
                    <span class="rating-label">1 Star</span>
                    <div class="rating-bar-track"><div class="rating-bar-fill" style="width:@(Model.RatingDistribution.OneStarPct)%;"></div></div>
                    <span class="rating-count">@Model.RatingDistribution.OneStar.ToString("N0") (@Model.RatingDistribution.OneStarPct%)</span>
                </div>

                <div class="rating-total">
                    <span>Total</span>
                    <strong>@Model.TotalReviews.ToString("N0")</strong>
                </div>
            </div>

            <div class="side-card">
                <div class="side-card-title">Top Reviewed Books</div>

                @if (Model.TopReviewedBooks.Any())
                {
                    @foreach (var book in Model.TopReviewedBooks)
                    {
                        <div class="top-book-row">
                            <div class="book-cover"></div>
                            <div class="top-book-info">
                                <div class="top-book-title">@book.Title</div>
                                <div class="top-book-sub">@book.ReviewCount.ToString("N0") reviews</div>
                            </div>
                            <div class="top-book-stats">
                                <div class="top-book-count">@book.ReviewCount</div>
                                <div class="top-book-rating">&#9733; @book.AverageRating.ToString("0.0")</div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p style="font-size:12px;color:#7878a0">No reviews yet.</p>
                }

                <button class="view-all-btn">View All Books</button>
            </div>

            <div class="side-card">
                <div class="side-card-title">Review Moderation Tips</div>

                <div class="tip-row">
                    <span class="tip-icon approve">&#10003;</span>
                    <div>
                        <div class="tip-title">Approve</div>
                        <div class="tip-desc">Reviews that are helpful and respectful</div>
                    </div>
                </div>
                <div class="tip-row">
                    <span class="tip-icon reject">&#10005;</span>
                    <div>
                        <div class="tip-title">Reject</div>
                        <div class="tip-desc">Reviews that contain spam or abuse</div>
                    </div>
                </div>
                <div class="tip-row">
                    <span class="tip-icon edit">&#9998;</span>
                    <div>
                        <div class="tip-title">Edit</div>
                        <div class="tip-desc">You can edit reviews to fix minor issues</div>
                    </div>
                </div>

                <a class="guidelines-link" href="#">View Moderation Guidelines &#8250;</a>
            </div>

        </div>
    </div>

</div>

<script>
    (function () {
        var tbody = document.querySelector(".reviews-table tbody");
        var allRows = Array.from(tbody.querySelectorAll("tr"));

        var searchInput = document.querySelector(".search-input-wrap input");
        var bookFilter = document.querySelectorAll(".filter-select")[0];
        var ratingFilter = document.querySelectorAll(".filter-select")[1];
        var statusFilter = document.querySelectorAll(".filter-select")[2];

        function populateBookFilter() {
            var titles = Array.from(new Set(allRows.map(function (r) {
                var el = r.querySelector(".book-title");
                return el ? el.textContent.trim() : null;
            }).filter(Boolean)));
            titles.forEach(function (title) {
                var opt = document.createElement("option");
                opt.value = title;
                opt.textContent = title;
                bookFilter.appendChild(opt);
            });
        }
        populateBookFilter();

        [5, 4, 3, 2, 1].forEach(function (n) {
            var opt = document.createElement("option");
            opt.value = n;
            opt.textContent = n + " Stars";
            ratingFilter.appendChild(opt);
        });

        ["Approved", "Pending", "Rejected"].forEach(function (s) {
            var opt = document.createElement("option");
            opt.value = s;
            opt.textContent = s;
            statusFilter.appendChild(opt);
        });

        function getRowRating(row) {
            var el = row.querySelector(".stars");
            if (!el) return 0;
            var filled = el.textContent.match(/★/g);
            return filled ? filled.length : 0;
        }
        function getRowStatus(row) {
            var badge = row.querySelector(".status-badge");
            return badge ? badge.textContent.trim() : "";
        }

        function applyFilters() {
            var q = searchInput.value.trim().toLowerCase();
            var book = bookFilter.value;
            var rating = ratingFilter.value;
            var status = statusFilter.value;

            allRows.forEach(function (row) {
                var titleEl = row.querySelector(".book-title");
                var reviewerEl = row.querySelector(".reviewer-name");
                if (!titleEl || !reviewerEl) { row.style.display = "none"; return; }

                var title = titleEl.textContent.toLowerCase();
                var reviewer = reviewerEl.textContent.toLowerCase();
                var matchesSearch = !q || title.indexOf(q) !== -1 || reviewer.indexOf(q) !== -1;
                var matchesBook = !book || titleEl.textContent.trim() === book;
                var matchesRating = !rating || getRowRating(row) === parseInt(rating, 10);
                var matchesStatus = !status || getRowStatus(row) === status;

                row.style.display = (matchesSearch && matchesBook && matchesRating && matchesStatus) ? "" : "none";
            });
        }

        function debounce(fn, delay) {
            var timer;
            return function () {
                var args = arguments;
                clearTimeout(timer);
                timer = setTimeout(function () { fn.apply(null, args); }, delay);
            };
        }

        searchInput.addEventListener("input", debounce(applyFilters, 200));
        bookFilter.addEventListener("change", applyFilters);
        ratingFilter.addEventListener("change", applyFilters);
        statusFilter.addEventListener("change", applyFilters);

        var filtersBtn = document.querySelector(".filters-btn");
        filtersBtn.addEventListener("click", function () {
            filtersBtn.classList.toggle("active");
        });

        var MENU_HTML =
            '<button type="button" role="menuitem" class="kebab-item" data-action="view">👁 View Full Review</button>' +
            '<button type="button" role="menuitem" class="kebab-item" data-action="edit">✎ Edit Review</button>' +
            '<button type="button" role="menuitem" class="kebab-item" data-action="approve">✓ Approve</button>' +
            '<button type="button" role="menuitem" class="kebab-item" data-action="reject">✕ Reject</button>' +
            '<div class="kebab-sep"></div>' +
            '<button type="button" role="menuitem" class="kebab-item danger" data-action="delete">🗑 Delete Review</button>';

        function attachMenu(trigger, alignClass) {
            var wrap = document.createElement("div");
            wrap.className = "kebab-wrap";
            trigger.parentNode.insertBefore(wrap, trigger);
            wrap.appendChild(trigger);

            var menu = document.createElement("div");
            menu.className = "kebab-menu" + (alignClass ? " " + alignClass : "");
            menu.setAttribute("role", "menu");
            menu.innerHTML = MENU_HTML;
            wrap.appendChild(menu);

            function positionMenu(trigger, menu) {
                menu.classList.remove("menu-up");
                menu.style.visibility = "hidden";
                menu.style.display = "block";

                var triggerRect = trigger.getBoundingClientRect();
                var menuHeight = menu.offsetHeight;
                var spaceBelow = window.innerHeight - triggerRect.bottom;
                var spaceAbove = triggerRect.top;

                if (spaceBelow < menuHeight && spaceAbove > menuHeight) {
                    menu.classList.add("menu-up");
                }

                menu.style.display = "";
                menu.style.visibility = "";
            }

            trigger.addEventListener("click", function (e) {
                e.stopPropagation();
                var isOpen = wrap.classList.contains("open");
                document.querySelectorAll(".kebab-wrap.open").forEach(function (w) {
                    w.classList.remove("open");
                });
                if (!isOpen) {
                    positionMenu(trigger, menu);
                    wrap.classList.add("open");
                }
            });

            menu.querySelectorAll(".kebab-item").forEach(function (item) {
                item.addEventListener("click", function (e) {
                    e.stopPropagation();
                    wrap.classList.remove("open");
                    var row = trigger.closest("tr");
                    var reviewId = trigger.getAttribute("data-review-id");
                    var action = item.getAttribute("data-action");
                    handleRowAction(action, row, reviewId);
                });
            });
        }

        function handleRowAction(action, row, reviewId) {
            console.log("[reviews]", action, "for review:", reviewId);
            // TODO: wire to real endpoints, e.g. POST /Library/UpdateReviewStatus
            if (action === "approve" || action === "reject") {
                var badge = row.querySelector(".status-badge");
                badge.className = "status-badge " + (action === "approve" ? "approved" : "rejected");
                badge.textContent = action === "approve" ? "Approved" : "Rejected";
            }
        }

        document.querySelectorAll(".actions-cell .action-icon-btn:last-child").forEach(function (btn) {
            attachMenu(btn, "menu-up");
        });

        document.addEventListener("click", function () {
            document.querySelectorAll(".kebab-wrap.open").forEach(function (w) {
                w.classList.remove("open");
            });
        });

        document.querySelector(".export-btn").addEventListener("click", function () {
            console.log("[reviews] export reviews clicked");
        });
    })();
</script>