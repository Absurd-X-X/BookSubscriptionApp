@{
    Layout = "~/Views/Shared/_LibraryLayout.cshtml";
    ViewData["Title"] = "Notification";
}
<link href="~/css/notification.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap">


    <main class="main-content">

        <!-- ============ Top bar ============ -->
        <div class="detail-topbar">
            <a href="#" class="back-link">
                <svg class="icon" viewBox="0 0 24 24" style="width:16px;height:16px;">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
                Back to Notifications
            </a>
            <div class="header-actions">
                <button class="date-range-btn">
                    May 1 – May 31, 2024
                    <svg class="icon" viewBox="0 0 24 24">
                        <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                </button>
                <button class="btn-primary">
                    <svg class="icon" viewBox="0 0 24 24" style="width:16px;height:16px;">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    Mark as Read
                    <svg class="icon chev" viewBox="0 0 24 24">
                        <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                </button>
            </div>
        </div>

        <!-- ============ Page header ============ -->
        <div class="page-header-block">
            <h1>Notification Details</h1>
            <p>View complete information about this notification and take action.</p>
        </div>

        <!-- ============ Content grid ============ -->
        <div class="content-grid">

            <!-- LEFT column -->
            <div class="left-col">

                <!-- Notification summary banner -->
                <div class="side-card notif-summary">
                    <div class="icon-circle purple">
                        <svg viewBox="0 0 24 24" fill="currentColor">
                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2">
                            </polygon>
                        </svg>
                    </div>
                    <div class="notif-main">
                        <span class="badge badge-tag">Review Notification</span>
                        <h2 class="notif-title">New review received for "Atomic Habits"</h2>
                        <p class="notif-desc">A new review has been submitted by Sarah Johnson for the book "Atomic Habits".</p>
                    </div>
                    <div class="notif-side">
                        <span class="status status-unread">Unread</span>
                        <span class="notif-date">May 31, 2024<br>10:15 AM</span>
                    </div>
                </div>

                <!-- Overview -->
                <div class="side-card">
                    <h3>Overview</h3>
                    <p class="overview-text">
                        A new review has been submitted by a reader. Please review and moderate the
                        content before it is visible to other readers.
                    </p>
                    <div class="overview-grid">
                        <div class="overview-item">
                            <div class="overview-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                </svg>
                            </div>
                            <div class="overview-text-col">
                                <span class="overview-label">Notification ID</span>
                                <span class="overview-value">NTF-2024-000128</span>
                            </div>
                        </div>
                        <div class="overview-item">
                            <div class="overview-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round">
                                    <path d="M20.59 13.41 11 22 2 13l8.59-8.59A2 2 0 0 1 12 4h7a2 2 0 0 1 2 2v7a2 2 0 0 1-.41 1.41z">
                                    </path>
                                    <circle cx="13.5" cy="9.5" r="1"></circle>
                                </svg>
                            </div>
                            <div class="overview-text-col">
                                <span class="overview-label">Category</span>
                                <span class="overview-value">Reviews</span>
                            </div>
                        </div>
                        <div class="overview-item">
                            <div class="overview-icon">
                                <span class="dot dot-orange"></span>
                            </div>
                            <div class="overview-text-col">
                                <span class="overview-label">Priority</span>
                                <span class="overview-value">Medium</span>
                            </div>
                        </div>
                        <div class="overview-item">
                            <div class="overview-icon">
                                <span class="dot dot-purple"></span>
                            </div>
                            <div class="overview-text-col">
                                <span class="overview-label">Status</span>
                                <span class="overview-value">Unread</span>
                            </div>
                        </div>
                        <div class="overview-item">
                            <div class="overview-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="3"></circle>
                                    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z">
                                    </path>
                                </svg>
                            </div>
                            <div class="overview-text-col">
                                <span class="overview-label">Source</span>
                                <span class="overview-value">Web Application</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Related Review -->
                <div class="side-card">
                    <h3>Related Review</h3>
                    <div class="related-review-grid">

                        <div class="reviewer-col">
                            <div class="avatar-circle">SJ</div>
                            <span class="reviewer-name">Sarah Johnson</span>
                            <span class="reviewer-email">sarah.j@email.com</span>
                            <span class="badge badge-verified">Verified Reader</span>
                        </div>

                        <div class="book-col">
                            <div class="book-cover">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round">
                                    <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                                    <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
                                </svg>
                            </div>
                            <div class="book-info">
                                <span class="book-title">Atomic Habits</span>
                                <span class="book-author">by James Clear</span>
                                <div class="rating">
                                    <span class="stars">
                                        <svg viewBox="0 0 24 24" fill="currentColor">
                                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2">
                                            </polygon>
                                        </svg>
                                        <svg viewBox="0 0 24 24" fill="currentColor">
                                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2">
                                            </polygon>
                                        </svg>
                                        <svg viewBox="0 0 24 24" fill="currentColor">
                                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2">
                                            </polygon>
                                        </svg>
                                        <svg viewBox="0 0 24 24" fill="currentColor">
                                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2">
                                            </polygon>
                                        </svg>
                                        <svg viewBox="0 0 24 24" fill="currentColor">
                                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2">
                                            </polygon>
                                        </svg>
                                    </span>
                                    <span class="score">5.0</span>
                                </div>
                                <span class="submitted-on">Submitted on May 31, 2024 10:14 AM</span>
                            </div>
                        </div>

                        <div class="meta-col">
                            <div class="meta-row"><span>Review ID</span><span>REV-2024-005678</span></div>
                            <div class="meta-row"><span>Review Type</span><span>Public Review</span></div>
                            <div class="meta-row">
                                <span>Visibility</span><span class="badge badge-pending">Pending Approval</span>
                            </div>
                            <div class="meta-row">
                                <span>Helpful Votes</span><span>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round">
                                    <path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3z"></path>
                                    <path d="M7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"></path>
                                </svg>
                                0
                            </span>
                        </div>
                        <div class="meta-row">
                            <span>Report Count</span><span>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round">
                                <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"></path>
                                <line x1="4" y1="22" x2="4" y2="15"></line>
                            </svg>
                            0
                        </span>
                    </div>
                </div>

            </div>

            <span class="review-label">Review Title</span>
            <p class="review-title-text">Life-changing book! The small habits approach really works.</p>

            <span class="review-label">Review Content</span>
            <p class="review-content-text">
                This book completely changed the way I think about building habits. The
                author does an excellent job breaking down complex concepts into simple, actionable steps. I especially
                loved the habit stacking technique and the emphasis on systems over goals. I've been applying these
                principles for the past 3 months and have seen remarkable improvements in my productivity and overall
                well-being. Highly recommended for anyone looking to make positive changes in their life!
            </p>

            <button class="btn-outline-purple">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                     stroke-linejoin="round">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                    <circle cx="12" cy="12" r="3"></circle>
                </svg>
                View Full Review
            </button>
        </div>

        <!-- Additional Details -->
        <div class="side-card">
            <h3>Additional Details</h3>
            <div class="additional-grid">
                <div class="additional-col">
                    <div class="add-row"><span>Triggered By</span><span>New review submission</span></div>
                    <div class="add-row"><span>IP Address</span><span>192.168.1.45</span></div>
                    <div class="add-row">
                        <span>User Agent</span><span>
                        Mozilla/5.0 (Windows NT 10.0; Win64; x64)
                        AppleWebKit/537.36
                    </span>
                </div>
            </div>
            <div class="additional-col">
                <div class="add-row">
                    <span>Browser</span><span>
                    <span class="browser-icon"></span>Chrome
                    124.0.0.0
                </span>
            </div>
            <div class="add-row">
                <span>Device</span><span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                     stroke-linejoin="round">
                    <rect x="2" y="3" width="20" height="14" rx="2"></rect>
                    <line x1="8" y1="21" x2="16" y2="21"></line>
                    <line x1="12" y1="17" x2="12" y2="21"></line>
                </svg>
                Desktop
            </span>
        </div>
        <div class="add-row">
            <span>Location</span><span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                 stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
            </svg>
            New York, USA
        </span>
    </div>
</div>
</div>
</div>

<!-- Action bar -->
<div class="action-bar">
    <button class="btn-action approve">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
             stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        Approve Review
    </button>
    <button class="btn-action reject">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
             stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="15" y1="9" x2="9" y2="15"></line>
            <line x1="9" y1="9" x2="15" y2="15"></line>
        </svg>
        Reject Review
    </button>
    <button class="btn-action neutral">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
             stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        Mark as Read
    </button>
    <span class="spacer"></span>
    <button class="btn-action archive">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
             stroke-linejoin="round">
            <polyline points="21 8 21 21 3 21 3 8"></polyline>
            <rect x="1" y="3" width="22" height="5"></rect>
            <line x1="10" y1="12" x2="14" y2="12"></line>
        </svg>
        Archive Notification
    </button>
</div>

</div>

<!-- RIGHT column -->
<aside class="right-col">

    <!-- Related Information -->
    <div class="side-card">
        <h3>Related Information</h3>

        <div class="related-info-item">
            <div class="book-cover" style="width:38px;height:50px;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                     stroke-linejoin="round" style="width:15px;height:15px;">
                    <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                    <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
                </svg>
            </div>
            <div class="related-info-text">
                <span class="related-info-title">Atomic Habits</span>
                <span class="related-info-sub">by James Clear</span>
                <a href="#" class="related-info-link">
                    View Book
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                </a>
            </div>
        </div>

        <div class="related-info-item">
            <div class="avatar-circle" style="margin-bottom:0;">SJ</div>
            <div class="related-info-text">
                <span class="related-info-title">Sarah Johnson</span>
                <span class="related-info-sub">Verified Reader</span>
                <a href="#" class="related-info-link">
                    View Reader
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                </a>
            </div>
        </div>

        <div class="related-info-item">
            <div class="icon-circle orange" style="width:38px;height:38px;">
                <svg viewBox="0 0 24 24" fill="currentColor" style="width:17px;height:17px;">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2">
                    </polygon>
                </svg>
            </div>
            <div class="related-info-text">
                <span class="related-info-title">All Reviews for this Book</span>
                <span class="related-info-sub">1,250 reviews</span>
