                <span class="timeline-date">May 31, 2024, 10:15 AM</span>
                <span class="timeline-actor">System</span>
            </div>
        </div>

        <div class="timeline-item">
            <div class="timeline-marker">
                <span class="timeline-dot blue"></span>
