        <div class="timeline-item">
            <div class="timeline-marker">
                <span class="timeline-dot hollow"></span>
            </div>
            <div class="timeline-content">
                <strong>Notification Sent</strong>
                <span class="timeline-date">May 31, 2024, 10:15 AM</span>
