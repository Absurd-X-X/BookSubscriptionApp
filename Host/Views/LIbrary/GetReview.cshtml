@{
    Layout = "~/Views/Shared/_LibraryLayout.cshtml";
    ViewData["Title"] = "Book Review";
}
<link href="~/css/getReview.css" rel="stylesheet" />
    <main class="review-main">

        <a class="review-back" href="#">
            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7" /></svg>
            Back to Reviews
        </a>

        <div class="review-header-row">
            <div>
                <h1>Review Details</h1>
                <p>View and manage review information and moderation status.</p>
            </div>
            <div class="review-header-actions">
                <button class="date-range-btn">
                    May 1 – May 31, 2024
                    <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>
                </button>
                <button class="export-btn">
                    <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v12m0 0l-4-4m4 4l4-4M5 21h14" /></svg>
                    Export Review
                    <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6" /></svg>
                </button>
            </div>
        </div>

        <div class="review-grid">

            <!-- LEFT COLUMN -->
            <div>

                <div class="card">

                    <div class="reviewer-row">
                        <div class="reviewer-identity">
                            <div class="avatar">SJ</div>
                            <div class="reviewer-identity-text">
                                <div class="name">Sarah Johnson</div>
                                <div class="email">sarah.j@email.com</div>
                                <div class="reviewer-meta">
                                    <span>
                                        <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 4-6 8-6s8 2 8 6" /></svg>
                                        Member since Jan 12, 2023
                                    </span>
                                    <span>
                                        <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v12H7l-3 3z" /></svg>
                                        12 reviews
                                    </span>
                                    <span>
                                        <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 11v9H4v-9zm0 0l3-7a2 2 0 0 1 2-1l-1 5h7a2 2 0 0 1 2 2l-1.5 6a2 2 0 0 1-2 1.5H7" /></svg>
                                        8 helpful votes
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="reviewer-status">
                            <div class="reviewer-status-top">
                                <span class="status-pill">Approved</span>
                                <button class="more-btn">&#8943;</button>
                            </div>
                            <div class="timestamp">Reviewed on May 31, 2024<br>10:15 AM</div>
                        </div>
                    </div>

                    <div class="book-strip">
                        <div class="book-strip-info">
                            <img class="book-thumb" src="https://m.media-amazon.com/images/I/51-nXsSRfZL._SY445_SX342_.jpg" alt="Atomic Habits cover">
                            <div>
                                <div class="book-title">Atomic Habits</div>
                                <div class="book-author">James Clear</div>
                            </div>
                        </div>
                        <div class="book-strip-score">
                            <div class="score"><span class="stars">★★★★★</span> 5.0</div>
                            <div class="label">Excellent</div>
                        </div>
                    </div>

                    <div class="field-label">Review Title</div>
                    <p class="review-title-text">Life-changing book! The small habits approach really works.</p>

                    <div class="field-label">Review Content</div>
                    <p class="review-body-text">This book completely changed the way I think about building habits. The author does an excellent job breaking down complex concepts into simple, actionable steps. I especially loved the habit stacking technique and the emphasis on systems over goals.</p>
                    <p class="review-body-text">I've been applying these principles for the past 3 months and have seen remarkable improvements in my productivity and overall well-being. Highly recommended for anyone looking to make positive changes in their life!</p>

                    <div class="helpful-row">
                        <span>Was this review helpful?</span>
                        <button class="vote-btn yes">
                            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 11v9H4v-9zm0 0l3-7a2 2 0 0 1 2-1l-1 5h7a2 2 0 0 1 2 2l-1.5 6a2 2 0 0 1-2 1.5H7" /></svg>
                            Yes (8)
                        </button>
                        <button class="vote-btn no">
                            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 13V4h3v9zm0 0l-3 7a2 2 0 0 1-2 1l1-5H6a2 2 0 0 1-2-2l1.5-6A2 2 0 0 1 7.5 6H17" /></svg>
                            No (1)
                        </button>
                    </div>

                    <div class="rating-breakdown">
                        <h3>Rating Breakdown</h3>

                        <div class="rating-row">
                            <span class="rating-name">Overall Rating</span>
                            <span class="stars">★★★★★</span>
                            <span class="rating-fraction">5/5</span>
                            <span class="rating-word">Excellent</span>
                        </div>
                        <div class="rating-row">
                            <span class="rating-name">Content Quality</span>
                            <span class="stars">★★★★★</span>
                            <span class="rating-fraction">5/5</span>
                            <span class="rating-word">Excellent</span>
                        </div>
                        <div class="rating-row">
                            <span class="rating-name">Writing Style</span>
                            <span class="stars">★★★★★</span>
                            <span class="rating-fraction">5/5</span>
                            <span class="rating-word">Excellent</span>
                        </div>
                        <div class="rating-row">
                            <span class="rating-name">Value for Money</span>
                            <span class="stars">★★★★★</span>
                            <span class="rating-fraction">5/5</span>
                            <span class="rating-word">Excellent</span>
                        </div>
                    </div>

                </div>

                <div class="action-bar">
                    <div class="action-bar-left">
                        <button class="btn btn-approve">
                            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5" /></svg>
                            Approve Review
                        </button>
                        <button class="btn btn-reject">
                            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9" /><path d="M9 9l6 6M15 9l-6 6" /></svg>
                            Reject Review
                        </button>
                        <button class="btn btn-edit">
                            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z" /></svg>
                            Edit Review
                        </button>
                    </div>
                    <button class="btn btn-delete">
                        <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m2 0l-1 14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2L4 6" /></svg>
                        Delete Review
                    </button>
                </div>

            </div>

            <!-- RIGHT SIDEBAR -->
            <div class="side">

                <div class="card">
                    <h3>Book Information</h3>
                    <div class="book-info-card-top">
                        <img class="book-info-cover" src="https://m.media-amazon.com/images/I/51-nXsSRfZL._SY445_SX342_.jpg" alt="Atomic Habits cover">
                        <div>
                            <div class="book-title">Atomic Habits</div>
                            <div class="book-author">James Clear</div>
                        </div>
                    </div>
                    <div class="info-row">
                        <span class="info-key">
                            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20M4 4.5A2.5 2.5 0 0 1 6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5z" /></svg>
                            Category
                        </span>
                        <span class="info-val">Self-Help</span>
                    </div>
                    <div class="info-row">
                        <span class="info-key">
                            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>
                            Published
                        </span>
                        <span class="info-val">October 16, 2018</span>
                    </div>
                    <div class="info-row">
                        <span class="info-key">
                            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3 7h7l-5.5 4.5L18.5 21 12 16.5 5.5 21l2-7.5L2 9h7z" /></svg>
                            Average Rating
                        </span>
                        <span class="info-val">4.8 ★ (12,450 reviews)</span>
                    </div>
                </div>

                <div class="card">
                    <h3>Reviewer Information</h3>
                    <div class="info-row">
                        <span class="info-key">
                            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 4-6 8-6s8 2 8 6" /></svg>
                            Full Name
                        </span>
                        <span class="info-val">Sarah Johnson</span>
                    </div>
                    <div class="info-row">
                        <span class="info-key">
                            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 7l9 6 9-6" /></svg>
                            Email Address
                        </span>
                        <span class="info-val">sarah.j@email.com</span>
                    </div>
                    <div class="info-row">
                        <span class="info-key">
                            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z" /><circle cx="12" cy="10" r="2.5" /></svg>
                            Location
                        </span>
                        <span class="info-val">New York, USA</span>
                    </div>
                    <div class="info-row">
                        <span class="info-key">
                            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>
                            Member Since
                        </span>
                        <span class="info-val">Jan 12, 2023</span>
                    </div>
                    <div class="info-row">
                        <span class="info-key">
                            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v12H7l-3 3z" /></svg>
                            Total Reviews
                        </span>
                        <span class="info-val">12 reviews</span>
                    </div>
                    <div class="info-row">
                        <span class="info-key">
                            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 11v9H4v-9zm0 0l3-7a2 2 0 0 1 2-1l-1 5h7a2 2 0 0 1 2 2l-1.5 6a2 2 0 0 1-2 1.5H7" /></svg>
                            Helpful Votes
                        </span>
                        <span class="info-val">8 helpful votes received</span>
                    </div>
                </div>

                <div class="card">
                    <h3>Review History</h3>
                    <div class="timeline">
                        <div class="timeline-item">
                            <div class="timeline-dot done">&#10003;</div>
                            <div class="timeline-text">
                                <div class="timeline-title">Approved</div>
                                <div class="timeline-meta">May 31, 2024 at 10:30 AM<br>by Library Admin</div>
                            </div>
                        </div>
                        <div class="timeline-item">
                            <div class="timeline-dot active">&#9998;</div>
                            <div class="timeline-text">
                                <div class="timeline-title">Submitted</div>
                                <div class="timeline-meta">May 31, 2024 at 10:15 AM<br>by Sarah Johnson</div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

        </div>

    </main>