<script>

(function () {
  "use strict";

  /* ---------------------------------------------------------
     1. Donut chart (Chart.js)
  --------------------------------------------------------- */
  function renderDonutChart() {
    const ctx = document.getElementById("al-donut-chart");
    if (!ctx || typeof Chart === "undefined") return;

    new Chart(ctx, {
      type: "doughnut",
      data: {
        labels: ["Book Activities", "Reader Activities", "Review Activities", "System Activities"],
        datasets: [{
          data: [328, 512, 248, 160],
          backgroundColor: ["#3b82f6", "#22c55e", "#f59e0b", "#8b5cf6"],
          borderColor: "#151728",
          borderWidth: 3,
          hoverOffset: 6
        }]
      },
      options: {
        cutout: "72%",
        responsive: true,
        maintainAspectRatio: true,
        plugins: {
          legend: { display: false },
          tooltip: {
            backgroundColor: "#1a1c30",
            titleColor: "#f3f4f8",
            bodyColor: "#d4d5e3",
            borderColor: "#232640",
            borderWidth: 1,
            padding: 10,
            callbacks: {
              label: (ctx) => {
                const total = ctx.dataset.data.reduce((a, b) => a + b, 0);
                const pct = Math.round((ctx.raw / total) * 100);
                return ` ${ctx.label}: ${ctx.raw} (${pct}%)`;
              }
            }
          }
        }
      }
    });
  }
  function applyFilters() {
    const q = document.getElementById("al-search-input").value.trim().toLowerCase();
    const actionFilter = document.getElementById("al-filter-action").value;
    const userFilter = document.getElementById("al-filter-user").value;
    const resourceFilter = document.getElementById("al-filter-resource").value;

    const rows = document.querySelectorAll("#al-activity-table tbody tr");
    let visibleCount = 0;

    rows.forEach((row) => {
      const title = row.querySelector(".al-activity-title")?.textContent.toLowerCase() || "";
      const desc = row.querySelector(".al-activity-desc")?.textContent.toLowerCase() || "";
      const userName = row.querySelector(".al-user-name")?.textContent.trim() || "";
      const resourceTitle = row.querySelector(".al-resource-title")?.textContent.toLowerCase() || "";
      const actionText = row.querySelector(".al-pill")?.textContent.trim() || "";

      const matchesQuery = !q ||
        title.includes(q) || desc.includes(q) || userName.toLowerCase().includes(q) || resourceTitle.includes(q);

      const matchesAction = actionFilter === "All Actions" || actionText === actionFilter;
      const matchesUser = userFilter === "All Users" || userName === userFilter;

      // "Resource" filter: add a data-category="Books|Readers|Reviews|System"
      // attribute to each <tr> in the HTML for an exact match. Left as a
      // pass-through here since the static markup doesn't carry that yet.
      const matchesResource = resourceFilter === "All Resources" || true;

      const show = matchesQuery && matchesAction && matchesUser && matchesResource;
      row.style.display = show ? "" : "none";
      if (show) visibleCount++;
    });

    const showingText = document.getElementById("al-showing-text");
    const isFiltering = q || actionFilter !== "All Actions" || userFilter !== "All Users" || resourceFilter !== "All Resources";
    showingText.textContent = isFiltering
      ? `Showing ${visibleCount} of ${visibleCount} activities (filtered)`
      : "Showing 1 to 10 of 1,248 activities";
  }

  /* ---------------------------------------------------------
     3. Pagination (visual state only)
     Swap the comment below for a real fetch/render call when
     you wire this up to a backend.
  --------------------------------------------------------- */
  function setupPagination() {
    const pageButtons = document.querySelectorAll(".al-page-num");
    pageButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        pageButtons.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        // e.g. loadActivityPage(btn.dataset.page)
      });
    });

    document.getElementById("al-prev-page").addEventListener("click", () => {
      const allBtns = Array.from(pageButtons);
      const idx = allBtns.indexOf(document.querySelector(".al-page-num.active"));
      if (idx > 0) allBtns[idx - 1].click();
    });

    document.getElementById("al-next-page").addEventListener("click", () => {
      const allBtns = Array.from(pageButtons);
      const idx = allBtns.indexOf(document.querySelector(".al-page-num.active"));
      if (idx < allBtns.length - 1) allBtns[idx + 1].click();
    });
  }

  /* ---------------------------------------------------------
     4. Date filter sidebar (single-select highlight)
  --------------------------------------------------------- */
  function setupDateFilters() {
    const items = document.querySelectorAll(".al-date-filter-item");
    items.forEach((item) => {
      item.addEventListener("click", () => {
        items.forEach((i) => i.classList.remove("active"));
        item.classList.add("active");
        // e.g. loadActivitiesForRange(item.dataset.range)
      });
    });
  }

  /* ---------------------------------------------------------
     5. Init
  --------------------------------------------------------- */
  
    document.addEventListener("DOMContentLoaded", () => {
    renderDonutChart();
    setupPagination();
    setupDateFilters();
    setupRowMenus();

    document.getElementById("al-search-input").addEventListener("input", applyFilters);
    document.getElementById("al-filter-action").addEventListener("change", applyFilters);
    document.getElementById("al-filter-user").addEventListener("change", applyFilters);
    document.getElementById("al-filter-resource").addEventListener("change", applyFilters);
    });

    function positionMenu(trigger, menu) {
    menu.classList.remove("al-menu-up");
    menu.style.visibility = "hidden";
    menu.style.display = "block";

    const rect = trigger.getBoundingClientRect();
    const menuHeight = menu.offsetHeight;
    const spaceBelow = window.innerHeight - rect.bottom;
    const spaceAbove = rect.top;

    if (spaceBelow < menuHeight && spaceAbove > menuHeight) {
    menu.classList.add("al-menu-up");
    }

    menu.style.display = "";
    menu.style.visibility = "";
    }

    function setupRowMenus() {
    const MENU_HTML = `
    <button type="button" class="al-menu-item" data-action="view">View Details</button>
    <button type="button" class="al-menu-item" data-action="export">Export Entry</button>
    <div class="al-menu-sep"></div>
    <button type="button" class="al-menu-item danger" data-action="flag">Flag Activity</button>
    `;

    document.querySelectorAll(".al-row-menu").forEach((btn) => {
    const wrap = document.createElement("div");
    wrap.className = "al-menu-wrap";
    btn.parentNode.insertBefore(wrap, btn);
    wrap.appendChild(btn);

    const menu = document.createElement("div");
    menu.className = "al-row-dropdown";
    menu.innerHTML = MENU_HTML;
    wrap.appendChild(menu);

    btn.addEventListener("click", (e) => {
    e.stopPropagation();
    const isOpen = wrap.classList.contains("open");
    document.querySelectorAll(".al-menu-wrap.open").forEach((w) => w.classList.remove("open"));
    if (!isOpen) {
    positionMenu(btn, menu);
    wrap.classList.add("open");
    }
    });

    menu.querySelectorAll(".al-menu-item").forEach((item) => {
    item.addEventListener("click", (e) => {
    e.stopPropagation();
    wrap.classList.remove("open");
    const row = btn.closest("tr");
    const title = row.querySelector(".al-activity-title")?.textContent || "";
    console.log("[activity-log]", item.dataset.action, "for:", title);
    });
    });
    });

    document.addEventListener("click", () => {
    document.querySelectorAll(".al-menu-wrap.open").forEach((w) => w.classList.remove("open"));
    });
    }
})();
</script>