@{
    Layout = "~/Views/Shared/_LibraryLayout.cshtml";
    ViewData["Title"] = "Library Revenue";
}
@model Application.Queries.GetRevenueDashboard.GetRevenueDashboardHandler.RevenueDashboardResponse

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@latest/tabler-icons.min.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<link href="~/css/revenue.css" rel="stylesheet" />

<main class="dash">

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (Model == null)
    {
        <p class="ss" style="padding:16px;">Unable to load revenue data.</p>
    }
    else
    {
        <div class="ph">
            @{
                string[] palette = { "#7c3aed", "#06b6d4", "#22c55e", "#f97316", "#ef4444", "#3b82f6", "#a855f7", "#eab308" };

                string ColorFor(string title)
                {
                    int hash = 0;
                    foreach (char c in title ?? "")
                    {
                        hash = c + ((hash << 5) - hash);
                    }
                    int index = Math.Abs(hash) % palette.Length;
                    return palette[index];
                }

                string InitialsFor(string title)
                {
                    if (string.IsNullOrWhiteSpace(title))
                    {
                        return "?";
                    }

                    var words = title.Split(' ', StringSplitOptions.RemoveEmptyEntries);

                    if (words.Length == 1)
                    {
                        return words[0].Length >= 2 ? words[0].Substring(0, 2).ToUpper() : words[0].ToUpper();
                    }

                    return (words[0][0].ToString() + words[1][0].ToString()).ToUpper();
                }
            }
            <div class="ph-left">
                <h1>Earnings Overview</h1>
                <p>Track your library's earnings and monthly payouts from Super Admin.</p>
            </div>
            <div class="ph-right">
                <div class="date-btn">
                    <i class="ti ti-calendar"></i>
                    @Model.RangeStart.ToString("MMM d") – @Model.RangeEnd.ToString("MMM d, yyyy")
                </div>
                <button class="dl-btn" id="downloadReportBtn">
                    <i class="ti ti-download"></i> Download Report <i class="ti ti-chevron-down"></i>
                </button>
            </div>
        </div>

        <div class="stats">
            <div class="sc">
                <div>
                    <div class="si-label">
                        Total Earnings <span class="info-i">ⓘ</span>
                    </div>
                    <div class="si-val">₦@Model.TotalEarnings.ToString("N0")</div>
                    <div class="si-sub @(Model.TotalEarningsGrowthPercent >= 0 ? "pos" : "neg")">
                        @(Model.TotalEarningsGrowthPercent >= 0 ? "▲" : "▼")
                        @Math.Abs(Model.TotalEarningsGrowthPercent)%
                        <span class="si-gray">vs previous period</span>
                    </div>
                </div>
                <div class="sic"><i class="ti ti-briefcase"></i></div>
            </div>

            <div class="sc">
                <div>
                    <div class="si-label">
                        Pending Payout <span class="info-i">ⓘ</span>
                    </div>
                    <div class="si-val">₦@Model.PendingPayout.ToString("N0")</div>
                    <div class="si-sub warn">
                        @if (Model.UnpaidMonthsCount > 0)
                        {
                            @($"{Model.UnpaidMonthsCount} month(s) awaiting payment")
                        }
                        else
                        {
                            @("All caught up")
                        }
                    </div>
                </div>
                <div class="sic"><i class="ti ti-hourglass"></i></div>
            </div>

            <div class="sc">
                <div>
                    <div class="si-label">
                        Last Payout <span class="info-i">ⓘ</span>
                    </div>
                    <div class="si-val">₦@Model.LastPayoutAmount.ToString("N0")</div>
                    <div class="si-sub paid-c">
                        @if (Model.LastPayoutDate.HasValue)
                        {
                            @($"Paid on {Model.LastPayoutDate.Value:MMM d, yyyy}")
                        }
                        else
                        {
                            @("No payouts yet")
                        }
                    </div>
                </div>
                <div class="sic"><i class="ti ti-circle-check"></i></div>
            </div>

            <div class="sc">
                <div>
                    <div class="si-label">
                        Books Sold (This Month) <span class="info-i">ⓘ</span>
                    </div>
                    <div class="si-val">@Model.BooksSoldThisMonth.ToString("N0")</div>
                    <div class="si-sub @(Model.BooksSoldGrowthPercent >= 0 ? "pos" : "neg")">
                        @(Model.BooksSoldGrowthPercent >= 0 ? "▲" : "▼")
                        @Math.Abs(Model.BooksSoldGrowthPercent)%
                        <span class="si-gray">vs previous period</span>
                    </div>
                </div>
                <div class="sic"><i class="ti ti-books"></i></div>
            </div>
        </div>

        <div class="mid">
            <div class="card">
                <div class="ch">
                    <span class="ct">
                        Monthly Earnings Trend <span class="info-i">ⓘ</span>
                    </span>
                    <div class="tabs">
                        <button class="tab on" data-range="6m">6 Months</button>
                        <button class="tab" data-range="1y">1 Year</button>
                        <button class="tab" data-range="all">All Time</button>
                        <button class="tab">
                            <i class="ti ti-adjustments-horizontal"></i>
                        </button>
                    </div>
                </div>
                <div class="chart-wrap">
                    <canvas id="trendChart"></canvas>
                </div>
            </div>

            <div class="card">
                <div class="ch">
                    <span class="ct">Earnings Summary <span class="info-i">ⓘ</span></span>
                </div>
                <div class="sum-items">
                    <div class="sum-item">
                        <div class="sum-ico ico-b">
                            <i class="ti ti-calendar"></i>
                        </div>
                        <div>
                            <span class="sl">Current Month Earnings</span>
                            <span class="sv">₦@Model.CurrentMonthEarnings.ToString("N0")</span>
                            <span class="ss">
                                @Model.RangeStart.ToString("MMM d") – @Model.RangeEnd.ToString("MMM d, yyyy")
                            </span>
                        </div>
                    </div>

                    <div class="sum-item">
                        <div class="sum-ico ico-t">
                            <i class="ti ti-clock"></i>
                        </div>
                        <div>
                            <span class="sl">Unpaid Months</span>
                            <span class="sv">@Model.UnpaidMonthsCount</span>
                            <span class="ss">Awaiting payment from Super Admin</span>
                        </div>
                    </div>

                    <div class="sum-item">
                        <div class="sum-ico ico-g">
                            <i class="ti ti-star"></i>
                        </div>
                        <div>
                            <span class="sl">Best Performing Book</span>
                            <span class="sv">@(Model.BestPerformingBook?.Title ?? "—")</span>
                            <span class="ss">
                                ₦@(Model.BestPerformingBook?.Earnings.ToString("N0") ?? "0") earned this month
                            </span>
                        </div>
                    </div>

                    <div class="sum-item">
                        <div class="sum-ico ico-gr">
                            <i class="ti ti-trending-up"></i>
                        </div>
                        <div>
                            <span class="sl">Growth Rate</span>
                            <span class="sv @(Model.TotalEarningsGrowthPercent >= 0 ? "pos" : "neg")">
                                @(Model.TotalEarningsGrowthPercent >= 0 ? "▲" : "▼")
                                @Math.Abs(Model.TotalEarningsGrowthPercent)%
                            </span>
                            <span class="ss">vs previous period</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="bot">

            <div class="card">
                <div class="ch">
                    <span class="ct">Payout Status <span class="info-i">ⓘ</span></span>
                </div>
                <div class="donut-wrap">
                    <canvas id="donutChart" width="250" height="250"></canvas>
                    <div class="leg">
                        <div class="li">
                            <span class="ld" style="background:#22c55e"></span>
                            <div>
                                <span class="ll">Paid</span>
                                <span class="lp">@Model.PayoutStatusOverview.PaidMonthsCount month(s)</span>
                                <span class="la">₦@Model.PayoutStatusOverview.TotalPaidAmount.ToString("N0")</span>
                            </div>
                        </div>
                        <div class="li">
                            <span class="ld" style="background:#f59e0b"></span>
                            <div>
                                <span class="ll">Pending</span>
                                <span class="lp">@Model.PayoutStatusOverview.PendingMonthsCount month(s)</span>
                                <span class="la">₦@Model.PayoutStatusOverview.TotalPendingAmount.ToString("N0")</span>
                            </div>
                        </div>
                    </div>
                </div>
                <a href="@Url.Action("GetWallet", "Library")" class="vl">View payout history →</a>
            </div>

            <div class="card">
                <div class="va">
                    <span class="ct">Top Earning Books <span class="info-i">ⓘ</span></span>
                    <a href="@Url.Action("TopPerformingBooks", "Library")" class="vl">View All →</a>
                </div>

                @if (Model.TopEarningBooks == null || !Model.TopEarningBooks.Any())
                {
                    <p class="ss" style="padding:16px;">No book earnings yet.</p>
                }
                else
                {
                    <table class="btbl">
                        <thead>
                            <tr>
                                <th>Book</th>
                                <th>Earnings</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var book in Model.TopEarningBooks)
                            {
                                <tr>
                                    <td>
                                        <div class="bcell">
                                            @if (!string.IsNullOrEmpty(book.CoverImageUrl))
                                            {
                                                <img src="@book.CoverImageUrl" alt="@book.Title" class="bcov-img" />
                                            }
                                            else
                                            {
                                                <div class="bcov" style="background:@ColorFor(book.Title)">
                                                    @InitialsFor(book.Title)
                                                </div>
                                            }
                                            @book.Title
                                        </div>
                                    </td>
                                    <td>₦@book.Earnings.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>

            <div class="card">
                <div class="ch">
                    <span class="ct">Quick Actions</span>
                </div>
                <div class="qa-list">
                    <button class="ai" onclick="location.href='@Url.Action("GetWallet", "Library")'">
                        <div class="ai-ico"><i class="ti ti-calendar"></i></div>
                        View Payout History
                        <i class="ti ti-chevron-right ai-chev"></i>
                    </button>
                    <button class="ai" id="downloadReportBtn2">
                        <div class="ai-ico"><i class="ti ti-download"></i></div>
                        Download Earnings Report
                        <i class="ti ti-chevron-right ai-chev"></i>
                    </button>
                    <button class="ai" onclick="location.href='@Url.Action("TopPerformingBooks")'">
                        <div class="ai-ico"><i class="ti ti-chart-bar"></i></div>
                        View Top Books
                        <i class="ti ti-chevron-right ai-chev"></i>
                    </button>
                    <button class="ai">
                        <div class="ai-ico"><i class="ti ti-headset"></i></div>
                        Contact Super Admin (Support)
                        <i class="ti ti-chevron-right ai-chev"></i>
                    </button>
                </div>
                <div class="sup-ban">
                    <div class="sup-icon"><i class="ti ti-gift"></i></div>
                    <p>Have questions about your earnings?</p>
                    <small>Create a support ticket and the Super Admin will get back to you.</small>
                    <button class="btn-tkt" onclick="location.href='#'">
                        Create Support Ticket
                    </button>
                </div>
            </div>

        </div>

        <div class="card">
            <div class="va">
                <span class="ct">Transaction History <span class="info-i">ⓘ</span></span>
                <a href="@Url.Action("GetWallet", "Library")" class="vl">View All →</a>
            </div>

            @if (Model.RecentTransactions == null || !Model.RecentTransactions.Items.Any())
            {
                <p class="ss" style="padding:16px;">No transactions found.</p>
            }
            else
            {
                <table class="ptbl">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Amount</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th>Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tx in Model.RecentTransactions.Items)
                        {
                            
                            <tr>
                                <td>@tx.DateCreated.ToString("MMM d, yyyy")</td>
                                @{
                                    string badgeClass;
                                    string statusLower = tx.Status?.ToLower() ?? "";

                                    if (statusLower == "success" || statusLower == "paid" || statusLower == "completed")
                                    {
                                        badgeClass = "badge-paid";
                                    }
                                    else if (statusLower == "pending")
                                    {
                                        badgeClass = "badge-pending";
                                    }
                                    else if (statusLower == "failed" || statusLower == "reversed")
                                    {
                                        badgeClass = "badge-failed";
                                    }
                                    else
                                    {
                                        badgeClass = "badge-paid";
                                    }
                                }
                                <td>₦@tx.Amount.ToString("N0")</td>
                                <td>@tx.Type</td>
                                <td><span class="@badgeClass">@tx.Status</span></td>
                                <td>@tx.Description</td>
                            </tr>
                        }
                    </tbody>
                </table>

                

                <div class="pg-nav" style="display:flex; gap:8px; justify-content:flex-end; padding:14px;">
                    @{
                        int totalPages = 1;

                        if (Model.RecentTransactions.PageSize > 0)
                        {
                            totalPages = (int)Math.Ceiling((double)Model.RecentTransactions.TotalCount / Model.RecentTransactions.PageSize);
                        }

                        if (totalPages < 1)
                        {
                            totalPages = 1;
                        }

                        string prevDisabled = Model.RecentTransactions.Page <= 1 ? "disabled" : "";
                        string nextDisabled = Model.RecentTransactions.Page >= totalPages ? "disabled" : "";
                    }
                    <a class="dl-btn @prevDisabled"
                       href="@Url.Action("GetRevenue", new { page = Model.RecentTransactions.Page - 1, pageSize = Model.RecentTransactions.PageSize })">
                        <i class="ti ti-chevron-left"></i> Prev
                    </a>
                    <span class="ss" style="align-self:center;">
                        Page @Model.RecentTransactions.Page of @totalPages
                    </span>
                    <a class="dl-btn @nextDisabled"
                       href="@Url.Action("GetRevenue", new { page = Model.RecentTransactions.Page + 1, pageSize = Model.RecentTransactions.PageSize })">
                        Next <i class="ti ti-chevron-right"></i>
                    </a>
                </div>
            }
        </div>
    }

</main>

@if (Model != null)
{
    <script>
        (function () {
            const trendLabels = @Html.Raw(Json.Serialize(Model.TrendLabels))
            const trendData = @Html.Raw(Json.Serialize(Model.TrendData))

            const trendChart = new Chart(document.getElementById('trendChart'), {
                type: 'line',
                data: {
                    labels: trendLabels,
                    datasets: [{
                        label: 'Earnings',
                        data: trendData,
                        borderColor: '#7c3aed',
                        backgroundColor: 'rgba(124,58,237,0.12)',
                        borderWidth: 2.5,
                        pointBackgroundColor: '#7c3aed',
                        pointBorderColor: '#0d0b1e',
                        pointBorderWidth: 2,
                        pointRadius: 5,
                        pointHoverRadius: 7,
                        fill: true,
                        tension: 0.35
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#1e1b4b',
                            titleColor: '#a5b4fc',
                            bodyColor: '#ffffff',
                            padding: 10,
                            cornerRadius: 8,
                            callbacks: {
                                label: function (ctx) {
                                    return '₦' + ctx.parsed.y.toLocaleString();
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: { color: 'rgba(255,255,255,0.05)' },
                            ticks: { color: '#6b7280', font: { size: 11 } }
                        },
                        y: {
                            grid: { color: 'rgba(255,255,255,0.05)' },
                            ticks: {
                                color: '#6b7280',
                                font: { size: 11 },
                                callback: function (v) {
                                    return '₦' + (v / 1000).toFixed(0) + 'k';
                                }
                            },
                            beginAtZero: true
                        }
                    }
                }
            });

            new Chart(document.getElementById('donutChart'), {
                type: 'doughnut',
                data: {
                    labels: ['Paid', 'Pending'],
                    datasets: [{
                        data: [
                            @Model.PayoutStatusOverview.TotalPaidAmount,
                            @Model.PayoutStatusOverview.TotalPendingAmount
                        ],
                        backgroundColor: ['#22c55e', '#f59e0b'],
                        borderColor: '#13102a',
                        borderWidth: 3,
                        hoverOffset: 5
                    }]
                },
                options: {
                    responsive: false,
                    cutout: '50%',
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#1e1b4b',
                            titleColor: '#a5b4fc',
                            bodyColor: '#ffffff',
                            callbacks: {
                                label: function (ctx) {
                                    return ' ' + ctx.label + ': ₦' + ctx.parsed.toLocaleString();
                                }
                            }
                        }
                    }
                }
            });

            const rangeButtons = document.querySelectorAll('.tab[data-range]');

            rangeButtons.forEach(function (tab) {
                tab.addEventListener('click', async function () {
                    document.querySelectorAll('.tab').forEach(function (t) {
                        t.classList.remove('on');
                    });
                    tab.classList.add('on');

                    const range = tab.dataset.range;

                    try {
                        const res = await fetch('/Revenue/GetTrend?range=' + range);

                        if (!res.ok) {
                            return;
                        }

                        const json = await res.json();
                        trendChart.data.labels = json.labels;
                        trendChart.data.datasets[0].data = json.data;
                        trendChart.update();
                    } catch (e) {
                        console.error('Failed to load trend range', e);
                    }
                });
            });

            function downloadReport() {
                window.location.href = '/Revenue/DownloadReport';
            }

            const downloadBtn1 = document.getElementById('downloadReportBtn');
            const downloadBtn2 = document.getElementById('downloadReportBtn2');

            if (downloadBtn1) {
                downloadBtn1.addEventListener('click', downloadReport);
            }

            if (downloadBtn2) {
                downloadBtn2.addEventListener('click', downloadReport);
            }
        })();
    </script>
}