@model Application.Common.Pagenation.PagenatedList<Application.Queries.GetTopPerformingBooks.TopPerformingBookDto>
@{
    Layout = "~/Views/Shared/_LibraryLayout.cshtml";
    ViewData["Title"] = "Library Top Performing Books";
}

<link href="~/css/topPerforminBooks.css" rel="stylesheet" />

<div class="page-header">
    <div class="page-title">
        <h1>Top Performing Books</h1>
        <p>Discover the books that are performing the best in your library based on reads, ratings and completion.</p>
    </div>

    <div class="header-actions">
        <button class="export-btn" onclick="handleExport()">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
            Export Report
        </button>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div style="background:#3a1a1a;color:#f87171;padding:10px 14px;border-radius:8px;margin-bottom:16px;font-size:13px">
        @TempData["Error"]
    </div>
}

<div class="table-card">
    <div class="table-wrap">
        <table id="booksTable">
            <thead>
                <tr>
                    <th class="col-rank">#</th>
                    <th>Book</th>
                    <th>Reads</th>
                    <th>Average Rating</th>
                    <th>Reviews</th>
                    <th>Completion Rate</th>
                    <th>Added On</th>
                    <th class="col-actions"></th>
                </tr>
            </thead>
            <tbody id="booksBody">
                @if (Model.Items.Any())
                {
                    var rank = ((Model.Page - 1) * Model.PageSize) + 1;
                    @foreach (var b in Model.Items)
                    {
                        <tr data-id="@b.BookId">
                            <td class="col-rank">@rank</td>

                            <td>
                                <div class="book-cell">
                                    <div class="book-cover-placeholder" style="@(string.IsNullOrEmpty(b.CoverUrl) ? "" : $"background-image:url('{b.CoverUrl}');background-size:cover;")">
                                        @if (string.IsNullOrEmpty(b.CoverUrl))
                                        {
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" /><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" /></svg>
                                        }
                                    </div>
                                    <div class="book-info">
                                        <span class="book-title">@b.Title</span>
                                        <span class="book-author">@b.Author</span>
                                        <span class="book-badge @(b.IsPublished ? "" : "unpublished")">@(b.IsPublished ? "Published" : "Unpublished")</span>
                                    </div>
                                </div>
                            </td>

                            <td>
                                <div class="stat-cell">
                                    <span class="stat-main">@b.Reads.ToString("N0")</span>
                                </div>
                            </td>

                            <td>
                                <div class="rating-cell">
                                    <span class="rating-main">@b.AverageRating.ToString("0.0") <span class="star">★</span></span>
                                    <span class="reviews-sub">@b.ReviewCount reviews</span>
                                </div>
                            </td>

                            <td>
                                <div class="stat-cell">
                                    <span class="stat-main">@b.ReviewCount.ToString("N0")</span>
                                </div>
                            </td>

                            <td>
                                <div class="completion-cell">
                                    <div class="completion-top">
                                        <span class="completion-pct">@b.CompletionRate%</span>
                                    </div>
                                    <div class="completion-bar-track">
                                        <div class="completion-bar-fill" style="width:@(b.CompletionRate)%"></div>
                                    </div>
                                </div>
                            </td>

                            <td class="date-cell">@b.AddedOn.ToString("MMM d, yyyy")</td>

                            <td class="actions-cell">
                                <button class="more-btn" onclick="toggleMenu(event, '@b.BookId')" aria-label="More options">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="12" cy="5" r="1" />
                                        <circle cx="12" cy="12" r="1" />
                                        <circle cx="12" cy="19" r="1" />
                                    </svg>
                                </button>

                                <div class="context-menu" id="menu-@b.BookId">
                                    <a class="context-menu-item" href="@Url.Action("PreviewBook", "Library", new { id = b.BookId })">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
                                        View Book
                                    </a>
                                    <a class="context-menu-item" href="@Url.Action("EditBook", "Library", new { id = b.BookId })">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" /></svg>
                                        Edit Book
                                    </a>

                                    <div class="context-menu-divider"></div>

                                    <a class="context-menu-item" href="@Url.Action("GetReviews", "Library", new { id = b.BookId })">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" /></svg>
                                        View Reviews
                                    </a>

                                    <div class="context-menu-divider"></div>

                                    <form method="post" asp-action="DeleteBook" asp-route-id="@b.BookId" onsubmit="return confirm('Delete this book permanently?');">
                                        <button type="submit" class="context-menu-item is-danger">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6" /><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" /></svg>
                                            Delete Book
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        rank++;
                    }
                }
                else
                {
                    <tr><td colspan="8" style="text-align:center;color:#7878a0;padding:20px">No books found</td></tr>
                }
            </tbody>
        </table>
    </div>

    <div class="table-footer">
        @{
            var startIdx = Model.TotalCount == 0 ? 0 : ((Model.Page - 1) * Model.PageSize) + 1;
            var endIdx = Math.Min(Model.Page * Model.PageSize, Model.TotalCount);
            var totalPages = Math.Max(1, (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize));
        }
        <span class="table-footer-info">Showing @startIdx to @endIdx of @Model.TotalCount.ToString("N0") books</span>
        <div class="pagination">
            <a class="pg-btn @(Model.Page <= 1 ? "disabled" : "")" asp-action="TopPerformingBooks" asp-route-page="@(Model.Page - 1)" asp-route-pageSize="@Model.PageSize">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6" /></svg>
            </a>
            @for (int p = 1; p <= totalPages; p++)
            {
                <a class="pg-btn @(p == Model.Page ? "is-active" : "")" asp-action="TopPerformingBooks" asp-route-page="@p" asp-route-pageSize="@Model.PageSize">@p</a>
            }
            <a class="pg-btn @(Model.Page >= totalPages ? "disabled" : "")" asp-action="TopPerformingBooks" asp-route-page="@(Model.Page + 1)" asp-route-pageSize="@Model.PageSize">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6" /></svg>
            </a>
        </div>
    </div>
</div>

<div class="toast-container" id="toastContainer"></div>

<script>
    function toggleMenu(e, id) {
        e.stopPropagation();
        const menu = document.getElementById('menu-' + id);
        const isOpen = menu.classList.contains('is-open');
        document.querySelectorAll('.context-menu.is-open').forEach(m => m.classList.remove('is-open'));
        if (!isOpen) menu.classList.add('is-open');
    }

    document.addEventListener('click', function () {
        document.querySelectorAll('.context-menu.is-open').forEach(m => m.classList.remove('is-open'));
    });

    function handleExport() {
        showToast('success', 'Exporting report… your download will start shortly.');
    }

    function showToast(type, message) {
        const icons = {
            success: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#24B35F" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>`,
            info: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#A78BFA" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>`,
            danger: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#E63B60" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>`,
        };
        const container = document.getElementById('toastContainer');
        const toast = document.createElement('div');
        toast.className = `toast is-${type}`;
        toast.innerHTML = `${icons[type]}<span>${message}</span>`;
        container.appendChild(toast);
        setTimeout(() => {
            toast.style.transition = 'opacity .3s ease';
            toast.style.opacity = '0';
            setTimeout(() => toast.remove(), 320);
        }, 3000);
    }
</script>