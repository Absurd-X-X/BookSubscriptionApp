        </div>

        <div class="book-meta">
            <h1>Atomic Habits</h1>
            <p class="author">James Clear</p>
            <div class="tags">
                <span class="pill pill-green">Published</span>
                <span class="pill pill-indigo">Self Help</span>
                <span class="pill-date">📅 Published on May 28, 2024</span>
