                        <div>
                            <b>Atomic Habits</b><br><small class="muted">James Clear</small>
                            <div class="tags" style="margin:8px 0">
                                <span class="pill pill-indigo">Self Help</span><span class="muted">English</span>
                            </div>
                            <div class="rating" style="margin:0 0 8px"><span class="stars">★</span> <strong>4.9</strong> <small class="muted">(245 reviews)</small></div>
                            <small class="muted">No matter your goals, Atomic Habits offers a proven framework for improving—every day…</small>
                        </div>
                        <div class="cover-box mini">
                            <div class="cover-inner"><h2>Atomic<br>Habits</h2><strong>James Clear</strong></div>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <h3>Quick Actions</h3>
                    <a class="action-row" href="#"><span class="a-ic">⧉</span><div><b>Duplicate Book</b><small class="muted">Create a copy of this book</small></div><span class="chev">›</span></a>
                    <a class="action-row" href="#"><span class="a-ic">🗑</span><div><b>Archive Book</b><small class="muted">Hide this book from the public</small></div><span class="chev">›</span></a>
