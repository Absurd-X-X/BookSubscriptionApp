@model Application.Common.Dtos.UpdateBookViewModel

@{
    Layout = "~/Views/Shared/_LibraryLayout.cshtml";
    ViewData["Title"] = "Edit Book";
}

<link href="~/css/editBook.css" rel="stylesheet" />
<main class="book-detail">
    <form asp-action="EditBook" asp-controller="Library" method="post">
        <input type="hidden" asp-for="BookId" />

        <!-- Breadcrumb + actions -->
        <div class="topline">
            <nav class="crumbs">
                <a href="#">Books</a><span>›</span><a href="#">@Model.Title</a><span>›</span><span class="current">Edit Book</span>
            </nav>
            <div class="topline-actions">
                <button type="button" class="btn btn-ghost">···</button>
                <a href="/Library/PreviewBook/@Model.BookId" class="btn btn-outline">👁 Preview Book</a>
                <button type="submit" class="btn btn-primary">✎ Save Changes</button>
            </div>
        </div>

        <!-- Book header -->
        <section class="book-header card">
            <div class="cover-col">
                <div class="cover-box">
                    <div class="cover-inner">
                        <small>@Model.Subtitle</small>
                        <h2>@Model.Title</h2>
                        <small>@Model.Subtitle</small>
                        <strong>@Model.Author</strong>
                    </div>
                </div>
                <button type="button" class="btn btn-block btn-outline">⬆ Change Cover</button>
            </div>

            <div class="book-meta">
                <h1>@Model.Title</h1>
                <p class="author">@Model.Author</p>
                <div class="tags">
                    <span class="pill @(Model.IsPublished ? "pill-green" : "pill-gray")">@(Model.IsPublished ? "Published" : "Draft")</span>
                    <span class="pill pill-indigo">@Model.Genre</span>
                    <span class="pill-date">📅 Published on @Model.PublicationYear</span>
                </div>
                <div class="rating">⭐ <strong>@Model.AverageRating.ToString("0.0")</strong> <span>(@Model.ReviewCount reviews)</span></div>

                <div class="stat-grid">
                    <div class="stat"><span class="ic">👁</span><div><strong>@Model.TotalReads</strong><small>Total Reads</small></div></div>
                    <div class="stat"><span class="ic">📖</span><div><strong>@Model.CompletionRate%</strong><small>Completion Rate</small></div></div>
                    <div class="stat"><span class="ic">⏱</span><div><strong>@Model.AvgReadingTime</strong><small>Avg. Reading Time</small></div></div>
                    <div class="stat"><span class="ic">🧾</span><div><strong>₦@Model.TotalRevenue</strong><small>Total Revenue</small></div></div>
                </div>
            </div>
        </section>

        <!-- Tabs -->
        <nav class="tabs" role="tablist">
            <button type="button" class="tab active" role="tab" data-tab="info">Book Information</button>
            <button type="button" class="tab" role="tab" data-tab="pricing">Pricing &amp; Access</button>
            <button type="button" class="tab" role="tab" data-tab="files">Files &amp; Versions</button>
            <button type="button" class="tab" role="tab" data-tab="seo">SEO &amp; Settings</button>
        </nav>

        <!-- ===================== BOOK INFORMATION ===================== -->
        <section class="tab-panel active" id="info">
            <div class="cols-2">
                <div>
                    <div class="card">
                        <h3>Basic Information</h3>
                        <div class="field"><label>Title <em>*</em></label><input asp-for="Title" required></div>
                        <div class="field"><label>Subtitle</label><input asp-for="Subtitle"></div>
                        <div class="row-2">
                            <div class="field"><label>Author <em>*</em></label><input asp-for="Author" required></div>
                            <div class="field">
                                <label>Genre <em>*</em></label>
                                <select asp-for="Genre">
                                    @foreach (var g in Model.GenreOptions)
                                    {
                                        <option value="@g" selected="@(g == Model.Genre)">@g</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="row-2">
                            <div class="field">
                                <label>Language <em>*</em></label>
                                <select asp-for="Language">
                                    @foreach (var l in Model.LanguageOptions)
                                    {
                                        <option value="@l" selected="@(l == Model.Language)">@l</option>
                                    }
                                </select>
                            </div>
                            <div class="field"><label>ISBN</label><input asp-for="Isbn"></div>
                        </div>
                        <div class="field">
                            <label>Description <em>*</em></label>
                            <textarea asp-for="About" rows="4" maxlength="1000"></textarea>
                            <small class="counter muted" id="aboutCounter">@Model.About?.Length/1000</small>
                        </div>
                    </div>

                    <div class="card">
                        <h3>Book Details</h3>
                        <div class="row-2">
                            <div class="field"><label>Publisher</label><input asp-for="Publisher"></div>
                            <div class="field"><label>Publish Date <em>*</em></label><input asp-for="PublicationYear" type="number"></div>
                        </div>
                        <div class="row-3">
                            <div class="field"><label>Edition</label><input asp-for="Edition" placeholder="mocked field"></div>
                            <div class="field"><label>Pages</label><input asp-for="Pages" type="number"></div>
                            <div class="field"><label>File Type</label><select disabled><option>@Model.FileType</option></select></div>
                        </div>
                        <div class="field"><label>File Size</label><input value="@Model.FileSize" disabled></div>
                    </div>

                    <div class="card">
                        <h3>Book Status</h3>
                        <div class="row-2">
                            <div class="field">
                                <label>Status <em>*</em></label>
                                <select asp-for="IsPublished">
                                    <option value="true">Published</option>
                                    <option value="false">Draft</option>
                                </select>
                            </div>
                            <div class="field">
                                <label>Visibility <em>*</em></label>
                                <select asp-for="AccessLevel">
                                    <option value="Public">Public</option>
                                    <option value="Private">Private</option>
                                </select>
                            </div>
                        </div>
                        <small class="muted">Published books are visible to all users.</small>
                    </div>
                </div>

                <!-- right column -->
                <div>
                    <div class="card">
                        <h3>Book Categories</h3>
                        <div class="field">
                            <label>Primary Category <em>*</em></label>
                            <select asp-for="CategoryId">
                                @foreach (var c in Model.Categories)
                                {
                                    <option value="@c.Id" selected="@(c.Id == Model.CategoryId)">@c.Name</option>
                                }
                            </select>
                        </div>
                        <div class="field">
                            <label>Additional Categories</label>
                            <div class="chips" id="additionalCategoriesChips">
                                @foreach (var cat in Model.AdditionalCategories)
                                {
                                    <span class="chip">@cat <a href="#" class="chip-remove">✕</a><input type="hidden" name="AdditionalCategories" value="@cat" /></span>
                                }
                            </div>
                            <input type="text" id="addCategoryInput" placeholder="Type and press enter... (mocked)">
                        </div>
                    </div>

                    <div class="card">
                        <h3>Tags</h3>
                        <div class="field"><label>Add Tags</label><input type="text" id="addTagInput" placeholder="Type and press enter... (mocked)"></div>
                        <div class="chips" id="tagsChips">
                            @foreach (var tag in Model.Tags)
                            {
                                <span class="chip">@tag <a href="#" class="chip-remove">✕</a><input type="hidden" name="Tags" value="@tag" /></span>
                            }
                        </div>
                    </div>

                    <div class="card">
                        <h3>Book Preview</h3>
                        <small class="muted">This is how your book information will appear to readers.</small>
                        <div class="preview-card">
                            <div>
                                <b>@Model.Title</b><br><small class="muted">@Model.Author</small>
                                <div class="tags" style="margin:8px 0">
                                    <span class="pill pill-indigo">@Model.Genre</span><span class="muted">@Model.Language</span>
                                </div>
                                <div class="rating" style="margin:0 0 8px"><span class="stars">★</span> <strong>@Model.AverageRating.ToString("0.0")</strong> <small class="muted">(@Model.ReviewCount reviews)</small></div>
                                <small class="muted">@Model.About</small>
                            </div>
                            <div class="cover-box mini">
                                <div class="cover-inner"><h2>@Model.Title</h2><strong>@Model.Author</strong></div>
                            </div>
                        </div>
                    </div>

                    <div class="card">
                        <h3>Quick Actions</h3>
                        <a class="action-row" href="#"><span class="a-ic">⧉</span><div><b>Duplicate Book</b><small class="muted">Create a copy of this book</small></div><span class="chev">›</span></a>
                        <a class="action-row" href="@Url.Action("ArchiveBook", "Library", new { id = Model.BookId })"><span class="a-ic">🗑</span><div><b>Archive Book</b><small class="muted">Hide this book from the public</small></div><span class="chev">›</span></a>
                        <a class="action-row danger" href="@Url.Action("ArchiveBook", "Library", new { id = Model.BookId })"><span class="a-ic">🗑</span><div><b>Delete Book</b><small class="muted">Permanently delete this book</small></div><span class="chev">›</span></a>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-head">
                    <div><h3>Files &amp; Versions</h3><small class="muted">Manage your book files and versions.</small></div>
                    <a class="btn btn-primary" href="#">+ Upload New Version</a>
                </div>
                <table class="data-table">
                    <thead><tr><th>File Name</th><th>Version</th><th>Type</th><th>Size</th><th>Uploaded On</th><th>Status</th><th>Actions</th></tr></thead>
                    <tbody>
                        @foreach (var f in Model.Files)
                        {
                            <tr>
                                <td><span class="file-ic @f.Type.ToLower() sm">@f.Type</span> @f.FileName</td>
                                <td>@f.Version</td>
                                <td>@f.Type</td>
                                <td>@f.Size</td>
                                <td>@f.UploadedOn.ToString("MMM dd, yyyy")</td>
                                <td><span class="pill @(f.IsPublished ? "pill-green" : "pill-gray")">@(f.IsPublished ? "Published" : "Unpublished")</span></td>
                                <td>⬇ ···</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <!-- ===================== PRICING & ACCESS ===================== -->
        <section class="tab-panel" id="pricing">
            <div class="cols-2">
                <div>
                    <div class="card">
                        <h3>Pricing Model</h3>
                        <small class="muted">Choose how this book will be monetized.</small>
                        <div class="choice-grid" data-radio-name="PricingType">
                            <button type="button" class="choice @(Model.PricingType == "Paid" ? "active" : "")" data-value="Paid"><span class="c-ic">🛒</span><b>Paid Book</b><small>Readers must pay to access this book.</small></button>
                            <button type="button" class="choice @(Model.PricingType == "Free" ? "active" : "")" data-value="Free"><span class="c-ic">🎁</span><b>Free Book</b><small>Readers can access this book for free.</small></button>
                            <button type="button" class="choice @(Model.PricingType == "Freemium" ? "active" : "")" data-value="Freemium"><span class="c-ic">👑</span><b>Freemium</b><small>Part of the book is free, rest is paid.</small></button>
                        </div>
                        <input type="hidden" asp-for="PricingType" id="PricingType" />
                    </div>

                    <div class="card">
                        <h3>Price Settings</h3>
                        <small class="muted">Set the price for this book.</small>
                        <div class="field"><label>Price (NGN) <em>*</em></label><input asp-for="Price" type="number" step="0.01"></div>
                        <div class="row-2">
                            <div class="field"><label>Compare at Price (Optional)</label><input asp-for="CompareAtPrice" type="number" step="0.01" placeholder="mocked field"><small class="muted">The original price before discount.</small></div>
                            <div class="field"><label>Discount (%)</label><input asp-for="Discount" type="number" step="0.01"><small class="muted">Leave empty if no discount.</small></div>
                        </div>
                        <div class="row-2 result-row">
                            <div><small class="muted">Final Price</small><strong class="up">₦@Model.Price</strong></div>
                            <div><small class="muted">You Save</small><strong>₦@(Model.CompareAtPrice - Model.Price) (@Model.Discount%)</strong></div>
                        </div>
                    </div>

                    <div class="card">
                        <h3>Membership &amp; Access Control</h3>
                        <small class="muted">Restrict or allow access based on membership plans. (mocked)</small>
                        <div class="radio-list" data-radio-name="MembershipAccess">
                            <label class="radio @(Model.MembershipAccess == "AllUsers" ? "active" : "")"><input type="radio" name="MembershipAccessDisplay" data-value="AllUsers" checked="@(Model.MembershipAccess == "AllUsers")"><div><b>All Users</b><small class="muted">All registered users can purchase and access this book.</small></div></label>
                            <label class="radio @(Model.MembershipAccess == "SpecificPlans" ? "active" : "")"><input type="radio" name="MembershipAccessDisplay" data-value="SpecificPlans" checked="@(Model.MembershipAccess == "SpecificPlans")"><div><b>Specific Membership Plans</b><small class="muted">Only users with selected plans can access this book.</small></div></label>
                            <label class="radio @(Model.MembershipAccess == "VipOnly" ? "active" : "")"><input type="radio" name="MembershipAccessDisplay" data-value="VipOnly" checked="@(Model.MembershipAccess == "VipOnly")"><div><b>VIP Only</b><small class="muted">Only VIP members can access this book.</small></div></label>
                        </div>
                        <input type="hidden" asp-for="MembershipAccess" id="MembershipAccess" />
                        <div class="toggle-row"><div><b>Rental Option (Optional)</b><small class="muted">Allow users to rent this book for a limited time.</small></div><span class="switch @(Model.RentalOption ? "on" : "")" data-target="RentalOption"></span></div>
                        <input type="hidden" asp-for="RentalOption" id="RentalOption" />
                    </div>
                </div>

                <div>
                    <div class="card">
                        <h3>Access Settings</h3>
                        <small class="muted">Control who can access and read this book.</small>
                        <div class="field">
                            <label>Access Type</label>
                            <select asp-for="AccessType">
                                <option value="AnyoneWithAccess">Anyone with Access</option>
                            </select>
                            <small class="muted">Book is available to all users after purchase.</small>
                        </div>
                        <label class="cb-label">Reading Permission</label>
                        <label class="checkbox @(Model.AllowOnlineReading ? "checked" : "")"><input type="checkbox" asp-for="AllowOnlineReading"><div><b>Allow Online Reading</b><small class="muted">Readers can read online in the platform.</small></div></label>
                        <label class="checkbox @(Model.AllowDownload ? "checked" : "")"><input type="checkbox" asp-for="AllowDownload"><div><b>Allow Offline Download</b><small class="muted">Readers can download and read offline.</small></div></label>
                        <label class="checkbox @(Model.LimitToOneDevice ? "checked" : "")"><input type="checkbox" asp-for="LimitToOneDevice"><div><b>Limit to 1 Device</b><small class="muted">Limit the book to be read on only 1 device.</small></div></label>
                        <div class="toggle-row"><div><b>Drip Content (Optional)</b><small class="muted">Release book chapters gradually over time.</small></div><span class="switch @(Model.DripContent ? "on" : "")" data-target="DripContent"></span></div>
                        <input type="hidden" asp-for="DripContent" id="DripContent" />
                    </div>

                    <div class="card">
                        <h3>Chapters Preview Settings</h3>
                        <small class="muted">Choose how much content is available for preview. (mocked)</small>
                        <div class="field">
                            <label>Preview Type</label>
                            <select asp-for="PreviewType">
                                <option value="FreePreviewChapters">Free Preview (Chapters)</option>
                            </select>
                        </div>
                        <div class="field">
                            <label>Number of Free Chapters</label>
                            <select asp-for="FreeChapterCount">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <option value="@i" selected="@(i == Model.FreeChapterCount)">@i</option>
                                }
                            </select>
                            <small class="muted">Readers can preview the selected number of chapters.</small>
                        </div>
                        <div class="preview-chapters">
                            <b>Preview Chapters</b>
                            @foreach (var ch in Model.PreviewChapters)
                            {
                                <div class="f-row">@ch.Number. @ch.Title <span class="pill pill-green">Preview</span></div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-footer">
                <button type="button" class="btn btn-outline" onclick="window.location.reload()">Cancel</button>
                <div class="spacer"></div>
                <button type="button" class="btn btn-outline">Save as Draft</button>
                <button type="submit" class="btn btn-primary">Save Changes</button>
            </div>
        </section>

        <!-- ===================== FILES & VERSIONS ===================== -->
        <section class="tab-panel" id="files">
            <div class="cols-2">
                <div class="card">
                    <div class="card-head"><h3>Current Active File</h3><span class="pill pill-green">Active</span></div>
                    <div class="active-file">
                        <span class="file-ic @Model.CurrentFile.Type.ToLower() lg">@Model.CurrentFile.Type</span>
                        <div class="af-info">
                            <b>@Model.CurrentFile.FileName ✎</b>
                            <div class="af-row"><span class="muted">Version</span><span class="pill pill-indigo">v@Model.CurrentFile.Version</span></div>
                            <div class="af-row"><span class="muted">File Type</span><span>@Model.CurrentFile.Type</span></div>
                            <div class="af-row"><span class="muted">File Size</span><span>@Model.CurrentFile.Size</span></div>
                            <div class="af-row"><span class="muted">Uploaded On</span><span>@Model.CurrentFile.UploadedOn.ToString("MMM dd, yyyy")</span></div>
                            <div class="af-row"><span class="muted">Uploaded By</span><span>👤 @Model.CurrentFile.UploadedBy</span></div>
                        </div>
                    </div>
                    <div class="btn-pair"><a class="btn btn-primary" href="@Url.Action("PreviewBook", "Library", new { id = Model.BookId })">👁 Open File</a><a class="btn btn-outline" href="@Model.CurrentFile.Url" download>⬇ Download</a></div>
                </div>

                <div class="card">
                    <h3>File Statistics</h3>
                    <div class="stat-grid two">
                        <div class="stat"><span class="ic">📦</span><div><small>Total Versions</small><strong>@Model.FileStats.TotalVersions</strong></div></div>
                        <div class="stat"><span class="ic">⬇</span><div><small>Downloads</small><strong>@Model.FileStats.Downloads</strong></div></div>
                        <div class="stat"><span class="ic">🕐</span><div><small>Current Version</small><strong>v@Model.FileStats.CurrentVersion</strong></div></div>
                        <div class="stat"><span class="ic">🗄</span><div><small>Storage Used</small><strong>@Model.FileStats.StorageUsed</strong></div></div>
                    </div>
                </div>
            </div>

            <div class="cols-2">
                <div class="card">
                    <h3>Upload New Version</h3>
                    <div class="upload-row">
                        <div class="dropzone">⬆<p>Drag &amp; drop your file here</p><small class="muted">EPUB, PDF or TXT (Max 100MB)</small><div>or</div><a class="btn btn-outline" href="@Url.Action("UploadVersion", "Library", new { id = Model.BookId })">Choose File</a></div>
                        <div class="upload-fields">
                            <div class="field"><label>Version Number <em>*</em></label><input value="@Model.NextVersionNumber" disabled></div>
                            <div class="field"><label>Release Notes</label><textarea rows="3" placeholder="Describe the changes in this version..." disabled></textarea><small class="counter muted">0/500</small></div>
                            <a class="btn btn-primary btn-block" href="#">⬆ Upload Version</a>
                        </div>
                    </div>
                </div>

                <div>
                    <div class="card">
                        <h3>File Information</h3>
                        <dl class="spec one">
                            <div><dt>File Type</dt><dd><span class="pill pill-indigo">@Model.FileType</span></dd></div>
                            <div><dt>Language</dt><dd>@Model.Language</dd></div>
                            <div><dt>Pages</dt><dd>@Model.Pages</dd></div>
                            <div><dt>ISBN</dt><dd>@Model.Isbn</dd></div>
                            <div><dt>Created On</dt><dd>@Model.CreatedOn.ToString("MMM dd, yyyy")</dd></div>
                            <div><dt>Last Modified</dt><dd>@Model.DateModified.ToString("MMM dd, yyyy")</dd></div>
                            <div><dt>Created By</dt><dd>👤 @Model.CreatedByName</dd></div>
                        </dl>
                    </div>
                    <div class="card">
                        <h3>Quick Actions</h3>
                        <a class="action-row" href="#"><span class="a-ic">🔁</span><div><b>Replace Active File</b><small class="muted">Upload and replace the current file</small></div><span class="chev">›</span></a>
                        <a class="action-row" href="#"><span class="a-ic">⬆</span><div><b>Upload New Version</b><small class="muted">Add a new version of this book</small></div><span class="chev">›</span></a>
                        <a class="action-row" href="@Model.CurrentFile.Url" download><span class="a-ic">⬇</span><div><b>Download Current File</b><small class="muted">Download the active file</small></div><span class="chev">›</span></a>
                    </div>
                </div>
            </div>

            <div class="card">
                <h3>Version History</h3>
                <table class="data-table">
                    <thead><tr><th>Version</th><th>File Name</th><th>File Type</th><th>Size</th><th>Uploaded By</th><th>Uploaded On</th><th>Status</th><th>Actions</th></tr></thead>
                    <tbody>
                        @foreach (var v in Model.VersionHistory)
                        {
                            <tr>
                                <td>v@v.Version @(v.IsCurrent ? Html.Raw("<span class=\"pill pill-indigo\">Current</span>") : null)</td>
                                <td>@v.FileName</td>
                                <td><span class="pill @(v.Type == "PDF" ? "pill-red" : v.Type == "EPUB" ? "pill-green" : "pill-gray")">@v.Type</span></td>
                                <td>@v.Size</td>
                                <td>👤 @v.UploadedBy</td>
                                <td>@v.UploadedOn.ToString("MMM dd, yyyy")</td>
                                <td><span class="pill @(v.IsCurrent ? "pill-green" : "pill-gray")">@(v.IsCurrent ? "Published" : "Archived")</span></td>
                                <td>👁 ⬇ ↺</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="pager">
                    <small class="muted">Showing 1 to @Model.VersionHistory.Count of @Model.VersionHistory.Count versions</small>
                    <div class="pages"><button type="button">‹</button><button type="button" class="active">1</button><button type="button">›</button></div>
                </div>
            </div>

            <div class="card">
                <h3>Version Comparison</h3>
                <small class="muted">Compare any two versions to see what has changed.</small>
                <div class="compare-row">
                    <select>
                        @foreach (var v in Model.VersionHistory)
                        {
                            <option value="@v.Version">v@v.Version @(v.IsCurrent ? "(Current)" : "(Archived)")</option>
                        }
                    </select>
                    <span class="swap">⇄</span>
                    <select>
                        @foreach (var v in Model.VersionHistory)
                        {
                            <option value="@v.Version">v@v.Version @(v.IsCurrent ? "(Current)" : "(Archived)")</option>
                        }
                    </select>
                    <button type="button" class="btn btn-primary">Compare Versions</button>
                </div>
            </div>
        </section>

        <!-- ===================== SEO & SETTINGS (mocked) ===================== -->
        <section class="tab-panel" id="seo">
            <div class="cols-2">
                <div class="card">
                    <h3>SEO Optimization</h3>
                    <small class="muted">Optimize how your book appears in search engines. (mocked)</small>
                    <div class="field"><label>SEO Title <em>*</em></label><input asp-for="SeoTitle" maxlength="60"><small class="counter muted">@Model.SeoTitle?.Length/60</small></div>
                    <div class="field"><label>SEO Slug <em>*</em></label><input asp-for="SeoSlug"><small class="muted">yourlibrary.com/books/@Model.SeoSlug</small></div>
                    <div class="field"><label>SEO Description <em>*</em></label><textarea asp-for="SeoDescription" rows="3" maxlength="160"></textarea><small class="counter muted">@Model.SeoDescription?.Length/160</small></div>
                    <div class="field">
                        <label>SEO Keywords</label>
                        <div class="chips">
                            @foreach (var kw in Model.SeoKeywords)
                            {
                                <span class="chip">@kw <a href="#" class="chip-remove">✕</a><input type="hidden" name="SeoKeywords" value="@kw" /></span>
                            }
                        </div>
                        <input type="text" id="addKeywordInput" placeholder="Add keyword and press enter...">
                    </div>
                    <div class="search-preview">
                        <b class="up-link">@Model.SeoTitle</b>
                        <small class="green-link">yourlibrary.com/books/@Model.SeoSlug</small>
                        <small class="muted">@Model.SeoDescription</small>
                    </div>
                </div>

                <div class="card">
                    <h3>Visibility Settings</h3>
                    <small class="muted">Control where and how this book is visible. (mocked)</small>
                    <label class="checkbox @(Model.ShowInSearch ? "checked" : "")"><input type="checkbox" asp-for="ShowInSearch"><div><b>Show in Search Results</b><small class="muted">Make this book discoverable in search.</small></div></label>
                    <label class="checkbox @(Model.FeaturedBook ? "checked" : "")"><input type="checkbox" asp-for="FeaturedBook"><div><b>Featured Book</b><small class="muted">Display this book on featured sections.</small></div></label>
                    <label class="checkbox @(Model.ShowInRecommendations ? "checked" : "")"><input type="checkbox" asp-for="ShowInRecommendations"><div><b>Display in Recommendations</b><small class="muted">Include in personalized recommendations.</small></div></label>
                    <label class="checkbox @(Model.ShowInCategoryListings ? "checked" : "")"><input type="checkbox" asp-for="ShowInCategoryListings"><div><b>Show in Category Listings</b><small class="muted">Display in relevant category pages.</small></div></label>
                    <label class="checkbox @(Model.AllowSocialSharing ? "checked" : "")"><input type="checkbox" asp-for="AllowSocialSharing"><div><b>Allow Social Sharing</b><small class="muted">Allow readers to share this book.</small></div></label>
                    <label class="checkbox @(Model.HideFromCatalog ? "checked" : "")"><input type="checkbox" asp-for="HideFromCatalog"><div><b>Hide from Public Catalog</b><small class="muted">Only admins and specific users can see this.</small></div></label>
                    <label class="checkbox @(Model.AdultContentWarning ? "checked" : "")"><input type="checkbox" asp-for="AdultContentWarning"><div><b>Adult Content Warning</b><small class="muted">Mark this book as adult content.</small></div></label>
                </div>
            </div>

            <div class="cols-3">
                <div class="card">
                    <h3>Reader Interaction</h3>
                    <small class="muted">Manage how readers can interact with this book. (mocked)</small>
                    <label class="checkbox sm @(Model.AllowReviews ? "checked" : "")"><input type="checkbox" asp-for="AllowReviews"><div><b>Allow Reviews</b><small class="muted">Readers can leave reviews for this book.</small></div></label>
                    <label class="checkbox sm @(Model.AllowRatings ? "checked" : "")"><input type="checkbox" asp-for="AllowRatings"><div><b>Allow Ratings</b><small class="muted">Readers can rate this book.</small></div></label>
                    <label class="checkbox sm @(Model.AllowComments ? "checked" : "")"><input type="checkbox" asp-for="AllowComments"><div><b>Allow Comments</b><small class="muted">Readers can comment on this book.</small></div></label>
                    <label class="checkbox sm @(Model.ShowReviewCount ? "checked" : "")"><input type="checkbox" asp-for="ShowReviewCount"><div><b>Show Review Count</b><small class="muted">Display total number of reviews.</small></div></label>
                    <label class="checkbox sm @(Model.ShowReadCount ? "checked" : "")"><input type="checkbox" asp-for="ShowReadCount"><div><b>Show Read Count</b><small class="muted">Display total number of reads.</small></div></label>
                    <label class="checkbox sm @(Model.ShowAverageRating ? "checked" : "")"><input type="checkbox" asp-for="ShowAverageRating"><div><b>Show Average Rating</b><small class="muted">Display average rating on book page.</small></div></label>
                    <label class="checkbox sm @(Model.DisableUserFeedback ? "checked" : "")"><input type="checkbox" asp-for="DisableUserFeedback"><div><b>Disable User Feedback</b><small class="muted">Hide all reviews, ratings and comments.</small></div></label>
                </div>

                <div class="card">
                    <h3>Discovery &amp; Promotion</h3>
                    <small class="muted">Promote your book across the library. (mocked)</small>
                    <label class="cb-label">Promotion Status</label>
                    <div class="choice-grid three" data-radio-name="PromotionStatus">
                        <button type="button" class="choice @(Model.PromotionStatus == "Standard" ? "active" : "")" data-value="Standard"><b>Standard</b><small>Normal visibility</small></button>
                        <button type="button" class="choice @(Model.PromotionStatus == "Featured" ? "active" : "")" data-value="Featured"><b>Featured</b><small>Increased visibility</small></button>
                        <button type="button" class="choice @(Model.PromotionStatus == "Sponsored" ? "active" : "")" data-value="Sponsored"><b>Sponsored</b><small>Paid promotion</small></button>
                    </div>
                    <input type="hidden" asp-for="PromotionStatus" id="PromotionStatus" />
                    <label class="cb-label">Homepage Placement</label>
                    <label class="checkbox sm @(Model.HomepageCarousel ? "checked" : "")"><input type="checkbox" asp-for="HomepageCarousel"><div><b>Homepage Carousel</b><small class="muted">Show in the homepage carousel.</small></div></label>
                    <label class="checkbox sm @(Model.TrendingSection ? "checked" : "")"><input type="checkbox" asp-for="TrendingSection"><div><b>Trending Books Section</b><small class="muted">Show in trending books section.</small></div></label>
                    <label class="checkbox sm @(Model.StaffPicks ? "checked" : "")"><input type="checkbox" asp-for="StaffPicks"><div><b>Staff Picks</b><small class="muted">Show in staff picks section.</small></div></label>
                    <label class="checkbox sm @(Model.EditorsChoice ? "checked" : "")"><input type="checkbox" asp-for="EditorsChoice"><div><b>Editor's Choice</b><small class="muted">Show as editor's choice.</small></div></label>
                </div>

                <div class="card">
                    <h3>Quick Actions</h3>
                    <small class="muted">Useful actions for SEO &amp; settings.</small>
                    <a class="action-row" href="#"><span class="a-ic">✨</span><div><b>Generate SEO Metadata</b><small class="muted">Auto generate meta title, description</small></div><span class="chev">›</span></a>
                    <a class="action-row" href="#"><span class="a-ic">🔑</span><div><b>Regenerate Keywords</b><small class="muted">Generate keywords using AI</small></div><span class="chev">›</span></a>
                    <a class="action-row" href="@Url.Action("PreviewBook", "Library", new { id = Model.BookId })"><span class="a-ic">👁</span><div><b>Preview Public Page</b><small class="muted">See how this book appears to readers</small></div><span class="chev">›</span></a>
                    <a class="action-row" href="#" id="copyPublicLink"><span class="a-ic">🔗</span><div><b>Copy Public Link</b><small class="muted">Copy direct link to this book</small></div><span class="chev">›</span></a>
                    <a class="action-row danger" href="#"><span class="a-ic">↺</span><div><b>Reset SEO Settings</b><small class="muted">Reset all SEO fields and settings</small></div><span class="chev">›</span></a>
                </div>
            </div>

            <div class="form-footer">
                <button type="button" class="btn btn-outline" onclick="window.location.reload()">Cancel</button>
                <div class="spacer"></div>
                <button type="button" class="btn btn-outline">Save as Draft</button>
                <button type="submit" class="btn btn-primary">Save Changes</button>
            </div>
        </section>
    </form>

    <script>
            (function () {
                const root = document.querySelector(".book-detail");
                if (!root) return;

                // ---- Tab switching ----
                const tabs = root.querySelectorAll(".tabs .tab");
                const panels = root.querySelectorAll(".tab-panel");
                tabs.forEach((tab) => {
                    tab.addEventListener("click", () => {
                        const target = tab.dataset.tab;
                        tabs.forEach((t) => t.classList.toggle("active", t === tab));
                        panels.forEach((p) => p.classList.toggle("active", p.id === target));
                    });
                });

                // ---- Card-style radio groups bound to hidden inputs ----
                root.querySelectorAll('[data-radio-name]').forEach((group) => {
                    const hiddenInput = document.getElementById(group.dataset.radioName);
                    const choices = group.querySelectorAll(".choice");
                    choices.forEach((choice) => {
                        choice.addEventListener("click", () => {
                            choices.forEach((c) => c.classList.remove("active"));
                            choice.classList.add("active");
                            if (hiddenInput) hiddenInput.value = choice.dataset.value;
                        });
                    });
                });

                // ---- List-style radios bound to hidden inputs ----
                root.querySelectorAll(".radio-list[data-radio-name]").forEach((list) => {
                    const hiddenInput = document.getElementById(list.dataset.radioName);
                    const rows = list.querySelectorAll(".radio");
                    rows.forEach((row) => {
                        row.addEventListener("click", () => {
                            rows.forEach((r) => r.classList.remove("active"));
                            row.classList.add("active");
                            const input = row.querySelector("input");
                            if (input) input.checked = true;
                            if (hiddenInput) hiddenInput.value = input.dataset.value;
                        });
                    });
                });

                // ---- Toggle switches bound to hidden inputs ----
                root.querySelectorAll(".switch[data-target]").forEach((sw) => {
                    const hiddenInput = document.getElementById(sw.dataset.target);
                    sw.addEventListener("click", () => {
                        sw.classList.toggle("on");
                        if (hiddenInput) hiddenInput.value = sw.classList.contains("on");
                    });
                });

                // ---- Checkbox visual state sync ----
                root.querySelectorAll(".checkbox input").forEach((cb) => {
                    const sync = () => cb.closest(".checkbox").classList.toggle("checked", cb.checked);
                    cb.addEventListener("change", sync);
                    sync();
                });

                // ---- Chip removal (mocked, client-side only) ----
                root.querySelectorAll(".chip-remove").forEach((btn) => {
                    btn.addEventListener("click", (e) => {
                        e.preventDefault();
                        btn.closest(".chip").remove();
                    });
                });

                // ---- Copy public link ----
                const copyLink = document.getElementById("copyPublicLink");
                if (copyLink) {
                    copyLink.addEventListener("click", (e) => {
                        e.preventDefault();
                        navigator.clipboard.writeText(window.location.origin + "/books/@Model.SeoSlug");
                    });
                }
            })();
    </script>
</main>