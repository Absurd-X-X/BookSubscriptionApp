            <div class="rating">⭐ <strong>4.9</strong> <span>(245 reviews)</span></div>

            <div class="stat-grid">
                <div class="stat"><span class="ic">👁</span><div><strong>1,245</strong><small>Total Reads</small></div></div>
                <div class="stat"><span class="ic">📖</span><div><strong>98%</strong><small>Completion Rate</small></div></div>
                <div class="stat"><span class="ic">⏱</span><div><strong>2h 34m</strong><small>Avg. Reading Time</small></div></div>
                <div class="stat"><span class="ic">🧾</span><div><strong>₦98,000</strong><small>Total Revenue</small></div></div>
            </div>
