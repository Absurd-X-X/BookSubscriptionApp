                        <label class="radio active"><input type="radio" name="mem" checked><div><b>All Users</b><small class="muted">All registered users can purchase and access this book.</small></div></label>
                        <label class="radio"><input type="radio" name="mem"><div><b>Specific Membership Plans</b><small class="muted">Only users with selected plans can access this book.</small></div></label>
                        <label class="radio"><input type="radio" name="mem"><div><b>VIP Only</b><small class="muted">Only VIP members can access this book.</small></div></label>
                    </div>
                    <div class="toggle-row"><div><b>Rental Option (Optional)</b><small class="muted">Allow users to rent this book for a limited time.</small></div><span class="switch"></span></div>
                </div>
