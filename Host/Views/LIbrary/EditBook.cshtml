                    </div>
                </div>

                <div class="card">
                    <h3>Book Details</h3>
                    <div class="row-2">
                        <div class="field"><label>Publisher</label><input value="Penguin Random House"></div>
                        <div class="field"><label>Publish Date <em>*</em></label><input value="05/28/2024"></div>
                    </div>
                    <div class="row-3">
                        <div class="field"><label>Edition</label><input value="1st Edition"></div>
                        <div class="field"><label>Pages</label><input value="320"></div>
