                    <div class="field"><label>Preview Type</label><select><option>Free Preview (Chapters)</option></select></div>
                    <div class="field">
                        <label>Number of Free Chapters</label><select><option>2</option></select>
                        <small class="muted">Readers can preview the selected number of chapters.</small>
                    </div>
                    <div class="preview-chapters">
                        <b>Preview Chapters</b>
