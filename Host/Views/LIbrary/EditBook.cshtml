@{
    Layout = "~/Views/Shared/_LibraryLayout.cshtml";
    ViewData["Title"] = "Edit Book";
}

<link href="~/css/editBook.css" rel="stylesheet" />
<main class="book-detail">
    <!-- Breadcrumb + actions -->
    <div class="topline">
        <nav class="crumbs">
            <a href="#">Books</a><span>›</span><a href="#">Atomic Habits</a><span>›</span><span class="current">Edit Book</span>
        </nav>
        <div class="topline-actions">
            <button class="btn btn-ghost">···</button>
            <a href="@Url.Action("PreviewBook", "Library")" class="btn btn-outline">👁 Preview Book</a>
            <button class="btn btn-primary">✎ Save Changes</button>
