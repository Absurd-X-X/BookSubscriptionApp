                <tbody>
                    <tr><td><span class="file-ic pdf sm">PDF</span> Atomic Habits - Full Book.pdf</td><td>1.3</td><td>PDF</td><td>2.4 MB</td><td>May 20, 2024</td><td><span class="pill pill-green">Published</span></td><td>⬇ ···</td></tr>
                    <tr><td><span class="file-ic epub sm">EPUB</span> Atomic Habits - Full Book.epub</td><td>1.3</td><td>EPUB</td><td>1.8 MB</td><td>May 20, 2024</td><td><span class="pill pill-green">Published</span></td><td>⬇ ···</td></tr>
