@{
    Layout = "~/Views/Shared/_LibraryLayout.cshtml";
    ViewData["Title"] = "Add New Book";
}
<link rel="stylesheet" href="~/css/addBook.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@latest/tabler-icons.min.css" />

<div class="wrap">

    <div class="topbar">
        <div class="breadcrumb">
            <a href="@Url.Action("GetByLibrary", "Book")">Books</a>
            <span class="bc-sep">›</span>
            <span id="bc-mid">Add New Book</span>
            <span class="bc-sep" id="bc-sep2" style="display:none">›</span>
            <span class="bc-cur" id="bc-cur"></span>
        </div>
        <div class="tbar-btns">
            <button type="button" class="btn btn-ghost"><i class="ti ti-eye"></i> Preview Book</button>
            <button type="submit" form="addBookForm" class="btn btn-primary"><i class="ti ti-pencil"></i> Save Book</button>
        </div>
    </div>

    <div class="page-hd">
        <div>
            <div class="page-title" id="page-title">Add New Book</div>
            <div class="page-sub" id="page-sub">Fill in the details below to add a new book to your library.</div>
        </div>
        <button type="button" class="btn btn-ghost-sm">Save as Draft</button>
    </div>

    <div class="step-tabs">
        <div class="step-tab active" onclick="goStep(1)">
            <div class="step-circle" id="c1">1</div>
            <span>Basic Information</span>
            <div class="step-line"></div>
        </div>
        <div class="step-tab" onclick="goStep(2)">
            <div class="step-circle" id="c2">2</div>
            <span>Pricing &amp; Access</span>
            <div class="step-line"></div>
        </div>
        <div class="step-tab" onclick="goStep(3)">
            <div class="step-circle" id="c3">3</div>
            <span>Files &amp; Versions</span>
            <div class="step-line"></div>
        </div>
        <div class="step-tab" onclick="goStep(4)">
            <div class="step-circle" id="c4">4</div>
            <span>SEO &amp; Visibility</span>
        </div>
    </div>

    <form id="addBookForm" method="post" asp-action="AddBook" asp-controller="Library" enctype="multipart/form-data">

        <!-- STEP 1 -->
        <div class="step-panel active" id="p1">
            <div class="two-col">
                <div class="form-col">
                    <div class="card">
                        <div class="card-title">Basic Details</div>
                        <div class="card-sub">Enter the core information about this book.</div>
                        <div class="frow">
                            <div class="field"><label class="label">Title <span class="req">*</span></label><input type="text" name="title" class="input" placeholder="Enter book title" required></div>
                            <div class="field"><label class="label">Subtitle</label><input type="text" name="subtitle" class="input" placeholder="Enter subtitle (optional)"></div>
                        </div>
                        <div class="frow">
                            <div class="field"><label class="label">Author <span class="req">*</span></label><input type="text" name="author" class="input" placeholder="Enter author name" required></div>
                            <div class="field"><label class="label">Co-Author(s)</label><input type="text" class="input" placeholder="Enter co-author(s) (optional)"></div>
                        </div>
                        <div class="frow">
                            <div class="field"><label class="label">Publisher <span class="req">*</span></label><input type="text" name="publisher" class="input" placeholder="Enter publisher name" required></div>
                            <div class="field"><label class="label">Publication Date <span class="req">*</span></label><input type="date" class="input"></div>
                        </div>
                        <div class="frow">
                            <div class="field">
                                <label class="label">Language <span class="req">*</span></label>
                                <select name="language" class="input" required><option value="">Select language</option><option>English</option><option>French</option><option>Yoruba</option><option>Igbo</option><option>Hausa</option></select>
                            </div>
                            <div class="field"><label class="label">ISBN</label><input type="text" name="isbn" class="input" placeholder="Enter ISBN (optional)" required></div>
                        </div>
                        <div class="frow">
                            <div class="field">
                                <label class="label">Category <span class="req">*</span></label>
                                <select name="categoryId" class="input" required>
                                    <option value="">Select primary category</option>
                                    @foreach (var cat in (ViewBag.Categories as List<Application.Queries.GetCategories.GetCategoriesResponse>) ?? new())
                                    {
                                        <option value="@cat.Id">@cat.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="field">
                                <label class="label">Additional Categories</label>
                                <select class="input"><option value="">Select additional categories</option><option>Personal Development</option><option>Psychology</option><option>Success</option></select>
                            </div>
                        </div>
                        <div class="field">
                            <label class="label">Genre <span class="req">*</span></label>
                            <input type="text" name="genre" class="input" placeholder="Enter genre" required>
                        </div>
                        <div class="field">
                            <label class="label">Description <span class="req">*</span></label>
                            <div class="rich-bar">
                                <button type="button" class="rt-btn"><b>B</b></button>
                                <button type="button" class="rt-btn"><i>I</i></button>
                                <button type="button" class="rt-btn"><u>U</u></button>
                                <button type="button" class="rt-btn"><i class="ti ti-list"></i></button>
                                <button type="button" class="rt-btn"><i class="ti ti-list-numbers"></i></button>
                            </div>
                            <textarea name="about" class="input textarea" id="desc" placeholder="Write a short description about the book..." oninput="cc('desc','desc-cc',2000)" required></textarea>
                            <div class="char-count" id="desc-cc">0/2000</div>
                        </div>
                    </div>
                    <div class="card">
                        <div class="card-title">Book Details</div>
                        <div class="frow">
                            <div class="field"><label class="label">Pages</label><input type="number" name="pages" class="input" placeholder="Enter number of pages" min="1" required></div>
                            <div class="field"><label class="label">Edition</label><input type="text" class="input" placeholder="e.g. 1st Edition"></div>
                        </div>
                        <div class="frow">
                            <div class="field">
                                <label class="label">Book Format</label>
                                <select class="input"><option value="">Select format</option><option>EPUB</option><option>PDF</option><option>Both</option></select>
                            </div>
                            <div class="field">
                                <label class="label">Reading Age (Optional)</label>
                                <select class="input"><option value="">Select reading age</option><option>Children (0–12)</option><option>Teen (13–17)</option><option>Adult (18+)</option><option>All Ages</option></select>
                            </div>
                        </div>
                        <div class="frow">
                            <div class="field"><label class="label">Publication Year <span class="req">*</span></label><input type="number" name="publicationYear" class="input" placeholder="e.g. 2024" min="1000" max="2100" required></div>
                        </div>
                    </div>
                </div>
                <div class="sidebar-col">
                    <div class="card">
                        <div class="card-title">Book Cover</div>
                        <div class="card-sub">Upload a high-quality cover image.</div>
                        <div class="dropzone" onclick="document.getElementById('bookCoverInput').click()">
                            <i class="ti ti-cloud-upload drop-icon"></i>
                            <div class="drop-txt">Drag &amp; drop image here</div>
                            <div class="drop-or">or</div>
                            <button type="button" class="btn btn-outline">Choose File</button>
                        </div>
                        <input type="file" id="bookCoverInput" name="bookCover" accept=".jpg,.jpeg,.png" required style="display:none" onchange="fileChosen(this,'coverFileName')">
                        <p class="hint" id="coverFileName">Recommended: 600×900px · JPG, PNG (Max 2MB)</p>
                    </div>
                    <div class="card">
                        <div class="card-title">Upload Book File</div>
                        <div class="card-sub">Upload the main file for this book.</div>
                        <div class="dropzone" onclick="document.getElementById('bookFileInput').click()">
                            <i class="ti ti-file-upload drop-icon"></i>
                            <div class="drop-txt">Drag &amp; drop file here</div>
                            <div class="drop-or">or</div>
                            <button type="button" class="btn btn-outline">Choose File</button>
                        </div>
                        <input type="file" id="bookFileInput" name="bookFile" accept=".pdf,.epub,.txt" required style="display:none" onchange="fileChosen(this,'bookFileName')">
                        <p class="hint" id="bookFileName">Allowed: PDF, EPUB, TXT · Max 100MB</p>
                    </div>
                    <div class="card">
                        <div class="card-title">Book Status</div>
                        <div class="card-sub">Set the current status of this book.</div>
                        <div class="radio-group">
                            <label class="radio-item">
                                <input type="radio" name="statusDisplay" checked>
                                <div><div class="radio-lbl">Published</div><div class="radio-sub">Book will be visible to all readers</div></div>
                            </label>
                            <label class="radio-item">
                                <input type="radio" name="statusDisplay">
                                <div><div class="radio-lbl">Draft</div><div class="radio-sub">Book will be saved as draft</div></div>
                            </label>
                            <label class="radio-item">
                                <input type="radio" name="statusDisplay">
                                <div><div class="radio-lbl">Archived</div><div class="radio-sub">Book will be hidden from readers</div></div>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="step-footer">
                <a href="@Url.Action("GetByLibrary", "Book")" class="btn btn-ghost">Cancel</a>
                <button type="button" class="btn btn-primary" onclick="goStep(2)">Next: Pricing &amp; Access <i class="ti ti-arrow-right"></i></button>
            </div>
        </div>

        <!-- STEP 2 -->
        <div class="step-panel" id="p2">
            <div class="two-col">
                <div class="form-col">
                    <div class="card">
                        <div class="card-title">Pricing</div>
                        <div class="card-sub">Choose how this book will be priced for readers.</div>
                        <div class="pricing-cards">
                            <div class="pc sel" data-value="Free" onclick="selPc(this)"><div class="pc-title">Free Book</div><div class="pc-sub">This book is free for all readers.</div></div>
                            <div class="pc" data-value="Paid" onclick="selPc(this)"><div class="pc-title">Paid Book</div><div class="pc-sub">Readers must pay once to access this book.</div></div>
                            <div class="pc" data-value="Subscription" onclick="selPc(this)"><div class="pc-title">Subscription Only</div><div class="pc-sub">Only accessible to active subscribers.</div></div>
                        </div>
                        <input type="hidden" name="pricingType" id="pricingType" value="Free">
                        <div class="frow">
                            <div class="field">
                                <label class="label">Price (NGN) <span class="req">*</span></label>
                                <input type="number" name="price" id="priceInput" class="input" value="2500.00" step="0.01" disabled>
                                <div class="hint">Set the selling price for this book.</div>
                            </div>
                            <div class="field">
                                <label class="label">Discount (Optional)</label>
                                <div class="input-suffix-wrap"><input type="number" name="discount" class="input" value="0" style="padding-right:28px"><span class="input-suffix">%</span></div>
                                <div class="hint">Set a discount percentage if applicable.</div>
                            </div>
                        </div>
                        <div class="info-banner" id="priceBanner"><i class="ti ti-info-circle"></i> This book will be available for free.</div>
                    </div>
                    <div class="card">
                        <div class="card-title">Access Rules</div>
                        <div class="card-sub">Define who can access this book.</div>
                        <div class="frow">
                            <div class="field">
                                <label class="label">Who can access? <span class="req">*</span></label>
                                <select name="accessLevel" class="input" required>
                                    <option value="Everyone">Everyone</option>
                                    <option value="SubscribersOnly">Subscribers Only</option>
                                    <option value="PremiumMembers">Premium Members</option>
                                </select>
                            </div>
                            <div class="field">
                                <label class="label">Require Login?</label>
                                <div class="toggle-wrap"><label class="toggle"><input type="checkbox" name="requireLogin" value="true" checked><span class="toggle-slider"></span></label><span class="toggle-lbl">Readers must be logged in to access this book.</span></div>
                            </div>
                        </div>
                        <div class="frow">
                            <div class="field">
                                <label class="label">Subscription Plan (Optional)</label>
                                <select class="input"><option value="">Select a plan</option><option>Basic</option><option>Premium</option></select>
                            </div>
                            <div class="field">
                                <label class="label">Download Allowed?</label>
                                <div class="toggle-wrap"><label class="toggle"><input type="checkbox" name="allowDownload" value="true"><span class="toggle-slider"></span></label><span class="toggle-lbl">Allow readers to download this book.</span></div>
                            </div>
                        </div>
                        <div class="frow">
                            <div class="field">
                                <label class="label">Print Allowed?</label>
                                <div class="toggle-wrap"><label class="toggle"><input type="checkbox" name="allowPrint" value="true"><span class="toggle-slider"></span></label><span class="toggle-lbl">Allow readers to print this book.</span></div>
                            </div>
                            <div class="field">
                                <label class="label">Copy &amp; Paste Allowed?</label>
                                <div class="toggle-wrap"><label class="toggle"><input type="checkbox" name="allowCopyPaste" value="true"><span class="toggle-slider"></span></label><span class="toggle-lbl">Allow readers to copy content from this book.</span></div>
                            </div>
                        </div>
                    </div>
                    <div class="card">
                        <div class="card-title">Availability</div>
                        <div class="card-sub">Control where and how this book is displayed.</div>
                        <div class="cb-grid">
                            <label class="cb-item"><input type="checkbox" checked><div><b>Publish Book</b><br><span>Make this book visible to readers.</span></div></label>
                            <label class="cb-item"><input type="checkbox" checked><div><b>Show on Homepage</b><br><span>Display this book on the homepage.</span></div></label>
                            <label class="cb-item"><input type="checkbox" checked><div><b>Include in Search</b><br><span>Allow this book to appear in search results.</span></div></label>
                            <label class="cb-item"><input type="checkbox" checked><div><b>Featured Book</b><br><span>Highlight this book as a featured book.</span></div></label>
                            <label class="cb-item"><input type="checkbox" checked><div><b>Show in Recommendations</b><br><span>Include in recommended books.</span></div></label>
                            <label class="cb-item"><input type="checkbox" checked><div><b>Show in New Arrivals</b><br><span>Display in the new arrivals section.</span></div></label>
                        </div>
                    </div>
                </div>
                <div class="sidebar-col">
                    <div class="card">
                        <div class="card-title">Pricing &amp; Access Summary</div>
                        <div class="card-sub">Review your pricing and access settings.</div>
                        <div class="summary-list">
                            <div class="sum-row"><span>Pricing Type</span><span class="badge badge-g" id="sumPricingType">Free Book</span></div>
                            <div class="sum-row"><span>Price</span><span id="sumPrice">NGN 0.00</span></div>
                            <div class="sum-row"><span>Discount</span><span>0%</span></div>
                            <div class="sum-row"><span>Access</span><span>Everyone</span></div>
                            <div class="sum-row"><span>Login Required</span><span>Yes</span></div>
                            <div class="sum-row"><span>Download</span><span class="badge badge-r">Not Allowed</span></div>
                            <div class="sum-row"><span>Print</span><span class="badge badge-r">Not Allowed</span></div>
                            <div class="sum-row"><span>Copy &amp; Paste</span><span class="badge badge-r">Not Allowed</span></div>
                        </div>
                    </div>
                    <div class="card">
                        <div class="card-title">Access Preview</div>
                        <div class="card-sub">This is how readers will see this book.</div>
                        <div class="preview-card">
                            <div class="prev-book-row">
                                <div class="prev-cover">Atomic<br>Habits</div>
                                <div>
                                    <div class="prev-title">Atomic Habits</div>
                                    <div class="prev-author">by James Clear</div>
                                    <span class="badge badge-g" style="margin-top:5px;display:inline-flex">FREE</span>
                                    <div class="prev-sub">Free for everyone</div>
                                </div>
                            </div>
                            <div class="prev-lock"><i class="ti ti-lock"></i> Login required to access this book</div>
                            <button type="button" class="btn btn-primary" style="width:100%;justify-content:center">Read Now</button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="step-footer">
                <button type="button" class="btn btn-ghost" onclick="goStep(1)"><i class="ti ti-arrow-left"></i> Previous</button>
                <button type="button" class="btn btn-primary" onclick="goStep(3)">Next: Files &amp; Versions <i class="ti ti-arrow-right"></i></button>
            </div>
        </div>

        <!-- STEP 3 -->
        <div class="step-panel" id="p3">
            <div class="two-col">
                <div class="form-col">
                    <div class="card">
                        <div class="card-hdr">
                            <div class="card-title" style="display:flex;align-items:center;gap:8px">Current Version <span class="badge badge-g">Active</span></div>
                            <button type="button" class="btn btn-outline"><i class="ti ti-upload"></i> Replace Current Version</button>
                        </div>
                        <div class="ver-cur">
                            <div class="ver-icon"><i class="ti ti-file" style="font-size:24px;color:#7c3aed"></i><span class="ver-icon-lbl">EPUB</span></div>
                            <div style="flex:1">
                                <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
                                    <strong>Version 1.0 (Current)</strong>
                                    <span class="badge badge-p">Current Version</span>
                                </div>
                                <div class="ver-meta-row">
                                    <div><div class="meta-lbl">File Type</div><div class="meta-val">EPUB</div></div>
                                    <div><div class="meta-lbl">Uploaded</div><div class="meta-val">May 20, 2025<br>10:30 AM</div></div>
                                    <div><div class="meta-lbl">File Size</div><div class="meta-val">2.4 MB</div></div>
                                    <div><div class="meta-lbl">Uploaded By</div><div class="meta-val">Unilag Library Admin</div></div>
                                </div>
                                <div class="rn-box"><div class="meta-lbl">Release Note</div>Initial version of the book.</div>
                            </div>
                        </div>
                    </div>
                    <div class="card">
                        <div class="card-title">Version History</div>
                        <div class="card-sub">View and manage all previous versions of this book.</div>
                        <div class="table-wrap">
                            <table>
                                <thead><tr><th>Version</th><th>File Type</th><th>Uploaded</th><th>File Size</th><th>Uploaded By</th><th>Release Note</th><th>Actions</th></tr></thead>
                                <tbody>
                                    <tr><td>1.0 <span class="badge badge-p">Current</span></td><td><span class="badge badge-g">EPUB</span></td><td>May 20, 2025<br><small>10:30 AM</small></td><td>2.4 MB</td><td>Unilag Library Admin</td><td>Initial version of the book.</td><td class="action-cell"><button type="button" class="icon-btn" onclick="toggleMenu(this)"><i class="ti ti-dots-vertical"></i></button><div class="vmenu"><div class="vm-item"><i class="ti ti-eye"></i> View Details</div><div class="vm-item"><i class="ti ti-download"></i> Download</div><div class="vm-item"><i class="ti ti-check"></i> Set as Current</div><div class="vm-item danger"><i class="ti ti-trash"></i> Delete Version</div></div></td></tr>
                                    <tr><td>0.9</td><td><span class="badge badge-g">EPUB</span></td><td>May 18, 2025<br><small>04:15 PM</small></td><td>2.1 MB</td><td>Unilag Library Admin</td><td>Revised introduction and chapter 1.</td><td class="action-cell"><button type="button" class="icon-btn" onclick="toggleMenu(this)"><i class="ti ti-dots-vertical"></i></button><div class="vmenu"><div class="vm-item"><i class="ti ti-eye"></i> View Details</div><div class="vm-item"><i class="ti ti-download"></i> Download</div><div class="vm-item"><i class="ti ti-check"></i> Set as Current</div><div class="vm-item danger"><i class="ti ti-trash"></i> Delete Version</div></div></td></tr>
                                    <tr><td>0.8</td><td><span class="badge badge-r">PDF</span></td><td>May 15, 2025<br><small>09:22 AM</small></td><td>3.7 MB</td><td>Unilag Library Admin</td><td>Converted from draft PDF.</td><td class="action-cell"><button type="button" class="icon-btn" onclick="toggleMenu(this)"><i class="ti ti-dots-vertical"></i></button><div class="vmenu"><div class="vm-item"><i class="ti ti-eye"></i> View Details</div><div class="vm-item"><i class="ti ti-download"></i> Download</div><div class="vm-item"><i class="ti ti-check"></i> Set as Current</div><div class="vm-item danger"><i class="ti ti-trash"></i> Delete Version</div></div></td></tr>
                                    <tr><td>0.7</td><td><span class="badge badge-g">EPUB</span></td><td>May 10, 2025<br><small>11:05 AM</small></td><td>1.9 MB</td><td>Unilag Library Admin</td><td>Updated formatting and typos.</td><td class="action-cell"><button type="button" class="icon-btn" onclick="toggleMenu(this)"><i class="ti ti-dots-vertical"></i></button><div class="vmenu"><div class="vm-item"><i class="ti ti-eye"></i> View Details</div><div class="vm-item"><i class="ti ti-download"></i> Download</div><div class="vm-item"><i class="ti ti-check"></i> Set as Current</div><div class="vm-item danger"><i class="ti ti-trash"></i> Delete Version</div></div></td></tr>
                                    <tr><td>0.6</td><td><span class="badge badge-b">DOCX</span></td><td>May 05, 2025<br><small>02:41 PM</small></td><td>1.5 MB</td><td>Unilag Library Admin</td><td>Original draft in Word.</td><td class="action-cell"><button type="button" class="icon-btn" onclick="toggleMenu(this)"><i class="ti ti-dots-vertical"></i></button><div class="vmenu"><div class="vm-item"><i class="ti ti-eye"></i> View Details</div><div class="vm-item"><i class="ti ti-download"></i> Download</div><div class="vm-item"><i class="ti ti-check"></i> Set as Current</div><div class="vm-item danger"><i class="ti ti-trash"></i> Delete Version</div></div></td></tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="tbl-footer">
                            <span>Showing 1 to 5 of 5 versions</span>
                            <div class="pagination"><button type="button" class="pg-btn">‹</button><button type="button" class="pg-btn active">1</button><button type="button" class="pg-btn">›</button></div>
                        </div>
                    </div>
                    <div class="tip-box">
                        <i class="ti ti-info-circle tip-icon"></i>
                        <div>
                            <strong>Version Management Tips</strong>
                            <ul><li>The current version is the file readers will access.</li><li>You can replace the current version without losing history.</li><li>Previous versions can be restored anytime.</li><li>Supported formats: EPUB, PDF, TXT</li></ul>
                        </div>
                    </div>
                </div>
                <div class="sidebar-col">
                    <div class="card">
                        <div class="card-title">Upload New Version</div>
                        <div class="card-sub">Upload a new version to replace the current book file.</div>
                        <div class="dropzone">
                            <i class="ti ti-cloud-upload drop-icon"></i>
                            <div class="drop-txt">Drag &amp; drop file here</div>
                            <div class="drop-or">or</div>
                            <button type="button" class="btn btn-outline">Choose File</button>
                        </div>
                        <p class="hint" style="margin-top:8px">Supported: EPUB, PDF, TXT · Max 100MB</p>
                        <div class="field" style="margin-top:14px">
                            <label class="label">Release Note (Optional)</label>
                            <textarea class="input textarea" id="rn" placeholder="Describe what's new in this version..." style="min-height:80px" oninput="cc('rn','rn-cc',500)"></textarea>
                            <div class="char-count" id="rn-cc">0/500</div>
                        </div>
                        <button type="button" class="btn btn-primary" style="width:100%;margin-top:10px;justify-content:center"><i class="ti ti-cloud-upload"></i> Upload &amp; Save Version</button>
                    </div>
                </div>
            </div>
            <div class="step-footer">
                <button type="button" class="btn btn-ghost" onclick="goStep(2)"><i class="ti ti-arrow-left"></i> Previous</button>
                <button type="button" class="btn btn-primary" onclick="goStep(4)">Next: SEO &amp; Visibility <i class="ti ti-arrow-right"></i></button>
            </div>
        </div>

        <!-- STEP 4 -->
        <div class="step-panel" id="p4">
