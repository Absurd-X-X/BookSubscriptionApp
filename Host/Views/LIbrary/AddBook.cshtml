<script>
    const stepMeta = {
        1: { title: 'Add New Book', sub: 'Fill in the details below to add a new book to your library.', bc: null },
        2: { title: 'Pricing & Access', sub: 'Set the price, access rules and visibility settings for this book.', bc: 'Pricing & Access' },
        3: { title: 'Files & Versions', sub: 'Upload, manage and track all versions of your book files.', bc: 'Files & Versions' },
        4: { title: 'SEO & Visibility', sub: 'Improve discoverability and control how this book appears to readers.', bc: 'SEO & Visibility' },
    };

    let currentStep = 1;

    function goStep(n) {
        document.getElementById('p' + currentStep).classList.remove('active');
        const tabs = document.querySelectorAll('.step-tab');
        for (let i = 1; i < n; i++) {
            tabs[i - 1].classList.remove('active');
            tabs[i - 1].classList.add('done');
            document.getElementById('c' + i).innerHTML = '<i class="ti ti-check"></i>';
        }
        for (let i = n; i <= 4; i++) {
            tabs[i - 1].classList.remove('done');
            if (i !== n) tabs[i - 1].classList.remove('active');
            if (i > n) document.getElementById('c' + i).textContent = i;
        }
        tabs[n - 1].classList.add('active');
        tabs[n - 1].classList.remove('done');
        document.getElementById('c' + n).textContent = n;
        currentStep = n;
        document.getElementById('p' + n).classList.add('active');
        const meta = stepMeta[n];
        document.getElementById('page-title').textContent = meta.title;
        document.getElementById('page-sub').textContent = meta.sub;
        if (meta.bc) {
            document.getElementById('bc-mid').textContent = 'Add New Book';
            document.getElementById('bc-sep2').style.display = 'inline';
            document.getElementById('bc-cur').textContent = meta.bc;
        } else {
            document.getElementById('bc-mid').textContent = 'Add New Book';
            document.getElementById('bc-sep2').style.display = 'none';
            document.getElementById('bc-cur').textContent = '';
        }
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function selPc(el) {
        document.querySelectorAll('.pc').forEach(p => p.classList.remove('sel'));
        el.classList.add('sel');
        var value = el.getAttribute('data-value');
        document.getElementById('pricingType').value = value;
        var priceInput = document.getElementById('priceInput');
        var banner = document.getElementById('priceBanner');
        var sumType = document.getElementById('sumPricingType');
        var sumPrice = document.getElementById('sumPrice');
        if (value === 'Free') {
            priceInput.disabled = true;
            priceInput.value = 0;
            banner.innerHTML = '<i class="ti ti-info-circle"></i> This book will be available for free.';
            sumType.textContent = 'Free Book';
            sumPrice.textContent = 'NGN 0.00';
        } else if (value === 'Paid') {
            priceInput.disabled = false;
            priceInput.value = 2500;
            banner.innerHTML = '<i class="ti ti-info-circle"></i> Readers will pay once to access this book.';
            sumType.textContent = 'Paid Book';
            sumPrice.textContent = 'NGN ' + priceInput.value;
        } else {
            priceInput.disabled = false;
            banner.innerHTML = '<i class="ti ti-info-circle"></i> Only active subscribers can access this book.';
            sumType.textContent = 'Subscription Only';
            sumPrice.textContent = 'NGN ' + priceInput.value;
        }
    }

    function toggleMenu(btn) {
        const menu = btn.nextElementSibling;
        const isOpen = menu.classList.contains('open');
        document.querySelectorAll('.vmenu').forEach(m => m.classList.remove('open'));
        if (!isOpen) menu.classList.add('open');
    }

    document.addEventListener('click', function (e) {
        if (!e.target.closest('.icon-btn')) {
            document.querySelectorAll('.vmenu').forEach(m => m.classList.remove('open'));
        }
    });

    function cc(inputId, counterId, max) {
        const len = document.getElementById(inputId).value.length;
        document.getElementById(counterId).textContent = len + '/' + max;
    }

    function liveSearch() {
        const t = document.getElementById('seo-t').value;
        const d = document.getElementById('seo-d').value;
        document.getElementById('seo-pt').textContent = t;
        document.getElementById('seo-pd').textContent = d;
        document.getElementById('seo-tc').textContent = t.length + '/60 characters';
        document.getElementById('seo-dc').textContent = d.length + '/160 characters';
    }

    function addKw(e) {
        if (e.key !== 'Enter' && e.key !== ',') return;
        e.preventDefault();
        const input = e.target;
        const val = input.value.trim().replace(/,$/, '');
        if (!val) return;
        const tag = document.createElement('span');
        tag.className = 'kw-tag';
        tag.innerHTML = val + ' <button type="button" onclick="rmKw(this)">×</button>';
        input.parentNode.insertBefore(tag, input);
        input.value = '';
    }

    function rmKw(btn) {
        btn.closest('.kw-tag').remove();
    }

    function fileChosen(input, hintId) {
        if (input.files && input.files[0]) {
            document.getElementById(hintId).textContent = input.files[0].name;
        }
    }

    document.querySelectorAll('textarea').forEach(function (ta) {
        ta.addEventListener('input', function () {
            const counter = this.nextElementSibling;
            if (counter && counter.classList.contains('char-count')) {
                const max = parseInt(counter.textContent.split('/')[1]) || 2000;
                counter.textContent = this.value.length + '/' + max;
            }
        });
    });
</script>