@{
    Layout = "~/Views/Shared/_LibraryLayout.cshtml";
    ViewData["Title"] = "Add New Book";
}
<link rel="stylesheet" href="~/css/addBook.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@latest/tabler-icons.min.css" />


<div class="wrap">

    <div class="topbar">
        <div class="breadcrumb">
            <a href="@Url.Action("GetByLibrary", "Book")">Books</a>
            <span class="bc-sep">›</span>
            <span id="bc-mid">Add New Book</span>
            <span class="bc-sep" id="bc-sep2" style="display:none">›</span>
            <span class="bc-cur" id="bc-cur"></span>
        </div>
        <div class="tbar-btns">
            <button type="button" class="btn btn-ghost"><i class="ti ti-eye"></i> Preview Book</button>
            <button type="submit" form="addBookForm" class="btn btn-primary"><i class="ti ti-pencil"></i> Save Book</button>
        </div>
    </div>

    <div class="page-hd">
        <div>
            <div class="page-title" id="page-title">Add New Book</div>
            <div class="page-sub" id="page-sub">Fill in the details below to add a new book to your library.</div>
        </div>
        <button type="button" class="btn btn-ghost-sm">Save as Draft</button>
    </div>

    <div class="step-tabs">
        <div class="step-tab active" onclick="goStep(1)">
            <div class="step-circle" id="c1">1</div><span>Basic Information</span><div class="step-line"></div>
        </div>
        <div class="step-tab" onclick="goStep(2)">
            <div class="step-circle" id="c2">2</div><span>Pricing &amp; Access</span><div class="step-line"></div>
        </div>
        <div class="step-tab" onclick="goStep(3)">
            <div class="step-circle" id="c3">3</div><span>Files &amp; Preview</span><div class="step-line"></div>
        </div>
        <div class="step-tab" onclick="goStep(4)">
            <div class="step-circle" id="c4">4</div><span>SEO &amp; Visibility</span>
        </div>
    </div>

    <form id="addBookForm" method="post" asp-action="AddBook" asp-controller="Library" enctype="multipart/form-data">

        <!-- STEP 1 -->
        <div class="step-panel active" id="p1">
            <div class="two-col">
                <div class="form-col">
                    <div class="card">
                        <div class="card-title">Basic Details</div>
                        <div class="card-sub">Enter the core information about this book.</div>
                        <div class="frow">
                            <div class="field"><label class="label">Title <span class="req">*</span></label><input type="text" name="title" id="titleInput" class="input" placeholder="Enter book title" required></div>
                            <div class="field"><label class="label">Subtitle</label><input type="text" name="subtitle" class="input" placeholder="Enter subtitle (optional)"></div>
                        </div>
                        <div class="frow">
                            <div class="field"><label class="label">Author <span class="req">*</span></label><input type="text" name="author" id="authorInput" class="input" placeholder="Enter author name" required></div>
                            <div class="field"><label class="label">Co-Author(s)</label><input type="text" class="input" placeholder="Enter co-author(s) (optional)"></div>
                        </div>
                        <div class="frow">
                            <div class="field"><label class="label">Publisher <span class="req">*</span></label><input type="text" name="publisher" class="input" placeholder="Enter publisher name" required></div>
                            <div class="field"><label class="label">Publication Date <span class="req">*</span></label><input type="date" class="input"></div>
                        </div>
                        <div class="frow">
                            <div class="field">
                                <label class="label">Language <span class="req">*</span></label>
                                <select name="language" class="input" required><option value="">Select language</option><option>English</option><option>French</option><option>Yoruba</option><option>Igbo</option><option>Hausa</option></select>
                            </div>
                            <div class="field"><label class="label">ISBN</label><input type="text" name="isbn" class="input" placeholder="Enter ISBN (optional)" required></div>
                        </div>
                        <div class="frow">
                            <div class="field">
                                <label class="label">Category <span class="req">*</span></label>
                                <select name="categoryId" class="input" required>
                                    <option value="">Select primary category</option>
                                    @foreach (var cat in (ViewBag.Categories as List<Application.Queries.GetCategories.GetCategoriesResponse>) ?? new())
                                    {
                                        <option value="@cat.Id">@cat.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="field">
                                <label class="label">Additional Categories</label>
                                <select class="input"><option value="">Select additional categories</option><option>Personal Development</option><option>Psychology</option><option>Success</option></select>
                            </div>
                        </div>
                        <div class="field">
                            <label class="label">Genre <span class="req">*</span></label>
                            <input type="text" name="genre" class="input" placeholder="Enter genre" required>
                        </div>
                        <div class="field">
                            <label class="label">Description <span class="req">*</span></label>
                            <div class="rich-bar">
                                <button type="button" class="rt-btn"><b>B</b></button>
                                <button type="button" class="rt-btn"><i>I</i></button>
                                <button type="button" class="rt-btn"><u>U</u></button>
                                <button type="button" class="rt-btn"><i class="ti ti-list"></i></button>
                                <button type="button" class="rt-btn"><i class="ti ti-list-numbers"></i></button>
                            </div>
                            <textarea name="about" class="input textarea" id="desc" placeholder="Write a short description about the book..." oninput="cc('desc','desc-cc',2000)" required></textarea>
                            <div class="char-count" id="desc-cc">0/2000</div>
                        </div>
                    </div>
                    <div class="card">
                        <div class="card-title">Book Details</div>
                        <div class="frow">
                            <div class="field"><label class="label">Pages</label><input type="number" name="pages" class="input" placeholder="Enter number of pages" min="1" required></div>
                            <div class="field"><label class="label">Edition</label><input type="text" class="input" placeholder="e.g. 1st Edition"></div>
                        </div>
                        <div class="frow">
                            <div class="field">
                                <label class="label">Book Format</label>
                                <select class="input"><option value="">Select format</option><option>EPUB</option><option>PDF</option><option>Both</option></select>
                            </div>
                            <div class="field">
                                <label class="label">Reading Age (Optional)</label>
                                <select class="input"><option value="">Select reading age</option><option>Children (0–12)</option><option>Teen (13–17)</option><option>Adult (18+)</option><option>All Ages</option></select>
                            </div>
                        </div>
                        <div class="frow">
                            <div class="field"><label class="label">Publication Year <span class="req">*</span></label><input type="number" name="publicationYear" class="input" placeholder="e.g. 2024" min="1000" max="2100" required></div>
                        </div>
                    </div>
                </div>
                <div class="sidebar-col">
                    <div class="card">
                        <div class="card-title">Book Cover</div>
                        <div class="card-sub">Upload a high-quality cover image.</div>
                        <div class="dropzone" id="coverDropzone" onclick="document.getElementById('bookCoverInput').click()">
                            <button type="button" class="dz-remove" id="coverRemoveBtn" style="display:none" onclick="removeCover(event)"><i class="ti ti-x"></i></button>
                            <div class="cover-preview-wrap" id="coverPreviewWrap">
                                <img id="coverPreviewImg" class="cover-preview-img" alt="Book cover preview">
                            </div>
                            <div class="dz-placeholder" id="coverPlaceholder">
                                <i class="ti ti-cloud-upload drop-icon"></i>
                                <div class="drop-txt">Drag &amp; drop image here</div>
                                <div class="drop-or">or</div>
                                <button type="button" class="btn btn-outline">Choose File</button>
                            </div>
                        </div>
                        <input type="file" id="bookCoverInput" name="bookCover" accept=".jpg,.jpeg,.png" required style="display:none" onchange="previewCover(this)">
                        <p class="hint" id="coverFileName">Recommended: 600×900px · JPG, PNG (Max 2MB)</p>
                    </div>
                    <div class="card">
                        <div class="card-title">Upload Book File</div>
                        <div class="card-sub">Upload the main file for this book.</div>
                        <div class="dropzone" id="fileDropzone" onclick="document.getElementById('bookFileInput').click()">
                            <button type="button" class="dz-remove" id="fileRemoveBtn" style="display:none" onclick="removeBookFile(event)"><i class="ti ti-x"></i></button>
                            <div class="file-drop-preview" id="fileDropPreview">
                                <i class="ti ti-file-text file-drop-icon" id="fileDropIcon"></i>
                                <div class="file-drop-name" id="fileDropName"></div>
                                <div class="file-drop-size" id="fileDropSize"></div>
                            </div>
                            <div class="dz-placeholder" id="filePlaceholder">
                                <i class="ti ti-file-upload drop-icon"></i>
                                <div class="drop-txt">Drag &amp; drop file here</div>
                                <div class="drop-or">or</div>
                                <button type="button" class="btn btn-outline">Choose File</button>
                            </div>
                        </div>
                        <input type="file" id="bookFileInput" name="bookFile" accept=".pdf,.epub,.txt" required style="display:none" onchange="previewBookFile(this)">
                        <p class="hint" id="bookFileName">Allowed: PDF, EPUB, TXT · Max 100MB</p>
                    </div>
                    <div class="card">
                        <div class="card-title">Book Status</div>
                        <div class="card-sub">Set the current status of this book.</div>
                        <div class="radio-group">
                            <label class="radio-item">
                                <input type="radio" name="statusDisplay" checked>
                                <div><div class="radio-lbl">Published</div><div class="radio-sub">Book will be visible to all readers</div></div>
                            </label>
                            <label class="radio-item">
                                <input type="radio" name="statusDisplay">
                                <div><div class="radio-lbl">Draft</div><div class="radio-sub">Book will be saved as draft</div></div>
                            </label>
                            <label class="radio-item">
                                <input type="radio" name="statusDisplay">
                                <div><div class="radio-lbl">Archived</div><div class="radio-sub">Book will be hidden from readers</div></div>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="step-footer">
                <a href="@Url.Action("GetByLibrary", "Book")" class="btn btn-ghost">Cancel</a>
                <button type="button" class="btn btn-primary" onclick="goStep(2)">Next: Pricing &amp; Access <i class="ti ti-arrow-right"></i></button>
            </div>
        </div>

        <!-- STEP 2 -->
        <div class="step-panel" id="p2">
            <div class="two-col">
                <div class="form-col">
                    <div class="card">
                        <div class="card-title">Pricing</div>
                        <div class="card-sub">Choose how this book will be priced for readers.</div>
                        <div class="pricing-cards">
                            <div class="pc sel" data-value="Free" onclick="selPc(this)"><div class="pc-title">Free Book</div><div class="pc-sub">This book is free for all readers.</div></div>
                            <div class="pc" data-value="Paid" onclick="selPc(this)"><div class="pc-title">Paid Book</div><div class="pc-sub">Readers must pay once to access this book.</div></div>
                            <div class="pc" data-value="Subscription" onclick="selPc(this)"><div class="pc-title">Subscription Only</div><div class="pc-sub">Only accessible to active subscribers.</div></div>
                        </div>
                        <input type="hidden" name="pricingType" id="pricingType" value="Free">
                        <div class="frow">
                            <div class="field">
                                <label class="label">Price (NGN) <span class="req">*</span></label>
                                <input type="number" name="price" id="priceInput" class="input" value="0" step="0.01" disabled>
                                <div class="hint">Set the selling price for this book.</div>
                            </div>
                            <div class="field">
                                <label class="label">Discount (Optional)</label>
                                <div class="input-suffix-wrap"><input type="number" name="discount" class="input" value="0" style="padding-right:28px"><span class="input-suffix">%</span></div>
                                <div class="hint">Set a discount percentage if applicable.</div>
                            </div>
                        </div>
                        <div class="info-banner" id="priceBanner"><i class="ti ti-info-circle"></i> This book will be available for free.</div>
                    </div>
                    <div class="card">
                        <div class="card-title">Access Rules</div>
                        <div class="card-sub">Define who can access this book.</div>
                        <div class="frow">
                            <div class="field">
                                <label class="label">Who can access? <span class="req">*</span></label>
                                <select name="accessLevel" class="input" required>
                                    <option value="Everyone">Everyone</option>
                                    <option value="SubscribersOnly">Subscribers Only</option>
                                    <option value="PremiumMembers">Premium Members</option>
                                </select>
                            </div>
                            <div class="field">
                                <label class="label">Require Login?</label>
                                <div class="toggle-wrap"><label class="toggle"><input type="checkbox" name="requireLogin" value="true" checked><span class="toggle-slider"></span></label><span class="toggle-lbl">Readers must be logged in to access this book.</span></div>
                            </div>
                        </div>
                        <div class="frow">
                            <div class="field">
                                <label class="label">Subscription Plan (Optional)</label>
                                <select class="input"><option value="">Select a plan</option><option>Basic</option><option>Premium</option></select>
                            </div>
                            <div class="field">
                                <label class="label">Download Allowed?</label>
                                <div class="toggle-wrap"><label class="toggle"><input type="checkbox" name="allowDownload" value="true"><span class="toggle-slider"></span></label><span class="toggle-lbl">Allow readers to download this book.</span></div>
                            </div>
                        </div>
                        <div class="frow">
                            <div class="field">
                                <label class="label">Print Allowed?</label>
                                <div class="toggle-wrap"><label class="toggle"><input type="checkbox" name="allowPrint" value="true"><span class="toggle-slider"></span></label><span class="toggle-lbl">Allow readers to print this book.</span></div>
                            </div>
                            <div class="field">
                                <label class="label">Copy &amp; Paste Allowed?</label>
                                <div class="toggle-wrap"><label class="toggle"><input type="checkbox" name="allowCopyPaste" value="true"><span class="toggle-slider"></span></label><span class="toggle-lbl">Allow readers to copy content from this book.</span></div>
                            </div>
                        </div>
                    </div>
                    <div class="card">
                        <div class="card-title">Availability</div>
                        <div class="card-sub">Control where and how this book is displayed.</div>
                        <div class="cb-grid">
                            <label class="cb-item"><input type="checkbox" checked><div><b>Publish Book</b><br><span>Make this book visible to readers.</span></div></label>
                            <label class="cb-item"><input type="checkbox" checked><div><b>Show on Homepage</b><br><span>Display this book on the homepage.</span></div></label>
                            <label class="cb-item"><input type="checkbox" checked><div><b>Include in Search</b><br><span>Allow this book to appear in search results.</span></div></label>
                            <label class="cb-item"><input type="checkbox" checked><div><b>Featured Book</b><br><span>Highlight this book as a featured book.</span></div></label>
                            <label class="cb-item"><input type="checkbox" checked><div><b>Show in Recommendations</b><br><span>Include in recommended books.</span></div></label>
                            <label class="cb-item"><input type="checkbox" checked><div><b>Show in New Arrivals</b><br><span>Display in the new arrivals section.</span></div></label>
                        </div>
                    </div>
                </div>
                <div class="sidebar-col">
                    <div class="card">
                        <div class="card-title">Pricing &amp; Access Summary</div>
                        <div class="card-sub">Review your pricing and access settings.</div>
                        <div class="summary-list">
                            <div class="sum-row"><span>Pricing Type</span><span class="badge badge-g" id="sumPricingType">Free Book</span></div>
                            <div class="sum-row"><span>Price</span><span id="sumPrice">NGN 0.00</span></div>
                            <div class="sum-row"><span>Discount</span><span>0%</span></div>
                            <div class="sum-row"><span>Access</span><span>Everyone</span></div>
                            <div class="sum-row"><span>Login Required</span><span>Yes</span></div>
                            <div class="sum-row"><span>Download</span><span class="badge badge-r">Not Allowed</span></div>
                            <div class="sum-row"><span>Print</span><span class="badge badge-r">Not Allowed</span></div>
                            <div class="sum-row"><span>Copy &amp; Paste</span><span class="badge badge-r">Not Allowed</span></div>
                        </div>
                    </div>
                    <div class="card">
                        <div class="card-title">Access Preview</div>
                        <div class="card-sub">This is how readers will see this book.</div>
                        <div class="preview-card">
                            <div class="prev-book-row">
                                <div class="prev-cover" id="accessPreviewCover"></div>
                                <div>
                                    <div class="prev-title" id="accessPreviewTitle">Untitled Book</div>
                                    <div class="prev-author" id="accessPreviewAuthor">by Unknown Author</div>
                                    <span class="badge badge-g" id="accessPreviewBadge" style="margin-top:5px;display:inline-flex">FREE</span>
                                    <div class="prev-sub" id="accessPreviewSub">Free for everyone</div>
                                </div>
                            </div>
                            <div class="prev-lock"><i class="ti ti-lock"></i> Login required to access this book</div>
                            <button type="button" class="btn btn-primary" style="width:100%;justify-content:center">Read Now</button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="step-footer">
                <button type="button" class="btn btn-ghost" onclick="goStep(1)"><i class="ti ti-arrow-left"></i> Previous</button>
                <button type="button" class="btn btn-primary" onclick="goStep(3)">Next: Files &amp; Preview <i class="ti ti-arrow-right"></i></button>
            </div>
        </div>

        <!-- STEP 3 (repurposed: live preview of what was uploaded in Step 1, no fake version history) -->
        <div class="step-panel" id="p3">
            <div class="two-col">
                <div class="form-col">
                    <div class="card">
                        <div class="card-title">Book File Preview</div>
                        <div class="card-sub">This is the file that will be uploaded with this book.</div>
                        <div class="ver-cur" id="filePreviewCard">
                            <div class="ver-icon">
                                <i class="ti ti-file" id="p3FileIcon" style="font-size:24px;color:#7c3aed"></i>
                                <span class="ver-icon-lbl" id="p3FileExt">-</span>
                            </div>
                            <div style="flex:1">
                                <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
                                    <strong id="p3FileName">No file uploaded yet</strong>
                                </div>
                                <div class="ver-meta-row">
                                    <div><div class="meta-lbl">File Type</div><div class="meta-val" id="p3FileType">—</div></div>
                                    <div><div class="meta-lbl">File Size</div><div class="meta-val" id="p3FileSize">—</div></div>
                                </div>
                            </div>
                        </div>
                        <p class="hint" id="p3NoFileHint">Go back to Step 1 to upload the book file.</p>
                    </div>
                </div>
                <div class="sidebar-col">
                    <div class="card">
                        <div class="card-title">Book Cover Preview</div>
                        <div class="card-sub">This is the cover that will be uploaded with this book.</div>
                        <div class="dropzone" style="pointer-events:none;min-height:180px">
                            <div class="cover-preview-wrap" id="p3CoverWrap">
                                <img id="p3CoverImg" class="cover-preview-img" alt="Book cover preview">
                            </div>
                            <div class="dz-placeholder" id="p3CoverPlaceholder">
                                <i class="ti ti-photo drop-icon"></i>
                                <div class="drop-txt">No cover uploaded yet</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="step-footer">
                <button type="button" class="btn btn-ghost" onclick="goStep(2)"><i class="ti ti-arrow-left"></i> Previous</button>
                <button type="button" class="btn btn-primary" onclick="goStep(4)">Next: SEO &amp; Visibility <i class="ti ti-arrow-right"></i></button>
            </div>
        </div>

        <!-- STEP 4 -->
        <div class="step-panel" id="p4">
            <div class="two-col">
                <div class="form-col">
                    <div class="card">
                        <div class="card-title">SEO Settings</div>
                        <div class="card-sub">Optimize how your book appears in search engines and on Unilag Library.</div>
                        <div class="field">
                            <label class="label">SEO Title <span class="req">*</span></label>
                            <input type="text" class="input" id="seo-t" value="" placeholder="Auto-filled from title and author" oninput="liveSearch()">
                            <div class="char-count" id="seo-tc">0/60 characters</div>
                            <div class="hint">This is the title that search engines will display.</div>
                        </div>
                        <div class="field">
                            <label class="label">SEO Description <span class="req">*</span></label>
                            <textarea class="input textarea" id="seo-d" style="min-height:75px" placeholder="Auto-filled once you enter a title" oninput="liveSearch()"></textarea>
                            <div class="char-count" id="seo-dc">0/160 characters</div>
                            <div class="hint">This description appears in search results.</div>
                        </div>
                        <div class="field">
                            <label class="label">SEO Keywords</label>
                            <div class="kw-tags" id="kw-wrap">
                                <input class="kw-input" placeholder="Add keyword and press Enter" onkeydown="addKw(event)">
                            </div>
                            <div class="hint">Add relevant keywords separated by commas or enter.</div>
                        </div>
                        <div class="frow">
                            <div class="field"><label class="label">URL Slug <span class="req">*</span></label><input type="text" class="input" id="urlSlugInput" name="slug" placeholder="e.g. atomic-habits-james-clear" oninput="updateSlugPreview()"><div class="hint">This will be used in the book's URL.</div></div>
                            <div class="field"><label class="label">Canonical URL (Optional)</label><input type="text" class="input" placeholder="https://unilaglibrary.com/books/..."><div class="hint">Use canonical URL if this book has multiple URLs.</div></div>
                        </div>
                    </div>
                    <div class="card">
                        <div class="card-title">Visibility Settings</div>
                        <div class="card-sub">Control where and how this book is visible.</div>
                        <div class="toggle-grid">
                            <div class="tg-block"><div><div class="tg-title">Published</div><div class="hint">Make this book available to readers.</div></div><label class="toggle"><input type="checkbox" checked><span class="toggle-slider"></span></label></div>
                            <div class="tg-block"><div><div class="tg-title">Show in Recommendations</div><div class="hint">Include in recommended books.</div></div><label class="toggle"><input type="checkbox" checked><span class="toggle-slider"></span></label></div>
                            <div class="tg-block"><div><div class="tg-title">Show in Search Results</div><div class="hint">Allow this book to appear in search results.</div></div><label class="toggle"><input type="checkbox" checked><span class="toggle-slider"></span></label></div>
                            <div class="tg-block"><div><div class="tg-title">Show in New Arrivals</div><div class="hint">Display in the new arrivals section.</div></div><label class="toggle"><input type="checkbox" checked><span class="toggle-slider"></span></label></div>
                            <div class="tg-block"><div><div class="tg-title">Show on Homepage</div><div class="hint">Display this book on the homepage.</div></div><label class="toggle"><input type="checkbox"><span class="toggle-slider"></span></label></div>
                            <div class="tg-block"><div><div class="tg-title">Allow in Collections</div><div class="hint">Allow this book to be added to collections.</div></div><label class="toggle"><input type="checkbox" checked><span class="toggle-slider"></span></label></div>
                            <div class="tg-block"><div><div class="tg-title">Featured Book</div><div class="hint">Highlight this book as a featured book.</div></div><label class="toggle"><input type="checkbox" checked><span class="toggle-slider"></span></label></div>
                            <div class="tg-block"><div><div class="tg-title">Allow Previews</div><div class="hint">Allow readers to preview this book.</div></div><label class="toggle"><input type="checkbox" checked><span class="toggle-slider"></span></label></div>
                        </div>
                    </div>
                    <div class="card">
                        <div class="card-title">Discoverability</div>
                        <div class="card-sub">Help readers find your book easily.</div>
                        <div class="frow">
                            <div class="field"><label class="label">Primary Category <span class="req">*</span></label><select class="input"><option>Self Help</option><option>Technology</option><option>Business</option></select></div>
                            <div class="field"><label class="label">Language <span class="req">*</span></label><select class="input"><option>English</option><option>French</option></select></div>
                        </div>
                        <div class="frow">
                            <div class="field">
                                <label class="label">Additional Categories</label>
                                <div class="kw-tags"><input class="kw-input" placeholder="Add category"></div>
                            </div>
                            <div class="field"><label class="label">Reading Level</label><select class="input"><option>Intermediate</option><option>Beginner</option><option>Advanced</option></select><div class="hint">Helps readers find books suitable for their level.</div></div>
                        </div>
                    </div>
                </div>
                <div class="sidebar-col">
                    <div class="card">
                        <div class="card-title">Search Preview</div>
                        <div class="card-sub">This is how your book may appear in search results.</div>
                        <div class="seo-prev">
                            <div class="seo-url" id="seoUrlPreview">unilaglibrary.com › books › your-book-slug</div>
                            <div class="seo-title" id="seo-pt"></div>
                            <div class="seo-desc" id="seo-pd"></div>
                            <div class="seo-tip"><i class="ti ti-info-circle"></i> Tip: Write a clear title and description to improve your book's visibility.</div>
                        </div>
                    </div>
                    <div class="card">
                        <div class="card-title">Visibility Summary</div>
                        <div class="card-sub">Overview of your visibility settings.</div>
                        <div class="summary-list">
                            <div class="sum-row"><span>Published</span><span class="badge badge-g">Yes</span></div>
                            <div class="sum-row"><span>Search Visibility</span><span class="badge badge-g">Enabled</span></div>
                            <div class="sum-row"><span>Homepage</span><span class="badge badge-r">Not Featured</span></div>
                            <div class="sum-row"><span>Featured Book</span><span class="badge badge-g">Yes</span></div>
                            <div class="sum-row"><span>Recommendations</span><span class="badge badge-g">Enabled</span></div>
                            <div class="sum-row"><span>New Arrivals</span><span class="badge badge-g">Enabled</span></div>
                            <div class="sum-row"><span>Collections</span><span class="badge badge-g">Enabled</span></div>
                            <div class="sum-row"><span>Previews</span><span class="badge badge-g">Enabled</span></div>
                        </div>
                        <div class="disc-badge"><i class="ti ti-circle-check"></i> Your book is highly discoverable</div>
                    </div>
                    <div class="card">
                        <div class="card-title">Social Share Preview</div>
                        <div class="card-sub">This is how your book will look when shared.</div>
                        <div class="social-card">
                            <div class="social-cover" id="socialCoverBox"></div>
                            <div class="social-body">
                                <div class="social-ttl" id="socialTtl">Untitled Book</div>
                                <div class="social-dsc" id="socialDsc"></div>
                                <div class="social-url">unilaglibrary.com</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="step-footer">
                <button type="button" class="btn btn-ghost" onclick="goStep(3)"><i class="ti ti-arrow-left"></i> Previous</button>
                <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy"></i> Save &amp; Update Book</button>
            </div>
        </div>

    </form>
</div>

<script>
    const stepMeta = {
        1: { title: 'Add New Book', sub: 'Fill in the details below to add a new book to your library.', bc: null },
        2: { title: 'Pricing & Access', sub: 'Set the price, access rules and visibility settings for this book.', bc: 'Pricing & Access' },
        3: { title: 'Files & Preview', sub: 'Confirm the file and cover you uploaded for this book.', bc: 'Files & Preview' },
        4: { title: 'SEO & Visibility', sub: 'Improve discoverability and control how this book appears to readers.', bc: 'SEO & Visibility' },
    };

    let currentStep = 1;

    function goStep(n) {
        document.getElementById('p' + currentStep).classList.remove('active');
        const tabs = document.querySelectorAll('.step-tab');
        for (let i = 1; i < n; i++) {
            tabs[i - 1].classList.remove('active');
            tabs[i - 1].classList.add('done');
            document.getElementById('c' + i).innerHTML = '<i class="ti ti-check"></i>';
        }
        for (let i = n; i <= 4; i++) {
            tabs[i - 1].classList.remove('done');
            if (i !== n) tabs[i - 1].classList.remove('active');
            if (i > n) document.getElementById('c' + i).textContent = i;
        }
        tabs[n - 1].classList.add('active');
        tabs[n - 1].classList.remove('done');
        document.getElementById('c' + n).textContent = n;
        currentStep = n;
        document.getElementById('p' + n).classList.add('active');
        const meta = stepMeta[n];
        document.getElementById('page-title').textContent = meta.title;
        document.getElementById('page-sub').textContent = meta.sub;
        if (meta.bc) {
            document.getElementById('bc-mid').textContent = 'Add New Book';
            document.getElementById('bc-sep2').style.display = 'inline';
            document.getElementById('bc-cur').textContent = meta.bc;
        } else {
            document.getElementById('bc-mid').textContent = 'Add New Book';
            document.getElementById('bc-sep2').style.display = 'none';
            document.getElementById('bc-cur').textContent = '';
        }
        if (n === 3) { syncBookMeta(); updateFilePreviewStep3(); }
        if (n === 4) { autoFillSeo(); updateSlugPreview(); }
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function selPc(el) {
        document.querySelectorAll('.pc').forEach(p => p.classList.remove('sel'));
        el.classList.add('sel');
        var value = el.getAttribute('data-value');
        document.getElementById('pricingType').value = value;
        var priceInput = document.getElementById('priceInput');
        var banner = document.getElementById('priceBanner');
        var sumType = document.getElementById('sumPricingType');
        var sumPrice = document.getElementById('sumPrice');
        if (value === 'Free') {
            priceInput.disabled = true;
            priceInput.value = 0;
            banner.innerHTML = '<i class="ti ti-info-circle"></i> This book will be available for free.';
            sumType.textContent = 'Free Book';
            sumPrice.textContent = 'NGN 0.00';
        } else if (value === 'Paid') {
            priceInput.disabled = false;
            if (!priceInput.value || priceInput.value == 0) priceInput.value = 2500;
            banner.innerHTML = '<i class="ti ti-info-circle"></i> Readers will pay once to access this book.';
            sumType.textContent = 'Paid Book';
            sumPrice.textContent = 'NGN ' + priceInput.value;
        } else {
            priceInput.disabled = false;
            banner.innerHTML = '<i class="ti ti-info-circle"></i> Only active subscribers can access this book.';
            sumType.textContent = 'Subscription Only';
            sumPrice.textContent = 'NGN ' + priceInput.value;
        }
        syncPricingPreview(value, priceInput.value);
    }

    function toggleMenu(btn) {
        const menu = btn.nextElementSibling;
        const isOpen = menu.classList.contains('open');
        document.querySelectorAll('.vmenu').forEach(m => m.classList.remove('open'));
        if (!isOpen) menu.classList.add('open');
    }

    document.addEventListener('click', function (e) {
        if (!e.target.closest('.icon-btn')) {
            document.querySelectorAll('.vmenu').forEach(m => m.classList.remove('open'));
        }
    });

    function cc(inputId, counterId, max) {
        const len = document.getElementById(inputId).value.length;
        document.getElementById(counterId).textContent = len + '/' + max;
    }

    function liveSearch() {
        const t = document.getElementById('seo-t').value;
        const d = document.getElementById('seo-d').value;
        document.getElementById('seo-pt').textContent = t;
        document.getElementById('seo-pd').textContent = d;
        document.getElementById('seo-tc').textContent = t.length + '/60 characters';
        document.getElementById('seo-dc').textContent = d.length + '/160 characters';
        const socialDsc = document.getElementById('socialDsc');
        if (socialDsc) socialDsc.textContent = d;
    }

    function addKw(e) {
        if (e.key !== 'Enter' && e.key !== ',') return;
        e.preventDefault();
        const input = e.target;
        const val = input.value.trim().replace(/,$/, '');
        if (!val) return;
        const tag = document.createElement('span');
        tag.className = 'kw-tag';
        tag.innerHTML = val + ' <button type="button" onclick="rmKw(this)">×</button>';
        input.parentNode.insertBefore(tag, input);
        input.value = '';
    }

    function rmKw(btn) {
        btn.closest('.kw-tag').remove();
    }

    function formatBytes(bytes) {
        if (!bytes) return '0 B';
        const units = ['B', 'KB', 'MB', 'GB'];
        let i = 0;
        let val = bytes;
        while (val >= 1024 && i < units.length - 1) {
            val /= 1024;
            i++;
        }
        return (i === 0 ? val : val.toFixed(val >= 10 ? 0 : 1)) + ' ' + units[i];
    }

    const fileTypeIconMap = {
        pdf: 'ti-file-type-pdf',
        epub: 'ti-book-2',
        txt: 'ti-file-text',
        docx: 'ti-file-type-docx'
    };

    function getExt(name) {
        const parts = name.split('.');
        return parts.length > 1 ? parts.pop().toLowerCase() : '';
    }

    /* ---------------------------------------------------------------- */
    /* Book Cover preview (image)                                        */
    /* ---------------------------------------------------------------- */
    function previewCover(input) {
        const file = input.files && input.files[0];
        if (!file) return;
        if (!/^image\//.test(file.type)) {
            alert('Please choose a JPG or PNG image for the cover.');
            input.value = '';
            return;
        }
        const reader = new FileReader();
        reader.onload = function (e) {
            const img = document.getElementById('coverPreviewImg');
            img.src = e.target.result;
            document.getElementById('coverPreviewWrap').classList.add('show');
            document.getElementById('coverPlaceholder').classList.add('hide');
            document.getElementById('coverRemoveBtn').style.display = 'flex';
            syncBookMeta();
        };
        reader.readAsDataURL(file);
        document.getElementById('coverFileName').textContent = file.name + ' · ' + formatBytes(file.size);
    }

    function removeCover(e) {
        e.stopPropagation();
        const input = document.getElementById('bookCoverInput');
        input.value = '';
        document.getElementById('coverPreviewWrap').classList.remove('show');
        document.getElementById('coverPreviewImg').src = '';
        document.getElementById('coverPlaceholder').classList.remove('hide');
        document.getElementById('coverRemoveBtn').style.display = 'none';
        document.getElementById('coverFileName').textContent = 'Recommended: 600×900px · JPG, PNG (Max 2MB)';
        syncBookMeta();
    }

    /* ---------------------------------------------------------------- */
    /* Book File preview (non-image: pdf/epub/txt)                       */
    /* ---------------------------------------------------------------- */
    function previewBookFile(input) {
        const file = input.files && input.files[0];
        if (!file) return;
        const ext = getExt(file.name);
        document.getElementById('fileDropIcon').className = 'file-drop-icon ti ' + (fileTypeIconMap[ext] || 'ti-file');
        document.getElementById('fileDropName').textContent = file.name;
        document.getElementById('fileDropSize').textContent = formatBytes(file.size);
        document.getElementById('fileDropPreview').classList.add('show');
        document.getElementById('filePlaceholder').classList.add('hide');
        document.getElementById('fileRemoveBtn').style.display = 'flex';
        document.getElementById('bookFileName').textContent = file.name + ' · ' + formatBytes(file.size);
        updateFilePreviewStep3();
    }

    function removeBookFile(e) {
        e.stopPropagation();
        const input = document.getElementById('bookFileInput');
        input.value = '';
        document.getElementById('fileDropPreview').classList.remove('show');
        document.getElementById('filePlaceholder').classList.remove('hide');
        document.getElementById('fileRemoveBtn').style.display = 'none';
        document.getElementById('bookFileName').textContent = 'Allowed: PDF, EPUB, TXT · Max 100MB';
        updateFilePreviewStep3();
    }

    /* ---------------------------------------------------------------- */
    /* Step 3: live preview of what was uploaded in Step 1               */
    /* ---------------------------------------------------------------- */
    function updateFilePreviewStep3() {
        const input = document.getElementById('bookFileInput');
        const file = input.files && input.files[0];
        const hint = document.getElementById('p3NoFileHint');
        if (!file) {
            document.getElementById('p3FileName').textContent = 'No file uploaded yet';
            document.getElementById('p3FileType').textContent = '—';
            document.getElementById('p3FileSize').textContent = '—';
            document.getElementById('p3FileExt').textContent = '-';
            document.getElementById('p3FileIcon').className = 'ti ti-file';
            if (hint) hint.style.display = 'block';
            return;
        }
        const ext = getExt(file.name);
        document.getElementById('p3FileIcon').className = 'ti ' + (fileTypeIconMap[ext] || 'ti-file');
        document.getElementById('p3FileExt').textContent = ext ? ext.toUpperCase() : 'FILE';
        document.getElementById('p3FileName').textContent = file.name;
        document.getElementById('p3FileType').textContent = ext ? ext.toUpperCase() : 'Unknown';
        document.getElementById('p3FileSize').textContent = formatBytes(file.size);
        if (hint) hint.style.display = 'none';
    }

    /* ---------------------------------------------------------------- */
    /* Live sync of title/author/cover across Step 2, 3, 4 previews      */
    /* ---------------------------------------------------------------- */
    function syncBookMeta() {
        const title = (document.getElementById('titleInput').value || '').trim() || 'Untitled Book';
        const author = (document.getElementById('authorInput').value || '').trim() || 'Unknown Author';
        const coverImg = document.getElementById('coverPreviewImg');
        const hasCover = coverImg && coverImg.src && document.getElementById('coverPreviewWrap').classList.contains('show');

        // Step 2 access preview
        const apTitle = document.getElementById('accessPreviewTitle');
        const apAuthor = document.getElementById('accessPreviewAuthor');
        const apCover = document.getElementById('accessPreviewCover');
        if (apTitle) apTitle.textContent = title;
        if (apAuthor) apAuthor.textContent = 'by ' + author;
        if (apCover) {
            if (hasCover) {
                apCover.style.backgroundImage = `url(${coverImg.src})`;
                apCover.style.backgroundSize = 'cover';
                apCover.style.backgroundPosition = 'center';
                apCover.textContent = '';
            } else {
                apCover.style.backgroundImage = '';
                apCover.textContent = title;
            }
        }

        // Step 3 cover preview
        const p3Wrap = document.getElementById('p3CoverWrap');
        const p3Img = document.getElementById('p3CoverImg');
        const p3Placeholder = document.getElementById('p3CoverPlaceholder');
        if (p3Wrap) {
            if (hasCover) {
                p3Img.src = coverImg.src;
                p3Wrap.classList.add('show');
                p3Placeholder.classList.add('hide');
            } else {
                p3Wrap.classList.remove('show');
                p3Placeholder.classList.remove('hide');
            }
        }

        // Step 4 social preview
        const socialCover = document.getElementById('socialCoverBox');
        const socialTtl = document.getElementById('socialTtl');
        if (socialTtl) socialTtl.textContent = author !== 'Unknown Author' ? `${title} by ${author}` : title;
        if (socialCover) {
            if (hasCover) {
                socialCover.style.backgroundImage = `url(${coverImg.src})`;
                socialCover.style.backgroundSize = 'cover';
                socialCover.style.backgroundPosition = 'center';
                socialCover.textContent = '';
            } else {
                socialCover.style.backgroundImage = '';
                socialCover.textContent = title;
            }
        }
    }

    function syncPricingPreview(value, priceValue) {
        const badge = document.getElementById('accessPreviewBadge');
        const sub = document.getElementById('accessPreviewSub');
        if (!badge || !sub) return;
        if (value === 'Free') {
            badge.className = 'badge badge-g';
            badge.textContent = 'FREE';
            sub.textContent = 'Free for everyone';
        } else if (value === 'Paid') {
            badge.className = 'badge badge-p';
            badge.textContent = 'NGN ' + priceValue;
            sub.textContent = 'One-time purchase';
        } else {
            badge.className = 'badge badge-b';
            badge.textContent = 'SUBSCRIPTION';
            sub.textContent = 'Subscribers only';
        }
    }

    /* ---------------------------------------------------------------- */
    /* Step 4: SEO auto-fill (only until the admin edits it themselves)  */
    /* ---------------------------------------------------------------- */
    function autoFillSeo() {
        const title = (document.getElementById('titleInput').value || '').trim();
        const author = (document.getElementById('authorInput').value || '').trim();
        const seoT = document.getElementById('seo-t');
        const seoD = document.getElementById('seo-d');
        if (seoT && !seoT.dataset.touched && title) {
            seoT.value = author ? `${title} by ${author} | Unilag Library` : `${title} | Unilag Library`;
        }
        if (seoD && !seoD.dataset.touched && title) {
            seoD.value = `Discover ${title}${author ? ' by ' + author : ''} on Unilag Library.`;
        }
        liveSearch();
    }

    function updateSlugPreview() {
        const slugInput = document.getElementById('urlSlugInput');
        const seoUrlPreview = document.getElementById('seoUrlPreview');
        if (slugInput && seoUrlPreview) {
            const slug = slugInput.value.trim() || 'your-book-slug';
            seoUrlPreview.textContent = 'unilaglibrary.com › books › ' + slug;
        }
    }

    /* ---------------------------------------------------------------- */
    /* Shared drag & drop wiring                                         */
    /* ---------------------------------------------------------------- */
    function setupDropzone(zoneId, inputId) {
        const zone = document.getElementById(zoneId);
        const input = document.getElementById(inputId);
        if (!zone || !input) return;

        ['dragenter', 'dragover'].forEach(evt => {
            zone.addEventListener(evt, function (e) {
                e.preventDefault();
                e.stopPropagation();
                zone.classList.add('dragover');
            });
        });

        ['dragleave', 'drop'].forEach(evt => {
            zone.addEventListener(evt, function (e) {
                e.preventDefault();
                e.stopPropagation();
                zone.classList.remove('dragover');
            });
        });

        zone.addEventListener('drop', function (e) {
            const files = e.dataTransfer.files;
            if (files && files.length) {
                input.files = files;
                input.dispatchEvent(new Event('change'));
            }
        });
    }

    document.addEventListener('DOMContentLoaded', function () {
        setupDropzone('coverDropzone', 'bookCoverInput');
        setupDropzone('fileDropzone', 'bookFileInput');

        document.getElementById('titleInput').addEventListener('input', function () { syncBookMeta(); autoFillSeo(); });
        document.getElementById('authorInput').addEventListener('input', function () { syncBookMeta(); autoFillSeo(); });
        document.getElementById('seo-t').addEventListener('input', function () { this.dataset.touched = 'true'; });
        document.getElementById('seo-d').addEventListener('input', function () { this.dataset.touched = 'true'; });

        syncBookMeta();
        updateSlugPreview();
    });

    document.querySelectorAll('textarea').forEach(function (ta) {
        ta.addEventListener('input', function () {
            const counter = this.nextElementSibling;
            if (counter && counter.classList.contains('char-count')) {
                const max = parseInt(counter.textContent.split('/')[1]) || 2000;
                counter.textContent = this.value.length + '/' + max;
            }
        });
    });
</script>