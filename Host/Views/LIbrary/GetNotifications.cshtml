                                    <div class="notif-text">
                                        <span class="notif-title">New reader registered</span>
                                        <span class="notif-desc">Emily Johnson has created a new account.</span>
                                    </div>
                                </div>
                            </td>
                            <td><span class="badge badge-readers">Readers</span></td>
                            <td class="date-cell">10 mins ago</td>
                            <td><span class="status status-unread">Unread</span></td>
                            <td>
                                <div class="action-cell">
