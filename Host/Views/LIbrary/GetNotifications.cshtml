<script>
    (function () {

      // -----------------------------------------------------------
      // No data model here on purpose: the rows in #tableBody and
      // the items in #bellMenuList are real markup (rendered by
      // your MVC view / partial). This script only reacts to
      // clicks on the DOM that's already there — it never builds
      // or rebuilds rows itself, so it stays out of the way of
      // server-side pagination, filtering, etc.
      // -----------------------------------------------------------

      const tbody = document.getElementById('tableBody');
      const unreadStatEl = document.getElementById('unreadStat');
      const bellCountEl = document.getElementById('bellCount');
      const bellMenuList = document.getElementById('bellMenuList');
      const bellMarkAllBtn = document.getElementById('bellMarkAllBtn');

      // ---------- counts ----------
      function updateUnreadCount() {
        const n = tbody.querySelectorAll('tr[data-status="unread"]').length;
        if (unreadStatEl) unreadStatEl.textContent = n;
        if (bellCountEl) {
          bellCountEl.textContent = n;
          bellCountEl.style.display = n > 0 ? 'flex' : 'none';
        }
        if (bellMarkAllBtn) bellMarkAllBtn.disabled = n === 0;
      }

      // ---------- keep a single row's UI (badge, dot, menu label) in sync ----------
      function setRowStatus(row, status) {
        row.dataset.status = status;
        const statusEl = row.querySelector('.status');
        const dotEl = row.querySelector('.unread-dot');
        const labelEl = row.querySelector('[data-action="toggle-status"] .action-label');

        if (status === 'unread') {
          statusEl.textContent = 'Unread';
          statusEl.classList.remove('status-read');
          statusEl.classList.add('status-unread');
          if (dotEl) dotEl.classList.remove('hidden');
          if (labelEl) labelEl.textContent = 'Mark as Read';
        } else {
          statusEl.textContent = 'Read';
          statusEl.classList.remove('status-unread');
          statusEl.classList.add('status-read');
          if (dotEl) dotEl.classList.add('hidden');
          if (labelEl) labelEl.textContent = 'Mark as Unread';
        }

        syncBellItem(row.dataset.id, status);
      }

      // ---------- keep the bell preview's dot in sync with the table row ----------
      function syncBellItem(id, status) {
        if (!bellMenuList) return;
        const bellItem = bellMenuList.querySelector(`.bell-item[data-id="${id}"]`);
        if (!bellItem) return;
        const titleEl = bellItem.querySelector('.bell-item-title');
        const existingDot = titleEl.querySelector('.bell-dot');
        if (status === 'unread' && !existingDot) {
          titleEl.insertAdjacentHTML('afterbegin', '<span class="bell-dot"></span>');
        } else if (status === 'read' && existingDot) {
          existingDot.remove();
        }
      }

      function showEmptyStateIfNeeded() {
        if (bellMenuList && bellMenuList.querySelectorAll('.bell-item').length === 0) {
          bellMenuList.innerHTML = '<div class="bell-empty">You\'re all caught up!</div>';
        }
      }

      // ---------- dropdown open/close ----------
      function closeAllDropdowns(except) {
        document.querySelectorAll('.dropdown.open').forEach(d => {
          if (d !== except) d.classList.remove('open');
        });
      }

      document.addEventListener('click', function (e) {
        const toggleBtn = e.target.closest('[data-toggle]');
        if (toggleBtn) {
          const dropdown = toggleBtn.closest('.dropdown');
          const wasOpen = dropdown.classList.contains('open');
          closeAllDropdowns();
          dropdown.classList.toggle('open', !wasOpen);
          return;
        }

        const actionBtn = e.target.closest('[data-action]');
        if (actionBtn) {
          const action = actionBtn.dataset.action;

          // clicking a row in the bell preview panel
          if (action === 'bell-toggle-read') {
            const id = actionBtn.dataset.id;
            const row = tbody.querySelector(`tr[data-id="${id}"]`);
            if (row) setRowStatus(row, row.dataset.status === 'unread' ? 'read' : 'unread');
            updateUnreadCount();
            closeAllDropdowns();
            return;
          }

          // table row kebab menu actions
          const row = actionBtn.closest('tr');
          if (row) {
            if (action === 'toggle-status') {
              setRowStatus(row, row.dataset.status === 'unread' ? 'read' : 'unread');
              updateUnreadCount();
            } else if (action === 'delete' || action === 'archive') {
              const id = row.dataset.id;
              row.style.transition = 'opacity .2s ease';
              row.style.opacity = '0';
              setTimeout(() => {
                row.remove();
                if (bellMenuList) {
                  const bellItem = bellMenuList.querySelector(`.bell-item[data-id="${id}"]`);
                  if (bellItem) bellItem.remove();
                }
                updateUnreadCount();
                showEmptyStateIfNeeded();
              }, 150);
            }
          }
          closeAllDropdowns();
          return;
        }

        if (!e.target.closest('.dropdown-menu')) {
          closeAllDropdowns();
        }
      });

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeAllDropdowns();
      });

      // ---------- search + filters (read straight from the rendered DOM) ----------
      const searchInput = document.getElementById('searchInput');
      const categoryFilter = document.getElementById('categoryFilter');
      const statusFilter = document.getElementById('statusFilter');

      function applyFilters() {
        const q = searchInput.value.trim().toLowerCase();
        const cat = categoryFilter.value;
        const status = statusFilter.value;

        tbody.querySelectorAll('tr').forEach(row => {
          const titleEl = row.querySelector('.notif-title');
          const descEl = row.querySelector('.notif-desc');
          const title = titleEl ? titleEl.textContent.toLowerCase() : '';
          const desc = descEl ? descEl.textContent.toLowerCase() : '';
          const matchesText = !q || title.includes(q) || desc.includes(q);
          const matchesCat = cat === 'all' || row.dataset.cat === cat;
          const matchesStatus = status === 'all' || row.dataset.status === status;
          row.classList.toggle('row-hidden', !(matchesText && matchesCat && matchesStatus));
        });
      }

      searchInput.addEventListener('input', applyFilters);
      categoryFilter.addEventListener('change', applyFilters);
      statusFilter.addEventListener('change', applyFilters);

      // ---------- mark all as read ----------
      function markAllRead() {
        tbody.querySelectorAll('tr[data-status="unread"]').forEach(row => setRowStatus(row, 'read'));
        updateUnreadCount();
      }
      document.getElementById('markAllBtn').addEventListener('click', markAllRead);
      document.getElementById('qaMarkAll').addEventListener('click', markAllRead);

      if (bellMarkAllBtn) {
        bellMarkAllBtn.addEventListener('click', function () {
          markAllRead();
          closeAllDropdowns();
        });
      }
      const bellViewAllLink = document.getElementById('bellViewAllLink');
      if (bellViewAllLink) {
        bellViewAllLink.addEventListener('click', function (e) {
          e.preventDefault();
          closeAllDropdowns();
          // hook this up to your real "all notifications" route
        });
      }

      // ---------- clear read notifications ----------
      document.getElementById('qaClearRead').addEventListener('click', function () {
        tbody.querySelectorAll('tr[data-status="read"]').forEach(row => {
          const id = row.dataset.id;
          row.remove();
          if (bellMenuList) {
            const bellItem = bellMenuList.querySelector(`.bell-item[data-id="${id}"]`);
            if (bellItem) bellItem.remove();
          }
        });
        updateUnreadCount();
        showEmptyStateIfNeeded();
      });

      // ---------- pagination (visual only — wire to your real paging) ----------
      document.querySelectorAll('.pagination-controls .page-btn:not(.dots)').forEach(btn => {
        btn.addEventListener('click', function () {
          if (this.id === 'prevPage' || this.id === 'nextPage') return;
          document.querySelectorAll('.pagination-controls .page-btn').forEach(b => b.classList.remove('active'));
          this.classList.add('active');
        });
      });

      updateUnreadCount();

    })();
</script>