@model Application.Queries.GetAllNotificationByUserId.NotificationPageResponse
@{
    Layout = "~/Views/Shared/_LibraryLayout.cshtml";
    ViewData["Title"] = "Notifications";
}

<link href="~/css/notifications.css" rel="stylesheet" />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap">

<main class="main-content">

    <div class="page-header">
        <div>
            <h1>Notifications</h1>
            <p>Stay updated with important alerts and activities across your library.</p>
        </div>
        <div class="header-actions">
            <button class="btn-primary" id="markAllBtn">
                <svg class="icon" viewBox="0 0 24 24" style="width:16px;height:16px;">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                Mark All as Read
            </button>
            <div class="dropdown bell-wrap">
                <button class="bell-btn" data-toggle>
                    <svg class="icon" viewBox="0 0 24 24">
                        <path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"></path>
                        <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                    </svg>
                    <span class="badge-count" id="bellCount">@Model.UnreadNotifications</span>
                </button>
                <div class="dropdown-menu bell-menu">
                    <div class="bell-menu-header">
                        <span>Notifications</span>
                        <button class="bell-mark-all-btn" id="bellMarkAllBtn">Mark all as read</button>
                    </div>
                    <div class="bell-menu-list" id="bellMenuList">
                        @if (Model.Items.Any())
                        {
                            @foreach (var n in Model.Items.Take(5))
                            {
                                <div class="bell-item" data-id="@n.Id" data-action="bell-toggle-read">
                                    <div class="bell-item-icon icon-circle purple">
                                        <svg viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" /></svg>
                                    </div>
                                    <div class="bell-item-text">
                                        <div class="bell-item-title">@if (!n.IsRead) {
                                            <span class="bell-dot"></span>
                                        }
                                        @n.Title</div>
                                        <div class="bell-item-desc">@n.Message</div>
                                        <div class="bell-item-time">@n.DateCreated.ToString("MMM d, h:mm tt")</div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="bell-empty">You're all caught up!</div>
                        }
                    </div>
                    <div class="bell-menu-footer">
                        <a href="#" id="bellViewAllLink">View all notifications</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div style="background:#3a1a1a;color:#f87171;padding:10px 14px;border-radius:8px;margin-bottom:16px;font-size:13px">
            @TempData["Error"]
        </div>
    }
    <div class="stats-grid">
        <div class="stat-card">
            <div class="icon-circle purple">
                <svg class="icon" viewBox="0 0 24 24">
                    <path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"></path>
                    <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                </svg>
            </div>
            <div class="stat-top">
                <span class="stat-label">Total Notifications</span>
                <div class="stat-value">@Model.TotalNotifications.ToString("N0")</div>
            </div>
        </div>

        <div class="stat-card">
            <div class="icon-circle blue">
                <svg class="icon" viewBox="0 0 24 24">
                    <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                    <path d="m3 7 9 6 9-6"></path>
                </svg>
            </div>
            <div class="stat-top">
                <span class="stat-label">Unread Notifications</span>
                <div class="stat-value" id="unreadStat">@Model.UnreadNotifications.ToString("N0")</div>
            </div>
        </div>

        <div class="stat-card">
            <div class="icon-circle orange">
                <svg class="icon" viewBox="0 0 24 24">
                    <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                    <line x1="12" y1="9" x2="12" y2="13"></line>
                    <line x1="12" y1="17" x2="12" y2="17.01"></line>
                </svg>
            </div>
            <div class="stat-top">
                <span class="stat-label">Action Required</span>
                <div class="stat-value">@Model.ActionRequired.ToString("N0")</div>
            </div>
        </div>

        <div class="stat-card">
            <div class="icon-circle green">
                <svg class="icon" viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="10"></circle>
                    <path d="m9 12 2 2 4-4"></path>
                </svg>
            </div>
            <div class="stat-top">
                <span class="stat-label">Resolved Today</span>
                <div class="stat-value">@Model.ResolvedToday.ToString("N0")</div>
            </div>
        </div>

        <div class="stat-card">
            <div class="icon-circle gray">
                <svg class="icon" viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="10"></circle>
                    <path d="m9 12 2 2 4-4"></path>
                </svg>
            </div>
            <div class="stat-top">
                <span class="stat-label">Read Notifications</span>
                <div class="stat-value">@Model.ReadNotifications.ToString("N0")</div>
            </div>
        </div>
    </div>

    <div class="content-grid">

        <div class="left-col">
            <div class="toolbar">
                <div class="search-box">
                    <svg class="icon" viewBox="0 0 24 24">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input type="text" id="searchInput" placeholder="Search notifications...">
                </div>
                <div class="select-box">
                    <select id="categoryFilter">
                        <option value="all">All Categories</option>
                        <option value="Reminder">Reminder</option>
                        <option value="Payment">Payment</option>
                        <option value="Others">Others</option>
                    </select>
                </div>
                <div class="select-box">
                    <select id="statusFilter">
                        <option value="all">All Status</option>
                        <option value="unread">Unread</option>
                        <option value="read">Read</option>
                    </select>
                </div>
            </div>

            <div class="table-card">
                <table class="ntable">
                    <thead>
                        <tr>
                            <th>Notification</th>
                            <th>Category</th>
                            <th>Date &amp; Time</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody">
                        @if (Model.Items.Any())
                        {
                            @foreach (var n in Model.Items)
                            {
                                var statusClass = n.IsRead ? "read" : "unread";
                                <tr data-id="@n.Id" data-cat="@n.Category" data-status="@statusClass">
                                    <td>
                                        <div class="notif-cell">
                                            <span class="unread-dot @(n.IsRead ? "hidden" : "")"></span>
                                            <div class="notif-icon-wrap icon-circle purple">
                                                <svg viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" /></svg>
                                            </div>
                                            <div class="notif-text">
                                                <span class="notif-title">@n.Title</span>
                                                <span class="notif-desc">@n.Message</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td><span class="badge badge-@n.Category.ToLower()">@n.Category</span></td>
                                    <td class="date-cell">@n.DateCreated.ToString("MMM d, yyyy h:mm tt")</td>
                                    <td><span class="status status-@statusClass">@(n.IsRead ? "Read" : "Unread")</span></td>
                                    <td>
                                        <div class="action-cell">
                                            <a href="@Url.Action("GetNotification", "Library", new { id = n.Id })" class="btn-view">View</a>
                                            <div class="dropdown">
                                                <button class="btn-more" data-toggle>
                                                    <svg viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="5" r="1.6" /><circle cx="12" cy="12" r="1.6" /><circle cx="12" cy="19" r="1.6" /></svg>
                                                </button>
                                                <div class="dropdown-menu">
                                                    <button data-action="toggle-status" data-id="@n.Id" data-read="@(!n.IsRead ? "true" : "false")">
                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg>
                                                        <span class="action-label">@(n.IsRead ? "Mark as Unread" : "Mark as Read")</span>
                                                    </button>
                                                    <button data-action="archive" data-id="@n.Id">
                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="21 8 21 21 3 21 3 8" /><rect x="1" y="3" width="22" height="5" /><line x1="10" y1="12" x2="14" y2="12" /></svg>
                                                        Archive
                                                    </button>
                                                    <div class="divider"></div>
                                                    <button class="danger" data-action="delete" data-id="@n.Id">
                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6" /><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" /><path d="M10 11v6" /><path d="M14 11v6" /></svg>
                                                        Delete
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="5" style="text-align:center;color:#7878a0;padding:20px">No notifications</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <aside class="right-col">
            <div class="side-card">
                <h3>Quick Actions</h3>
                <div class="quick-action" id="qaMarkAll">
                    <svg class="icon" viewBox="0 0 24 24">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    Mark All as Read
                </div>
            </div>

            <div class="side-card">
                <h3>Notification Summary</h3>
                <div class="legend">
                    @foreach (var c in Model.CategoryBreakdown)
                    {
                        <div class="legend-row">
                            <div class="legend-left">@c.Category</div><span class="legend-val">@c.Count (@c.Percentage%)</span>
                        </div>
                    }
                </div>
            </div>
        </aside>

    </div>
</main>

<script>
    (function () {
        const tbody = document.getElementById('tableBody');
        const searchInput = document.getElementById('searchInput');
        const categoryFilter = document.getElementById('categoryFilter');
        const statusFilter = document.getElementById('statusFilter');
        const bellCountEl = document.getElementById('bellCount');
        const unreadStatEl = document.getElementById('unreadStat');

        function applyFilters() {
            const q = searchInput.value.trim().toLowerCase();
            const cat = categoryFilter.value;
            const status = statusFilter.value;

            tbody.querySelectorAll('tr[data-id]').forEach(row => {
                const title = row.querySelector('.notif-title')?.textContent.toLowerCase() || '';
                const desc = row.querySelector('.notif-desc')?.textContent.toLowerCase() || '';
                const matchesText = !q || title.includes(q) || desc.includes(q);
                const matchesCat = cat === 'all' || row.dataset.cat === cat;
                const matchesStatus = status === 'all' || row.dataset.status === status;
                row.style.display = (matchesText && matchesCat && matchesStatus) ? '' : 'none';
            });
        }

        searchInput.addEventListener('input', applyFilters);
        categoryFilter.addEventListener('change', applyFilters);
        statusFilter.addEventListener('change', applyFilters);

        function closeAllDropdowns() {
            document.querySelectorAll('.dropdown.open').forEach(d => d.classList.remove('open'));
        }

        document.addEventListener('click', async function (e) {
            const toggleBtn = e.target.closest('[data-toggle]');
            if (toggleBtn) {
                const dropdown = toggleBtn.closest('.dropdown');
                const wasOpen = dropdown.classList.contains('open');
                closeAllDropdowns();
                dropdown.classList.toggle('open', !wasOpen);
                return;
            }

            const actionBtn = e.target.closest('[data-action]');
            if (actionBtn) {
                const action = actionBtn.dataset.action;
                const id = actionBtn.dataset.id;
                const row = actionBtn.closest('tr');

                try {
                    if (action === 'bell-toggle-read') {
                        const tableRow = tbody.querySelector(`tr[data-id="${id}"]`);
                        const isUnread = tableRow ? tableRow.dataset.status === 'unread' : true;
                        await fetch('@Url.Action("ToggleNotificationRead")', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ id, read: isUnread })
                        });
                        location.reload();
                    } else if (action === 'toggle-status') {
                        const read = actionBtn.dataset.read === 'true';
                        await fetch('@Url.Action("ToggleNotificationRead")', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ id, read })
                        });
                        location.reload();
                    } else if (action === 'archive') {
                        await fetch('@Url.Action("ArchiveNotification")', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ id })
                        });
                        row.remove();
                    } else if (action === 'delete') {
                        await fetch('@Url.Action("DeleteNotification")', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ id })
                        });
                        row.remove();
                    }
                } catch (err) {
                    console.error('[notifications] action failed:', err);
                }

                closeAllDropdowns();
                return;
            }

            if (!e.target.closest('.dropdown-menu')) closeAllDropdowns();
        });

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') closeAllDropdowns();
        });

        async function markAllRead() {
            await fetch('@Url.Action("MarkAllNotificationsRead")', { method: 'POST' });
            location.reload();
        }
        document.getElementById('markAllBtn').addEventListener('click', markAllRead);
        document.getElementById('qaMarkAll').addEventListener('click', markAllRead);

        const bellMarkAllBtn = document.getElementById('bellMarkAllBtn');
        if (bellMarkAllBtn) {
            bellMarkAllBtn.addEventListener('click', function () {
                markAllRead();
                closeAllDropdowns();
            });
        }
    })();
</script>