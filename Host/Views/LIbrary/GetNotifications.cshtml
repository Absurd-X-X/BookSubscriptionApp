@{
    Layout = "~/Views/Shared/_LibraryLayout.cshtml";
    ViewData["Title"] = "Notifications";
}

<link href="~/css/notifications.css" rel="stylesheet" />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap">


<main class="main-content">

    <!-- ============ Page header ============ -->
    <div class="page-header">
        <div>
            <h1>Notifications</h1>
            <p>Stay updated with important alerts and activities across your library.</p>
        </div>
        <div class="header-actions">
            <button class="date-range-btn">
                May 1 – May 31, 2024
                <svg class="icon" viewBox="0 0 24 24">
                    <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
            </button>
            <button class="btn-primary" id="markAllBtn">
                <svg class="icon" viewBox="0 0 24 24" style="width:16px;height:16px;">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                Mark All as Read
            </button>
            <div class="dropdown bell-wrap">
                <button class="bell-btn" data-toggle>
                    <svg class="icon" viewBox="0 0 24 24">
                        <path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"></path>
                        <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                    </svg>
                    <span class="badge-count" id="bellCount">15</span>
                </button>
                <div class="dropdown-menu bell-menu">
                    <div class="bell-menu-header">
                        <span>Notifications</span>
                        <button class="bell-mark-all-btn" id="bellMarkAllBtn">Mark all as read</button>
                    </div>
                    <div class="bell-menu-list" id="bellMenuList">
                        <div class="bell-item" data-id="ntf-1" data-action="bell-toggle-read">
                            <div class="bell-item-icon icon-circle purple">
                                <svg viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" /></svg>
                            </div>
                            <div class="bell-item-text">
                                <div class="bell-item-title"><span class="bell-dot"></span>New review received</div>
                                <div class="bell-item-desc">A new review has been submitted for "Atomic Habits".</div>
                                <div class="bell-item-time">2 mins ago</div>
                            </div>
                        </div>
                        <div class="bell-item" data-id="ntf-2" data-action="bell-toggle-read">
                            <div class="bell-item-icon icon-circle green">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><line x1="19" y1="8" x2="19" y2="14" /><line x1="22" y1="11" x2="16" y2="11" /></svg>
                            </div>
                            <div class="bell-item-text">
                                <div class="bell-item-title"><span class="bell-dot"></span>New reader registered</div>
                                <div class="bell-item-desc">Emily Johnson has created a new account.</div>
                                <div class="bell-item-time">10 mins ago</div>
                            </div>
                        </div>
                        <div class="bell-item" data-id="ntf-3" data-action="bell-toggle-read">
                            <div class="bell-item-icon icon-circle orange">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23" /><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" /></svg>
                            </div>
                            <div class="bell-item-text">
                                <div class="bell-item-title"><span class="bell-dot"></span>Payment received</div>
                                <div class="bell-item-desc">Payment of $49.00 received from Michael Chen.</div>
                                <div class="bell-item-time">45 mins ago</div>
                            </div>
                        </div>
                        <div class="bell-item" data-id="ntf-4" data-action="bell-toggle-read">
                            <div class="bell-item-icon icon-circle blue">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg>
                            </div>
                            <div class="bell-item-text">
                                <div class="bell-item-title">Ticket response received</div>
                                <div class="bell-item-desc">Super Admin replied to ticket #TIC-2024-125.</div>
                                <div class="bell-item-time">1 hour ago</div>
                            </div>
                        </div>
                        <div class="bell-item" data-id="ntf-5" data-action="bell-toggle-read">
                            <div class="bell-item-icon icon-circle purple">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" /><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" /></svg>
                            </div>
                            <div class="bell-item-text">
                                <div class="bell-item-title">Book updated</div>
                                <div class="bell-item-desc">The book "Deep Work" has been updated.</div>
                                <div class="bell-item-time">2 hours ago</div>
                            </div>
                        </div>
                    </div>
                    <div class="bell-menu-footer">
                        <a href="#" id="bellViewAllLink">View all notifications</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ============ Stat cards ============ -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="icon-circle purple">
                <svg class="icon" viewBox="0 0 24 24">
                    <path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"></path>
                    <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                </svg>
            </div>
            <div class="stat-top">
                <span class="stat-label">Total Notifications</span>
                <div class="stat-value">128</div>
                <div class="stat-change up">↑ 12.4% <span>vs Apr 1 – Apr 30</span></div>
            </div>
        </div>

        <div class="stat-card">
            <div class="icon-circle blue">
                <svg class="icon" viewBox="0 0 24 24">
                    <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                    <path d="m3 7 9 6 9-6"></path>
                </svg>
            </div>
            <div class="stat-top">
                <span class="stat-label">Unread Notifications</span>
                <div class="stat-value" id="unreadStat">15</div>
                <div class="stat-change up">↑ 25% <span>vs Apr 1 – Apr 30</span></div>
            </div>
        </div>

        <div class="stat-card">
            <div class="icon-circle orange">
                <svg class="icon" viewBox="0 0 24 24">
                    <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                    <line x1="12" y1="9" x2="12" y2="13"></line>
                    <line x1="12" y1="17" x2="12" y2="17.01"></line>
                </svg>
            </div>
            <div class="stat-top">
                <span class="stat-label">Action Required</span>
                <div class="stat-value">7</div>
                <div class="stat-change up">↑ 16.7% <span>vs Apr 1 – Apr 30</span></div>
            </div>
        </div>

        <div class="stat-card">
            <div class="icon-circle green">
                <svg class="icon" viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="10"></circle>
                    <path d="m9 12 2 2 4-4"></path>
                </svg>
            </div>
            <div class="stat-top">
                <span class="stat-label">Resolved Today</span>
                <div class="stat-value">12</div>
                <div class="stat-change down">↓ 7.7% <span>vs Apr 1 – Apr 30</span></div>
            </div>
        </div>
    </div>

    <!-- ============ Content grid ============ -->
    <div class="content-grid">

        <!-- LEFT: toolbar + table -->
        <div class="left-col">
            <div class="toolbar">
                <div class="search-box">
                    <svg class="icon" viewBox="0 0 24 24">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input type="text" id="searchInput" placeholder="Search notifications...">
                </div>
                <div class="select-box">
                    <select id="categoryFilter">
                        <option value="all">All Categories</option>
                        <option value="reviews">Reviews</option>
                        <option value="readers">Readers</option>
                        <option value="earnings">Earnings</option>
                        <option value="support">Support</option>
                        <option value="books">Books</option>
                        <option value="reports">Reports</option>
                        <option value="system">System</option>
                    </select>
                </div>
                <div class="select-box">
                    <select id="statusFilter">
                        <option value="all">All Status</option>
                        <option value="unread">Unread</option>
                        <option value="read">Read</option>
                    </select>
                </div>
                <div class="select-box">
                    <svg class="icon" viewBox="0 0 24 24" style="width:15px;height:15px;">
                        <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                    <select id="dateFilter">
                        <option>Last 30 Days</option>
                        <option>Last 7 Days</option>
                        <option>Today</option>
                        <option>All Time</option>
                    </select>
                </div>
                <button class="filters-btn">
                    <svg class="icon" viewBox="0 0 24 24" style="width:15px;height:15px;">
                        <line x1="4" y1="21" x2="4" y2="14"></line>
                        <line x1="4" y1="10" x2="4" y2="3"></line>
                        <line x1="12" y1="21" x2="12" y2="12"></line>
                        <line x1="12" y1="8" x2="12" y2="3"></line>
                        <line x1="20" y1="21" x2="20" y2="16"></line>
                        <line x1="20" y1="12" x2="20" y2="3"></line>
                        <line x1="1" y1="14" x2="7" y2="14"></line>
                        <line x1="9" y1="8" x2="15" y2="8"></line>
                        <line x1="17" y1="16" x2="23" y2="16"></line>
                    </svg>
                    Filters
                </button>
            </div>

            <div class="table-card">
                <table class="ntable">
                    <thead>
                        <tr>
                            <th>Notification</th>
                            <th>Category</th>
                            <th>Date &amp; Time</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody">
                        <tr data-id="ntf-1" data-cat="reviews" data-status="unread">
                            <td>
                                <div class="notif-cell">
                                    <span class="unread-dot"></span>
                                    <div class="notif-icon-wrap icon-circle purple">
                                        <svg viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" /></svg>
                                    </div>
                                    <div class="notif-text">
                                        <span class="notif-title">New review received</span>
                                        <span class="notif-desc">A new review has been submitted for "Atomic Habits".</span>
                                    </div>
                                </div>
                            </td>
                            <td><span class="badge badge-reviews">Reviews</span></td>
                            <td class="date-cell">2 mins ago</td>
                            <td><span class="status status-unread">Unread</span></td>
                            <td>
                                <div class="action-cell">
                                    <a href="@Url.Action("GetNotification", "Library")" class="btn-view">View</a>
                                    <div class="dropdown">
                                        <button class="btn-more" data-toggle>
                                            <svg viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="5" r="1.6" /><circle cx="12" cy="12" r="1.6" /><circle cx="12" cy="19" r="1.6" /></svg>
                                        </button>
                                        <div class="dropdown-menu">
                                            <button data-action="toggle-status">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg>
                                                <span class="action-label">Mark as Read</span>
                                            </button>
                                            <button data-action="archive">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="21 8 21 21 3 21 3 8" /><rect x="1" y="3" width="22" height="5" /><line x1="10" y1="12" x2="14" y2="12" /></svg>
                                                Archive
                                            </button>
                                            <div class="divider"></div>
                                            <button class="danger" data-action="delete">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6" /><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" /><path d="M10 11v6" /><path d="M14 11v6" /></svg>
                                                Delete
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>

                        <tr data-id="ntf-2" data-cat="readers" data-status="unread">
                            <td>
                                <div class="notif-cell">
                                    <span class="unread-dot"></span>
                                    <div class="notif-icon-wrap icon-circle green">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><line x1="19" y1="8" x2="19" y2="14" /><line x1="22" y1="11" x2="16" y2="11" /></svg>
