@model Application.Queries.GetLibraryAnalytics.LibraryAnalyticsResponse
@{
    Layout = "~/Views/Shared/_LibraryLayout.cshtml";
    ViewData["Title"] = " Library Analytics";
}

<link href="~/css/analysis.css" rel="stylesheet" />

<div class="dash">

    <!-- TOP BAR -->
    <div class="topbar">
        <div class="topbar-left">
            <h2>Analytics Overview</h2>
            <p>Track and analyze how readers engage with your books.</p>
        </div>
        <div class="topbar-right">
            <form method="get" asp-action="Analysis" style="display:flex;gap:8px;align-items:center">
                <input type="date" name="start" value="@Model.PeriodStart.ToString("yyyy-MM-dd")" class="date-btn" />
                <input type="date" name="end" value="@Model.PeriodEnd.ToString("yyyy-MM-dd")" class="date-btn" />
                <button type="submit" class="export-btn">Apply</button>
            </form>
            <button class="export-btn">⬇ Export Analytics ▾</button>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div style="background:#3a1a1a;color:#f87171;padding:10px 14px;border-radius:8px;margin-bottom:16px;font-size:13px">
            @TempData["Error"]
        </div>
    }

    <!-- STAT CARDS -->
    <div class="stat-grid">
        <div class="stat-card">
            <div class="stat-icon si-blue">👥</div>
            <div class="stat-info">
                <p>Total Readers</p>
                <h3>@Model.TotalReaders.ToString("N0")</h3>
                <div class="stat-badge @(Model.TotalReadersGrowthPercent >= 0 ? "up" : "down")">
                    @(Model.TotalReadersGrowthPercent >= 0 ? "▲" : "▼") @Math.Abs(Model.TotalReadersGrowthPercent)%
                    <span style="color:#7878a0">vs prior period</span>
                </div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon si-green">✅</div>
            <div class="stat-info">
                <p>Active Readers</p>
                <h3>@Model.ActiveReaders.ToString("N0")</h3>
                <div class="stat-badge @(Model.ActiveReadersGrowthPercent >= 0 ? "up" : "down")">
                    @(Model.ActiveReadersGrowthPercent >= 0 ? "▲" : "▼") @Math.Abs(Model.ActiveReadersGrowthPercent)%
                    <span style="color:#7878a0">vs prior period</span>
                </div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon si-amber">⭐</div>
            <div class="stat-info">
                <p>Average Rating</p>
                <h3>@Model.AverageRating.ToString("0.0") ★</h3>
                <div class="stat-badge @(Model.AverageRatingChange >= 0 ? "up" : "down")">
                    @(Model.AverageRatingChange >= 0 ? "▲" : "▼") @Math.Abs(Model.AverageRatingChange)
                    <span style="color:#7878a0">vs prior period</span>
                </div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon si-purple">🔄</div>
            <div class="stat-info">
                <p>Average Completion Rate</p>
                <h3>@Model.AverageCompletionRate%</h3>
                <div class="stat-badge @(Model.AverageCompletionRateGrowthPercent >= 0 ? "up" : "down")">
                    @(Model.AverageCompletionRateGrowthPercent >= 0 ? "▲" : "▼") @Math.Abs(Model.AverageCompletionRateGrowthPercent)%
                    <span style="color:#7878a0">vs prior period</span>
                </div>
            </div>
        </div>
    </div>

    <!-- TREND CHART + SUMMARY -->
    <div class="mid-section">
        <div class="chart-card">
            <div class="card-header">
                <span class="card-title">Reader Activity Trend</span>
                <div class="tab-group">
                    <div class="tab active">Daily</div>
                    <div class="tab">Weekly</div>
                    <div class="tab">Monthly</div>
                </div>
            </div>
            <div class="chart-area">
                <canvas id="trendChart"></canvas>
            </div>
        </div>
        <div class="summary-card">
            <div class="card-header"><span class="card-title">Analytics Summary</span></div>
            <div class="summary-item">
                <div class="sum-icon si-yellow">🏆</div>
                <div>
                    <div class="sum-label">Best Performing Book</div>
                    <div class="sum-val">@(Model.BestPerformingBookTitle ?? "N/A")</div>
                    <div class="sum-sub">@Model.BestPerformingBookReads.ToString("N0") reads • @Model.BestPerformingBookCompletionPercent% completion</div>
                </div>
            </div>
            <div class="summary-item">
                <div class="sum-icon si-cal">📅</div>
                <div>
                    <div class="sum-label">Most Active Day</div>
                    <div class="sum-val">@(Model.MostActiveDay ?? "N/A")</div>
                    <div class="sum-sub">@Model.MostActiveDayReaders.ToString("N0") readers</div>
                </div>
            </div>
            <div class="summary-item">
                <div class="sum-icon si-clk">🕐</div>
                <div>
                    <div class="sum-label">Average Reading Time</div>
                    <div class="sum-val">@(TimeSpan.FromMinutes(Model.AverageReadingTimeMinutes).ToString(@"h\h\ m\m"))</div>
                    <div class="sum-sub @(Model.AverageReadingTimeGrowthPercent >= 0 ? "up" : "down")">
                        @(Model.AverageReadingTimeGrowthPercent >= 0 ? "▲" : "▼") @Math.Abs(Model.AverageReadingTimeGrowthPercent)% vs prior period
                    </div>
                </div>
            </div>
            <div class="summary-item">
                <div class="sum-icon si-org">📈</div>
                <div>
                    <div class="sum-label">Fastest Growing Book</div>
                    <div class="sum-val">@(Model.FastestGrowingBookTitle ?? "N/A")</div>
                    <div class="sum-sub @(Model.FastestGrowingBookGrowthPercent >= 0 ? "up" : "down")">
                        @(Model.FastestGrowingBookGrowthPercent >= 0 ? "▲" : "▼") @Math.Abs(Model.FastestGrowingBookGrowthPercent)% this period
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- READER INSIGHTS | READING TIME | FUNNEL -->
    <div class="three-col">
        <div class="chart-card">
            <div class="card-header"><span class="card-title">Reader Insights</span></div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:4px">
                <div style="background:#1a1a2e;border-radius:8px;padding:12px; border: 1px solid #2d2b72">
                    <p style="font-size:11px;color:#7878a0">Total Reads</p>
                    <h4 style="font-size:20px;font-weight:700;color:#fff;margin-top:2px">@Model.TotalReads.ToString("N0")</h4>
                    <div class="stat-badge @(Model.TotalReadsGrowthPercent >= 0 ? "up" : "down")" style="font-size:10px">
                        @(Model.TotalReadsGrowthPercent >= 0 ? "▲" : "▼") @Math.Abs(Model.TotalReadsGrowthPercent)%
                    </div>
                </div>
                <div style="background:#1a1a2e;border-radius:8px;padding:12px; border: 1px solid #2d2b72">
                    <p style="font-size:11px;color:#7878a0">Completed Reads</p>
                    <h4 style="font-size:20px;font-weight:700;color:#fff;margin-top:2px">@Model.CompletedReads.ToString("N0")</h4>
                    <div class="stat-badge @(Model.CompletedReadsGrowthPercent >= 0 ? "up" : "down")" style="font-size:10px">
                        @(Model.CompletedReadsGrowthPercent >= 0 ? "▲" : "▼") @Math.Abs(Model.CompletedReadsGrowthPercent)%
                    </div>
                </div>
                <div style="background:#1a1a2e;border-radius:8px;padding:12px; border: 1px solid #2d2b72">
                    <p style="font-size:11px;color:#7878a0">Abandoned Reads</p>
                    <h4 style="font-size:20px;font-weight:700;color:#fff;margin-top:2px">@Model.AbandonedReads.ToString("N0")</h4>
                    <div class="stat-badge @(Model.AbandonedReadsGrowthPercent <= 0 ? "up" : "down")" style="font-size:10px">
                        @(Model.AbandonedReadsGrowthPercent <= 0 ? "▼" : "▲") @Math.Abs(Model.AbandonedReadsGrowthPercent)%
                    </div>
                </div>
                <div style="background:#1a1a2e;border-radius:8px;padding:12px; border: 1px solid #2d2b72">
                    <p style="font-size:11px;color:#7878a0">Completion Rate</p>
                    <h4 style="font-size:20px;font-weight:700;color:#fff;margin-top:2px">@Model.AverageCompletionRate%</h4>
                    <div class="stat-badge @(Model.AverageCompletionRateGrowthPercent >= 0 ? "up" : "down")" style="font-size:10px">
                        @(Model.AverageCompletionRateGrowthPercent >= 0 ? "▲" : "▼") @Math.Abs(Model.AverageCompletionRateGrowthPercent)%
                    </div>
                </div>
            </div>
        </div>

        <div class="chart-card">
            <div class="card-header"><span class="card-title">Reading Time Distribution</span></div>
            <div style="display:flex;align-items:center;gap:16px">
                <div style="position:relative;width:100px;height:100px;flex-shrink:0">
                    <canvas id="donutChart"></canvas>
                </div>
                <div style="flex:1">
                    <div class="leg-item"><span style="display:flex;align-items:center"><span class="leg-dot" style="background:#6366f1"></span>&lt; 30 mins</span><span>@Model.TimeDistribution.Under30MinPct%</span></div>
                    <div class="leg-item"><span style="display:flex;align-items:center"><span class="leg-dot" style="background:#8b5cf6"></span>30 – 60 mins</span><span>@Model.TimeDistribution.Min30To60Pct%</span></div>
                    <div class="leg-item"><span style="display:flex;align-items:center"><span class="leg-dot" style="background:#a78bfa"></span>1 – 2 hours</span><span>@Model.TimeDistribution.Hour1To2Pct%</span></div>
                    <div class="leg-item"><span style="display:flex;align-items:center"><span class="leg-dot" style="background:#f59e0b"></span>2 – 3 hours</span><span>@Model.TimeDistribution.Hour2To3Pct%</span></div>
                    <div class="leg-item"><span style="display:flex;align-items:center"><span class="leg-dot" style="background:#10b981"></span>&gt; 3 hours</span><span>@Model.TimeDistribution.Over3HourPct%</span></div>
                </div>
            </div>
            <p style="text-align:center;font-size:11px;color:#7878a0;margin-top:10px">@Model.TotalReads.ToString("N0") Total Reads</p>
        </div>

        <div class="chart-card">
            <div class="card-header"><span class="card-title">Reading Funnel</span></div>
            <div class="funnel-bar">
                @foreach (var step in Model.Funnel)
                {
                    <div class="funnel-row">
                        <span class="funnel-label">@step.Label</span>
                        <div class="funnel-track"><div class="funnel-fill" style="width:@(step.Percentage)%"></div></div>
                        <span class="funnel-val">@step.Count.ToString("N0") <span style="color:#7878a0">@step.Percentage%</span></span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- TOP BOOKS | DEMOGRAPHICS | DEVICES -->
    <div class="three-col">
        <div class="chart-card">
            <div class="card-header">
                <span class="card-title">Top Performing Books</span>
                <a href="#" style="font-size:11px;color:#a78bfa;text-decoration:none">View All Books →</a>
            </div>
            <table class="books-table">
                <thead>
                    <tr><th>Book</th><th>Reads</th><th>Completion</th><th>Rating</th></tr>
                </thead>
                <tbody>
                    @if (Model.TopBooks.Any())
                    {
                        @foreach (var book in Model.TopBooks)
                        {
                            <tr>
                                <td>@book.Title</td>
                                <td>@book.Reads.ToString("N0")</td>
                                <td><div class="prog-bar"><div class="prog-fill" style="width:@(book.CompletionPercent)%"></div></div></td>
                                <td>@book.Rating.ToString("0.0") <span class="star">★</span></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="4" style="text-align:center;color:#7878a0;font-size:12px">No data for this period</td></tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="chart-card">
            <div class="card-header"><span class="card-title">Reader Demographics</span></div>
            <div style="display:flex;align-items:center;gap:16px">
                <div style="width:90px;height:90px;flex-shrink:0">
                    <canvas id="demoChart"></canvas>
                </div>
                <div style="flex:1">
                    <div class="demo-row"><span style="color:#a0a0c0">18 – 24</span><div class="demo-bar"><div class="demo-fill" style="width:@(Model.Demographics.Age18To24Pct)%;background:#6366f1"></div></div><span>@Model.Demographics.Age18To24Pct%</span></div>
                    <div class="demo-row"><span style="color:#a0a0c0">25 – 34</span><div class="demo-bar"><div class="demo-fill" style="width:@(Model.Demographics.Age25To34Pct)%;background:#8b5cf6"></div></div><span>@Model.Demographics.Age25To34Pct%</span></div>
                    <div class="demo-row"><span style="color:#a0a0c0">35 – 44</span><div class="demo-bar"><div class="demo-fill" style="width:@(Model.Demographics.Age35To44Pct)%;background:#a78bfa"></div></div><span>@Model.Demographics.Age35To44Pct%</span></div>
                    <div class="demo-row"><span style="color:#a0a0c0">45+</span><div class="demo-bar"><div class="demo-fill" style="width:@(Model.Demographics.Age45PlusPct)%;background:#c4b5fd"></div></div><span>@Model.Demographics.Age45PlusPct%</span></div>
                </div>
            </div>
        </div>

        <div class="chart-card">
            <div class="card-header"><span class="card-title">Reading Devices</span></div>
            <div class="device-row">
                <span style="color:#c0c0e0;min-width:70px">📱 Mobile</span>
                <div class="device-bar"><div style="height:100%;background:#7c3aed;width:@(Model.Devices.MobilePct)%;border-radius:3px"></div></div>
                <span style="color:#e0e0f0;font-weight:600">@Model.Devices.MobilePct%</span>
            </div>
            <div class="device-row">
                <span style="color:#c0c0e0;min-width:70px">🖥 Desktop</span>
                <div class="device-bar"><div style="height:100%;background:#60a5fa;width:@(Model.Devices.DesktopPct)%;border-radius:3px"></div></div>
                <span style="color:#e0e0f0;font-weight:600">@Model.Devices.DesktopPct%</span>
            </div>
            <div class="device-row">
                <span style="color:#c0c0e0;min-width:70px">📟 Tablet</span>
                <div class="device-bar"><div style="height:100%;background:#34d399;width:@(Model.Devices.TabletPct)%;border-radius:3px"></div></div>
                <span style="color:#e0e0f0;font-weight:600">@Model.Devices.TabletPct%</span>
            </div>
        </div>
    </div>

    <!-- SESSIONS | RATINGS | LOCATIONS -->
    <div class="bottom-row">
        <div class="chart-card">
            <div class="card-header"><span class="card-title">Reading Sessions</span></div>
            <div class="session-stats">
                <div class="sess-box">
                    <p>Avg. Session Time</p><h4>@(TimeSpan.FromMinutes(Model.AvgSessionTimeMinutes).ToString(@"h\h\ m\m"))</h4>
                    <div class="stat-badge @(Model.AvgSessionTimeGrowthPercent >= 0 ? "up" : "down")" style="font-size:10px;justify-content:center">
                        @(Model.AvgSessionTimeGrowthPercent >= 0 ? "▲" : "▼") @Math.Abs(Model.AvgSessionTimeGrowthPercent)%
                    </div>
                </div>
                <div class="sess-box">
                    <p>Pages Per Session</p><h4>@Model.PagesPerSession.ToString("0")</h4>
                    <div class="stat-badge @(Model.PagesPerSessionGrowthPercent >= 0 ? "up" : "down")" style="font-size:10px;justify-content:center">
                        @(Model.PagesPerSessionGrowthPercent >= 0 ? "▲" : "▼") @Math.Abs(Model.PagesPerSessionGrowthPercent)%
                    </div>
                </div>
                <div class="sess-box">
                    <p>Avg. Daily Readers</p><h4>@Model.AvgDailyReaders.ToString("0")</h4>
                    <div class="stat-badge @(Model.AvgDailyReadersGrowthPercent >= 0 ? "up" : "down")" style="font-size:10px;justify-content:center">
                        @(Model.AvgDailyReadersGrowthPercent >= 0 ? "▲" : "▼") @Math.Abs(Model.AvgDailyReadersGrowthPercent)%
                    </div>
                </div>
                <div class="sess-box">
                    <p>Return Reader Rate</p><h4>@Model.ReturnReaderRatePercent.ToString("0")%</h4>
                    <div class="stat-badge @(Model.ReturnReaderRateGrowthPercent >= 0 ? "up" : "down")" style="font-size:10px;justify-content:center">
                        @(Model.ReturnReaderRateGrowthPercent >= 0 ? "▲" : "▼") @Math.Abs(Model.ReturnReaderRateGrowthPercent)%
                    </div>
                </div>
            </div>
        </div>

        <div class="chart-card">
            <div class="card-header"><span class="card-title">Ratings Distribution</span></div>
            <div class="rating-row"><span class="rat-label"><span class="star">★</span> 5 Star</span><div class="rat-bar"><div class="rat-fill" style="width:@(Model.Ratings.FiveStarPct)%"></div></div><span class="rat-val">@Model.Ratings.FiveStarPct%</span></div>
            <div class="rating-row"><span class="rat-label"><span class="star">★</span> 4 Star</span><div class="rat-bar"><div class="rat-fill" style="width:@(Model.Ratings.FourStarPct)%"></div></div><span class="rat-val">@Model.Ratings.FourStarPct%</span></div>
            <div class="rating-row"><span class="rat-label"><span class="star">★</span> 3 Star</span><div class="rat-bar"><div class="rat-fill" style="width:@(Model.Ratings.ThreeStarPct)%"></div></div><span class="rat-val">@Model.Ratings.ThreeStarPct%</span></div>
            <div class="rating-row"><span class="rat-label"><span class="star">★</span> 2 Star</span><div class="rat-bar"><div class="rat-fill" style="width:@(Model.Ratings.TwoStarPct)%"></div></div><span class="rat-val">@Model.Ratings.TwoStarPct%</span></div>
            <div class="rating-row"><span class="rat-label"><span class="star">★</span> 1 Star</span><div class="rat-bar"><div class="rat-fill" style="width:@(Model.Ratings.OneStarPct)%"></div></div><span class="rat-val">@Model.Ratings.OneStarPct%</span></div>
        </div>

        <div class="chart-card">
            <div class="card-header"><span class="card-title">Top Reader Locations</span></div>
            @if (Model.TopLocations.Any())
            {
                @foreach (var loc in Model.TopLocations)
                {
                    <div class="location-row"><div class="loc-name">@loc.CountryName</div><span class="loc-count">@loc.ReaderCount.ToString("N0")</span><span class="loc-pct">@loc.Percentage%</span></div>
                }
            }
            else
            {
                <p style="font-size:12px;color:#7878a0">No location data available yet.</p>
            }
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
    <script>
        const trendCtx = document.getElementById('trendChart').getContext('2d');
        const dayLabels = @Html.Raw(Json.Serialize(Model.TrendLabels));
        const trendData = @Html.Raw(Json.Serialize(Model.TrendData));
        new Chart(trendCtx, {
        type: 'line',
        data: {
        labels: dayLabels,
        datasets: [{
        data: trendData,
        borderColor: '#7c3aed',
        backgroundColor: 'rgba(124,58,237,0.15)',
        fill: true,
        tension: 0.4,
        pointBackgroundColor: '#a78bfa',
        pointRadius: 3,
        pointHoverRadius: 5,
        borderWidth: 2
        }]
        },
        options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
        x: { ticks: { color: '#7878a0', font: { size: 10 }, maxTicksLimit: 7 }, grid: { color: '#1a1a2e' } },
        y: { ticks: { color: '#7878a0', font: { size: 10 } }, grid: { color: '#1a1a2e' }, beginAtZero: true }
        }
        }
        });

        const donutCtx = document.getElementById('donutChart').getContext('2d');
        new Chart(donutCtx, {
        type: 'doughnut',
        data: {
        labels: ['<30m', '30-60m', '1-2h', '2-3h', '>3h'],
        datasets: [{
        data: [@Model.TimeDistribution.Under30MinPct, @Model.TimeDistribution.Min30To60Pct, @Model.TimeDistribution.Hour1To2Pct, @Model.TimeDistribution.Hour2To3Pct, @Model.TimeDistribution.Over3HourPct],
        backgroundColor: ['#6366f1', '#8b5cf6', '#a78bfa', '#f59e0b', '#10b981'],
        borderWidth: 0
        }]
        },
        options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        cutout: '70%'
        }
        });

        const demoCtx = document.getElementById('demoChart').getContext('2d');
        new Chart(demoCtx, {
        type: 'doughnut',
        data: {
        labels: ['18-24', '25-34', '35-44', '45+'],
        datasets: [{
        data: [@Model.Demographics.Age18To24Pct, @Model.Demographics.Age25To34Pct, @Model.Demographics.Age35To44Pct, @Model.Demographics.Age45PlusPct],
        backgroundColor: ['#6366f1', '#8b5cf6', '#a78bfa', '#c4b5fd'],
        borderWidth: 0
        }]
        },
        options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        cutout: '65%'
        }
        });
    </script>
</div>