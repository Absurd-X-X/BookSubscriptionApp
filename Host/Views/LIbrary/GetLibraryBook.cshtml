@{
    Layout = "~/Views/Shared/_LibraryLayout.cshtml";
    ViewData["Title"] = "Get Book";
}
<link href="~/css/getLibraryBook.css" rel="stylesheet" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>

<!-- Book Header -->
<div class="book-header">
    <div class="book-cover-wrap">
        <div class="book-cover-img">
            <div class="cover-placeholder">
                <div class="cover-top">Tiny Changes,<br>Remarkable Results</div>
                <div class="cover-main">Atomic<br>Habits</div>
                <div class="cover-sub">An Easy & Proven Way to Build Good Habits & Break Bad Ones</div>
                <div class="cover-author">James Clear</div>
            </div>
        </div>
    </div>
    <div class="book-header-info">
        <h1 class="book-title">Atomic Habits</h1>
        <p class="book-author">James Clear</p>
        <div class="book-badges">
            <span class="badge badge-green">Published</span>
            <span class="badge badge-purple">Self Help</span>
            <span class="badge-date">&#128197; Published on May 28, 2024</span>
        </div>
        <div class="book-rating">
            <span class="star-icon">&#9733;</span>
            <span class="rating-val">4.9</span>
            <span class="rating-count">(245 reviews)</span>
        </div>
        <div class="book-stats">
            <div class="stat-box">
                <span class="stat-icon si-green">&#128065;</span>
                <div>
                    <div class="stat-val">1,245</div>
                    <div class="stat-lbl">Total Reads</div>
                </div>
            </div>
            <div class="stat-box">
                <span class="stat-icon si-blue">&#128218;</span>
                <div>
                    <div class="stat-val">98%</div>
                    <div class="stat-lbl">Completion Rate</div>
                </div>
            </div>
            <div class="stat-box">
                <span class="stat-icon si-orange">&#9201;</span>
                <div>
                    <div class="stat-val">2h 34m</div>
                    <div class="stat-lbl">Avg. Reading Time</div>
                </div>
            </div>
            <div class="stat-box">
                <span class="stat-icon si-pink">&#128179;</span>
                <div>
                    <div class="stat-val">&#8358;98,000</div>
                    <div class="stat-lbl">Total Revenue</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Tab Navigation -->
<div class="tab-nav">
    <button class="tab-btn active" data-tab="overview" onclick="switchTab('overview')">Overview</button>
    <button class="tab-btn" data-tab="analytics" onclick="switchTab('analytics')">Analytics</button>
    <button class="tab-btn" data-tab="reviews" onclick="switchTab('reviews')">Reviews <span class="tab-count">245</span></button>
    <button class="tab-btn" data-tab="revenue" onclick="switchTab('revenue')">Revenue</button>
</div>

<!-- ===== TAB: Overview ===== -->
<div class="tab-pane active" id="tab-overview">
    <div class="two-col">
        <div class="main-col">

            <div class="card">
                <h2 class="card-title">About the Book</h2>
                <p class="book-desc">No matter your goals, Atomic Habits offers a proven framework for improving—every day. James Clear, one of the world's leading experts on habit formation, reveals practical strategies that will teach you exactly how to form good habits, break bad ones, and master the tiny behaviors that lead to remarkable results.</p>
                <div class="book-meta-grid">
                    <div class="meta-item"><span class="meta-lbl">Category</span><span class="meta-val">Self Help</span></div>
                    <div class="meta-item"><span class="meta-lbl">ISBN</span><span class="meta-val">978-1847941831</span></div>
                    <div class="meta-item"><span class="meta-lbl">Language</span><span class="meta-val">English</span></div>
                    <div class="meta-item"><span class="meta-lbl">File Type</span><span class="meta-val">EPUB, PDF</span></div>
                    <div class="meta-item"><span class="meta-lbl">Pages</span><span class="meta-val">320</span></div>
                    <div class="meta-item"><span class="meta-lbl">File Size</span><span class="meta-val">2.4 MB</span></div>
                </div>
            </div>

            <div class="card">
                <div class="card-header-row">
                    <h2 class="card-title">Recent Reviews</h2>
                    <a href="#" class="view-all-link" onclick="switchTab('reviews');return false;">View all</a>
                </div>
                <div class="review-list">
                    <div class="review-item">
                        <div class="avatar av-purple">SO</div>
                        <div class="review-body">
                            <div class="review-top">
                                <span class="reviewer-name">Sarah O.</span>
                                <span class="review-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
                                <span class="review-age">2 days ago</span>
                            </div>
                            <p class="review-text">This book changed the way I think about small daily actions. Simple but powerful!</p>
                        </div>
                    </div>
                    <div class="review-item">
                        <div class="avatar av-teal">MT</div>
                        <div class="review-body">
                            <div class="review-top">
                                <span class="reviewer-name">Michael T.</span>
                                <span class="review-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
                                <span class="review-age">5 days ago</span>
                            </div>
                            <p class="review-text">Practical, easy to read, and life changing. Highly recommend!</p>
                        </div>
                    </div>
                    <div class="review-item">
                        <div class="avatar av-blue">DL</div>
                        <div class="review-body">
                            <div class="review-top">
                                <span class="reviewer-name">David L.</span>
                                <span class="review-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
                                <span class="review-age">1 week ago</span>
                            </div>
                            <p class="review-text">The best book on habits I've ever read.</p>
                        </div>
                    </div>
                    <div class="review-item">
                        <div class="avatar av-orange">ER</div>
                        <div class="review-body">
                            <div class="review-top">
                                <span class="reviewer-name">Emily R.</span>
                                <span class="review-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
                                <span class="review-age">1 week ago</span>
                            </div>
                            <p class="review-text">Clear and actionable. Great examples!</p>
                        </div>
                    </div>
                </div>
                <button class="view-all-btn" onclick="switchTab('reviews')">View all 245 reviews</button>
            </div>

            <div class="card">
                <h2 class="card-title">Book Files</h2>
                <div class="file-list">
                    <div class="file-item">
                        <div class="file-icon fi-red">PDF</div>
                        <div class="file-info">
                            <div class="file-name">Atomic Habits - Full Book.pdf</div>
                            <div class="file-meta">PDF · 2.4 MB · Uploaded on May 20, 2024</div>
                        </div>
                        <div class="file-actions">
                            <button class="icon-btn" title="Download">&#8595;</button>
                            <button class="icon-btn" title="More">&#8942;</button>
                        </div>
                    </div>
                    <div class="file-item">
                        <div class="file-icon fi-green">EPUB</div>
                        <div class="file-info">
                            <div class="file-name">Atomic Habits - Full Book.epub</div>
                            <div class="file-meta">EPUB · 1.8 MB · Uploaded on May 20, 2024</div>
                        </div>
                        <div class="file-actions">
                            <button class="icon-btn" title="Download">&#8595;</button>
                            <button class="icon-btn" title="More">&#8942;</button>
                        </div>
                    </div>
                </div>
            </div>

        </div>
        <div class="side-col">

            <div class="card">
                <div class="card-header-row">
                    <h2 class="card-title">Book Performance <span class="card-title-sub">(This Month)</span></h2>
                    <select class="mini-select"><option>This Month</option><option>Last Month</option></select>
                </div>
                <div class="perf-chart-area">
                    <canvas id="perfChart"></canvas>
                </div>
                <div class="perf-stats">
                    <div class="perf-stat">
                        <div class="ps-val">245 <span class="ps-up">&#8593; 12%</span></div>
                        <div class="ps-lbl">Reads</div>
                    </div>
                    <div class="perf-stat">
                        <div class="ps-val">98% <span class="ps-up">&#8593; 8%</span></div>
                        <div class="ps-lbl">Completion Rate</div>
                    </div>
                    <div class="perf-stat">
                        <div class="ps-val">2h 34m <span class="ps-up">&#8593; 5%</span></div>
                        <div class="ps-lbl">Reading Time</div>
                    </div>
                    <div class="perf-stat">
                        <div class="ps-val">128 <span class="ps-up">&#8593; 15%</span></div>
                        <div class="ps-lbl">New Readers</div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header-row">
                    <h2 class="card-title">Revenue Overview</h2>
                    <select class="mini-select"><option>This Month</option><option>Last Month</option></select>
                </div>
                <div class="rev-total">&#8358;98,000 <span class="ps-up">&#8593; 10% from last month</span></div>
                <div class="rev-chart-area">
                    <canvas id="revChart"></canvas>
                </div>
                <div class="rev-stats">
                    <div class="rev-stat"><div class="rs-lbl">Total Revenue</div><div class="rs-val">&#8358;98,000</div></div>
                    <div class="rev-stat"><div class="rs-lbl">Paid Reads</div><div class="rs-val">980</div></div>
                    <div class="rev-stat"><div class="rs-lbl">Free Reads</div><div class="rs-val">265</div></div>
                    <div class="rev-stat"><div class="rs-lbl">Refunds</div><div class="rs-val">&#8358;0</div></div>
                </div>
            </div>

            <div class="card">
                <h2 class="card-title">Quick Actions</h2>
                <div class="quick-actions">
                    <div class="qa-item">
                        <span class="qa-icon qa-purple">&#9998;</span>
                        <div class="qa-info">
                            <div class="qa-title">Edit Book Information</div>
                            <div class="qa-desc">Update title, description, categories and more</div>
                        </div>
                        <span class="qa-arrow">&#8250;</span>
                    </div>
                    <div class="qa-item">
                        <span class="qa-icon qa-blue">&#8679;</span>
                        <div class="qa-info">
                            <div class="qa-title">Upload New Version</div>
                            <div class="qa-desc">Upload a new file to replace current book</div>
                        </div>
                        <span class="qa-arrow">&#8250;</span>
                    </div>
                    <div class="qa-item">
                        <span class="qa-icon qa-green">&#9647;</span>
                        <div class="qa-info">
                            <div class="qa-title">Duplicate Book</div>
                            <div class="qa-desc">Create a copy of this book</div>
                        </div>
                        <span class="qa-arrow">&#8250;</span>
                    </div>
                    <div class="qa-item qa-danger">
                        <span class="qa-icon qa-red">&#128190;</span>
                        <div class="qa-info">
                            <div class="qa-title qa-title-red">Archive Book</div>
                            <div class="qa-desc">Hide this book from the public</div>
                        </div>
                        <span class="qa-arrow">&#8250;</span>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- ===== TAB: Analytics ===== -->
<div class="tab-pane" id="tab-analytics">
