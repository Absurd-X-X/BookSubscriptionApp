        </div>

        <div class="card reader-insights-card">
            <h2 class="card-title">Reader Insights</h2>
            <div class="insight-item">
                <div class="insight-icon ii-purple">&#128101;</div>
                <div class="insight-info">
                    <div class="insight-lbl">Total Readers</div>
